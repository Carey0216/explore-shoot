.file-composer {
  margin: calc(var(--jy-rpx, 1rpx) * 18) 0;
  color: var(--text, #273d50);
}
.file-choose {
  margin: 0;
  padding: calc(var(--jy-rpx, 1rpx) * 12) calc(var(--jy-rpx, 1rpx) * 22);
  display: inline-flex;
  align-items: center;
  font-size: calc(var(--jy-rpx, 1rpx) * 24);
  line-height: 1.4;
  border: calc(var(--jy-rpx, 1rpx) * 1) solid var(--line, #d5e0e7);
  border-radius: calc(var(--jy-rpx, 1rpx) * 24);
  background: var(--raised, #edf3f7);
  color: var(--accent, #346b9c);
}
.file-choose::after,
.file-action::after {
  border: 0;
}
.file-tip {
  display: block;
  font-size: calc(var(--jy-rpx, 1rpx) * 21);
  line-height: 1.5;
  color: var(--muted, #637887);
  margin-top: calc(var(--jy-rpx, 1rpx) * 10);
}
.file-row {
  display: flex;
  align-items: center;
  gap: calc(var(--jy-rpx, 1rpx) * 12);
  padding: calc(var(--jy-rpx, 1rpx) * 18);
  margin-top: calc(var(--jy-rpx, 1rpx) * 12);
  border: calc(var(--jy-rpx, 1rpx) * 1) solid var(--line, #d5e0e7);
  border-radius: calc(var(--jy-rpx, 1rpx) * 24);
  background: var(--raised, #edf3f7);
}
.file-meta {
  min-width: 0;
  flex: 1;
}
.file-name {
  display: block;
  word-break: break-all;
  font-size: calc(var(--jy-rpx, 1rpx) * 24);
  line-height: 1.5;
}
.file-state {
  display: block;
  font-size: calc(var(--jy-rpx, 1rpx) * 21);
  color: var(--muted, #637887);
  margin-top: calc(var(--jy-rpx, 1rpx) * 6);
}
.file-error {
  display: block;
  font-size: calc(var(--jy-rpx, 1rpx) * 21);
  line-height: 1.5;
  color: var(--danger, #b33f57);
  margin-top: calc(var(--jy-rpx, 1rpx) * 8);
}
.file-action {
  flex: none;
  margin: 0;
  padding: calc(var(--jy-rpx, 1rpx) * 8) calc(var(--jy-rpx, 1rpx) * 10);
  border: 0;
  background: transparent;
  color: var(--accent, #346b9c);
  font-size: calc(var(--jy-rpx, 1rpx) * 22);
  line-height: 1.5;
}
