.collection-entry { display:flex;align-items:center;gap:18rpx;min-width:0;margin:22rpx 0;padding:22rpx;border:1rpx solid var(--line,#d5e0e7);border-radius:30rpx;background:var(--raised,#f0f5f9);color:var(--text,#273d50);position:relative;overflow:hidden; }
.atlas-mini { width:200rpx;height:108rpx;flex:none;overflow:hidden;border-radius:18rpx;position:relative; }
.collection-canvas { width:100%; }
.collection-symbol { width:76rpx;height:76rpx;position:absolute;left:58rpx;top:16rpx; }
.collection-copy { flex:1;min-width:0; }
.collection-title { display:block;font-size:27rpx;font-weight:600;line-height:1.5; }
.collection-note { display:block;margin-top:6rpx;font-size:22rpx;line-height:1.55;color:var(--muted,#637887); }
.collection-arrow { font-size:28rpx;flex:none; }
.celebrating { flex-direction:column;background:transparent;border:0;padding:0;margin:16rpx 0; }
.celebrating .atlas-mini { width:100%;height:320rpx;border-radius:28rpx; }
.celebrating .collection-title { font-size:30rpx; }
.collection-seal { position:absolute;right:22rpx;top:220rpx;transform:rotate(-9deg);padding:10rpx 20rpx;border:3rpx solid #de8e56;border-radius:16rpx;color:#bc7547;font-size:28rpx;font-weight:700;animation:collection-seal812 500ms cubic-bezier(.22,1,.36,1) both; }
@keyframes collection-seal812 { from { opacity:0;transform:scale(1.35) rotate(-16deg); } 72% { opacity:1;transform:scale(.96) rotate(-9deg); } to { opacity:1;transform:scale(1) rotate(-9deg); } }
