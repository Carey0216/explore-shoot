<wxs src="/services/i18n.wxs" module="i18n"/>
<view wx:if="{{hint}}" class="collection-live {{themeClass}}" style="{{themeStyle}}"><image class="guide-icon" src="{{i18n.icon('passport',true)}}" mode="aspectFit"/><view class="guide-copy" bindtap="open" aria-role="button"><text class="guide-title">{{i18n.content(hint.title,locale,localeTranslations,localeOriginal)}}</text><text class="guide-note">{{i18n.content(hint.text,locale,localeTranslations,localeOriginal)}}</text><text class="guide-action">{{i18n.ui(hint.direct?'去打卡':'看看下一栋',locale)}} ↗</text></view><view class="guide-close" bindtap="close" aria-role="button" aria-label="{{i18n.ui('关闭收集提示',locale)}}"><image class="close-icon" src="{{i18n.icon('close',true)}}" mode="aspectFit"/></view></view>
