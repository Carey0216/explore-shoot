<wxs src="/services/i18n.wxs" module="i18n"/>
<view wx:if="{{runtime && runtime.name !== 'production'}}" class="u-view env">{{i18n.content(runtime.label,locale,localeTranslations,localeOriginal)}}</view>
<button wx:if="{{content && (page === 'shots' || page === 'my' || page === 'settings')}}" class="u-button help" bindtap="openHelp">{{i18n.content(content.helpTitle || '项目介绍与拍摄帮助',locale,localeTranslations,localeOriginal)}}</button>
<view wx:if="{{announcement || help}}" class="u-view mask" catchtap="dismiss">
  <view class="u-view panel" catchtap="noop">
    <view class="u-view heading"><text class="u-text">{{i18n.content(announcement ? announcement.title : (content.helpTitle || content.siteName),locale,localeTranslations,localeOriginal)}}</text><button size="mini" class="u-button close" bindtap="dismiss" aria-label="{{i18n.ui('关闭',locale)}}">×</button></view>
    <scroll-view scroll-y class="u-scroll-view body">
      <message-body wx:if="{{announcement}}" value="{{announcement}}" bind:navigate="dismiss"/>
      <block wx:else><view class="u-view muted">{{i18n.content(content.helpSubtitle || content.campusName,locale,localeTranslations,localeOriginal)}}</view><view class="u-view subtitle">{{i18n.content(content.aboutTitle || '项目介绍',locale,localeTranslations,localeOriginal)}}</view><text class="u-text copy">{{i18n.content(content.about,locale,localeTranslations,localeOriginal)}}</text><view class="u-view subtitle">{{i18n.content(content.helpSectionTitle || '使用帮助',locale,localeTranslations,localeOriginal)}}</view><text class="u-text copy">{{i18n.content(content.help,locale,localeTranslations,localeOriginal)}}</text><view class="u-view subtitle">{{i18n.content(content.shootingGuideTitle || '拍摄建议',locale,localeTranslations,localeOriginal)}}</view><text class="u-text copy">{{i18n.content(content.shootingGuide,locale,localeTranslations,localeOriginal)}}</text><view wx:for="{{content.categories}}" wx:key="id" class="u-view gap"><text class="u-text">{{i18n.content(item.label,locale,localeTranslations,localeOriginal)}}：{{i18n.content(item.description,locale,localeTranslations,localeOriginal)}}</text></view><view wx:for="{{content.conditions}}" wx:key="id" class="u-view gap"><text class="u-text">{{i18n.content(item.label,locale,localeTranslations,localeOriginal)}}：{{i18n.content(item.description,locale,localeTranslations,localeOriginal)}}</text></view><button wx:for="{{content.helpLinks}}" wx:key="href" class="u-button gap" data-href="{{item.href}}" bindtap="helpLink">{{i18n.content(item.label,locale,localeTranslations,localeOriginal)}} ↗</button></block>
    </scroll-view>
    <button class="u-button confirm" bindtap="dismiss">{{i18n.ui('知道了',locale)}}</button>
  </view>
</view>
