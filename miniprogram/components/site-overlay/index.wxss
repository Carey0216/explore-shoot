@import '../base.wxss';
:host {
  display: block;
}
.env {
  position: fixed;
  top: auto;
  bottom: 4rpx;
  right: 20rpx;
  z-index: 800;
  background: #e2f2e8;
  color: #245b4c;
  padding: 5rpx 12rpx;
  border-radius: 12rpx;
  font-size: calc(20rpx * var(--font-scale, 1));
  pointer-events: none;
}
.notice {
  margin: 20rpx 32rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #f4ecdb;
  color: #675337;
  white-space: pre-wrap;
}
.help {
  width: auto;
  margin: 12rpx 32rpx 170rpx;
  background: transparent;
  color: #406858;
  font-size: calc(24rpx * var(--font-scale, 1));
}
.help::after,
.close::after,
.confirm::after {
  border: 0;
}
.mask {
  position: fixed;
  inset: 0;
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #16251f66;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  padding: 36rpx;
  box-sizing: border-box;
}
.panel {
  width: 100%;
  max-width: 650rpx;
  padding: 30rpx;
  border-radius: 40rpx;
  background: #fffffff5;
  box-shadow: 0 24rpx 80rpx #12271d33;
  box-sizing: border-box;
}
.heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  font-size: calc(34rpx * var(--font-scale, 1));
  font-weight: 600;
  color: #203d32;
}
.close {
  flex-shrink: 0;
  margin: 0;
  padding: 0;
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  border-radius: 22rpx;
  background: #eaf0ed;
  color: #426357;
  font-size: calc(40rpx * var(--font-scale, 1));
}
.body {
  max-height: 52vh;
  margin: 20rpx 0 28rpx;
  color: #40564b;
  font-size: calc(28rpx * var(--font-scale, 1));
  line-height: 1.7;
}
.copy {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.subtitle {
  font-weight: 600;
  margin-top: 24rpx;
}
.muted {
  color: #849087;
  font-size: calc(24rpx * var(--font-scale, 1));
}
.gap {
  margin-top: 12rpx;
}
.confirm {
  margin: 0;
  border-radius: 28rpx;
  background: #245b4c;
  color: white;
  font-size: calc(28rpx * var(--font-scale, 1));
}

.heading > .u-text {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
}
.close {
  flex: 0 0 64rpx;
  min-width: 64rpx;
  max-width: 64rpx;
}
.confirm {
  display: block;
  width: 100%;
  max-width: none;
  flex: none;
}

:host {
  color: var(--text, #25374a);
}
.dialog,
.panel,
.card,
.sheet,
.reward-card,
.modal,
.popup {
  background: var(--surface, #fff);
  color: var(--text, #25374a);
  border-color: var(--line, #d8e4ed);
}
.muted,
.privacy,
.subtitle {
  color: var(--muted, #6e808b);
}
.u-button {
  background: var(--raised, #eaf1f6);
  color: var(--accent, #326ba6);
  border-color: var(--line, #d8e4ed);
  box-shadow: none;
}
.placeholder,
.empty {
  background: var(--raised, #eaf1f6);
  color: var(--muted, #6e808b);
}

.body {
  height: 52vh;
  min-height: 0;
  box-sizing: border-box;
  color: var(--text, #25374a);
}
.heading {
  color: var(--text, #25374a);
}
.mask {
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}
.panel {
  max-height: 90vh;
  overflow: hidden;
}
.help {
  background: var(--raised, #eaf1f6);
  color: var(--accent, #326ba6);
}
