@import '../base.wxss';
:host {
  display: block;
}
.env {
  position: fixed;
  top: auto;
  bottom: calc(var(--jy-rpx, 1rpx) * 4);
  right: calc(var(--jy-rpx, 1rpx) * 20);
  z-index: 800;
  background: #e2f2e8;
  color: #245b4c;
  padding: calc(var(--jy-rpx, 1rpx) * 5) calc(var(--jy-rpx, 1rpx) * 12);
  border-radius: calc(var(--jy-rpx, 1rpx) * 12);
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 20) * var(--font-scale, 1));
  pointer-events: none;
}
.notice {
  margin: calc(var(--jy-rpx, 1rpx) * 20) calc(var(--jy-rpx, 1rpx) * 32);
  padding: calc(var(--jy-rpx, 1rpx) * 24);
  border-radius: calc(var(--jy-rpx, 1rpx) * 24);
  background: #f4ecdb;
  color: #675337;
  white-space: pre-wrap;
}
.help {
  width: auto;
  margin: calc(var(--jy-rpx, 1rpx) * 12) calc(var(--jy-rpx, 1rpx) * 32)
    calc(var(--jy-rpx, 1rpx) * 170);
  background: transparent;
  color: #406858;
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 24) * var(--font-scale, 1));
}
.help::after,
.close::after,
.confirm::after {
  border: 0;
}
.mask {
  position: fixed;
  inset: 0;
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #16251f66;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  padding: calc(var(--jy-rpx, 1rpx) * 36);
  box-sizing: border-box;
}
.panel {
  width: 100%;
  max-width: calc(var(--jy-rpx, 1rpx) * 650);
  padding: calc(var(--jy-rpx, 1rpx) * 30);
  border-radius: calc(var(--jy-rpx, 1rpx) * 40);
  background: #fffffff5;
  box-shadow: 0 calc(var(--jy-rpx, 1rpx) * 24) calc(var(--jy-rpx, 1rpx) * 80) #12271d33;
  box-sizing: border-box;
}
.heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: calc(var(--jy-rpx, 1rpx) * 16);
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 34) * var(--font-scale, 1));
  font-weight: 600;
  color: #203d32;
}
.close {
  flex-shrink: 0;
  margin: 0;
  padding: 0;
  width: calc(var(--jy-rpx, 1rpx) * 64);
  height: calc(var(--jy-rpx, 1rpx) * 64);
  line-height: calc(var(--jy-rpx, 1rpx) * 60);
  border-radius: calc(var(--jy-rpx, 1rpx) * 22);
  background: #eaf0ed;
  color: #426357;
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 40) * var(--font-scale, 1));
}
.body {
  max-height: 52vh;
  margin: calc(var(--jy-rpx, 1rpx) * 20) 0 calc(var(--jy-rpx, 1rpx) * 28);
  color: #40564b;
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 28) * var(--font-scale, 1));
  line-height: 1.7;
}
.copy {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.subtitle {
  font-weight: 600;
  margin-top: calc(var(--jy-rpx, 1rpx) * 24);
}
.muted {
  color: #849087;
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 24) * var(--font-scale, 1));
}
.gap {
  margin-top: calc(var(--jy-rpx, 1rpx) * 12);
}
.confirm {
  margin: 0;
  border-radius: calc(var(--jy-rpx, 1rpx) * 28);
  background: #245b4c;
  color: white;
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 28) * var(--font-scale, 1));
}

.heading > .u-text {
  flex: 1;
  min-width: 0;
  overflow-wrap: anywhere;
}
.close {
  flex: 0 0 calc(var(--jy-rpx, 1rpx) * 64);
  min-width: calc(var(--jy-rpx, 1rpx) * 64);
  max-width: calc(var(--jy-rpx, 1rpx) * 64);
}
.confirm {
  display: block;
  width: 100%;
  max-width: none;
  flex: none;
}

:host {
  color: var(--text, #25374a);
}
.dialog,
.panel,
.card,
.sheet,
.reward-card,
.modal,
.popup {
  background: var(--surface, #fff);
  color: var(--text, #25374a);
  border-color: var(--line, #d8e4ed);
}
.muted,
.privacy,
.subtitle {
  color: var(--muted, #6e808b);
}
.u-button {
  background: var(--raised, #eaf1f6);
  color: var(--accent, #326ba6);
  border-color: var(--line, #d8e4ed);
  box-shadow: none;
}
.placeholder,
.empty {
  background: var(--raised, #eaf1f6);
  color: var(--muted, #6e808b);
}

.body {
  height: 52vh;
  min-height: 0;
  box-sizing: border-box;
  color: var(--text, #25374a);
}
.heading {
  color: var(--text, #25374a);
}
.mask {
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}
.panel {
  max-height: 90vh;
  overflow: hidden;
}
.help {
  background: var(--raised, #eaf1f6);
  color: var(--accent, #326ba6);
}
