<wxs src="/services/i18n.wxs" module="i18n"/>
<view class="u-view frame {{loading?'pending811':''}} {{mode==='aspectFill'?'crop':mode==='aspectFit'?'fit':''}}"><image class="u-image" wx:if="{{src && !failed}}" src="{{src}}" mode="{{mode}}" lazy-load="{{!eager}}" data-serial="{{imageSerial}}" bindload="loaded" binderror="error" />
<view wx:if="{{!src || failed || loading}}" class="u-view placeholder {{loading?'pending-placeholder811':''}}"><text class="u-text">{{i18n.ui(failed ? failureReason : loading ? '照片加载中…' : '校园机位',locale)}}</text><button class="u-button" wx:if="{{failed}}" size="mini" catchtap="retry">{{i18n.ui('重试',locale)}}</button></view></view>
