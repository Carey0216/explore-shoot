<view class="u-view frame {{mode==='aspectFill'?'crop':''}}"><image class="u-image" wx:if="{{src && !failed}}" src="{{src}}" mode="{{mode}}" lazy-load="{{!eager}}" binderror="error" />
<view wx:else class="u-view placeholder"><text class="u-text">{{failed ? '照片暂不可用' : '校园机位'}}</text><button class="u-button" wx:if="{{failed}}" size="mini" catchtap="retry">重试</button></view></view>
