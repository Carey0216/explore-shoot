@import '../base.wxss';
:host {
  display: block;
  width: 100%;
  height: auto;
}
.frame {
  width: 100%;
  height: auto;
}
.u-image {
  width: 100%;
  height: auto;
  display: block;
}
.placeholder {
  height: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #829389;
  background: linear-gradient(135deg, #e4ece5, #f5eddf);
  font-size: calc(24rpx * var(--font-scale, 1));
}

.placeholder {
  min-height: 260rpx;
}

:host,
.frame {
  height: auto;
  overflow: visible;
}
.u-image {
  height: auto;
}

:host {
  height: inherit;
}
.crop,
.crop .u-image {
  height: 100%;
  min-height: 180rpx;
}
.placeholder {
  background: var(--raised, #eaf1f6);
  color: var(--muted, #6e808b);
}
