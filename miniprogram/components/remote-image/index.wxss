@import '../base.wxss';
:host {
  display: block;
  width: 100%;
  height: auto;
}
.frame {
  width: 100%;
  height: auto;
}
.u-image {
  width: 100%;
  height: auto;
  display: block;
}
.placeholder {
  height: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #829389;
  background: linear-gradient(135deg, #e4ece5, #f5eddf);
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 24) * var(--font-scale, 1));
}

.placeholder {
  min-height: calc(var(--jy-rpx, 1rpx) * 260);
}

:host,
.frame {
  height: auto;
  overflow: visible;
}
.u-image {
  height: auto;
}

:host {
  height: inherit;
}
.crop,
.crop .u-image {
  height: 100%;
  min-height: calc(var(--jy-rpx, 1rpx) * 180);
}
.placeholder {
  background: var(--raised, #eaf1f6);
  color: var(--muted, #6e808b);
}

/* aspectFit also needs a real frame before the visibility observer can fetch private photos. */
.fit,
.fit .u-image {
  height: 100%;
  min-height: calc(var(--jy-rpx, 1rpx) * 180);
}

.frame {
  position: relative;
}
.pending811 {
  min-height: calc(var(--jy-rpx, 1rpx) * 180);
}
.pending-placeholder811 {
  position: absolute;
  inset: 0;
  min-height: 0;
  background: var(--raised, #eaf1f6);
}
