<wxs src="/services/i18n.wxs" module="i18n"/>
<template name="field"><view wx:if="{{field.type!=='hidden'}}" class="u-view form-field {{field.type==='bool'?'switch-field':''}}"><text class="u-text field-label">{{i18n.content(field.label,locale,localeTranslations,localeOriginal)}}{{i18n.content(field.required?' *':'',locale,localeTranslations,localeOriginal)}}</text><text wx:if="{{field.hint}}" class="u-text field-hint">{{i18n.content(field.hint,locale,localeTranslations,localeOriginal)}}</text><switch class="u-switch" wx:if="{{field.type==='bool'}}" checked="{{field.value}}" data-path="{{path}}" bindchange="change" disabled="{{busy}}"/><picker wx:elif="{{field.type==='pick'}}" range="{{i18n.options(field.options,locale)}}" range-key="label" value="{{field.selected}}" data-path="{{path}}" bindchange="pick" disabled="{{busy}}"><view class="u-view picker">{{i18n.content(field.options[field.selected].label,locale,localeTranslations,localeOriginal)}} ⌄</view></picker><checkbox-group wx:elif="{{field.type==='multi'}}" data-path="{{path}}" bindchange="multi"><label wx:for="{{field.options}}" wx:key="id" class="u-label check-row"><checkbox class="u-checkbox" value="{{item.id}}" checked="{{item.checked}}" disabled="{{busy}}"/><text class="u-text">{{i18n.content(item.label,locale,localeTranslations,localeOriginal)}}</text></label></checkbox-group><view wx:elif="{{field.type==='rows'}}" class="u-view nested-rows"><view class="u-view nested-row" wx:for="{{field.rows}}" wx:for-item="row" wx:for-index="rowIndex" wx:key="index"><view class="u-view row-head"><text class="u-text">{{i18n.content(rowIndex+1,locale,localeTranslations,localeOriginal)}}</text><button class="u-button" size="mini" data-path="{{path}}" data-index="{{rowIndex}}" data-delta="-1" bindtap="move">{{i18n.ui('上移',locale)}}</button><button class="u-button" size="mini" data-path="{{path}}" data-index="{{rowIndex}}" data-delta="1" bindtap="move">{{i18n.ui('下移',locale)}}</button><button class="u-button" size="mini" data-path="{{path}}" data-index="{{rowIndex}}" bindtap="remove">{{i18n.ui('移除',locale)}}</button></view><template wx:for="{{row.fields}}" wx:for-item="child" wx:for-index="childIndex" wx:key="key" is="field" data="{{field:child,path:path+'.rows['+rowIndex+'].fields['+childIndex+']',busy:busy,locale:locale,localeTranslations:localeTranslations,localeOriginal:localeOriginal}}"/></view><button class="{{busy ? 'u-disabled' : ''}} u-button add-row" data-path="{{path}}" bindtap="add" disabled="{{busy}}">{{i18n.ui('＋ 添加',locale)}}{{i18n.content(field.label,locale,localeTranslations,localeOriginal)}}</button></view><view class="u-view" wx:elif="{{field.type==='image'}}"><image wx:if="{{field.preview}}" class="u-image preview" src="{{field.preview}}" mode="widthFix"/><view wx:if="{{field.value}}" class="u-view field-hint">{{i18n.ui('图片已准备好',locale)}}</view><button class="{{busy ? 'u-disabled' : ''}} u-button" data-path="{{path}}" bindtap="photo" loading="{{uploading}}" disabled="{{busy}}">{{i18n.ui('选择图片',locale)}}</button><button class="{{busy ? 'u-disabled' : ''}} u-button" wx:if="{{field.value}}" data-path="{{path}}" bindtap="clearPhoto" disabled="{{busy}}">{{i18n.ui('移除图片',locale)}}</button></view><textarea class="u-textarea" wx:elif="{{field.type==='multiline'||field.type==='lines'||field.type==='tags'}}" value="{{field.value}}" data-path="{{path}}" bindinput="change" maxlength="{{field.maxlength||6000}}" placeholder-class="field-placeholder" placeholder="{{i18n.content(field.placeholder||field.label,locale,localeTranslations,localeOriginal)}}" disabled="{{busy}}"/><text wx:elif="{{field.type==='readonly'}}" selectable class="u-text readonly">{{i18n.content(field.value,locale,localeTranslations,localeOriginal)}}</text><input class="u-input" wx:else value="{{field.value}}" password="{{field.type==='password'}}" type="{{field.type==='number'&&(field.min===undefined||field.min>=0)?'digit':'text'}}" data-path="{{path}}" bindinput="change" maxlength="{{field.maxlength||1000}}" placeholder-class="field-placeholder" placeholder="{{i18n.content(field.placeholder||field.label,locale,localeTranslations,localeOriginal)}}" disabled="{{busy}}"/><button class="u-button" wx:if="{{field.key==='lng'}}" size="mini" data-path="{{path}}" bindtap="location">{{i18n.ui('地图选点并转换为项目坐标',locale)}}</button></view></template>
<map wx:if="{{mapCoordinate}}" style="width:100%;height:300rpx;border-radius:24rpx;margin-bottom:24rpx" longitude="{{mapCoordinate.longitude}}" latitude="{{mapCoordinate.latitude}}" markers="{{markers}}" scale="18"/><template wx:for="{{fields}}" wx:key="key" is="field" data="{{field:item,path:'fields['+index+']',busy:busy,locale:locale,localeTranslations:localeTranslations,localeOriginal:localeOriginal}}"/><view wx:if="{{error}}" class="u-view form-error">{{i18n.content(error,locale,localeTranslations,localeOriginal)}}</view><canvas id="form-photo" type="2d" class="compression-canvas"/>
