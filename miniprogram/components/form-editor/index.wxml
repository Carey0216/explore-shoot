<template name="field"><view wx:if="{{field.type!=='hidden'}}" class="u-view form-field {{field.type==='bool'?'switch-field':''}}"><text class="u-text field-label">{{field.label}}{{field.required?' *':''}}</text><text wx:if="{{field.hint}}" class="u-text field-hint">{{field.hint}}</text><switch class="u-switch" wx:if="{{field.type==='bool'}}" checked="{{field.value}}" data-path="{{path}}" bindchange="change" disabled="{{busy}}"/><picker wx:elif="{{field.type==='pick'}}" range="{{field.options}}" range-key="label" value="{{field.selected}}" data-path="{{path}}" bindchange="pick" disabled="{{busy}}"><view class="u-view picker">{{field.options[field.selected].label}} ⌄</view></picker><checkbox-group wx:elif="{{field.type==='multi'}}" data-path="{{path}}" bindchange="multi"><label wx:for="{{field.options}}" wx:key="id" class="u-label check-row"><checkbox class="u-checkbox" value="{{item.id}}" checked="{{item.checked}}" disabled="{{busy}}"/><text class="u-text">{{item.label}}</text></label></checkbox-group><view wx:elif="{{field.type==='rows'}}" class="u-view nested-rows"><view class="u-view nested-row" wx:for="{{field.rows}}" wx:for-item="row" wx:for-index="rowIndex" wx:key="index"><view class="u-view row-head"><text class="u-text">{{rowIndex+1}}</text><button class="u-button" size="mini" data-path="{{path}}" data-index="{{rowIndex}}" data-delta="-1" bindtap="move">上移</button><button class="u-button" size="mini" data-path="{{path}}" data-index="{{rowIndex}}" data-delta="1" bindtap="move">下移</button><button class="u-button" size="mini" data-path="{{path}}" data-index="{{rowIndex}}" bindtap="remove">移除</button></view><template wx:for="{{row.fields}}" wx:for-item="child" wx:for-index="childIndex" wx:key="key" is="field" data="{{field:child,path:path+'.rows['+rowIndex+'].fields['+childIndex+']',busy:busy}}"/></view><button class="{{busy ? 'u-disabled' : ''}} u-button add-row" data-path="{{path}}" bindtap="add" disabled="{{busy}}">＋ 添加{{field.label}}</button></view><view class="u-view" wx:elif="{{field.type==='image'}}"><image wx:if="{{field.preview}}" class="u-image preview" src="{{field.preview}}" mode="widthFix"/><view wx:if="{{field.value}}" class="u-view field-hint">图片已准备好</view><button class="{{busy ? 'u-disabled' : ''}} u-button" data-path="{{path}}" bindtap="photo" loading="{{uploading}}" disabled="{{busy}}">选择图片</button><button class="{{busy ? 'u-disabled' : ''}} u-button" wx:if="{{field.value}}" data-path="{{path}}" bindtap="clearPhoto" disabled="{{busy}}">移除图片</button></view><textarea class="u-textarea" wx:elif="{{field.type==='multiline'||field.type==='lines'||field.type==='tags'}}" value="{{field.value}}" data-path="{{path}}" bindinput="change" maxlength="{{field.maxlength||6000}}" placeholder-class="field-placeholder" placeholder="{{field.placeholder||field.label}}" disabled="{{busy}}"/><text wx:elif="{{field.type==='readonly'}}" selectable class="u-text readonly">{{field.value}}</text><input class="u-input" wx:else value="{{field.value}}" password="{{field.type==='password'}}" type="{{field.type==='number'&&(field.min===undefined||field.min>=0)?'digit':'text'}}" data-path="{{path}}" bindinput="change" maxlength="{{field.maxlength||1000}}" placeholder-class="field-placeholder" placeholder="{{field.placeholder||field.label}}" disabled="{{busy}}"/><button class="u-button" wx:if="{{field.key==='lng'}}" size="mini" data-path="{{path}}" bindtap="location">地图选点并转换为项目坐标</button></view></template>
<map wx:if="{{mapCoordinate}}" style="width:100%;height:300rpx;border-radius:24rpx;margin-bottom:24rpx" longitude="{{mapCoordinate.longitude}}" latitude="{{mapCoordinate.latitude}}" markers="{{markers}}" scale="18"/><template wx:for="{{fields}}" wx:key="key" is="field" data="{{field:item,path:'fields['+index+']',busy:busy}}"/><view wx:if="{{error}}" class="u-view form-error">{{error}}</view><canvas id="form-photo" type="2d" class="compression-canvas"/>
