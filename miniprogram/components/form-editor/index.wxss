@import '../base.wxss';
@import '../../styles/admin-controls.wxss';
.form-field {
  display: block;
  margin-bottom: calc(var(--jy-rpx, 1rpx) * 28);
  min-width: 0;
}
.field-label {
  display: block;
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 27) * var(--font-scale, 1));
  font-weight: 600;
  color: var(--text, #25374a);
  margin-bottom: calc(var(--jy-rpx, 1rpx) * 14);
  line-height: 1.6;
}
.field-hint {
  display: block;
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 23) * var(--font-scale, 1));
  line-height: 1.7;
  color: var(--muted, #6e808b);
  margin: calc(var(--jy-rpx, 1rpx) * 10) 0;
}
.u-input,
.u-textarea,
.picker {
  display: block;
  width: 100%;
  box-sizing: border-box;
  min-height: calc(var(--jy-rpx, 1rpx) * 86);
  border: calc(var(--jy-rpx, 1rpx) * 1) solid var(--line, #d8e4ed);
  border-radius: calc(var(--jy-rpx, 1rpx) * 22);
  background: var(--raised, #eaf1f6);
  padding: calc(var(--jy-rpx, 1rpx) * 22);
  color: var(--text, #25374a);
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 27) * var(--font-scale, 1));
}
.u-textarea {
  height: calc(var(--jy-rpx, 1rpx) * 200);
  line-height: 1.8;
}
.picker.admin-control-row {
  display: flex;
}
.check-row {
  display: flex;
  align-items: center;
  gap: calc(var(--jy-rpx, 1rpx) * 18);
  min-height: calc(var(--jy-rpx, 1rpx) * 86);
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 25) * var(--font-scale, 1));
  line-height: 1.6;
  color: var(--text, #25374a);
}
.u-checkbox {
  flex-shrink: 0;
  align-self: center;
}
.nested-rows {
  padding: calc(var(--jy-rpx, 1rpx) * 16);
  border-radius: calc(var(--jy-rpx, 1rpx) * 24);
  background: var(--raised, #eaf1f6);
}
.nested-row {
  border: calc(var(--jy-rpx, 1rpx) * 1) solid var(--line, #d8e4ed);
  background: var(--surface, #fff);
  padding: calc(var(--jy-rpx, 1rpx) * 20);
  border-radius: calc(var(--jy-rpx, 1rpx) * 22);
  margin-bottom: calc(var(--jy-rpx, 1rpx) * 20);
}
.row-head {
  display: flex;
  gap: calc(var(--jy-rpx, 1rpx) * 12);
  align-items: center;
  margin-bottom: calc(var(--jy-rpx, 1rpx) * 24);
}
.row-head .u-text {
  flex: 1;
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 24) * var(--font-scale, 1));
  color: var(--muted, #6e808b);
}
.u-button {
  color: var(--accent, #326ba6);
  background: var(--selected, #dcecff);
  border: 0;
  border-radius: calc(var(--jy-rpx, 1rpx) * 22);
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 24) * var(--font-scale, 1));
  min-height: calc(var(--jy-rpx, 1rpx) * 76);
  line-height: 1.5;
  padding: calc(var(--jy-rpx, 1rpx) * 18);
  box-shadow: none;
}
.u-button:after {
  border: 0;
}
.row-head .u-button {
  padding: calc(var(--jy-rpx, 1rpx) * 12);
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 22) * var(--font-scale, 1));
  min-height: calc(var(--jy-rpx, 1rpx) * 64);
}
.preview {
  width: 100%;
  border-radius: calc(var(--jy-rpx, 1rpx) * 24);
}
.readonly {
  display: block;
  white-space: pre-wrap;
  line-height: 1.8;
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 26) * var(--font-scale, 1));
}
.form-error {
  color: var(--danger, #b33f57);
  padding: calc(var(--jy-rpx, 1rpx) * 20);
}
.compression-canvas {
  position: absolute;
  left: -2000px;
  top: -2000px;
  width: 1000px;
  height: 1000px;
}

.switch-field {
  display: flex;
  align-items: center;
  gap: calc(var(--jy-rpx, 1rpx) * 24);
  min-height: calc(var(--jy-rpx, 1rpx) * 90);
  margin-bottom: calc(var(--jy-rpx, 1rpx) * 12);
  border-bottom: calc(var(--jy-rpx, 1rpx) * 1) solid var(--line, #d8e4ed);
  padding: calc(var(--jy-rpx, 1rpx) * 12) 0;
}
.switch-field .field-label {
  flex: 1;
  min-width: 0;
  margin: 0;
  font-weight: 500;
}
.switch-field .u-switch {
  flex-shrink: 0;
}
.switch-field .field-hint {
  display: none;
}
