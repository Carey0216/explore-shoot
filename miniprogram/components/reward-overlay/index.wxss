@import '../base.wxss';
.reward-backdrop {
  position: fixed;
  z-index: 9999;
  inset: 0;
  background: #17392f38;
  backdrop-filter: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx;
}
.reward {
  width: 100%;
  padding: 36rpx 28rpx;
  border: 2rpx solid #fff;
  border-radius: 48rpx;
  text-align: center;
  background: radial-gradient(ellipse at 50% 25%, #fff3c9, #f4f7ee 65%);
  box-shadow: 0 25rpx 80rpx #183c3d44;
}
.label {
  font-size: calc(24rpx * var(--font-scale, 1));
  color: #997b3d;
  letter-spacing: 4rpx;
}
.medal {
  width: 360rpx;
  height: 360rpx;
  filter: drop-shadow(0 20rpx 20rpx #97722f40);
}
.title {
  font-size: calc(42rpx * var(--font-scale, 1));
  font-weight: 600;
  color: #455735;
}
.description {
  font-size: calc(25rpx * var(--font-scale, 1));
  color: #728074;
  margin-top: 20rpx;
}
.reward .u-button {
  margin-top: 36rpx;
  border-radius: 27rpx;
  background: #2d6352;
  color: white;
  font-size: calc(29rpx * var(--font-scale, 1));
}
.close {
  color: #7a847a;
  font-size: calc(24rpx * var(--font-scale, 1));
  margin-top: 28rpx;
}

:host {
  color: var(--text, #25374a);
}
.dialog,
.panel,
.card,
.sheet,
.reward-card,
.modal,
.popup {
  background: var(--surface, #fff);
  color: var(--text, #25374a);
  border-color: var(--line, #d8e4ed);
}
.muted,
.privacy,
.subtitle {
  color: var(--muted, #6e808b);
}
.u-button {
  background: var(--raised, #eaf1f6);
  color: var(--accent, #326ba6);
  border-color: var(--line, #d8e4ed);
  box-shadow: none;
}
.placeholder,
.empty {
  background: var(--raised, #eaf1f6);
  color: var(--muted, #6e808b);
}

.reward {
  height: auto;
  max-height: 68vh;
  background: var(--surface, #fff);
  color: var(--text, #25374a);
  box-sizing: border-box;
}
.description {
  color: var(--muted, #6e808b);
}

.impact812 .reward {
  animation: reward-impact812 500ms ease-out both;
}
.impact812 .reward .u-button {
  animation: reward-control812 500ms ease-out 30ms both;
}
@keyframes reward-impact812 {
  0%,
  100% {
    transform: none;
  }
  18% {
    transform: translate(6rpx, 8rpx) rotate(0.4deg);
  }
  38% {
    transform: translate(-8rpx, -4rpx) rotate(-0.4deg);
  }
  62% {
    transform: translate(4rpx, 2rpx);
  }
  82% {
    transform: translate(-2rpx, 0);
  }
}
@keyframes reward-control812 {
  0%,
  100% {
    transform: none;
  }
  30% {
    transform: translateY(-5rpx) rotate(-1.3deg);
  }
  60% {
    transform: translateY(2rpx) rotate(0.6deg);
  }
}

.reward .replay813 {
  display: inline-flex;
  width: auto;
  min-height: 56rpx;
  padding: 10rpx 24rpx;
  margin-top: 12rpx;
  background: transparent;
  color: var(--muted, #56706a);
  font-size: 24rpx;
  border: 1px solid var(--line, #d8e4df);
}

.reward .title {
  color: var(--text, #273d50);
  font-size: 36rpx;
}
.reward .label {
  color: var(--muted, #637887);
  font-size: 23rpx;
}
.reward .u-button:not(.replay813) {
  background: var(--accent, #346b9c);
  color: var(--on-accent, #fff);
}
.cinematic814 {
  padding: 0;
  background: #0d1f2a70;
  display: block;
  overflow: hidden;
}
.cinema-heading814 {
  position: absolute;
  left: 36rpx;
  right: 36rpx;
  top: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--text);
  font-size: 26rpx;
  z-index: 2;
}
.cinema-heading814 .cinema-close814 {
  width: 72rpx;
  height: 72rpx;
  min-width: 72rpx;
  padding: 0;
  border-radius: 50%;
  font-size: 38rpx;
  line-height: 72rpx;
  background: var(--surface);
  color: var(--text);
  margin: 0;
}
.cinema-result814 {
  position: absolute;
  left: 40rpx;
  right: 40rpx;
  padding: 22rpx 24rpx;
  border-radius: 32rpx;
  background: var(--surface);
  box-sizing: border-box;
  text-align: center;
  opacity: 0;
  transform: translateY(32rpx);
  pointer-events: none;
  transition:
    opacity 240ms ease-out,
    transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
}
.cinema-result814.landed {
  opacity: 1;
  transform: none;
  pointer-events: auto;
}
.cinema-result814 .title {
  font-size: 40rpx;
  color: var(--text);
}
.cinema-result814 .description {
  font-size: 24rpx;
  line-height: 1.65;
  margin-top: 16rpx;
}
.cinema-result814 .replay813,
.cinema-loading814 .replay813 {
  display: inline-flex;
  width: auto;
  font-size: 24rpx;
  padding: 10rpx 22rpx;
  min-height: 56rpx;
  border: 1rpx solid var(--line);
  border-radius: 26rpx;
  color: var(--text);
  background: var(--surface);
  margin-top: 22rpx;
}
.cinema-next814 {
  position: absolute;
  bottom: calc(156rpx + env(safe-area-inset-bottom));
  left: 40rpx;
  right: 40rpx;
  width: auto;
  min-height: 84rpx;
  border-radius: 40rpx;
  background: var(--accent);
  color: var(--on-accent, #fff);
  font-size: 28rpx;
}
.cinema-loading814 {
  position: absolute;
  left: 40rpx;
  right: 40rpx;
  top: 40%;
  text-align: center;
  color: var(--text);
  font-size: 28rpx;
}
.cinematic814.impact812 .cinema-heading814 {
  animation: cinema-world814 1000ms both;
}
.cinematic814.impact812 .cinema-heading814 .cinema-close814 {
  animation: cinema-button814 1100ms both;
}
@keyframes cinema-world814 {
  0%,
  100% {
    transform: none;
  }
  14% {
    transform: translate(40rpx, 64rpx) rotate(0.8deg);
  }
  32% {
    transform: translate(-48rpx, -32rpx) rotate(-0.8deg);
  }
  48% {
    transform: translate(36rpx, 28rpx) rotate(0.5deg);
  }
  64% {
    transform: translate(-28rpx, -20rpx) rotate(-0.3deg);
  }
  78% {
    transform: translate(16rpx, 12rpx);
  }
  90% {
    transform: translate(-8rpx, -4rpx);
  }
}
@keyframes cinema-button814 {
  0%,
  100% {
    transform: none;
  }
  12% {
    transform: translateY(-36rpx) rotate(6deg);
  }
  29% {
    transform: translateY(18rpx) rotate(-4deg);
  }
  46% {
    transform: translateY(-12rpx) rotate(2.5deg);
  }
  67% {
    transform: translateY(6rpx) rotate(-1deg);
  }
  85% {
    transform: translateY(-2rpx);
  }
}

/* Keep the native canvas above the backdrop, and the title/actions above the canvas. */
.cinema-heading814 {
  box-sizing: border-box;
  min-height: 112rpx;
  padding: 18rpx 28rpx;
  border-radius: 38rpx;
  background: var(--surface);
}
.cinema-result814,
.cinema-loading814,
.cinema-next814 {
  z-index: 2;
}

.milestone820 {
  background: var(--jy-color-surface);
  color: var(--jy-color-ink);
}
.milestone820 .title {
  color: var(--jy-color-ink);
}
.milestone820 .description {
  color: var(--jy-color-muted);
}
.milestone820 .medal {
  animation: milestone820-arrive 600ms cubic-bezier(0.22, 1, 0.36, 1);
}
.milestone820.area .medal {
  animation: milestone820-area 700ms cubic-bezier(0.22, 1, 0.36, 1);
}
.milestone820.season .medal {
  animation: milestone820-season 800ms cubic-bezier(0.22, 1, 0.36, 1);
}
@keyframes milestone820-arrive {
  from {
    transform: scale(0.75);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}
@keyframes milestone820-area {
  from {
    transform: translateY(28px) rotate(-12deg);
    opacity: 0;
  }
  to {
    transform: none;
    opacity: 1;
  }
}
@keyframes milestone820-season {
  from {
    transform: scale(1.15) rotate(14deg);
    opacity: 0;
  }
  to {
    transform: none;
    opacity: 1;
  }
}
