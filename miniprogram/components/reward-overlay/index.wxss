@import '../base.wxss';
.reward-backdrop {
  position: fixed;
  z-index: 9999;
  inset: 0;
  background: #17392f78;
  backdrop-filter: blur(16rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx;
}
.reward {
  width: 100%;
  padding: 36rpx 28rpx;
  border: 2rpx solid #fff;
  border-radius: 48rpx;
  text-align: center;
  background: radial-gradient(ellipse at 50% 25%, #fff3c9, #f4f7ee 65%);
  box-shadow: 0 25rpx 80rpx #183c3d44;
}
.label {
  font-size: calc(24rpx * var(--font-scale, 1));
  color: #997b3d;
  letter-spacing: 4rpx;
}
.medal {
  width: 360rpx;
  height: 360rpx;
  filter: drop-shadow(0 20rpx 20rpx #97722f40);
}
.title {
  font-size: calc(42rpx * var(--font-scale, 1));
  font-weight: 600;
  color: #455735;
}
.description {
  font-size: calc(25rpx * var(--font-scale, 1));
  color: #728074;
  margin-top: 20rpx;
}
.reward .u-button {
  margin-top: 36rpx;
  border-radius: 27rpx;
  background: #2d6352;
  color: white;
  font-size: calc(29rpx * var(--font-scale, 1));
}
.close {
  color: #7a847a;
  font-size: calc(24rpx * var(--font-scale, 1));
  margin-top: 28rpx;
}

:host {
  color: var(--text, #25374a);
}
.dialog,
.panel,
.card,
.sheet,
.reward-card,
.modal,
.popup {
  background: var(--surface, #fff);
  color: var(--text, #25374a);
  border-color: var(--line, #d8e4ed);
}
.muted,
.privacy,
.subtitle {
  color: var(--muted, #6e808b);
}
.u-button {
  background: var(--raised, #eaf1f6);
  color: var(--accent, #326ba6);
  border-color: var(--line, #d8e4ed);
  box-shadow: none;
}
.placeholder,
.empty {
  background: var(--raised, #eaf1f6);
  color: var(--muted, #6e808b);
}

.reward {
  height: 78vh;
  max-height: 78vh;
  background: var(--surface, #fff);
  color: var(--text, #25374a);
  box-sizing: border-box;
}
.description {
  color: var(--muted, #6e808b);
}
