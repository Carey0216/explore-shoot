@import '../base.wxss';
.reward-backdrop {
  position: fixed;
  z-index: 9999;
  inset: 0;
  background: #17392f38;
  backdrop-filter: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx;
}
.reward {
  width: 100%;
  padding: 36rpx 28rpx;
  border: 2rpx solid #fff;
  border-radius: 48rpx;
  text-align: center;
  background: radial-gradient(ellipse at 50% 25%, #fff3c9, #f4f7ee 65%);
  box-shadow: 0 25rpx 80rpx #183c3d44;
}
.label {
  font-size: calc(24rpx * var(--font-scale, 1));
  color: #997b3d;
  letter-spacing: 4rpx;
}
.medal {
  width: 360rpx;
  height: 360rpx;
  filter: drop-shadow(0 20rpx 20rpx #97722f40);
}
.title {
  font-size: calc(42rpx * var(--font-scale, 1));
  font-weight: 600;
  color: #455735;
}
.description {
  font-size: calc(25rpx * var(--font-scale, 1));
  color: #728074;
  margin-top: 20rpx;
}
.reward .u-button {
  margin-top: 36rpx;
  border-radius: 27rpx;
  background: #2d6352;
  color: white;
  font-size: calc(29rpx * var(--font-scale, 1));
}
.close {
  color: #7a847a;
  font-size: calc(24rpx * var(--font-scale, 1));
  margin-top: 28rpx;
}

:host {
  color: var(--text, #25374a);
}
.dialog,
.panel,
.card,
.sheet,
.reward-card,
.modal,
.popup {
  background: var(--surface, #fff);
  color: var(--text, #25374a);
  border-color: var(--line, #d8e4ed);
}
.muted,
.privacy,
.subtitle {
  color: var(--muted, #6e808b);
}
.u-button {
  background: var(--raised, #eaf1f6);
  color: var(--accent, #326ba6);
  border-color: var(--line, #d8e4ed);
  box-shadow: none;
}
.placeholder,
.empty {
  background: var(--raised, #eaf1f6);
  color: var(--muted, #6e808b);
}

.reward {
  height: auto;
  max-height: 68vh;
  background: var(--surface, #fff);
  color: var(--text, #25374a);
  box-sizing: border-box;
}
.description {
  color: var(--muted, #6e808b);
}

.impact812 .reward { animation:reward-impact812 500ms ease-out both; }
.impact812 .reward .u-button { animation:reward-control812 500ms ease-out 30ms both; }
@keyframes reward-impact812 { 0%,100% { transform:none; } 18% { transform:translate(6rpx,8rpx) rotate(.4deg); } 38% { transform:translate(-8rpx,-4rpx) rotate(-.4deg); } 62% {transform:translate(4rpx,2rpx)} 82% {transform:translate(-2rpx,0)} }
@keyframes reward-control812 { 0%,100% { transform:none; } 30% { transform:translateY(-5rpx) rotate(-1.3deg); } 60% { transform:translateY(2rpx) rotate(.6deg); } }

.reward .replay813{display:inline-flex;width:auto;min-height:56rpx;padding:10rpx 24rpx;margin-top:12rpx;background:transparent;color:var(--muted,#56706a);font-size:24rpx;border:1px solid var(--line,#d8e4df)}

.reward .title{color:var(--text,#273d50);font-size:36rpx}.reward .label{color:var(--muted,#637887);font-size:23rpx}.reward .u-button:not(.replay813){background:var(--accent,#346b9c);color:var(--on-accent,#fff)}
