@import '../base.wxss';
.reward-backdrop {
  position: fixed;
  z-index: 9999;
  inset: 0;
  background: #17392f38;
  backdrop-filter: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: calc(var(--jy-rpx, 1rpx) * 36);
}
.reward {
  width: 100%;
  max-width: var(--jy-dialog-max, 560px);
  padding: calc(var(--jy-rpx, 1rpx) * 36) calc(var(--jy-rpx, 1rpx) * 28);
  border: calc(var(--jy-rpx, 1rpx) * 2) solid #fff;
  border-radius: calc(var(--jy-rpx, 1rpx) * 48);
  text-align: center;
  background: radial-gradient(ellipse at 50% 25%, #fff3c9, #f4f7ee 65%);
  box-shadow: 0 calc(var(--jy-rpx, 1rpx) * 25) calc(var(--jy-rpx, 1rpx) * 80) #183c3d44;
}
.label {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 24) * var(--font-scale, 1));
  color: #997b3d;
  letter-spacing: calc(var(--jy-rpx, 1rpx) * 4);
}
.medal {
  display: block;
  margin: calc(var(--jy-rpx, 1rpx) * 20) auto;
  width: calc(var(--jy-rpx, 1rpx) * 360);
  height: calc(var(--jy-rpx, 1rpx) * 360);
  filter: drop-shadow(0 calc(var(--jy-rpx, 1rpx) * 20) calc(var(--jy-rpx, 1rpx) * 20) #97722f40);
}
.title {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 42) * var(--font-scale, 1));
  font-weight: 600;
  color: #455735;
}
.description {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 25) * var(--font-scale, 1));
  color: #728074;
  margin-top: calc(var(--jy-rpx, 1rpx) * 20);
}
.reward .u-button {
  margin-top: calc(var(--jy-rpx, 1rpx) * 36);
  border-radius: calc(var(--jy-rpx, 1rpx) * 27);
  background: #2d6352;
  color: white;
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 29) * var(--font-scale, 1));
}
.close {
  color: #7a847a;
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 24) * var(--font-scale, 1));
  margin-top: calc(var(--jy-rpx, 1rpx) * 28);
}

:host {
  color: var(--text, #25374a);
}
.dialog,
.panel,
.card,
.sheet,
.reward-card,
.modal,
.popup {
  background: var(--surface, #fff);
  color: var(--text, #25374a);
  border-color: var(--line, #d8e4ed);
}
.muted,
.privacy,
.subtitle {
  color: var(--muted, #6e808b);
}
.u-button {
  background: var(--raised, #eaf1f6);
  color: var(--accent, #326ba6);
  border-color: var(--line, #d8e4ed);
  box-shadow: none;
}
.placeholder,
.empty {
  background: var(--raised, #eaf1f6);
  color: var(--muted, #6e808b);
}

.reward {
  height: auto;
  max-height: 76vh;
  background: var(--surface, #fff);
  color: var(--text, #25374a);
  box-sizing: border-box;
}
.reward .u-button {
  width: 100%;
}
.reward-backdrop {
  box-sizing: border-box;
}
.reward {
  max-width: calc(var(--jy-rpx, 1rpx) * 680);
}
.cinematic814.impact812 .cinema-result814.landed {
  animation: cinema-world814 1000ms both;
}
.cinematic814.impact812 .cinema-next814 {
  animation: cinema-button814 1100ms both;
}
.description {
  color: var(--muted, #6e808b);
}

.impact812 .reward {
  animation: reward-impact812 500ms ease-out both;
}
.impact812 .reward .u-button {
  animation: reward-control812 500ms ease-out 30ms both;
}
@keyframes reward-impact812 {
  0%,
  100% {
    transform: none;
  }
  18% {
    transform: translate(calc(var(--jy-rpx, 1rpx) * 6), calc(var(--jy-rpx, 1rpx) * 8))
      rotate(0.4deg);
  }
  38% {
    transform: translate(calc(var(--jy-rpx, 1rpx) * -8), calc(var(--jy-rpx, 1rpx) * -4))
      rotate(-0.4deg);
  }
  62% {
    transform: translate(calc(var(--jy-rpx, 1rpx) * 4), calc(var(--jy-rpx, 1rpx) * 2));
  }
  82% {
    transform: translate(calc(var(--jy-rpx, 1rpx) * -2), 0);
  }
}
@keyframes reward-control812 {
  0%,
  100% {
    transform: none;
  }
  30% {
    transform: translateY(calc(var(--jy-rpx, 1rpx) * -5)) rotate(-1.3deg);
  }
  60% {
    transform: translateY(calc(var(--jy-rpx, 1rpx) * 2)) rotate(0.6deg);
  }
}

.reward .replay813 {
  display: inline-flex;
  width: auto;
  min-height: calc(var(--jy-rpx, 1rpx) * 56);
  padding: calc(var(--jy-rpx, 1rpx) * 10) calc(var(--jy-rpx, 1rpx) * 24);
  margin-top: calc(var(--jy-rpx, 1rpx) * 12);
  background: transparent;
  color: var(--muted, #56706a);
  font-size: calc(var(--jy-rpx, 1rpx) * 24);
  border: 1px solid var(--line, #d8e4df);
}

.reward .title {
  color: var(--text, #273d50);
  font-size: calc(var(--jy-rpx, 1rpx) * 36);
}
.reward .label {
  color: var(--muted, #637887);
  font-size: calc(var(--jy-rpx, 1rpx) * 23);
}
.reward .u-button:not(.replay813) {
  background: var(--accent, #346b9c);
  color: var(--on-accent, #fff);
}
.cinematic814 {
  padding: 0;
  background: #0d1f2a70;
  display: block;
  overflow: hidden;
}
.cinema-heading814 {
  position: absolute;
  left: calc(var(--jy-rpx, 1rpx) * 36);
  right: calc(var(--jy-rpx, 1rpx) * 36);
  top: calc(var(--jy-rpx, 1rpx) * 32);
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--text);
  font-size: calc(var(--jy-rpx, 1rpx) * 26);
  z-index: 2;
}
.cinema-heading814 .cinema-close814 {
  width: calc(var(--jy-rpx, 1rpx) * 72);
  height: calc(var(--jy-rpx, 1rpx) * 72);
  min-width: calc(var(--jy-rpx, 1rpx) * 72);
  padding: 0;
  border-radius: 50%;
  font-size: calc(var(--jy-rpx, 1rpx) * 38);
  line-height: calc(var(--jy-rpx, 1rpx) * 72);
  background: var(--surface);
  color: var(--text);
  margin: 0;
}
.cinema-result814 {
  position: absolute;
  left: calc(var(--jy-rpx, 1rpx) * 40);
  right: calc(var(--jy-rpx, 1rpx) * 40);
  padding: calc(var(--jy-rpx, 1rpx) * 22) calc(var(--jy-rpx, 1rpx) * 24);
  border-radius: calc(var(--jy-rpx, 1rpx) * 32);
  background: var(--surface);
  box-sizing: border-box;
  text-align: center;
  opacity: 0;
  transform: translateY(calc(var(--jy-rpx, 1rpx) * 32));
  pointer-events: none;
  transition:
    opacity 240ms ease-out,
    transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
}
.cinema-result814.landed {
  opacity: 1;
  transform: none;
  pointer-events: auto;
}
.cinema-result814 .title {
  font-size: calc(var(--jy-rpx, 1rpx) * 40);
  color: var(--text);
}
.cinema-result814 .description {
  font-size: calc(var(--jy-rpx, 1rpx) * 24);
  line-height: 1.65;
  margin-top: calc(var(--jy-rpx, 1rpx) * 16);
}
.cinema-result814 .replay813,
.cinema-loading814 .replay813 {
  display: inline-flex;
  width: auto;
  font-size: calc(var(--jy-rpx, 1rpx) * 24);
  padding: calc(var(--jy-rpx, 1rpx) * 10) calc(var(--jy-rpx, 1rpx) * 22);
  min-height: calc(var(--jy-rpx, 1rpx) * 56);
  border: calc(var(--jy-rpx, 1rpx) * 1) solid var(--line);
  border-radius: calc(var(--jy-rpx, 1rpx) * 26);
  color: var(--text);
  background: var(--surface);
  margin-top: calc(var(--jy-rpx, 1rpx) * 22);
}
.cinema-next814 {
  position: absolute;
  bottom: calc(calc(var(--jy-rpx, 1rpx) * 156) + env(safe-area-inset-bottom));
  left: calc(var(--jy-rpx, 1rpx) * 40);
  right: calc(var(--jy-rpx, 1rpx) * 40);
  width: auto;
  min-height: calc(var(--jy-rpx, 1rpx) * 84);
  border-radius: calc(var(--jy-rpx, 1rpx) * 40);
  background: var(--accent);
  color: var(--on-accent, #fff);
  font-size: calc(var(--jy-rpx, 1rpx) * 28);
}
.cinema-loading814 {
  position: absolute;
  left: calc(var(--jy-rpx, 1rpx) * 40);
  right: calc(var(--jy-rpx, 1rpx) * 40);
  top: 40%;
  text-align: center;
  color: var(--text);
  font-size: calc(var(--jy-rpx, 1rpx) * 28);
}
.cinematic814.impact812 .cinema-heading814 {
  animation: cinema-world814 1000ms both;
}
.cinematic814.impact812 .cinema-heading814 .cinema-close814 {
  animation: cinema-button814 1100ms both;
}
@keyframes cinema-world814 {
  0%,
  100% {
    transform: none;
  }
  14% {
    transform: translate(calc(var(--jy-rpx, 1rpx) * 40), calc(var(--jy-rpx, 1rpx) * 64))
      rotate(0.8deg);
  }
  32% {
    transform: translate(calc(var(--jy-rpx, 1rpx) * -48), calc(var(--jy-rpx, 1rpx) * -32))
      rotate(-0.8deg);
  }
  48% {
    transform: translate(calc(var(--jy-rpx, 1rpx) * 36), calc(var(--jy-rpx, 1rpx) * 28))
      rotate(0.5deg);
  }
  64% {
    transform: translate(calc(var(--jy-rpx, 1rpx) * -28), calc(var(--jy-rpx, 1rpx) * -20))
      rotate(-0.3deg);
  }
  78% {
    transform: translate(calc(var(--jy-rpx, 1rpx) * 16), calc(var(--jy-rpx, 1rpx) * 12));
  }
  90% {
    transform: translate(calc(var(--jy-rpx, 1rpx) * -8), calc(var(--jy-rpx, 1rpx) * -4));
  }
}
@keyframes cinema-button814 {
  0%,
  100% {
    transform: none;
  }
  12% {
    transform: translateY(calc(var(--jy-rpx, 1rpx) * -36)) rotate(6deg);
  }
  29% {
    transform: translateY(calc(var(--jy-rpx, 1rpx) * 18)) rotate(-4deg);
  }
  46% {
    transform: translateY(calc(var(--jy-rpx, 1rpx) * -12)) rotate(2.5deg);
  }
  67% {
    transform: translateY(calc(var(--jy-rpx, 1rpx) * 6)) rotate(-1deg);
  }
  85% {
    transform: translateY(calc(var(--jy-rpx, 1rpx) * -2));
  }
}

/* Keep the native canvas above the backdrop, and the title/actions above the canvas. */
.cinema-heading814 {
  box-sizing: border-box;
  min-height: calc(var(--jy-rpx, 1rpx) * 112);
  padding: calc(var(--jy-rpx, 1rpx) * 18) calc(var(--jy-rpx, 1rpx) * 28);
  border-radius: calc(var(--jy-rpx, 1rpx) * 38);
  background: var(--surface);
}
.cinema-result814,
.cinema-loading814,
.cinema-next814 {
  z-index: 2;
}

.milestone820 {
  background: var(--jy-color-surface);
  color: var(--jy-color-ink);
}
.milestone820 .title {
  color: var(--jy-color-ink);
}
.milestone820 .description {
  color: var(--jy-color-muted);
}
.reward .medal {
  opacity: 0;
}
.reward .medal-arrives {
  opacity: 1;
  animation: medal-arrive 500ms cubic-bezier(0.22, 1, 0.36, 1) both;
}
.reward.area {
  --medal-rise: 8px;
  --medal-turn: -5deg;
}
.reward.season {
  --medal-rise: 4px;
  --medal-turn: 5deg;
}
@keyframes medal-arrive {
  from {
    transform: translateY(var(--medal-rise, 4px)) rotate(var(--medal-turn, 0deg)) scale(0.76);
    opacity: 0;
  }
  72% {
    transform: scale(1.035);
    opacity: 1;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}
