<view wx:if="{{items.length}}" class="u-view reward-backdrop"><scroll-view scroll-y class="u-scroll-view reward" catchtap="noop"><view class="u-view label">校园护照 · 新的收获</view><image class="u-image medal" src="{{items[index].badge}}" mode="aspectFit"/><view class="u-view title">{{items[index].title}}</view><view class="u-view description">{{items[index].description || '每一步，都值得被记住。'}}</view><view class="u-view description">{{index+1}} / {{items.length}}</view><button class="u-button" bindtap="next">{{index+1<items.length?'收下，看看下一个':'收进校园护照'}}</button><view class="u-view close" bindtap="close">稍后查看</view></scroll-view></view>
