<wxs src="/services/i18n.wxs" module="i18n"/>
<view wx:if="{{items.length}}" style="{{themeStyle}}" class="u-view reward-backdrop {{themeClass}} {{items[index].atlas?'cinematic814':''}} {{impact?'impact812':''}}" catchtap="noop">
  <block wx:if="{{items[index].atlas}}">
    <campus-collection id="reward-atlas812" atlas="{{items[index].atlas}}" reveal-key="{{items[index].revealKey}}" celebrating="{{true}}" cinematic="{{true}}" revisit="{{items[index].revisit}}" bind:impact="impact" bind:phase="phase"/>
    <view class="cinema-heading814"><text>{{i18n.ui('点亮校园建筑',locale)}}</text><button class="u-button cinema-close814" bindtap="close" aria-label="{{i18n.ui('关闭',locale)}}">×</button></view>
    <view class="cinema-result814 {{cinemaLanded?'landed':''}}" style="top:{{resultTop || 420}}px">
      <view class="title">{{i18n.content(items[index].title,locale,localeTranslations,localeOriginal)}}</view>
      <view class="description">{{i18n.ui(items[index].description || '每一步，都值得被记住。',locale)}}</view>
      <button class="u-button replay813" bindtap="replay">{{i18n.ui('重看建筑落位',locale)}}</button>
    </view>
    <view wx:if="{{!cinemaReady}}" class="cinema-loading814">{{i18n.ui('正在准备建筑落位…',locale)}}<button class="replay813" bindtap="replay">{{i18n.ui('重试',locale)}}</button></view>
    <button wx:if="{{cinemaLanded}}" class="u-button cinema-next814" bindtap="next">{{i18n.ui(index+1<items.length?'收下，看看下一个':'收进校园护照',locale)}}</button>
  </block>
  <scroll-view wx:else scroll-y class="u-scroll-view reward {{items[index].milestoneKind?'milestone820 '+items[index].milestoneKind:''}}" catchtap="noop"><view class="label">{{i18n.ui('校园护照 · 新的收获',locale)}}</view><image class="u-image medal" src="{{items[index].badge}}" mode="aspectFit"/><view class="title">{{i18n.content(items[index].title,locale,localeTranslations,localeOriginal)}}</view><view class="description">{{i18n.ui(items[index].description || '每一步，都值得被记住。',locale)}}</view><button class="u-button" bindtap="next">{{i18n.ui(index+1<items.length?'收下，看看下一个':'收进校园护照',locale)}}</button><view class="close" bindtap="close">{{i18n.ui('稍后查看',locale)}}</view></scroll-view>
</view>
