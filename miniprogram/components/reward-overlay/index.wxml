<view wx:if="{{items.length}}" class="reward-backdrop" catchtouchmove="noop"><view class="reward" catchtap="noop"><view class="label">校园护照 · 新的收获</view><image class="medal" src="{{items[index].badge}}" mode="aspectFit"/><view class="title">{{items[index].title}}</view><view class="description">{{items[index].description || '每一步，都值得被记住。'}}</view><view class="description">{{index+1}} / {{items.length}}</view><button bindtap="next">{{index+1<items.length?'收下，看看下一个':'收进校园护照'}}</button><view class="close" bindtap="close">稍后查看</view></view></view>
