<wxs src="/services/i18n.wxs" module="i18n"/>
<view wx:if="{{items.length}}" style="{{themeStyle}}" class="u-view reward-backdrop {{themeClass}} {{impact?'impact812':''}}"><scroll-view scroll-y class="u-scroll-view reward" catchtap="noop"><view class="u-view label">{{i18n.ui('校园护照 · 新的收获',locale)}}</view><campus-collection id="reward-atlas812" wx:if="{{items[index].atlas}}" atlas="{{items[index].atlas}}" revealed="{{items[index].revealed}}" reveal-key="{{items[index].revealKey}}" celebrating="{{true}}" revisit="{{items[index].revisit}}" bind:impact="impact" bind:navigate="close"/><image wx:else class="u-image medal" src="{{items[index].badge}}" mode="aspectFit"/><button wx:if="{{items[index].atlas}}" class="replay813" bindtap="replay">{{i18n.ui('重看建筑落位',locale)}}</button><view class="u-view title">{{i18n.content(items[index].title,locale,localeTranslations,localeOriginal)}}</view><view class="u-view description">{{i18n.ui(items[index].description || '每一步，都值得被记住。',locale)}}</view><view class="u-view description">{{i18n.content(index+1,locale,localeTranslations,localeOriginal)}} / {{i18n.content(items.length,locale,localeTranslations,localeOriginal)}}</view><button class="u-button" bindtap="next">{{i18n.ui(index+1<items.length?'收下，看看下一个':'收进校园护照',locale)}}</button><view class="u-view close" bindtap="close">{{i18n.ui('稍后查看',locale)}}</view></scroll-view></view>
