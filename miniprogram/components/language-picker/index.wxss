:host {
  display: block;
  width: var(--jy-touch, 44px);
  height: var(--jy-touch, 44px);
  line-height: 0;
}
.language-trigger.language-trigger {
  box-sizing: border-box;
  width: var(--jy-touch, 44px);
  height: var(--jy-touch, 44px);
  min-width: var(--jy-touch, 44px);
  max-width: var(--jy-touch, 44px);
  min-height: var(--jy-touch, 44px);
  max-height: var(--jy-touch, 44px);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: transparent;
  box-shadow: none;
  line-height: 1;
}
.language-trigger::after {
  border: 0;
}
.flag-disc {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  overflow: hidden;
}
.flag-image {
  width: 20px;
  height: 14px;
}
.language-trigger .flag-disc {
  box-sizing: border-box;
  width: var(--jy-header-disc, 38px);
  height: var(--jy-header-disc, 38px);
  border: 1px solid var(--line, #d8e4ed);
  background: var(--surface, #fff);
}
.language-dismiss {
  position: fixed;
  inset: 0;
  z-index: 1100;
  background: transparent;
}
.language-panel {
  position: fixed;
  right: calc(var(--jy-rpx, 1rpx) * 24);
  top: calc(var(--jy-rpx, 1rpx) * 170);
  z-index: 1101;
  width: calc(var(--jy-rpx, 1rpx) * 450);
  max-width: calc(100vw - calc(var(--jy-rpx, 1rpx) * 48));
  box-sizing: border-box;
  padding: calc(var(--jy-rpx, 1rpx) * 24);
  border-radius: calc(var(--jy-rpx, 1rpx) * 30);
  background: var(--surface, #fff);
  color: var(--text, #273d50);
  border: calc(var(--jy-rpx, 1rpx) * 1) solid var(--line, #d5e0e7);
  box-shadow: 0 calc(var(--jy-rpx, 1rpx) * 16) calc(var(--jy-rpx, 1rpx) * 50) #0002;
}
.language-heading {
  font-weight: 650;
  margin-bottom: calc(var(--jy-rpx, 1rpx) * 16);
}
.language-option {
  display: flex;
  align-items: center;
  text-align: left;
  gap: calc(var(--jy-rpx, 1rpx) * 16);
  margin: calc(var(--jy-rpx, 1rpx) * 8) 0;
  min-height: calc(var(--jy-rpx, 1rpx) * 82);
  line-height: 1.4;
  font-size: calc(var(--jy-rpx, 1rpx) * 27);
  white-space: normal;
}
.language-option::after {
  border: 0;
}
.language-help {
  display: block;
  color: var(--muted, #637887);
  font-size: calc(var(--jy-rpx, 1rpx) * 23);
  line-height: 1.6;
  margin-top: calc(var(--jy-rpx, 1rpx) * 16);
}
.language-error {
  display: block;
  color: var(--danger, #b33f57);
  font-size: calc(var(--jy-rpx, 1rpx) * 24);
}
