<wxs src="/services/i18n.wxs" module="i18n"/>
<view class="workspace81 {{theme}}" style="{{styles}}" wx:if="{{active}}"><view class="task-card81"><view class="task-head81"><text>{{i18n.content(active.title,locale,localeTranslations,localeOriginal)}} · {{i18n.ui(stage==='arrived'?'正在拍摄':stage==='captured'?'拍完之后':'这次拍摄',locale)}}</text><button class="u-button task-close81" bindtap="clear" aria-label="{{i18n.ui('结束这次拍摄',locale)}}">×</button></view><view class="task-copy81">{{i18n.ui(active.availability==='closed'||active.pointOpen===false?'机位当前关闭，出发前请重新核对。':stage==='arrived'?'已经到达？先稳住画面，再留下自己的照片。':stage==='captured'?'照片拍好了，把地点和这一刻一起记下来。':'先看路线与开放情况，到达后再打开取景辅助。',locale)}}</view><view class="task-copy81">{{i18n.content(active.openingHours||'开放时间待核对。',locale,localeTranslations,localeOriginal)}}</view><view class="task-actions81"><button class="u-button primary" wx:if="{{stage!=='arrived'&&stage!=='captured'&&features.exploration.visible!==false}}" bindtap="primary" disabled="{{active.availability==='closed'||active.pointOpen===false}}">{{i18n.ui('准备出发',locale)}}</button><button class="u-button primary" wx:if="{{stage==='arrived'&&features.framing.visible!==false}}" bindtap="primary" disabled="{{active.availability==='closed'||active.pointOpen===false}}">{{i18n.ui('取景辅助',locale)}}</button><button class="u-button primary" wx:if="{{stage==='captured'&&features.publishing.visible!==false}}" bindtap="primary" disabled="{{active.availability==='closed'||active.pointOpen===false}}">{{i18n.ui('记录这张照片',locale)}}</button><button class="u-button" wx:if="{{stage==='prepare'}}" bindtap="arrived">{{i18n.ui('我已到达',locale)}}</button><button class="u-button" wx:if="{{stage==='arrived'&&features.publishing.visible!==false}}" bindtap="capture">{{i18n.ui('拍好了，去记录',locale)}}</button><button class="u-button quiet" wx:if="{{features.plans.visible!==false}}" bindtap="plans">{{i18n.ui('拍摄计划 ↗',locale)}}</button></view></view>
<view class="timing-card81" wx:if="{{timingVisible}}"><view class="task-head81">{{i18n.ui('今天什么时候适合拍？',locale)}}</view><view wx:if="{{loading}}" class="task-copy81">{{i18n.ui('正在结合天气与机位朝向…',locale)}}</view><view class="task-copy81" wx:if="{{timing}}">{{i18n.content(timing.message,locale,localeTranslations,localeOriginal)}}</view><view wx:for="{{timing.windows}}" wx:key="start" class="timing-window81"><view class="timing-time81">{{i18n.content(item.startLabel,locale,localeTranslations,localeOriginal)}}–{{i18n.content(item.endLabel,locale,localeTranslations,localeOriginal)}}</view><view>{{i18n.content(item.label,locale,localeTranslations,localeOriginal)}}</view><view class="task-copy81">{{i18n.content(item.reason,locale,localeTranslations,localeOriginal)}}</view><view class="task-copy81">{{i18n.ui('太阳方位',locale)}} {{item.solarAzimuth}}° · {{i18n.ui('高度',locale)}} {{item.solarElevation}}°</view><button class="u-button" wx:if="{{features.plans.visible!==false}}" data-index="{{index}}" bindtap="addPlan" disabled="{{saving}}">{{i18n.ui('加入拍摄计划',locale)}}</button></view><view class="task-copy81" wx:if="{{timing}}">{{i18n.content(timing.notice,locale,localeTranslations,localeOriginal)}} · Open-Meteo</view><view wx:if="{{error}}" class="task-copy81">{{i18n.content(error,locale,localeTranslations,localeOriginal)}}</view><button class="u-button" wx:if="{{!timing&&!loading}}" bindtap="maintenance">{{i18n.ui('查看拍摄时机',locale)}}</button></view></view>

<view wx:if="{{planChoices}}" class="plan-choice-mask81 {{theme}}" style="{{styles}}" bindtap="closePlan"><view class="plan-choice-dialog81" catchtap="noop"><view class="task-head81">{{i18n.ui('保存到拍摄计划',locale)}}<button class="u-button task-close81" bindtap="closePlan">×</button></view><scroll-view scroll-y class="plan-choice-scroll81"><button class="u-button plan-choice-button81" wx:for="{{planChoices}}" wx:key="index" data-index="{{index}}" bindtap="choosePlan">{{i18n.content(item.title,locale,localeTranslations,localeOriginal)}}</button></scroll-view></view></view>
