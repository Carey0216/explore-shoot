@import '../base.wxss';
.workspace81 {
  color: var(--text, #273d35);
}
.task-card81,
.timing-card81 {
  padding: calc(var(--jy-rpx, 1rpx) * 28);
  margin: calc(var(--jy-rpx, 1rpx) * 24) 0;
  border: calc(var(--jy-rpx, 1rpx) * 1) solid var(--line, #d5e0db);
  border-radius: calc(var(--jy-rpx, 1rpx) * 30);
  background: var(--surface, #fff);
}
.task-head81 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: calc(var(--jy-rpx, 1rpx) * 16);
  font-size: calc(var(--jy-rpx, 1rpx) * 28);
  font-weight: 600;
  line-height: 1.6;
}
.task-close81 {
  width: calc(var(--jy-rpx, 1rpx) * 48);
  min-width: calc(var(--jy-rpx, 1rpx) * 48);
  height: calc(var(--jy-rpx, 1rpx) * 48);
  line-height: calc(var(--jy-rpx, 1rpx) * 48);
  padding: 0;
  margin: 0;
  background: transparent;
  border: 0;
  flex: none;
}
.task-copy81 {
  font-size: calc(var(--jy-rpx, 1rpx) * 23);
  color: var(--muted, #64766e);
  line-height: 1.8;
  margin: calc(var(--jy-rpx, 1rpx) * 12) 0;
}
.task-actions81 {
  display: flex;
  gap: calc(var(--jy-rpx, 1rpx) * 12);
  flex-wrap: wrap;
  align-items: center;
  margin-top: calc(var(--jy-rpx, 1rpx) * 20);
}
.task-actions81 .u-button {
  font-size: calc(var(--jy-rpx, 1rpx) * 24);
  margin: 0;
  padding: calc(var(--jy-rpx, 1rpx) * 12) calc(var(--jy-rpx, 1rpx) * 20);
  line-height: 1.6;
}
.task-actions81 .primary {
  background: var(--primary, #34705b);
  color: #fff;
}
.task-actions81 .quiet {
  background: transparent;
  box-shadow: none;
}
.timing-window81 {
  margin-top: calc(var(--jy-rpx, 1rpx) * 18);
  padding: calc(var(--jy-rpx, 1rpx) * 24);
  border: calc(var(--jy-rpx, 1rpx) * 1) solid var(--line, #d5e0db);
  border-radius: calc(var(--jy-rpx, 1rpx) * 22);
}
.timing-time81 {
  font-size: calc(var(--jy-rpx, 1rpx) * 34);
  color: var(--primary, #34705b);
  margin-bottom: calc(var(--jy-rpx, 1rpx) * 12);
}
.timing-window81 .u-button {
  font-size: calc(var(--jy-rpx, 1rpx) * 24);
  line-height: 1.6;
  padding: calc(var(--jy-rpx, 1rpx) * 14) calc(var(--jy-rpx, 1rpx) * 22);
  margin: calc(var(--jy-rpx, 1rpx) * 16) 0 0;
}

.plan-choice-mask81 {
  position: fixed;
  inset: 0;
  z-index: 9200;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0005;
}
.plan-choice-dialog81 {
  box-sizing: border-box;
  width: calc(100vw - calc(var(--jy-rpx, 1rpx) * 48));
  padding: calc(var(--jy-rpx, 1rpx) * 32);
  border-radius: calc(var(--jy-rpx, 1rpx) * 36);
  background: var(--surface, #fff);
  color: var(--text, #25374a);
}
.plan-choice-scroll81 {
  max-height: 50vh;
}
.plan-choice-button81 {
  display: block;
  width: 100%;
  padding: calc(var(--jy-rpx, 1rpx) * 24);
  text-align: left;
  margin: calc(var(--jy-rpx, 1rpx) * 14) 0;
  background: var(--raised, #eaf1f6);
  border: 0;
  border-radius: calc(var(--jy-rpx, 1rpx) * 24);
  color: var(--text, #25374a);
  font-size: calc(var(--jy-rpx, 1rpx) * 26);
}
