<wxs src="/services/i18n.wxs" module="i18n"/>
<view class="u-view state" wx:if="{{loading || error || empty}}"><text class="u-text">{{i18n.ui(loading ? '正在加载…' : error || '暂时没有内容',locale)}}</text><button class="u-button" wx:if="{{error && !loading}}" bindtap="retry">{{i18n.ui('重试',locale)}}</button></view>
