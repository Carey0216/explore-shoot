<wxs src="/services/i18n.wxs" module="i18n"/>
<view class="u-view state" wx:if="{{loading || error || empty}}"><view wx:if="{{loading&&skeleton}}" class="skeleton-grid81" aria-hidden="true"><view class="skeleton-card81"><view class="skeleton-photo81"/><view class="skeleton-line81"/><view class="skeleton-line81 short"/></view><view class="skeleton-card81"><view class="skeleton-photo81"/><view class="skeleton-line81"/><view class="skeleton-line81 short"/></view></view><view wx:if="{{loading&&!skeleton}}" class="loading-dots81" aria-hidden="true"><view class="loading-dot81"/><view class="loading-dot81"/><view class="loading-dot81"/></view><text class="u-text">{{i18n.ui(loading ? '正在加载…' : error || '暂时没有内容',locale)}}</text><button class="u-button" wx:if="{{error && !loading}}" bindtap="retry">{{i18n.ui('重试',locale)}}</button></view>
