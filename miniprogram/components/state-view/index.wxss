@import '../base.wxss';
.state {
  text-align: center;
  padding: calc(var(--jy-rpx, 1rpx) * 60) calc(var(--jy-rpx, 1rpx) * 20);
  color: #78847e;
  line-height: 1.8;
}
.u-button {
  margin-top: calc(var(--jy-rpx, 1rpx) * 24);
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 26) * var(--font-scale, 1));
  border: 0;
  color: #245b4c;
  background: #e8eee8;
}
.u-button::after {
  border: 0;
}

:host {
  color: var(--text, #25374a);
}
.dialog,
.panel,
.card,
.sheet,
.reward-card,
.modal,
.popup {
  background: var(--surface, #fff);
  color: var(--text, #25374a);
  border-color: var(--line, #d8e4ed);
}
.muted,
.privacy,
.subtitle {
  color: var(--muted, #6e808b);
}
.u-button {
  background: var(--raised, #eaf1f6);
  color: var(--accent, #326ba6);
  border-color: var(--line, #d8e4ed);
  box-shadow: none;
}
.placeholder,
.empty {
  background: var(--raised, #eaf1f6);
  color: var(--muted, #6e808b);
}

.loading-dots81 {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: calc(var(--jy-rpx, 1rpx) * 14);
  height: calc(var(--jy-rpx, 1rpx) * 44);
  margin-bottom: calc(var(--jy-rpx, 1rpx) * 18);
}
.loading-dot81 {
  width: calc(var(--jy-rpx, 1rpx) * 12);
  height: calc(var(--jy-rpx, 1rpx) * 12);
  background: var(--accent, #4e83a8);
  border-radius: 50%;
  animation: loading-dot81 1.2s ease-in-out infinite;
}
.loading-dot81:nth-child(2) {
  animation-delay: 0.15s;
}
.loading-dot81:nth-child(3) {
  animation-delay: 0.3s;
}
@keyframes loading-dot81 {
  0%,
  65%,
  100% {
    opacity: 0.35;
    transform: translateY(0);
  }
  30% {
    opacity: 1;
    transform: translateY(calc(var(--jy-rpx, 1rpx) * -8));
  }
}

.skeleton-grid81 {
  display: flex;
  gap: calc(var(--jy-rpx, 1rpx) * 20);
  margin-bottom: calc(var(--jy-rpx, 1rpx) * 24);
  text-align: left;
}
.skeleton-card81 {
  flex: 1;
  min-width: 0;
}
.skeleton-photo81 {
  height: calc(var(--jy-rpx, 1rpx) * 180);
  border-radius: calc(var(--jy-rpx, 1rpx) * 24);
  background: var(--raised, #e3edf4);
}
.skeleton-line81 {
  height: calc(var(--jy-rpx, 1rpx) * 20);
  border-radius: calc(var(--jy-rpx, 1rpx) * 10);
  background: var(--raised, #e3edf4);
  margin-top: calc(var(--jy-rpx, 1rpx) * 18);
}
.skeleton-line81.short {
  width: 62%;
}
