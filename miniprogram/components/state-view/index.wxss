@import '../base.wxss';
.state {
  text-align: center;
  padding: 60rpx 20rpx;
  color: #78847e;
  line-height: 1.8;
}
.u-button {
  margin-top: 24rpx;
  font-size: calc(26rpx * var(--font-scale, 1));
  border: 0;
  color: #245b4c;
  background: #e8eee8;
}
.u-button::after {
  border: 0;
}

:host {
  color: var(--text, #25374a);
}
.dialog,
.panel,
.card,
.sheet,
.reward-card,
.modal,
.popup {
  background: var(--surface, #fff);
  color: var(--text, #25374a);
  border-color: var(--line, #d8e4ed);
}
.muted,
.privacy,
.subtitle {
  color: var(--muted, #6e808b);
}
.u-button {
  background: var(--raised, #eaf1f6);
  color: var(--accent, #326ba6);
  border-color: var(--line, #d8e4ed);
  box-shadow: none;
}
.placeholder,
.empty {
  background: var(--raised, #eaf1f6);
  color: var(--muted, #6e808b);
}

.loading-dots81 {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  height: 44rpx;
  margin-bottom: 18rpx;
}
.loading-dot81 {
  width: 12rpx;
  height: 12rpx;
  background: var(--accent, #4e83a8);
  border-radius: 50%;
  animation: loading-dot81 1.2s ease-in-out infinite;
}
.loading-dot81:nth-child(2) {
  animation-delay: 0.15s;
}
.loading-dot81:nth-child(3) {
  animation-delay: 0.3s;
}
@keyframes loading-dot81 {
  0%,
  65%,
  100% {
    opacity: 0.35;
    transform: translateY(0);
  }
  30% {
    opacity: 1;
    transform: translateY(-8rpx);
  }
}
.reduce-motion .loading-dot81 {
  animation: none;
  opacity: 0.65;
}

.skeleton-grid81 {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
  text-align: left;
}
.skeleton-card81 {
  flex: 1;
  min-width: 0;
}
.skeleton-photo81 {
  height: 180rpx;
  border-radius: 24rpx;
  background: var(--raised, #e3edf4);
}
.skeleton-line81 {
  height: 20rpx;
  border-radius: 10rpx;
  background: var(--raised, #e3edf4);
  margin-top: 18rpx;
}
.skeleton-line81.short {
  width: 62%;
}
