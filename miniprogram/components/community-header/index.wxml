<wxs src="/services/i18n.wxs" module="i18n"/>
<view class="u-view header"><view class="u-view community-toolbar"><view class="u-view brand" bindtap="discover"><image class="u-image jingyu-brand" src="/assets/brand/jingyu-{{themeDark ? 'dark' : 'light'}}.png" mode="aspectFit" aria-label="{{i18n.ui('景遇校园',locale)}}"/></view><view class="u-view actions"><language-picker class="language-picker-host" id="language-picker"/><view class="u-view search" bindtap="search" aria-role="button" aria-label="{{i18n.ui('搜索校园点位',locale)}}"><image class="u-image header-icon" src="/assets/tools/search{{themeDark ? '-dark' : ''}}.png" mode="aspectFit"/></view><view wx:if="{{messagesVisible}}" class="u-view message" bindtap="messages" aria-role="button" aria-label="{{i18n.ui('站内通知',locale)}}"><image class="u-image header-icon" src="/assets/tools/bell{{themeDark ? '-dark' : ''}}.png" mode="aspectFit"/><text wx:if="{{unread}}" class="u-text count">{{i18n.content(unread>99?'99+':unread,locale,localeTranslations,localeOriginal)}}</text></view><view class="u-view avatar" bindtap="toggleMenu" aria-role="button" aria-label="{{i18n.ui('我的账号',locale)}}"><image class="u-image" wx:if="{{avatar}}" src="{{avatar}}"/><text class="u-text" wx:else>{{initial}}</text></view></view></view><view class="u-view tabs" wx:if="{{active}}"><view class="u-view tab {{active==='discover'?'selected':''}}" bindtap="discover">{{i18n.ui('发现',locale)}}</view><view class="u-view tab {{active==='shots'?'selected':''}}" bindtap="shots">{{i18n.ui('机位',locale)}}</view></view></view>
<view wx:if="{{menuOpen}}" class="u-view account-dismiss" bindtap="closeMenu"/><view wx:if="{{menuOpen}}" class="u-view account-menu"><view class="u-view account-name">{{i18n.ui(account?account.nickname:'欢迎探索校园',locale)}}</view><text class="u-text account-description">{{i18n.ui(account?'@'+account.username:'登录后保存你的校园足迹',locale)}}</text><button class="u-button" wx:if="{{account}}" bindtap="my">{{i18n.ui('我的主页',locale)}}</button><button class="u-button" wx:if="{{!account}}" bindtap="login">{{i18n.ui('登录 / 注册',locale)}}</button><button class="u-button" wx:if="{{account}}" bindtap="records">{{i18n.ui('私人打卡',locale)}}</button><button class="u-button" bindtap="settings">{{i18n.ui('账户与外观设置',locale)}}</button><button class="u-button" bindtap="administration">{{i18n.ui('管理工作台',locale)}}</button></view>
