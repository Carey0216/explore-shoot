<view class="header"><view class="tabs" wx:if="{{active}}"><view class="tab {{active==='discover'?'selected':''}}" bindtap="discover">发现</view><view class="tab {{active==='shots'?'selected':''}}" bindtap="shots">机位</view></view><view class="actions"><view wx:if="{{messagesVisible}}" class="message" bindtap="messages" aria-role="button" aria-label="站内通知"><view class="bell"/><text wx:if="{{unread}}" class="count">{{unread>99?'99+':unread}}</text></view><view class="avatar" bindtap="my" aria-role="button" aria-label="我的账号">{{initial}}</view></view></view>
