<view class="u-view header"><view class="u-view community-toolbar"><view class="u-view brand" bindtap="discover"><view class="u-view brand-mark"><view class="u-view"/></view><text class="u-text">探索与拍摄</text></view><view class="u-view actions"><view class="u-view search" bindtap="search" aria-role="button" aria-label="搜索校园点位"><image class="u-image header-icon" src="/assets/tools/search{{themeDark ? '-dark' : ''}}.png" mode="aspectFit"/></view><view wx:if="{{messagesVisible}}" class="u-view message" bindtap="messages" aria-role="button" aria-label="站内通知"><image class="u-image header-icon" src="/assets/tools/bell{{themeDark ? '-dark' : ''}}.png" mode="aspectFit"/><text wx:if="{{unread}}" class="u-text count">{{unread>99?'99+':unread}}</text></view><view class="u-view avatar" bindtap="toggleMenu" aria-role="button" aria-label="我的账号"><image class="u-image" wx:if="{{avatar}}" src="{{avatar}}"/><text class="u-text" wx:else>{{initial}}</text></view></view></view><view class="u-view tabs" wx:if="{{active}}"><view class="u-view tab {{active==='discover'?'selected':''}}" bindtap="discover">发现</view><view class="u-view tab {{active==='shots'?'selected':''}}" bindtap="shots">机位</view></view></view>
<view wx:if="{{menuOpen}}" class="u-view account-dismiss" bindtap="closeMenu"/><view wx:if="{{menuOpen}}" class="u-view account-menu"><view class="u-view account-name">{{account?account.nickname:'欢迎探索校园'}}</view><text class="u-text account-description">{{account?'@'+account.username:'登录后保存你的校园足迹'}}</text><button class="u-button" wx:if="{{account}}" bindtap="my">我的主页</button><button class="u-button" wx:if="{{!account}}" bindtap="login">登录 / 注册</button><button class="u-button" wx:if="{{account}}" bindtap="records">私人打卡</button><button class="u-button" bindtap="settings">账户与外观设置</button><button class="u-button" bindtap="administration">管理工作台</button></view>
