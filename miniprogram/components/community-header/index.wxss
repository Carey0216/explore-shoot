@import '../base.wxss';
@import '../../styles/header820.wxss';
.header {
  display: block;
  margin: 0 calc(var(--jy-rpx, 1rpx) * -32) calc(var(--jy-rpx, 1rpx) * 14);
}
.community-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  min-height: var(--jy-header-row, 52px);
  padding: 0 calc(var(--jy-rpx, 1rpx) * 32);
  box-sizing: border-box;
  width: 100%;
}
.brand {
  display: flex;
  align-items: center;
  padding: 0;
}
.brand .jingyu-brand {
  display: block;
  width: 100%;
  object-fit: contain;
  border-radius: 0;
}
.actions {
  display: flex;
  flex: none;
  min-width: 0;
  margin-left: auto;
  gap: 4px;
}
.actions .search,
.actions .message,
.actions .avatar {
  box-sizing: border-box;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  background: transparent;
  color: var(--accent, #366c96);
  font-size: 14px;
  overflow: visible;
}
.actions .search::before,
.actions .message::before,
.actions .avatar::before {
  content: '';
  position: absolute;
  left: 3px;
  top: 3px;
  width: var(--jy-header-disc, 38px);
  height: var(--jy-header-disc, 38px);
  box-sizing: border-box;
  border-radius: 50%;
  border: 1px solid var(--line, #d8e4ed);
  background: var(--surface, #fff);
}
.actions .header-icon {
  width: var(--jy-header-icon, 18px);
  height: var(--jy-header-icon, 18px);
  position: relative;
}
.actions .avatar .u-text {
  position: relative;
}
.brand {
  flex-basis: var(--jy-header-logo, 100px);
}
.brand .jingyu-brand {
  max-width: var(--jy-header-logo, 100px);
  height: 48px;
}
.language-picker-host {
  height: var(--jy-touch, 44px);
  min-height: var(--jy-touch, 44px);
  max-height: var(--jy-touch, 44px);
  line-height: 0;
}
.avatar .u-image {
  width: var(--jy-header-disc, 38px);
  height: var(--jy-header-disc, 38px);
  border-radius: 50%;
}
.count {
  position: absolute;
  right: 0;
  top: 0;
  z-index: 2;
  min-width: 14px;
  height: 14px;
  padding: 0 4px;
  border-radius: 20px;
  background: #d55374;
  color: #fff;
  font-size: 10px;
  line-height: 14px;
  text-align: center;
  box-sizing: border-box;
}
.tabs {
  display: flex;
  justify-content: center;
  gap: 28px;
  margin: 0 calc(var(--jy-rpx, 1rpx) * 32);
  border-bottom: 1px solid var(--line, #d8e4ed);
}
.tab {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  padding: 10px 14px 14px;
  color: var(--muted, #657985);
  font-size: 14px;
  line-height: 1.4;
}
.tab.selected {
  color: var(--text, #243846);
  font-weight: 600;
  background: transparent;
  box-shadow: none;
  border-radius: 0;
}
.tab.selected:after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 24px;
  height: 3px;
  margin-left: -12px;
  border-radius: 3px;
  background: #e780a3;
}
.header-impact821 {
  animation: header-world821 1000ms both;
}
@keyframes header-world821 {
  0%,
  100% {
    transform: none;
  }
  14% {
    transform: translate(calc(var(--jy-rpx, 1rpx) * 24), calc(var(--jy-rpx, 1rpx) * 38))
      rotate(0.6deg);
  }
  32% {
    transform: translate(calc(var(--jy-rpx, 1rpx) * -28), calc(var(--jy-rpx, 1rpx) * -20))
      rotate(-0.6deg);
  }
  48% {
    transform: translate(calc(var(--jy-rpx, 1rpx) * 20), calc(var(--jy-rpx, 1rpx) * 16));
  }
  64% {
    transform: translate(calc(var(--jy-rpx, 1rpx) * -14), calc(var(--jy-rpx, 1rpx) * -10));
  }
  82% {
    transform: translate(calc(var(--jy-rpx, 1rpx) * 6), calc(var(--jy-rpx, 1rpx) * 4));
  }
}

.header-login {
  margin: 0;
  padding: 0 10px;
  min-width: 0;
  min-height: 44px;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  line-height: 1.3;
  white-space: nowrap;
  color: var(--accent);
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 24px;
}
.header-login::after {
  border: 0;
}
@media (max-width: 360px) {
  .brand {
    flex-basis: 76px;
    min-width: 60px;
  }
  .actions {
    gap: 0;
  }
  .community-toolbar {
    gap: 4px;
  }
  .header-login {
    padding: 0 7px;
  }
}
