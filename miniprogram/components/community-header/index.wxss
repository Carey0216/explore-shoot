.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 30rpx;
}
.tabs {
  display: flex;
  padding: 6rpx;
  border-radius: 30rpx;
  background: #fff9;
}
.tab {
  font-size: 29rpx;
  padding: 14rpx 30rpx;
  border-radius: 25rpx;
  color: #667c74;
}
.selected {
  background: #fff;
  color: #245b4c;
  font-weight: 600;
  box-shadow: 0 3rpx 12rpx #284b3f10;
}
.actions {
  display: flex;
  gap: 18rpx;
  margin-left: auto;
}
.message,
.avatar {
  position: relative;
  width: 66rpx;
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #ffffffe0;
  color: #315b4b;
  border: 2rpx solid #fff;
}
.bell {
  width: 25rpx;
  height: 29rpx;
  border: 3rpx solid #527363;
  border-radius: 20rpx 20rpx 6rpx 6rpx;
}
.bell:after {
  content: '';
  position: absolute;
  bottom: 12rpx;
  left: 30rpx;
  width: 7rpx;
  height: 4rpx;
  border-radius: 5rpx;
  background: #527363;
}
.count {
  position: absolute;
  right: -5rpx;
  top: -5rpx;
  background: #e95f7b;
  color: #fff;
  font-size: 18rpx;
  padding: 1rpx 7rpx;
  border-radius: 20rpx;
}

.header {
  display: block;
  margin: 0 -32rpx 28rpx;
}
.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 104rpx;
  padding: 20rpx 32rpx;
  background: transparent;
}
.brand {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  font-weight: 650;
  color: #233b57;
  white-space: nowrap;
}
.brand-mark {
  width: 38rpx;
  height: 38rpx;
  border-radius: 10rpx;
  background: #387ab8;
  transform: rotate(-12deg);
  display: flex;
  align-items: center;
  justify-content: center;
}
.brand-mark view {
  width: 22rpx;
  height: 22rpx;
  border: 6rpx solid white;
  border-radius: 5rpx;
}
.actions {
  gap: 14rpx;
}
.message,
.avatar,
.search {
  width: 60rpx;
  height: 60rpx;
  background: #fbfdff;
  color: #385c80;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  position: relative;
  border: 2rpx solid white;
}
.search-mark {
  width: 23rpx;
  height: 23rpx;
  border: 2rpx solid #456f98;
  border-radius: 50%;
  position: relative;
}
.search-mark:after {
  content: '';
  position: absolute;
  width: 12rpx;
  height: 2rpx;
  background: #456f98;
  right: -8rpx;
  bottom: -4rpx;
  transform: rotate(45deg);
}
.tabs {
  margin: 24rpx 32rpx 0;
  width: max-content;
  background: transparent;
}
.selected {
  background: #fff;
  color: #2f6294;
}
.bell {
  border-color: #527395;
}
.bell:after {
  background: #527395;
  bottom: 8rpx;
  left: 25rpx;
}
