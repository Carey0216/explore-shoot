@import '../base.wxss';
.message-text {
  display: block;
  white-space: pre-wrap;
  line-height: 1.9;
  word-break: break-all;
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 28) * var(--font-scale, 1));
  color: #344f63;
}
.message-links {
  display: flex;
  flex-wrap: wrap;
  gap: calc(var(--jy-rpx, 1rpx) * 16);
  margin: calc(var(--jy-rpx, 1rpx) * 22) 0;
}
.message-links .u-button {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 25) * var(--font-scale, 1));
  line-height: 1.5;
  padding: calc(var(--jy-rpx, 1rpx) * 16) calc(var(--jy-rpx, 1rpx) * 24);
  border-radius: calc(var(--jy-rpx, 1rpx) * 24);
  background: #e9f1fa;
  color: #356383;
  margin: 0;
  max-width: 100%;
  white-space: normal;
}

:host {
  color: var(--text, #25374a);
}
.dialog,
.panel,
.card,
.sheet,
.reward-card,
.modal,
.popup {
  background: var(--surface, #fff);
  color: var(--text, #25374a);
  border-color: var(--line, #d8e4ed);
}
.muted,
.privacy,
.subtitle {
  color: var(--muted, #6e808b);
}
.u-button {
  background: var(--raised, #eaf1f6);
  color: var(--accent, #326ba6);
  border-color: var(--line, #d8e4ed);
  box-shadow: none;
}
.placeholder,
.empty {
  background: var(--raised, #eaf1f6);
  color: var(--muted, #6e808b);
}
.message-file {
  display: flex;
  align-items: center;
  gap: calc(var(--jy-rpx, 1rpx) * 18);
  padding: calc(var(--jy-rpx, 1rpx) * 22) calc(var(--jy-rpx, 1rpx) * 24);
  margin: calc(var(--jy-rpx, 1rpx) * 16) 0;
  border: calc(var(--jy-rpx, 1rpx) * 1) solid var(--line, #d5e0e7);
  border-radius: calc(var(--jy-rpx, 1rpx) * 28);
  background: var(--raised, #edf3f7);
  color: var(--text, #273d50);
}
.file-symbol {
  width: calc(var(--jy-rpx, 1rpx) * 44);
  height: calc(var(--jy-rpx, 1rpx) * 44);
  flex: none;
}
.message-file .file-meta {
  min-width: 0;
  flex: 1;
}
.file-title {
  display: block;
  word-break: break-all;
  font-size: calc(var(--jy-rpx, 1rpx) * 25);
  line-height: 1.5;
}
.file-action {
  display: block;
  margin-top: calc(var(--jy-rpx, 1rpx) * 6);
  font-size: calc(var(--jy-rpx, 1rpx) * 21);
  color: var(--accent, #346b9c);
}
