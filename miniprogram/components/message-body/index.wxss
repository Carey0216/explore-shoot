@import '../base.wxss';
.message-text {
  display: block;
  white-space: pre-wrap;
  line-height: 1.9;
  word-break: break-all;
  font-size: calc(28rpx * var(--font-scale, 1));
  color: #344f63;
}
.message-links {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 22rpx 0;
}
.message-links .u-button {
  font-size: calc(25rpx * var(--font-scale, 1));
  line-height: 1.5;
  padding: 16rpx 24rpx;
  border-radius: 24rpx;
  background: #e9f1fa;
  color: #356383;
  margin: 0;
  max-width: 100%;
  white-space: normal;
}

:host {
  color: var(--text, #25374a);
}
.dialog,
.panel,
.card,
.sheet,
.reward-card,
.modal,
.popup {
  background: var(--surface, #fff);
  color: var(--text, #25374a);
  border-color: var(--line, #d8e4ed);
}
.muted,
.privacy,
.subtitle {
  color: var(--muted, #6e808b);
}
.u-button {
  background: var(--raised, #eaf1f6);
  color: var(--accent, #326ba6);
  border-color: var(--line, #d8e4ed);
  box-shadow: none;
}
.placeholder,
.empty {
  background: var(--raised, #eaf1f6);
  color: var(--muted, #6e808b);
}
