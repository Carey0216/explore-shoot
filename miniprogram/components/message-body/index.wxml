<text class="message-text">{{value.body || value.message}}</text><view wx:if="{{value.image}}" bindtap="preview"><remote-image source="{{value.image}}" administrator="{{administrator}}" full/><text class="muted">点击查看完整配图</text></view><view class="message-links"><button wx:for="{{value.links}}" wx:key="href" data-href="{{item.href}}" bindtap="link">{{item.label}} ↗</button></view>
