<wxs src="/services/i18n.wxs" module="i18n"/>
<text class="u-text message-text">{{i18n.content(value.body || value.message,locale,localeTranslations,localeOriginal)}}</text><view class="u-view" wx:if="{{value.image}}" bindtap="preview"><remote-image class="u-remote-image" source="{{value.image}}" administrator="{{administrator}}" full/><text class="u-text muted">{{i18n.ui('点击查看完整配图',locale)}}</text></view><view class="u-view message-links"><button class="u-button" wx:for="{{value.links}}" wx:key="href" data-href="{{item.href}}" bindtap="link">{{i18n.content(item.label,locale,localeTranslations,localeOriginal)}} ↗</button></view>
<view class="message-file" wx:for="{{value.files}}" wx:key="id" data-index="{{index}}" bindtap="file" aria-role="button"><image class="file-symbol" src="{{i18n.icon('file',themeDark)}}" mode="aspectFit"/><view class="file-meta"><text class="file-title">{{i18n.content(item.name,locale,localeTranslations,localeOriginal)}}</text><text class="file-action">{{fileStatus[index] || i18n.ui('打开 / 保存文件',locale)}}</text></view></view>
