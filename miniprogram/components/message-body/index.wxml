<text class="u-text message-text">{{value.body || value.message}}</text><view class="u-view" wx:if="{{value.image}}" bindtap="preview"><remote-image class="u-remote-image" source="{{value.image}}" administrator="{{administrator}}" full/><text class="u-text muted">点击查看完整配图</text></view><view class="u-view message-links"><button class="u-button" wx:for="{{value.links}}" wx:key="href" data-href="{{item.href}}" bindtap="link">{{item.label}} ↗</button></view>
