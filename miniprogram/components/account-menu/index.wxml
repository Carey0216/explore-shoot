<wxs src="/services/i18n.wxs" module="i18n"/>
<block wx:if="{{open}}"><view class="account-dismiss81" bindtap="close"/><view class="account-menu81 {{theme}}" style="{{styles}}"><view class="account-head81"><image wx:if="{{avatar}}" class="account-avatar81" src="{{avatar}}" mode="aspectFill"/><view wx:else class="account-avatar81 initial81">{{initial}}</view><view class="account-copy81"><view class="account-name81">{{account?(account.nickname||account.name||account.username):i18n.ui('欢迎探索校园',locale)}}</view><text class="account-detail81">{{account?'@'+account.username:i18n.ui('登录后保存你的校园足迹',locale)}}</text><text wx:if="{{account}}" class="account-detail81">{{i18n.ui(administrator?(account.role==='owner'?'顶级管理员':account.role==='super'?'超级管理员':'普通管理员'):(account.scoutStatus==='approved'?'校园探索官':'校园探索者'),locale)}}</text></view></view>
<button class="account-action81" wx:if="{{account}}" data-action="home" bindtap="action"><image class="account-icon81" src="/assets/tools/user.png"/>{{i18n.ui(administrator?'管理工作台':'我的内容',locale)}}</button><button class="account-action81" wx:else data-action="login" bindtap="action"><image class="account-icon81" src="/assets/tools/user.png"/>{{i18n.ui('登录 / 注册',locale)}}</button>
<button class="account-action81" wx:if="{{account&&!administrator}}" data-action="records" bindtap="action"><image class="account-icon81" src="/assets/tools/camera.png"/>{{i18n.ui('私人打卡',locale)}}</button><button class="account-action81" wx:if="{{administrator}}" data-action="profile" bindtap="action"><image class="account-icon81" src="/assets/tools/user.png"/>{{i18n.ui('编辑个人资料',locale)}}</button><button class="account-action81" wx:if="{{account}}" data-action="avatar" bindtap="action"><image class="account-icon81" src="/assets/tools/camera.png"/>{{i18n.ui('编辑我的头像',locale)}}</button><button class="account-action81" data-action="settings" bindtap="action"><image class="account-icon81" src="/assets/tools/settings.png"/>{{i18n.ui('账户设置与账号安全',locale)}}</button><button class="account-action81" wx:if="{{account}}" data-action="logout" bindtap="action"><image class="account-icon81" src="/assets/tools/logout.png"/>{{i18n.ui('退出登录',locale)}}</button><button class="account-action81" wx:if="{{!administrator}}" data-action="administration" bindtap="action"><image class="account-icon81" src="/assets/tools/shield.png"/>{{i18n.ui('管理工作台',locale)}}</button></view></block>
