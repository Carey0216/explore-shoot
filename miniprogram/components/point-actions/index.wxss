@import '../base.wxss';
.point-actions {
  padding-top: 16rpx;
}
.reactions,
.actions-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
  margin-top: 10rpx;
}
.u-button {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 14rpx 18rpx;
  min-height: 76rpx;
  line-height: 1.3;
  font-size: 24rpx;
  color: var(--accent, #326ba6);
  background: var(--raised, #eaf1f6);
  border: 1rpx solid var(--line, #d8e4ed);
  box-shadow: none;
  border-radius: 24rpx;
  margin: 0;
}
.u-button:after {
  border: 0;
}
.u-image {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}
.reaction {
  width: auto;
  min-width: 78rpx;
}
.navigate {
  flex: 1;
  min-width: 0;
  width: auto;
  padding-inline: 8rpx;
  white-space: nowrap;
}
.save {
  width: 76rpx;
  min-width: 76rpx;
  padding: 14rpx;
  flex: 0 0 76rpx;
}
.selected {
  background: var(--selected, #dcecff);
  border-color: var(--accent, #326ba6);
}
.u-button.u-disabled {
  opacity: 0.5;
}
