@import '../base.wxss';
.point-actions {
  padding-top: calc(var(--jy-rpx, 1rpx) * 16);
}
.reactions,
.actions-row {
  display: flex;
  gap: calc(var(--jy-rpx, 1rpx) * 12);
  align-items: center;
  margin-top: calc(var(--jy-rpx, 1rpx) * 10);
}
.u-button {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: calc(var(--jy-rpx, 1rpx) * 8);
  padding: calc(var(--jy-rpx, 1rpx) * 14) calc(var(--jy-rpx, 1rpx) * 18);
  min-height: calc(var(--jy-rpx, 1rpx) * 76);
  line-height: 1.3;
  font-size: calc(var(--jy-rpx, 1rpx) * 24);
  color: var(--accent, #326ba6);
  background: var(--raised, #eaf1f6);
  border: calc(var(--jy-rpx, 1rpx) * 1) solid var(--line, #d8e4ed);
  box-shadow: none;
  border-radius: calc(var(--jy-rpx, 1rpx) * 24);
  margin: 0;
}
.u-button:after {
  border: 0;
}
.u-image {
  width: calc(var(--jy-rpx, 1rpx) * 32);
  height: calc(var(--jy-rpx, 1rpx) * 32);
  flex-shrink: 0;
}
.reaction {
  width: auto;
  min-width: calc(var(--jy-rpx, 1rpx) * 78);
}
.navigate {
  flex: 1;
  min-width: 0;
  width: auto;
  padding-inline: calc(var(--jy-rpx, 1rpx) * 8);
  white-space: nowrap;
}
.save {
  width: calc(var(--jy-rpx, 1rpx) * 76);
  min-width: calc(var(--jy-rpx, 1rpx) * 76);
  padding: calc(var(--jy-rpx, 1rpx) * 14);
  flex: 0 0 calc(var(--jy-rpx, 1rpx) * 76);
}
.selected {
  background: var(--selected, #dcecff);
  border-color: var(--accent, #326ba6);
}
.u-button.u-disabled {
  opacity: 0.5;
}
