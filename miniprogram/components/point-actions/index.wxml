<view wx:if="{{current}}" class="u-view point-actions" catchtap="noop"><view wx:if="{{features.reactions.visible!==false}}" class="u-view reactions"><button size="mini" class="{{busy ? 'u-disabled' : ''}} u-button reaction {{current.myReaction==='like'?'selected':''}}" data-value="like" catchtap="react" disabled="{{busy}}" aria-label="喜欢"><image class="u-image" src="/assets/tools/thumb-up{{themeDark ? '-dark' : ''}}.png"/><text class="u-text">{{current.likeCount||0}}</text></button><button size="mini" class="{{busy ? 'u-disabled' : ''}} u-button reaction {{current.myReaction==='dislike'?'selected':''}}" data-value="dislike" catchtap="react" disabled="{{busy}}" aria-label="不喜欢"><image class="u-image" src="/assets/tools/thumb-down{{themeDark ? '-dark' : ''}}.png"/></button></view><view class="u-view actions-row"><button size="mini" class="u-button navigate" catchtap="navigate"><image class="u-image" src="/assets/tools/pin{{themeDark ? '-dark' : ''}}.png"/><text class="u-text">去这里</text></button><button wx:if="{{features.bookmarks.visible!==false}}" size="mini" class="{{busy ? 'u-disabled' : ''}} u-button save {{saved?'selected':''}}" catchtap="bookmark" disabled="{{busy}}" aria-label="{{saved?'取消收藏':'收藏地点'}}"><image class="u-image" src="/assets/tools/heart{{themeDark ? '-dark' : ''}}.png"/><text class="u-text" wx:if="{{saved}}">✓</text></button></view></view>
