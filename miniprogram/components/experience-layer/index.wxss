@import '../base.wxss';
.experience {
  color: var(--text, #25374a);
}
.u-button {
  border: 0;
  box-shadow: none;
  font-size: calc(25rpx * var(--font-scale, 1));
  min-height: 80rpx;
  line-height: 1.5;
  padding: 20rpx;
  border-radius: 24rpx;
  background: var(--raised, #eaf1f6);
  color: var(--accent, #326ba6);
}
.u-button:after {
  border: 0;
}
.assistant-launch {
  position: fixed;
  right: 0;
  bottom: calc(210rpx + env(safe-area-inset-bottom));
  z-index: 9001;
  width: 86rpx;
  height: 100rpx;
  padding: 22rpx;
  border: 1rpx solid var(--line, #d8e4ed);
  border-radius: 38rpx 0 0 38rpx;
  background: var(--dock, #edf5fcf5);
}
.assistant-launch .u-image {
  width: 40rpx;
  height: 40rpx;
}
.sheet-mask,
.tour-mask {
  position: fixed;
  inset: 0;
  z-index: 9000;
  background: #0006;
  display: flex;
  align-items: flex-end;
}
.chat-sheet {
  width: 100%;
  height: 78vh;
  max-height: calc(100vh - 60px);
  display: flex;
  flex-direction: column;
  border-radius: 44rpx 44rpx 0 0;
  background: var(--surface, #fff);
  padding-bottom: env(safe-area-inset-bottom);
  overflow: hidden;
  animation: sheet-in 0.25s ease-out;
}
.sheet-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid var(--line, #d8e4ed);
  font-weight: 600;
}
.sheet-head > .u-text {
  flex: 1;
}
.sheet-head .u-button {
  margin: 0;
}
.close {
  width: 80rpx;
  height: 80rpx;
  padding: 0;
  font-size: calc(44rpx * var(--font-scale, 1));
}
.tiny {
  min-height: 60rpx;
}
.sheet-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
}
.chat-log {
  padding: 22rpx;
  box-sizing: border-box;
}
.chat-welcome {
  text-align: center;
  padding: 40rpx 12rpx;
  color: var(--muted, #6e808b);
  font-size: calc(24rpx * var(--font-scale, 1));
}
.chat-welcome .u-text {
  display: block;
  line-height: 1.8;
}
.chat-title {
  font-size: calc(46rpx * var(--font-scale, 1));
  font-weight: 700;
  color: var(--text, #25374a);
  margin: 20rpx;
}
.chat-welcome .u-button {
  margin-top: 18rpx;
}
.bubble {
  background: var(--raised, #eaf1f6);
  margin: 18rpx 55rpx 18rpx 0;
  padding: 24rpx;
  border-radius: 28rpx;
  white-space: pre-wrap;
  line-height: 1.8;
  font-size: calc(27rpx * var(--font-scale, 1));
}
.bubble.user {
  margin: 18rpx 0 18rpx 55rpx;
  background: var(--selected, #dcecff);
}
.bubble .u-button {
  font-size: calc(23rpx * var(--font-scale, 1));
  text-align: left;
}
.chat-input {
  flex-shrink: 0;
  display: flex;
  padding: 16rpx 24rpx;
  gap: 14rpx;
}
.chat-input .u-input {
  flex: 1;
  min-width: 0;
  min-height: 80rpx;
  padding: 0 20rpx;
  border-radius: 24rpx;
  background: var(--raised, #eaf1f6);
  font-size: calc(27rpx * var(--font-scale, 1));
}
.chat-input .u-button {
  min-width: 110rpx;
}
.plan-link,
.further {
  margin: 0 24rpx 12rpx;
  font-size: calc(23rpx * var(--font-scale, 1));
  min-height: 60rpx;
  padding: 14rpx;
}
.tour-mask {
  align-items: center;
  padding: 30rpx;
}
.tour-card {
  width: 100%;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border-radius: 64rpx;
  background: var(--surface, #fff);
  padding-bottom: 24rpx;
}
.tour-copy {
  max-height: 48vh;
  min-height: 160rpx;
  padding: 30rpx;
  box-sizing: border-box;
  white-space: pre-wrap;
  line-height: 1.9;
  font-size: calc(27rpx * var(--font-scale, 1));
}
.tour-copy .u-image {
  width: 60rpx;
  height: 60rpx;
}
.tour-title {
  font-size: calc(38rpx * var(--font-scale, 1));
  font-weight: 700;
  margin: 18rpx 0;
}
.tour-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  padding: 0 24rpx;
}
.primary {
  background: var(--accent, #326ba6);
  color: var(--bg, #fff);
}
.error {
  padding: 8rpx 24rpx;
  color: var(--danger, #b33f57);
}
.reward-island {
  position: fixed;
  z-index: 8000;
  top: 24rpx;
  left: 20rpx;
  right: 20rpx;
  border-radius: 65rpx;
  padding: 18rpx 16rpx 18rpx 28rpx;
  display: flex;
  gap: 20rpx;
  align-items: center;
  background: #1b2028f5;
  color: #f1f4f8;
  box-shadow: 0 12rpx 36rpx #0003;
  animation: sheet-in 0.25s ease-out;
}
.reward-island .u-image {
  width: 72rpx;
  height: 72rpx;
}
.reward-island .locked {
  filter: grayscale(1);
  opacity: 0.65;
}
.reward-island > .u-view {
  flex: 1;
  min-width: 0;
}
.reward-island .u-text {
  display: block;
  font-size: calc(23rpx * var(--font-scale, 1));
  line-height: 1.6;
}
.reward-island .u-text + .u-text {
  color: #b9c8d8;
  font-size: calc(22rpx * var(--font-scale, 1));
}
.reward-island .u-button {
  width: 80rpx;
  background: transparent;
  color: inherit;
  font-size: calc(35rpx * var(--font-scale, 1));
  padding: 14rpx;
}
.celebration {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
  z-index: 9999;
}
@keyframes sheet-in {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
.reduce-motion .chat-sheet,
.reduce-motion .reward-island {
  animation: none;
}

.activity-guide {
  background: transparent;
}
.guide-highlight {
  position: fixed;
  pointer-events: none;
  border: 2px solid #a8d3ff;
  border-radius: 28rpx;
  box-shadow: 0 0 0 5000rpx #0009;
}
.activity-guide .tour-card {
  position: relative;
  z-index: 1;
  max-height: 52vh;
  margin-top: -180rpx;
}

.sheet-head .close {
  flex: 0 0 80rpx;
  width: 80rpx;
  min-width: 80rpx;
  max-width: 80rpx;
  border-radius: 50%;
  padding: 0;
}
.sheet-head .tiny {
  flex: 0 0 auto;
  width: auto;
  min-width: 92rpx;
}
.tour-actions .u-button {
  flex: 1;
  min-width: 0;
  width: auto;
}
.chat-input .u-button {
  flex: 0 0 110rpx;
  width: 110rpx;
}

.u-button.assistant-launch {
  width: 86rpx;
  min-width: 86rpx;
  max-width: 86rpx;
  height: 100rpx;
  margin: 0;
  padding: 18rpx;
}
.assistant-launch .u-image {
  width: 55rpx;
  height: 55rpx;
}
.sheet-head .u-button.close {
  width: 80rpx;
  margin: 0;
}
.reward-island .u-button {
  flex: 0 0 68rpx;
  min-width: 68rpx;
  max-width: 68rpx;
  margin: 0;
}

.tour-progress73 {
  height: 6rpx;
  background: var(--line);
  margin: 0 30rpx;
  border-radius: 8rpx;
  overflow: hidden;
}
.tour-progress-fill73 {
  height: 100%;
  background: var(--accent);
  border-radius: 8rpx;
}
.tour-card {
  border: 1rpx solid var(--line);
  box-shadow: 0 30rpx 90rpx #0003;
  animation: sheet-in 0.25s ease-out;
}
.tour-copy {
  line-height: 1.85;
}
.tour-actions .u-button {
  border-radius: 24rpx;
}

.chat-input {
  flex-shrink: 0;
}
.chat-sheet {
  min-height: 0;
}
.typing-dots {
  display: flex;
  align-items: center;
  gap: 9rpx;
  width: fit-content;
}
.typing-dots > .typing-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--muted, #748392);
  animation: typing732 1.1s ease-in-out infinite;
}
.typing-dots > .typing-dot:nth-child(2) {
  animation-delay: 0.13s;
}
.typing-dots > .typing-dot:nth-child(3) {
  animation-delay: 0.26s;
}
@keyframes typing732 {
  0%,
  70%,
  100% {
    transform: translateY(0);
    opacity: 0.4;
  }
  35% {
    transform: translateY(-7rpx);
    opacity: 1;
  }
}
.chat-reveal {
  animation: reply732 0.35s ease-out both;
}
@keyframes reply732 {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
.update-copy {
  height: 48vh;
  flex: 1;
  min-height: 0;
}
.update-scroll-hint {
  color: var(--accent, #376b98);
  font-size: 23rpx;
  text-align: center;
  margin-bottom: 20rpx;
}
.update-scroll-hint .update-hint-arrow {
  display: inline-block;
  animation: typing732 1.6s ease-in-out infinite;
}
.reduce-motion .chat-reveal,
.reduce-motion .typing-dots > .typing-dot,
.reduce-motion .update-scroll-hint .update-hint-arrow {
  animation: none;
}

.weather-whisper81 {
  position: fixed;
  right: 24rpx;
  bottom: calc(326rpx + env(safe-area-inset-bottom));
  z-index: 8999;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-sizing: border-box;
  width: 476rpx;
  max-width: calc(100vw - 48rpx);
  padding: 20rpx 58rpx 20rpx 26rpx;
  border: 1rpx solid var(--line, #d8e4ed);
  border-radius: 64rpx;
  background: var(--surface, #fff);
  box-shadow: 0 12rpx 48rpx #193b5514;
  animation: weather-in81 0.2s ease-out;
}
.weather-whisper81::after {
  content: '';
  position: absolute;
  right: 44rpx;
  bottom: -12rpx;
  width: 24rpx;
  height: 24rpx;
  transform: rotate(45deg);
  background: var(--surface, #fff);
  border-right: 1rpx solid var(--line, #d8e4ed);
  border-bottom: 1rpx solid var(--line, #d8e4ed);
}
.weather-close81.u-button {
  position: absolute;
  right: 16rpx;
  top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  min-height: 0;
  padding: 0;
  border-radius: 50%;
  font-size: 32rpx;
}
.weather-symbol81 {
  font-size: 46rpx;
  flex-shrink: 0;
}
.weather-place81 {
  font-weight: 600;
  font-size: 24rpx;
}
.weather-line81 {
  font-size: 22rpx;
  margin: 5rpx 0 0;
}
.chat-dock81 {
  position: relative;
  width: 100%;
  height: 64vh;
  max-height: calc(100vh - 76px);
}
.chat-dock81 > .chat-sheet {
  height: 100%;
  max-height: 100%;
}
.assistant-weather81 {
  position: absolute;
  left: 20rpx;
  bottom: calc(100% + 20rpx);
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: max-content;
  max-width: calc(100vw - 40rpx);
  box-sizing: border-box;
  padding: 18rpx 28rpx;
  border-radius: 64rpx;
  border: 1rpx solid var(--line, #d8e4ed);
  background: var(--surface, #fff);
  box-shadow: 0 10rpx 36rpx #193b5514;
}
.assistant-weather81::after {
  content: '';
  position: absolute;
  right: 52rpx;
  bottom: -8rpx;
  width: 16rpx;
  height: 16rpx;
  transform: rotate(45deg);
  background: var(--surface, #fff);
  border-right: 1rpx solid var(--line, #d8e4ed);
  border-bottom: 1rpx solid var(--line, #d8e4ed);
}
.weather-maintenance81.u-button {
  min-height: 0;
  font-size: 24rpx;
}
@keyframes weather-in81 {
  from {
    opacity: 0;
    transform: translateY(8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
.reduce-motion .weather-whisper81 {
  animation: none;
}

.assistant-weather81 {
  flex-direction: column;
  align-items: center;
  width: 220rpx;
  padding: 20rpx 16rpx;
  text-align: center;
  gap: 10rpx;
}
.assistant-weather81 .weather-line81 {
  max-width: 180rpx;
  line-height: 1.6;
}
.chat-dock81 {
  max-height: calc(100vh - 136px);
}

.assistant-weather81 .weather-current81 {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.3;
}
.assistant-weather81 .weather-range81 {
  font-size: 18rpx;
  white-space: nowrap;
}

.theme-light .chat-sheet {
  background: linear-gradient(140deg, #f3fbff, #e8f1f8 60%, #f5f3f8);
}
.assistant-head81 {
  width: 54rpx;
  height: 54rpx;
  flex-shrink: 0;
}
.sheet-head .assistant-clear81,
.sheet-head .close {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 72rpx;
  min-width: 72rpx;
  width: 72rpx;
  min-height: 72rpx;
  height: 72rpx;
  padding: 0;
  border-radius: 50%;
}
.head-icon81 {
  width: 32rpx;
  height: 32rpx;
}

/* 8.1.1: same compact rhythm as the web client. */
.chat-sheet .sheet-head {
  padding: 4rpx 20rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  gap: 12rpx;
  font-size: 26rpx;
}
.chat-sheet .assistant-head81 {
  width: 50rpx;
  height: 50rpx;
}
.chat-sheet .sheet-head .u-button {
  flex: 0 0 72rpx;
  min-width: 72rpx;
  max-width: 72rpx;
  width: 72rpx;
  height: 72rpx;
  min-height: 72rpx;
}
.chat-input {
  padding: 8rpx 20rpx;
  gap: 12rpx;
}
.chat-input .u-input {
  height: 72rpx;
  min-height: 72rpx;
  padding: 0 20rpx;
  border-radius: 28rpx;
  font-size: 30rpx;
}
.chat-input .u-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  height: 72rpx;
  min-height: 72rpx;
  padding: 0 12rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
}
.chat-sheet .plan-link {
  min-height: 64rpx;
  padding: 10rpx 20rpx;
  margin: 0 20rpx 8rpx;
}
.bubble .u-button {
  margin: 14rpx 0 0;
  padding: 10rpx 18rpx;
  min-height: 64rpx;
  border-radius: 26rpx;
  font-size: 24rpx;
  line-height: 1.5;
  animation: action-in811 250ms cubic-bezier(0.22, 1, 0.36, 1);
}
.chat-keyboard811 .assistant-weather81 {
  display: none;
}
.chat-keyboard811 {
  max-height: none;
}
.chat-keyboard811 .sheet-head {
  padding-top: 0;
  padding-bottom: 0;
}
.chat-keyboard811 .chat-log {
  padding: 16rpx 20rpx;
}
@keyframes action-in811 {
  from {
    opacity: 0;
    transform: translateY(8rpx);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
.reduce-motion .bubble .u-button {
  animation: none;
}

.weather-retry811.u-button {
  flex-shrink: 0;
  min-height: 56rpx;
  padding: 8rpx;
  font-size: 24rpx;
  color: var(--muted);
  background: transparent;
}

.bubble .u-button {
  border: 1rpx solid var(--line, #d8e4ed);
  background: var(--surface, #fff);
}

/* Match web bubbles: each message sizes to content, with a clear left/right gutter. */
.chat-mask811 {
  background: transparent;
  padding: 0;
}
.chat-mask811 .chat-dock81 {
  width: calc(100vw - 24px);
  max-width: 370px;
  margin: 0 12px calc(8px + env(safe-area-inset-bottom)) auto;
}
.chat-mask811 .chat-sheet {
  border-radius: 28px;
  padding-bottom: 0;
  box-sizing: border-box;
  border: 1rpx solid var(--line, #d8e4ed);
  box-shadow: 0 12px 36px #18384d24;
}
.chat-mask811 .chat-keyboard811 {
  margin-bottom: 8px;
}
.chat-flow811 {
  width: 100%;
  padding-bottom: 4rpx;
}
.chat-row811 {
  display: flex;
  width: 100%;
  justify-content: flex-start;
  margin: 0 0 18rpx;
}
.chat-row811.user {
  justify-content: flex-end;
}
.chat-row811 .bubble {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  flex: 0 1 auto;
  width: auto;
  max-width: 90%;
  min-width: 0;
  box-sizing: border-box;
  margin: 0;
  padding: 16rpx 22rpx;
  border-radius: 32rpx 32rpx 32rpx 8rpx;
  background: var(--surface, #ffffffc2);
}
.chat-row811 .bubble.user {
  max-width: 85%;
  border-radius: 32rpx 32rpx 8rpx 32rpx;
  background: var(--selected, #d2e7f5c9);
}
.chat-row811 .bubble .u-text {
  width: auto;
  max-width: 100%;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}
.chat-row811 .bubble .u-button {
  flex: 0 0 auto;
  max-width: 100%;
  align-self: flex-start;
  width: auto;
  min-height: 64rpx;
}
.chat-log .typing-dots {
  width: fit-content;
  max-width: 100rpx;
  margin: 0 0 18rpx;
}
.chat-mask811 .chat-log {
  padding: 20rpx;
}
