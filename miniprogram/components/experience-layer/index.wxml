<view style="{{styles}}" class="u-view experience {{theme}}">
 <button size="mini" wx:if="{{!administrator && supportVisible && !tour && !unreadUpdate && !suspended}}" class="u-button assistant-launch" aria-label="{{open?'收起校园助手':'打开校园助手'}}" bindtap="toggle"><image class="u-image" src="/assets/assistant/{{avatar}}.png"/> </button>
 <view wx:if="{{open}}" class="u-view sheet-mask" bindtap="close"><view class="u-view chat-sheet" catchtap="noop"><view class="u-view sheet-head"><text class="u-text">校园助手</text><button size="mini" bindtap="clear" class="u-button tiny">清空</button><button size="mini" bindtap="close" class="u-button close" aria-label="收起助手">×</button></view><scroll-view scroll-y enhanced class="u-scroll-view sheet-scroll chat-log" scroll-into-view="last-turn"><view wx:if="{{!turns.length}}" class="u-view chat-welcome"><text class="u-text chat-title">想拍点什么？</text><text class="u-text">找地点、看拍法，或者一起安排一条路线。</text><button class="u-button" wx:for="{{caps.presets}}" wx:key="id" data-question="{{item.question||item.title}}" bindtap="preset">{{item.question||item.title}}</button></view><view wx:for="{{turns}}" wx:key="index" class="u-view bubble {{item.role}}"><text class="u-text" selectable>{{item.content}}</text><button class="u-button" wx:for="{{item.links}}" wx:for-item="link" wx:key="path" data-path="{{link.path}}" bindtap="link">{{link.title}} ↗</button></view><view wx:if="{{loading}}" class="u-view muted">正在整理公开资料…</view><view class="u-view" id="last-turn"/></scroll-view><view wx:if="{{error}}" class="u-view error">{{error}}</view><button wx:if="{{furtherVisible}}" class="u-button further" bindtap="further">使用{{caps.modelLabel||'AI'}}进一步回答</button><button wx:if="{{features.exploration.visible!==false}}" class="u-button plan-link" bindtap="plan">安排一次拍摄 ↗</button><view class="u-view chat-input"><input class="u-input" value="{{input}}" bindinput="input" bindconfirm="send" maxlength="300" placeholder-class="field-placeholder" placeholder="输入消息…"/><button class="{{loading||!input ? 'u-disabled' : ''}} u-button" bindtap="send" disabled="{{loading||!input}}">发送</button></view></view></view>
 <view wx:if="{{tour}}" class="u-view tour-mask {{activitySpotlight?'activity-guide':''}}"><view wx:if="{{activitySpotlight}}" class="u-view guide-highlight" style="{{activitySpotlight}}"/><view class="u-view tour-card"><view class="u-view sheet-head"><text class="u-text">{{tourIndex+1}} / {{tourTotal}} · 功能引导</text><button size="mini" class="u-button close" bindtap="closeTour" aria-label="关闭引导">×</button></view><view class="u-view tour-progress73"><view class="u-view tour-progress-fill73" style="width:{{(tourIndex+1)/tourTotal*100}}%"/></view><scroll-view scroll-y class="u-scroll-view tour-copy"><image class="u-image" src="/assets/tools/{{tour[0]}}{{(theme==='theme-dark'||theme==='theme-dark reduce-motion')?'-dark':''}}.png"/><view class="u-view tour-title">{{tour[1]}}</view><text class="u-text">{{tour[2]}}</text></scroll-view><view class="u-view tour-actions"><button class="u-button" bindtap="closeTour">跳过</button><button class="u-button" wx:if="{{tourIndex}}" bindtap="prevTour">上一步</button><button class="u-button primary" bindtap="nextTour">{{tourIndex+1===tourTotal?'开始体验':'下一步'}}</button></view></view></view>
 <view wx:if="{{unreadUpdate}}" class="u-view tour-mask"><view class="u-view tour-card"><view class="u-view sheet-head"><text class="u-text">What's new · {{unreadUpdate.version}}</text><button size="mini" class="u-button close" bindtap="updateClose">×</button></view><view class="u-view tour-progress73"><view class="u-view tour-progress-fill73" style="width:{{(tourIndex+1)/tourTotal*100}}%"/></view><scroll-view scroll-y class="u-scroll-view tour-copy"><view class="u-view tour-title">{{unreadUpdate.title}}</view><text class="u-text">{{unreadUpdate.body}}</text></scroll-view><button class="u-button" bindtap="updateOpen">查看本次更新</button></view></view>
 <view wx:if="{{hint}}" class="u-view reward-island"><image wx:if="{{hint.badge}}" class="u-image {{hint.earned?'':'locked'}}" src="{{hint.badge}}"/><view class="u-view"><text class="u-text">{{hint.title}}</text><text class="u-text">{{hint.text}}</text></view><button class="u-button" aria-label="关闭活动奖励提示" bindtap="closeHint">×</button></view>
 <canvas wx:if="{{confetti}}" id="celebration" type="2d" class="celebration"/>
</view>
