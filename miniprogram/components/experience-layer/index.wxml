<wxs src="/services/i18n.wxs" module="i18n"/>
<view style="{{styles}}" class="u-view experience {{theme}}"><collection-guide id="collection-guide813" account="{{account}}" page="{{page}}" administrator="{{administrator}}" paused="{{suspended || tour || unreadUpdate || open || reward}}"/><message-island id="message-island812" administrator="{{administrator}}" paused="{{suspended || tour || unreadUpdate}}" bind:navigate="close" bind:busy="messageBusy813"/>
<view wx:if="{{weather&&!open&&!tour&&!unreadUpdate&&!suspended}}" class="u-view weather-whisper81"><button class="u-button weather-close81" bindtap="closeWeather" aria-label="{{i18n.ui('关闭天气提醒',locale)}}">×</button><text class="weather-symbol81">{{i18n.content(weather.symbol,locale,localeTranslations,localeOriginal)}}</text><view><view class="weather-place81">{{i18n.content(weather.label,locale,localeTranslations,localeOriginal)}}</view><view class="weather-line81">{{weather.temperature}}° · {{i18n.ui('最高',locale)}} {{weather.high}}° / {{i18n.ui('最低',locale)}} {{weather.low}}°</view></view></view>
 <button size="mini" wx:if="{{!administrator && !open && supportVisible && !tour && !unreadUpdate && !suspended}}" class="u-button assistant-launch" aria-label="{{i18n.ui(open?'收起校园助手':'打开校园助手',locale)}}" bindtap="toggle"><image class="u-image" src="/assets/assistant/{{avatar}}.png"/> </button>
 <view wx:if="{{open}}" class="u-view sheet-mask chat-mask811" style="bottom:{{keyboardHeight}}px;" bindtap="close"><view class="u-view chat-dock81 {{keyboardHeight?'chat-keyboard811':''}}" style="height:{{fittedHeight}}px;max-height:{{fittedHeight}}px;" catchtap="noop"><view wx:if="{{assistantWeather}}" class="assistant-weather81"><text class="weather-symbol81">{{i18n.content(assistantWeather.symbol,locale,localeTranslations,localeOriginal)}}</text><view><view class="weather-place81">{{i18n.content(assistantWeather.label,locale,localeTranslations,localeOriginal)}}</view><view class="weather-line81"><view class="weather-current81">{{i18n.content(assistantWeather.temperature,locale,localeTranslations,localeOriginal)}}°</view><view class="weather-range81">{{i18n.ui('最高',locale)}} {{assistantWeather.high}}° / {{i18n.ui('最低',locale)}} {{assistantWeather.low}}°</view></view></view></view><button wx:if="{{weatherVisible&&!weatherEnabled}}" class="u-button assistant-weather81 weather-maintenance81" bindtap="weatherMaintenance">{{i18n.ui('查看天气',locale)}}</button><view class="u-view chat-sheet" style="{{keyboardHeight ? 'padding-bottom:0;' : ''}}"><view class="u-view sheet-head"><image class="assistant-head81" src="/assets/assistant/{{avatar}}.png"/><text class="u-text">{{i18n.ui('校园助手',locale)}}</text><button size="mini" bindtap="clear" class="u-button tiny assistant-clear81" aria-label="{{i18n.ui('清空本机对话',locale)}}"><image class="head-icon81" src="{{i18n.icon('trash',themeDark || theme==='theme-dark')}}"/></button><button size="mini" bindtap="close" class="u-button close" aria-label="{{i18n.ui('收起助手',locale)}}">×</button></view><button wx:if="{{weatherError && weatherEnabled}}" class="u-button weather-retry811" bindtap="retryWeather">{{i18n.ui('天气暂不可用 · 重试',locale)}}</button><scroll-view scroll-y enhanced class="u-scroll-view sheet-scroll chat-log" scroll-into-view="{{turns.length ? 'last-turn' : ''}}"><view class="u-view chat-flow811"><view wx:if="{{!turns.length}}" class="u-view chat-welcome"><text class="u-text chat-title">{{i18n.ui('想拍点什么？',locale)}}</text><text class="u-text">{{i18n.ui('找地点、看拍法，或者一起安排一条路线。',locale)}}</text><button class="u-button" wx:for="{{caps.presets}}" wx:key="id" data-question="{{item.question||item.title}}" bindtap="preset">{{i18n.content(item.question||item.title,locale,localeTranslations,localeOriginal)}}</button></view><view wx:for="{{turns}}" wx:key="index" class="u-view chat-row811 {{item.role}}"><view class="u-view bubble {{item.role}}"><text wx:if="{{!item.chunks}}" class="u-text" selectable>{{i18n.content(item.content,locale,localeTranslations,localeOriginal)}}</text><text wx:else class="u-text" aria-label="{{i18n.content(item.content,locale,localeTranslations,localeOriginal)}}"><text wx:for="{{item.chunks}}" wx:for-item="chunk" wx:key="index" class="chat-reveal" style="animation-delay:{{chunk.delay}}ms">{{i18n.content(chunk.text,locale,localeTranslations,localeOriginal)}}</text></text><view wx:if="{{item.planActive && !item.chunks && planPreview}}" class="chat-plan820"><text class="chat-plan-title820">{{i18n.content(planPreview.plan.title,locale,localeTranslations,localeOriginal)}}</text><view wx:for="{{planPreview.plan.items}}" wx:for-item="stop" wx:for-index="stopIndex" wx:key="id" class="chat-plan-stop820"><button class="u-button" data-path="#spot/{{stop.spotId}}" data-title="{{i18n.content(stop.title,locale,localeTranslations,localeOriginal)}}" bindtap="link">{{stopIndex+1}}. {{i18n.content(stop.title,locale,localeTranslations,localeOriginal)}} ↗</button><text class="chat-plan-stop-minutes820">{{i18n.ui('拍摄约',locale)}} {{stop.minutes}} {{i18n.ui('分钟',locale)}}</text></view><text class="chat-plan-basis820">{{i18n.content(planPreview.basis,locale,localeTranslations,localeOriginal)}}</text><text class="chat-plan-basis820">{{i18n.content(planPreview.notice,locale,localeTranslations,localeOriginal)}}</text><view class="chat-plan-actions820"><button class="u-button" data-question="第二站太远" bindtap="planFollow">{{i18n.ui('第二站太远',locale)}}</button><button class="u-button" data-question="换个安静点的" bindtap="planFollow">{{i18n.ui('换个安静点的',locale)}}</button><button class="u-button" data-question="从我收藏里挑" bindtap="planFollow">{{i18n.ui('从我收藏里挑',locale)}}</button></view><button wx:if="{{planPreview.canSave}}" class="u-button chat-plan-save820" loading="{{planSaving}}" disabled="{{planSaving||loading}}" bindtap="savePlan">{{i18n.ui(savedPlan ? (planDirty?'保存本次调整':'已保存 · 再次保存') : '保存到拍摄清单',locale)}}</button><button wx:if="{{savedPlan}}" class="u-button" data-path="#plans" data-title="{{i18n.ui('拍摄清单',locale)}}" bindtap="link">{{i18n.ui('查看清单 · 导航下一站',locale)}} ↗</button></view><button class="u-button" wx:if="{{!item.chunks}}" wx:for="{{item.links}}" wx:for-item="link" wx:key="path" data-path="{{link.path}}" data-title="{{i18n.content(link.title,locale,localeTranslations,localeOriginal)}}" bindtap="link">{{i18n.content(link.label||link.title,locale,localeTranslations,localeOriginal)}} ↗</button></view></view><view wx:if="{{loading && (!turns.length || turns[turns.length-1].role==='user')}}" class="u-view bubble typing-dots" role="status" aria-label="{{i18n.ui('校园助手正在回复',locale)}}"><view class="typing-dot"/><view class="typing-dot"/><view class="typing-dot"/></view><view class="u-view" id="last-turn"/></view></scroll-view><view wx:if="{{error}}" class="u-view error">{{i18n.content(error,locale,localeTranslations,localeOriginal)}}</view><button wx:if="{{furtherVisible && !keyboardHeight && !loading}}" class="u-button further" bindtap="further">{{i18n.ui('使用',locale)}}{{i18n.content(caps.modelLabel||'AI',locale,localeTranslations,localeOriginal)}}{{i18n.ui('进一步回答',locale)}}</button><button wx:if="{{!keyboardHeight && features.exploration.visible!==false}}" class="u-button plan-link" bindtap="plan">{{i18n.ui('安排一次拍摄 ↗',locale)}}</button><view class="u-view chat-input"><input class="u-input" value="{{input}}" bindinput="input" bindconfirm="send" confirm-type="send" adjust-position="{{false}}" hold-keyboard="{{true}}" bindkeyboardheightchange="keyboard" maxlength="300" placeholder-class="field-placeholder" placeholder="{{i18n.ui('输入消息…',locale)}}"/><button class="{{loading||!input ? 'u-disabled' : ''}} u-button" bindtap="send" disabled="{{loading||!input}}">{{i18n.ui('发送',locale)}}</button></view></view></view></view>
 <view wx:if="{{tour}}" class="u-view tour-mask {{activitySpotlight?'activity-guide':''}}"><view wx:if="{{activitySpotlight}}" class="u-view guide-highlight" style="{{activitySpotlight}}"/><view class="u-view tour-card" style="{{guideCardStyle}}"><view class="u-view sheet-head"><text class="u-text">{{i18n.content(tourIndex+1,locale,localeTranslations,localeOriginal)}} / {{i18n.content(tourTotal,locale,localeTranslations,localeOriginal)}} {{i18n.ui('· 功能引导',locale)}}</text><button size="mini" class="u-button close" bindtap="closeTour" aria-label="{{i18n.ui('关闭引导',locale)}}">×</button></view><view class="u-view tour-progress73"><view class="u-view tour-progress-fill73" style="width:{{(tourIndex+1)/tourTotal*100}}%"/></view><scroll-view scroll-y class="u-scroll-view tour-copy"><image class="u-image" src="{{i18n.icon(tour[0],themeDark || theme==='theme-dark')}}"/><view class="u-view tour-title">{{i18n.content(tour[1],locale,localeTranslations,localeOriginal)}}</view><text class="u-text">{{i18n.content(tour[2],locale,localeTranslations,localeOriginal)}}</text></scroll-view><view class="u-view tour-actions"><button class="u-button" bindtap="closeTour">{{i18n.ui('跳过',locale)}}</button><button class="u-button" wx:if="{{tourIndex}}" bindtap="prevTour">{{i18n.ui('上一步',locale)}}</button><button class="u-button primary" bindtap="nextTour">{{i18n.ui(tourIndex+1===tourTotal?'开始体验':'下一步',locale)}}</button></view></view></view>
 <view wx:if="{{unreadUpdate}}" class="u-view tour-mask"><view class="u-view tour-card"><view class="u-view sheet-head"><text class="u-text">What's new · {{i18n.content(unreadUpdate.version,locale,localeTranslations,localeOriginal)}}</text><button size="mini" class="u-button close" bindtap="updateClose">×</button></view><view class="u-view tour-progress73"><view class="u-view tour-progress-fill73" style="width:{{(tourIndex+1)/tourTotal*100}}%"/></view><scroll-view scroll-y enhanced class="u-scroll-view tour-copy update-copy" bindscroll="updateScroll"><view wx:if="{{!updateAtEnd}}" class="update-scroll-hint">{{i18n.ui('向下滑动，查看更多',locale)}} <text class="update-hint-arrow">⌄</text></view><view class="u-view tour-title">{{i18n.content(unreadUpdate.title,'zh-CN',localeTranslations,true)}}</view><text class="u-text">{{i18n.content(unreadUpdate.body,'zh-CN',localeTranslations,true)}}</text></scroll-view><button class="u-button" bindtap="updateOpen">{{i18n.ui('查看本次更新',locale)}}</button></view></view>
 <view wx:if="{{hint}}" class="u-view reward-island"><image wx:if="{{hint.badge}}" class="u-image {{hint.earned?'':'locked'}}" src="{{hint.badge}}"/><view class="u-view"><text class="u-text">{{i18n.content(hint.title,locale,localeTranslations,localeOriginal)}}</text><text class="u-text">{{i18n.content(hint.text,locale,localeTranslations,localeOriginal)}}</text></view><button class="u-button" aria-label="{{i18n.ui('关闭活动奖励提示',locale)}}" bindtap="closeHint">×</button></view>
 <canvas wx:if="{{confetti}}" id="celebration" type="2d" class="celebration"/>
</view>
