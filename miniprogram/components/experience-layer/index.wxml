<wxs src="/services/i18n.wxs" module="i18n"/>
<view style="{{styles}}" class="u-view experience {{theme}}">
 <button size="mini" wx:if="{{!administrator && supportVisible && !tour && !unreadUpdate && !suspended}}" class="u-button assistant-launch" aria-label="{{i18n.ui(open?'收起校园助手':'打开校园助手',locale)}}" bindtap="toggle"><image class="u-image" src="/assets/assistant/{{avatar}}.png"/> </button>
 <view wx:if="{{open}}" class="u-view sheet-mask" style="bottom:{{keyboardHeight}}px;" bindtap="close"><view class="u-view chat-sheet" style="{{keyboardHeight ? 'height:'+chatHeight+'px;max-height:'+chatHeight+'px;padding-bottom:0;' : ''}}" catchtap="noop"><view class="u-view sheet-head"><text class="u-text">{{i18n.ui('校园助手',locale)}}</text><button size="mini" bindtap="clear" class="u-button tiny">{{i18n.ui('清空',locale)}}</button><button size="mini" bindtap="close" class="u-button close" aria-label="{{i18n.ui('收起助手',locale)}}">×</button></view><scroll-view scroll-y enhanced class="u-scroll-view sheet-scroll chat-log" scroll-into-view="last-turn"><view wx:if="{{!turns.length}}" class="u-view chat-welcome"><text class="u-text chat-title">{{i18n.ui('想拍点什么？',locale)}}</text><text class="u-text">{{i18n.ui('找地点、看拍法，或者一起安排一条路线。',locale)}}</text><button class="u-button" wx:for="{{caps.presets}}" wx:key="id" data-question="{{item.question||item.title}}" bindtap="preset">{{i18n.content(item.question||item.title,locale,localeTranslations,localeOriginal)}}</button></view><view wx:for="{{turns}}" wx:key="index" class="u-view bubble {{item.role}}"><text wx:if="{{!item.chunks}}" class="u-text" selectable>{{i18n.content(item.content,locale,localeTranslations,localeOriginal)}}</text><text wx:else class="u-text" aria-label="{{i18n.content(item.content,locale,localeTranslations,localeOriginal)}}"><text wx:for="{{item.chunks}}" wx:for-item="chunk" wx:key="index" class="chat-reveal" style="animation-delay:{{chunk.delay}}ms">{{i18n.content(chunk.text,locale,localeTranslations,localeOriginal)}}</text></text><button class="u-button" wx:for="{{item.links}}" wx:for-item="link" wx:key="path" data-path="{{link.path}}" bindtap="link">{{i18n.content(link.title,locale,localeTranslations,localeOriginal)}} ↗</button></view><view wx:if="{{loading && (!turns.length || turns[turns.length-1].role==='user')}}" class="u-view bubble typing-dots" role="status" aria-label="{{i18n.ui('校园助手正在回复',locale)}}"><view class="typing-dot"/><view class="typing-dot"/><view class="typing-dot"/></view><view class="u-view" id="last-turn"/></scroll-view><view wx:if="{{error}}" class="u-view error">{{i18n.content(error,locale,localeTranslations,localeOriginal)}}</view><button wx:if="{{furtherVisible && !keyboardHeight && !loading}}" class="u-button further" bindtap="further">{{i18n.ui('使用',locale)}}{{i18n.content(caps.modelLabel||'AI',locale,localeTranslations,localeOriginal)}}{{i18n.ui('进一步回答',locale)}}</button><button wx:if="{{!keyboardHeight && features.exploration.visible!==false}}" class="u-button plan-link" bindtap="plan">{{i18n.ui('安排一次拍摄 ↗',locale)}}</button><view class="u-view chat-input"><input class="u-input" value="{{input}}" bindinput="input" bindconfirm="send" confirm-type="send" adjust-position="{{false}}" hold-keyboard="{{true}}" bindkeyboardheightchange="keyboard" maxlength="300" placeholder-class="field-placeholder" placeholder="{{i18n.ui('输入消息…',locale)}}"/><button class="{{loading||!input ? 'u-disabled' : ''}} u-button" bindtap="send" disabled="{{loading||!input}}">{{i18n.ui('发送',locale)}}</button></view></view></view>
 <view wx:if="{{tour}}" class="u-view tour-mask {{activitySpotlight?'activity-guide':''}}"><view wx:if="{{activitySpotlight}}" class="u-view guide-highlight" style="{{activitySpotlight}}"/><view class="u-view tour-card"><view class="u-view sheet-head"><text class="u-text">{{i18n.content(tourIndex+1,locale,localeTranslations,localeOriginal)}} / {{i18n.content(tourTotal,locale,localeTranslations,localeOriginal)}} {{i18n.ui('· 功能引导',locale)}}</text><button size="mini" class="u-button close" bindtap="closeTour" aria-label="{{i18n.ui('关闭引导',locale)}}">×</button></view><view class="u-view tour-progress73"><view class="u-view tour-progress-fill73" style="width:{{(tourIndex+1)/tourTotal*100}}%"/></view><scroll-view scroll-y class="u-scroll-view tour-copy"><image class="u-image" src="/assets/tools/{{tour[0]}}{{(theme==='theme-dark'||theme==='theme-dark reduce-motion')?'-dark':''}}.png"/><view class="u-view tour-title">{{i18n.content(tour[1],locale,localeTranslations,localeOriginal)}}</view><text class="u-text">{{i18n.content(tour[2],locale,localeTranslations,localeOriginal)}}</text></scroll-view><view class="u-view tour-actions"><button class="u-button" bindtap="closeTour">{{i18n.ui('跳过',locale)}}</button><button class="u-button" wx:if="{{tourIndex}}" bindtap="prevTour">{{i18n.ui('上一步',locale)}}</button><button class="u-button primary" bindtap="nextTour">{{i18n.ui(tourIndex+1===tourTotal?'开始体验':'下一步',locale)}}</button></view></view></view>
 <view wx:if="{{unreadUpdate}}" class="u-view tour-mask"><view class="u-view tour-card"><view class="u-view sheet-head"><text class="u-text">What's new · {{i18n.content(unreadUpdate.version,locale,localeTranslations,localeOriginal)}}</text><button size="mini" class="u-button close" bindtap="updateClose">×</button></view><view class="u-view tour-progress73"><view class="u-view tour-progress-fill73" style="width:{{(tourIndex+1)/tourTotal*100}}%"/></view><scroll-view scroll-y enhanced class="u-scroll-view tour-copy update-copy" bindscroll="updateScroll"><view wx:if="{{!updateAtEnd}}" class="update-scroll-hint">{{i18n.ui('向下滑动，查看更多',locale)}} <text class="update-hint-arrow">⌄</text></view><view class="u-view tour-title">{{i18n.content(unreadUpdate.title,locale,localeTranslations,localeOriginal)}}</view><text class="u-text">{{i18n.content(unreadUpdate.body,locale,localeTranslations,localeOriginal)}}</text></scroll-view><button class="u-button" bindtap="updateOpen">{{i18n.ui('查看本次更新',locale)}}</button></view></view>
 <view wx:if="{{hint}}" class="u-view reward-island"><image wx:if="{{hint.badge}}" class="u-image {{hint.earned?'':'locked'}}" src="{{hint.badge}}"/><view class="u-view"><text class="u-text">{{i18n.content(hint.title,locale,localeTranslations,localeOriginal)}}</text><text class="u-text">{{i18n.content(hint.text,locale,localeTranslations,localeOriginal)}}</text></view><button class="u-button" aria-label="{{i18n.ui('关闭活动奖励提示',locale)}}" bindtap="closeHint">×</button></view>
 <canvas wx:if="{{confetti}}" id="celebration" type="2d" class="celebration"/>
</view>
