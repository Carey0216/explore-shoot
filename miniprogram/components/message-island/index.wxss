.message-island {
  position: fixed;
  z-index: 12000;
  top: calc(var(--jy-rpx, 1rpx) * 18);
  left: calc(var(--jy-rpx, 1rpx) * 24);
  right: calc(var(--jy-rpx, 1rpx) * 24);
  max-width: calc(var(--jy-rpx, 1rpx) * 720);
  margin: 0 auto;
  display: flex;
  align-items: center;
  padding: calc(var(--jy-rpx, 1rpx) * 18) calc(var(--jy-rpx, 1rpx) * 16)
    calc(var(--jy-rpx, 1rpx) * 18) calc(var(--jy-rpx, 1rpx) * 22);
  box-sizing: border-box;
  border: calc(var(--jy-rpx, 1rpx) * 1) solid var(--line, #d5e0e7);
  border-radius: calc(var(--jy-rpx, 1rpx) * 54);
  background: var(--surface, #fff);
  color: var(--text, #273d50);
  box-shadow: 0 calc(var(--jy-rpx, 1rpx) * 14) calc(var(--jy-rpx, 1rpx) * 50) #162c4326;
  animation: message-arrive812 260ms cubic-bezier(0.22, 1, 0.36, 1) both;
}
.message-main {
  display: flex;
  align-items: center;
  gap: calc(var(--jy-rpx, 1rpx) * 18);
  min-width: 0;
  flex: 1;
}
.message-icon {
  width: calc(var(--jy-rpx, 1rpx) * 48);
  height: calc(var(--jy-rpx, 1rpx) * 48);
  flex: none;
}
.message-copy {
  min-width: 0;
  flex: 1;
}
.message-title {
  display: block;
  font-size: calc(var(--jy-rpx, 1rpx) * 25);
  font-weight: 600;
  line-height: 1.4;
}
.message-preview {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  word-break: break-all;
  margin-top: calc(var(--jy-rpx, 1rpx) * 4);
  font-size: calc(var(--jy-rpx, 1rpx) * 24);
  line-height: 1.45;
  color: var(--muted, #637887);
}
.message-action {
  display: block;
  margin-top: calc(var(--jy-rpx, 1rpx) * 4);
  color: var(--accent, #346b9c);
  font-size: calc(var(--jy-rpx, 1rpx) * 21);
  line-height: 1.3;
}
.message-close {
  flex: 0 0 calc(var(--jy-rpx, 1rpx) * 60);
  min-width: calc(var(--jy-rpx, 1rpx) * 60);
  max-width: calc(var(--jy-rpx, 1rpx) * 60);
  min-height: calc(var(--jy-rpx, 1rpx) * 60);
  max-height: calc(var(--jy-rpx, 1rpx) * 60);
  box-sizing: border-box;
  line-height: 1;
  box-shadow: none;
  display: flex;
  align-items: center;
  justify-content: center;
  align-self: flex-start;
  width: calc(var(--jy-rpx, 1rpx) * 60);
  height: calc(var(--jy-rpx, 1rpx) * 60);
  margin: 0 0 0 calc(var(--jy-rpx, 1rpx) * 8);
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: transparent;
}
.message-close::after {
  border: 0;
}
.close-icon {
  width: calc(var(--jy-rpx, 1rpx) * 32);
  height: calc(var(--jy-rpx, 1rpx) * 32);
}
@keyframes message-arrive812 {
  from {
    opacity: 0;
    transform: translateY(calc(var(--jy-rpx, 1rpx) * -12)) scale(0.97);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
