.editor-page {
  padding-bottom: calc(var(--jy-rpx, 1rpx) * 60);
}
.canvas-wrap {
  margin-top: calc(var(--jy-rpx, 1rpx) * 28);
  border-radius: calc(var(--jy-rpx, 1rpx) * 28);
  overflow: hidden;
  background: #151b20;
  border: 1px solid var(--line);
}
.edit-canvas {
  width: 100%;
  height: calc(var(--jy-rpx, 1rpx) * 660);
}
.edit-status {
  font-size: calc(var(--jy-rpx, 1rpx) * 26);
  color: var(--muted);
  padding: calc(var(--jy-rpx, 1rpx) * 20) 0;
}
.editor-tools {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: calc(var(--jy-rpx, 1rpx) * 12);
}
.editor-tools button {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
  white-space: normal;
  font-size: calc(var(--jy-rpx, 1rpx) * 26);
  line-height: 1.4;
  padding: calc(var(--jy-rpx, 1rpx) * 22) calc(var(--jy-rpx, 1rpx) * 8);
  min-height: calc(var(--jy-rpx, 1rpx) * 80);
  margin: 0;
}
.editor-tools .selected {
  background: var(--selected);
  color: var(--accent);
  border-color: var(--accent);
}
