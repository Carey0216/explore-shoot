<wxs src="/services/i18n.wxs" module="i18n"/>
<page-meta page-style="{{pageStyle}}"/>
<view class="native-surface {{locale==='en-US'?'locale-en':''}} {{themeClass}}" style="{{themeStyle}}"><view class="page editor-page"><view class="title">{{i18n.ui(name || '楼宇轮廓',locale)}}</view><view class="muted gap">{{i18n.content(frameName,locale,localeTranslations,localeOriginal)}} {{i18n.ui('· 保存后网页与小程序同步',locale)}}</view><state-view loading="{{loading}}" error="{{error}}" bind:retry="load"/>
<view class="canvas-wrap"><canvas id="editor-canvas" type="2d" class="edit-canvas" bindtouchstart="start" catchtouchmove="move" bindtouchend="end" bindtouchcancel="cancel"/></view>
<view class="edit-status">{{i18n.ui(mode==='draw'?'依次点击边缘圈画':'拖动底图或拖动顶点调整',locale)}} · {{i18n.content(vertices,locale,localeTranslations,localeOriginal)}} {{i18n.ui('个顶点',locale)}}</view>
<view class="editor-tools"><button data-action="pan" class="{{mode==='pan'?'selected':''}}" bindtap="command">{{i18n.ui('拖动底图',locale)}}</button><button data-action="draw" class="{{mode==='draw'?'selected':''}}" bindtap="command">{{i18n.ui('添加顶点',locale)}}</button><button data-action="in" bindtap="command">{{i18n.ui('放大 ＋',locale)}}</button><button data-action="out" bindtap="command">{{i18n.ui('缩小 −',locale)}}</button><button data-action="redraw" bindtap="command">{{i18n.ui('重画外轮廓',locale)}}</button><button data-action="hole" bindtap="command">{{i18n.ui('新增内院',locale)}}</button><button data-action="undo" bindtap="command">{{i18n.ui('撤销',locale)}}</button><button data-action="reset" bindtap="command">{{i18n.ui('还原本次修改',locale)}}</button><button data-action="focus" bindtap="command">{{i18n.ui('定位楼宇',locale)}}</button></view>
<view class="privacy">{{i18n.ui('至少圈出三个顶点。内院必须位于楼宇轮廓内，边线不能交叉。保存前服务器自动备份；不改变导航坐标。',locale)}}</view><button class="primary gap" bindtap="save" loading="{{busy}}" disabled="{{loading||busy||!changed}}">{{i18n.ui('备份并保存轮廓',locale)}}</button></view></view>
