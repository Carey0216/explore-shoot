<page-meta page-style="{{pageStyle}}"/>
<view class="native-surface {{themeClass}}" style="{{themeStyle}}"><view class="page editor-page"><view class="title">{{name || '楼宇轮廓'}}</view><view class="muted gap">{{frameName}} · 保存后网页与小程序同步</view><state-view loading="{{loading}}" error="{{error}}" bind:retry="load"/>
<view class="canvas-wrap"><canvas id="editor-canvas" type="2d" class="edit-canvas" bindtouchstart="start" catchtouchmove="move" bindtouchend="end" bindtouchcancel="cancel"/></view>
<view class="edit-status">{{mode==='draw'?'依次点击边缘圈画':'拖动底图或拖动顶点调整'}} · {{vertices}} 个顶点</view>
<view class="editor-tools"><button data-action="pan" class="{{mode==='pan'?'selected':''}}" bindtap="command">拖动底图</button><button data-action="draw" class="{{mode==='draw'?'selected':''}}" bindtap="command">添加顶点</button><button data-action="in" bindtap="command">放大 ＋</button><button data-action="out" bindtap="command">缩小 −</button><button data-action="redraw" bindtap="command">重画外轮廓</button><button data-action="hole" bindtap="command">新增内院</button><button data-action="undo" bindtap="command">撤销</button><button data-action="reset" bindtap="command">还原本次修改</button><button data-action="focus" bindtap="command">定位楼宇</button></view>
<view class="privacy">至少圈出三个顶点。内院必须位于楼宇轮廓内，边线不能交叉。保存前服务器自动备份；不改变导航坐标。</view><button class="primary gap" bindtap="save" loading="{{busy}}" disabled="{{loading||busy||!changed}}">备份并保存轮廓</button></view></view>
