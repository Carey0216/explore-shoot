.scene-page {
  padding: calc(var(--jy-rpx, 1rpx) * 26) calc(var(--jy-rpx, 1rpx) * 24)
    calc(var(--jy-rpx, 1rpx) * 60);
}
.scene-canvas {
  width: 100%;
  height: 58vh;
  border-radius: calc(var(--jy-rpx, 1rpx) * 30);
  overflow: hidden;
  margin: calc(var(--jy-rpx, 1rpx) * 24) 0;
  background: var(--raised);
}
.controls {
  gap: calc(var(--jy-rpx, 1rpx) * 12);
  margin: calc(var(--jy-rpx, 1rpx) * 20) 0;
}
.controls button {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 24) * var(--font-scale, 1));
  min-height: calc(var(--jy-rpx, 1rpx) * 75);
  padding: calc(var(--jy-rpx, 1rpx) * 18);
}
.picker {
  padding: calc(var(--jy-rpx, 1rpx) * 18);
  border-radius: calc(var(--jy-rpx, 1rpx) * 20);
}
.muted {
  margin-top: calc(var(--jy-rpx, 1rpx) * 20);
  line-height: 1.8;
}
.controls button {
  width: auto;
  min-width: calc(var(--jy-rpx, 1rpx) * 70);
  flex: 0 0 auto;
  margin: 0;
}
.controls {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}
.scene-page .row {
  display: flex;
  align-items: center;
  gap: calc(var(--jy-rpx, 1rpx) * 16);
}

.placement-map {
  width: 100%;
  height: calc(var(--jy-rpx, 1rpx) * 320);
  border-radius: calc(var(--jy-rpx, 1rpx) * 26);
  margin: calc(var(--jy-rpx, 1rpx) * 20) 0;
}

.campus-time-row {
  display: flex;
  align-items: center;
  gap: calc(var(--jy-rpx, 1rpx) * 12);
  flex-wrap: wrap;
  margin-top: calc(var(--jy-rpx, 1rpx) * 20);
  color: var(--muted);
  font-size: calc(var(--jy-rpx, 1rpx) * 24);
}
.time-icon {
  width: calc(var(--jy-rpx, 1rpx) * 36);
  height: calc(var(--jy-rpx, 1rpx) * 36);
}
.campus-time-row .picker {
  background: var(--raised);
  color: var(--text);
  border-radius: calc(var(--jy-rpx, 1rpx) * 40);
  padding: calc(var(--jy-rpx, 1rpx) * 14) calc(var(--jy-rpx, 1rpx) * 24);
}
