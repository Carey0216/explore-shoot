.scene-page {
  padding: 26rpx 24rpx 60rpx;
}
.scene-canvas {
  width: 100%;
  height: 58vh;
  border-radius: 30rpx;
  overflow: hidden;
  margin: 24rpx 0;
  background: var(--raised);
}
.controls {
  gap: 12rpx;
  margin: 20rpx 0;
}
.controls button {
  font-size: calc(24rpx * var(--font-scale, 1));
  min-height: 75rpx;
  padding: 18rpx;
}
.picker {
  padding: 18rpx;
  border-radius: 20rpx;
}
.muted {
  margin-top: 20rpx;
  line-height: 1.8;
}
.controls button {
  width: auto;
  min-width: 70rpx;
  flex: 0 0 auto;
  margin: 0;
}
.controls {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}
.scene-page .row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.placement-map {
  width: 100%;
  height: 320rpx;
  border-radius: 26rpx;
  margin: 20rpx 0;
}

.campus-time-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-top: 20rpx;
  color: var(--muted);
  font-size: 24rpx;
}
.time-icon {
  width: 36rpx;
  height: 36rpx;
}
.campus-time-row .picker {
  background: var(--raised);
  color: var(--text);
  border-radius: 40rpx;
  padding: 14rpx 24rpx;
}
