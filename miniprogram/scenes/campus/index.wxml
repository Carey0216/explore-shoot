<wxs src="/services/i18n.wxs" module="i18n"/>
<page-meta page-style="{{pageStyle}} {{nativeOverlayOpen?'overflow:hidden;':''}}"/><view class="native-surface {{locale==='en-US'?'locale-en':''}} {{themeClass}}" style="{{themeStyle}}"><view class="scene-page"><view class="title">{{i18n.content(sceneTitle,locale,localeTranslations,localeOriginal)}}</view><view wx:if="{{mode!=='panorama'&&mode!=='placement'}}" class="row gap"><picker range="{{i18n.options(['全校','东校区','西校区'],locale)}}" bindchange="zone"><view class="picker">{{i18n.ui(zone==='east'?'东校区':zone==='west'?'西校区':'全校',locale)}} ⌄</view></picker><picker range="{{i18n.options(models,locale)}}" range-key="name" value="{{selected}}" bindchange="pick"><view class="picker">{{i18n.ui(models[selected].name||'校园总览',locale)}} ⌄</view></picker></view><view wx:if="{{features['campus-time'].visible!==false}}" class="campus-time-row"><image class="time-icon" src="/assets/tools/clock{{themeDark?'-dark':''}}.png"/><view wx:if="{{features['campus-time'].enabled===false}}" class="picker" data-feature="campus-time" bindtap="featureTap">{{i18n.ui('校园时段 ⌄',locale)}}</view><picker wx:else range="{{i18n.options(['跟随设备时间','白天','傍晚'],locale)}}" value="{{preferences.campusTime==='evening'?2:preferences.campusTime==='day'?1:0}}" bindchange="campusTime"><view class="picker">{{i18n.ui(preferences.campusTime==='auto'?'跟随时间':preferences.campusTime==='evening'?'傍晚':'白天',locale)}} ⌄</view></picker><text>{{i18n.ui('当前 ·',locale)}} {{i18n.ui(campusPeriod==='evening'?'傍晚':'白天',locale)}}</text></view><canvas wx:if="{{canvasVisible}}" id="campus-scene" type="webgl" class="scene-canvas" bindtouchstart="touchStart" catchtouchmove="touchMove"/><map wx:if="{{placement}}" class="placement-map" longitude="{{placement.longitude}}" latitude="{{placement.latitude}}" markers="{{placementMarkers}}" scale="18"/><view wx:if="{{placement}}" class="muted">{{i18n.ui('经纬度为WGS84：',locale)}}{{i18n.content(placement.lng,locale,localeTranslations,localeOriginal)}}, {{i18n.content(placement.lat,locale,localeTranslations,localeOriginal)}} {{i18n.ui('· 朝向',locale)}} {{i18n.content(placement.heading,locale,localeTranslations,localeOriginal)}}{{i18n.ui('° · 比例',locale)}} {{i18n.content(placement.scale,locale,localeTranslations,localeOriginal)}} {{i18n.ui('· 高度偏移',locale)}} {{i18n.content(placement.altitude,locale,localeTranslations,localeOriginal)}}m</view><state-view error="{{error}}" loading="{{loading}}" bind:retry="load"/><view class="row wrap controls"><button size="mini" data-value="-35" bindtap="turn">↶</button><button size="mini" data-value="35" bindtap="turn">↷</button><button size="mini" data-value="0.8" bindtap="zoom">＋</button><button size="mini" data-value="1.25" bindtap="zoom">−</button><button size="mini" wx:if="{{mode!=='panorama'&&mode!=='placement'}}" bindtap="flat">{{i18n.ui('平面 / 立体',locale)}}</button><button size="mini" wx:if="{{mode!=='panorama'&&mode!=='placement'}}" bindtap="texture">{{i18n.ui(textured?'隐藏材质':'显示材质',locale)}}</button><button size="mini" bindtap="save">{{i18n.ui('保存视图',locale)}}</button></view><view class="muted">{{i18n.content(status,locale,localeTranslations,localeOriginal)}}</view><view class="muted">{{i18n.ui('拖动旋转 · 双指缩放。照片和模型来源沿用现有校园资料；未测量的部分保留估算标注。',locale)}}</view></view><experience-layer administrator="{{administrator}}" features="{{features}}" id="experience" page="map" account="{{nativeAccount}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/></view>