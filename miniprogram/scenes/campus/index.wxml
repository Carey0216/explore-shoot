<page-meta page-style="{{pageStyle}} {{nativeOverlayOpen?'overflow:hidden;':''}}"/><view class="native-surface {{themeClass}}" style="{{themeStyle}}"><view class="scene-page"><view class="title">{{sceneTitle}}</view><view wx:if="{{mode!=='panorama'&&mode!=='placement'}}" class="row gap"><picker range="{{['全校','东校区','西校区']}}" bindchange="zone"><view class="picker">{{zone==='east'?'东校区':zone==='west'?'西校区':'全校'}} ⌄</view></picker><picker range="{{models}}" range-key="name" value="{{selected}}" bindchange="pick"><view class="picker">{{models[selected].name||'校园总览'}} ⌄</view></picker></view><view wx:if="{{features['campus-time'].visible!==false}}" class="campus-time-row"><image class="time-icon" src="/assets/tools/clock{{themeDark?'-dark':''}}.png"/><view wx:if="{{features['campus-time'].enabled===false}}" class="picker" data-feature="campus-time" bindtap="featureTap">校园时段 ⌄</view><picker wx:else range="{{['跟随设备时间','白天','傍晚']}}" value="{{preferences.campusTime==='evening'?2:preferences.campusTime==='day'?1:0}}" bindchange="campusTime"><view class="picker">{{preferences.campusTime==='auto'?'跟随时间':preferences.campusTime==='evening'?'傍晚':'白天'}} ⌄</view></picker><text>当前 · {{campusPeriod==='evening'?'傍晚':'白天'}}</text></view><canvas wx:if="{{canvasVisible}}" id="campus-scene" type="webgl" class="scene-canvas" bindtouchstart="touchStart" catchtouchmove="touchMove"/><map wx:if="{{placement}}" class="placement-map" longitude="{{placement.longitude}}" latitude="{{placement.latitude}}" markers="{{placementMarkers}}" scale="18"/><view wx:if="{{placement}}" class="muted">经纬度为WGS84：{{placement.lng}}, {{placement.lat}} · 朝向 {{placement.heading}}° · 比例 {{placement.scale}} · 高度偏移 {{placement.altitude}}m</view><state-view error="{{error}}" loading="{{loading}}" bind:retry="load"/><view class="row wrap controls"><button size="mini" data-value="-35" bindtap="turn">↶</button><button size="mini" data-value="35" bindtap="turn">↷</button><button size="mini" data-value="0.8" bindtap="zoom">＋</button><button size="mini" data-value="1.25" bindtap="zoom">−</button><button size="mini" wx:if="{{mode!=='panorama'&&mode!=='placement'}}" bindtap="flat">平面 / 立体</button><button size="mini" wx:if="{{mode!=='panorama'&&mode!=='placement'}}" bindtap="texture">{{textured?'隐藏材质':'显示材质'}}</button><button size="mini" bindtap="save">保存视图</button></view><view class="muted">{{status}}</view><view class="muted">拖动旋转 · 双指缩放。照片和模型来源沿用现有校园资料；未测量的部分保留估算标注。</view></view><experience-layer administrator="{{administrator}}" features="{{features}}" id="experience" page="map" account="{{nativeAccount}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/></view>