function ui(value,locale){if(typeof value!=='string'||locale!=='en-US')return value;var key=value.trim();return dictionary[key] ? value.replace(key,dictionary[key]):value;}
function content(value,locale,cache,original){if(original||typeof value!=='string')return value;return cache&&cache[value] ? cache[value]:ui(value,locale);}
function options(items,locale){if(!items)return items;var result=[];for(var i=0;i<items.length;i++){var item=items[i];if(typeof item==='string')result.push(ui(item,locale));else{result.push({id:item.id,value:item.value,key:item.key,label:ui(item.label,locale),name:ui(item.name,locale),title:ui(item.title,locale),checked:item.checked});}}return result;}
var iconPath=require("./icon-path.wxs");
module.exports={ui:ui,content:content,options:options,icon:iconPath.path};
