@import "styles/content73.wxss";
page {
  background-color: #f1f6f2;
  background-image:
    radial-gradient(ellipse at 8% 5%, rgba(204, 230, 227, 0.72), transparent 58%),
    radial-gradient(ellipse at 100% 44%, rgba(225, 233, 248, 0.68), transparent 60%),
    linear-gradient(160deg, #f7f8f2, #edf5f1 60%, #f9f3e9);
  background-attachment: fixed;
  color: #233d35;
  font-family: -apple-system, sans-serif;
  font-size: calc(28rpx * var(--font-scale, 1));
}
view,
text,
label,
input,
textarea,
button {
  box-sizing: border-box;
}
button {
  margin: 0;
  padding: 0 28rpx;
  border-radius: 24rpx;
  font-size: calc(28rpx * var(--font-scale, 1));
  line-height: 88rpx;
  color: #245b4c;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.96), rgba(218, 235, 228, 0.85));
  border: 1rpx solid rgba(255, 255, 255, 0.95);
  box-shadow:
    0 6rpx 20rpx rgba(44, 79, 66, 0.07),
    inset 0 2rpx 2rpx rgba(255, 255, 255, 0.95);
}
button::after {
  border: none;
}
button[disabled] {
  opacity: 0.5;
}
.page {
  padding: 32rpx 32rpx calc(180rpx + env(safe-area-inset-bottom));
  max-width: 1000rpx;
  margin: auto;
}
.title {
  font-size: calc(48rpx * var(--font-scale, 1));
  font-weight: 650;
  letter-spacing: -1rpx;
}
.subtitle,
.muted {
  color: #78847e;
  font-size: calc(25rpx * var(--font-scale, 1));
  line-height: 1.7;
}
.eyebrow {
  color: #a27445;
  font-size: calc(24rpx * var(--font-scale, 1));
  letter-spacing: 3rpx;
  margin-bottom: 12rpx;
}
.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.between {
  justify-content: space-between;
}
.wrap {
  flex-wrap: wrap;
}
.grow {
  flex: 1;
  min-width: 0;
}
.card {
  background: rgba(255, 255, 255, 0.83);
  background-image: linear-gradient(140deg, rgba(255, 255, 255, 0.55), rgba(240, 248, 245, 0.2));
  border: 2rpx solid rgba(255, 255, 255, 0.96);
  box-shadow:
    0 10rpx 34rpx rgba(47, 80, 67, 0.055),
    inset 0 2rpx 3rpx white;
  border-radius: 30rpx;
  padding: 28rpx;
  margin-top: 24rpx;
}
.section-title {
  font-size: calc(32rpx * var(--font-scale, 1));
  font-weight: 600;
  margin: 30rpx 0 20rpx;
}
.primary {
  background: linear-gradient(135deg, #347363, #245b4c);
  color: white;
  border-color: rgba(255, 255, 255, 0.65);
  box-shadow:
    0 8rpx 24rpx rgba(36, 91, 76, 0.16),
    inset 0 2rpx 2rpx rgba(255, 255, 255, 0.25);
}
.danger {
  color: #af4d50;
  background: #fbefed;
}
.small {
  font-size: calc(24rpx * var(--font-scale, 1));
  line-height: 64rpx;
  padding: 0 22rpx;
  border-radius: 20rpx;
}
.pill {
  display: inline-block;
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.65);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 3rpx 12rpx rgba(47, 80, 67, 0.04);
  border-radius: 99rpx;
  font-size: calc(25rpx * var(--font-scale, 1));
  white-space: nowrap;
}
.pill.active {
  background: #245b4c;
  color: white;
}
.tag {
  display: inline-block;
  padding: 6rpx 14rpx;
  margin: 10rpx 10rpx 0 0;
  font-size: calc(22rpx * var(--font-scale, 1));
  border-radius: 10rpx;
  background: #f0f3ee;
  color: #677b70;
}
.warning {
  padding: 22rpx;
  background: #fff4e4;
  color: #906132;
  border-radius: 20rpx;
  line-height: 1.7;
  margin: 20rpx 0;
}
.input {
  background: rgba(255, 255, 255, 0.88);
  box-shadow: inset 0 2rpx 4rpx rgba(45, 80, 66, 0.025);
  padding: 22rpx 26rpx;
  height: 90rpx;
  border-radius: 22rpx;
  border: 1rpx solid #e0e7df;
  margin: 12rpx 0 24rpx;
  width: 100%;
}
.label {
  display: block;
  margin-top: 24rpx;
  color: #52695e;
}
.search {
  margin: 24rpx 0;
}
.scroll-chips {
  white-space: nowrap;
  width: 100%;
  margin: 20rpx 0;
}
.scroll-chips .pill {
  margin-right: 12rpx;
}
.point-title {
  font-size: calc(32rpx * var(--font-scale, 1));
  font-weight: 600;
}
.photo {
  height: 320rpx;
  width: 100%;
  overflow: hidden;
  border-radius: 22rpx;
  display: block;
}
.point-card {
  padding: 18rpx;
}
.point-copy {
  padding: 20rpx 8rpx 8rpx;
}
.gap {
  margin-top: 24rpx;
}
.block {
  width: 100%;
}
.link {
  color: #245b4c;
  padding: 20rpx 0;
}
.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  text-align: center;
  gap: 16rpx;
}
.stat-number {
  font-size: calc(40rpx * var(--font-scale, 1));
  font-weight: 650;
  display: block;
}
.empty {
  text-align: center;
  padding: 60rpx 20rpx;
  color: #78847e;
}
.stack > button {
  margin-top: 20rpx;
}
.privacy {
  font-size: calc(23rpx * var(--font-scale, 1));
  line-height: 1.8;
  color: #78847e;
  margin: 24rpx 0;
}

.assistant-entry {
  width: 100%;
  box-sizing: border-box;
  padding: 16rpx 24rpx;
  font-size: calc(26rpx * var(--font-scale, 1));
  color: #245b4c;
  background: rgba(255, 255, 255, 0.72);
}

.wrap {
  flex-wrap: wrap;
}
.experience-card {
  padding: 24rpx;
  border-radius: 24rpx;
  background: #edf3ee;
  color: #285546;
}

/* v7.1: original photo proportions in cards and detail views. */
.photo,
.photo.hero {
  height: auto !important;
  min-height: 0 !important;
  aspect-ratio: auto !important;
  overflow: visible !important;
}

/* v7.1.3 editorial surfaces, shared by the native user and management pages. */
.feed-heading {
  font-size: calc(40rpx * var(--font-scale, 1));
  font-weight: 650;
  margin: 16rpx 0 24rpx;
}
.waterfall {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
}
.feed-column {
  flex: 1;
  min-width: 0;
}
.feed-tile {
  background: #fff;
  border: 1rpx solid #e4ecec;
  border-radius: 28rpx;
  overflow: hidden;
  margin-bottom: 22rpx;
  box-shadow: 0 3rpx 10rpx #29455505;
}
.feed-copy {
  padding: 18rpx;
}
.feed-title {
  font-size: calc(28rpx * var(--font-scale, 1));
  font-weight: 600;
  line-height: 1.5;
}
.feed-author {
  font-size: calc(21rpx * var(--font-scale, 1));
  color: #829198;
  margin: 10rpx 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.feed-foot {
  display: flex;
  justify-content: space-between;
  color: #819295;
  font-size: calc(21rpx * var(--font-scale, 1));
}
button {
  box-shadow:
    inset 0 2rpx 2rpx #fff,
    0 2rpx 5rpx #29455508;
}

/* Native semantic surfaces; pictures retain their original colors. */
.native-surface {
  min-height: 100vh;
  background: var(--bg);
  color: var(--text);
  font-size: inherit;
  transition:
    background-color 0.18s ease,
    color 0.18s ease;
}
.native-surface button {
  color: var(--accent);
  background: var(--raised);
  border-color: var(--line);
  box-shadow: none;
  line-height: 1.5;
  min-height: 80rpx;
  padding: 20rpx 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.native-surface .card,
.native-surface .feed-tile,
.native-surface .tool-grid,
.native-surface .panel,
.native-surface .sheet,
.native-surface .modal,
.native-surface .empty {
  background: var(--surface);
  color: var(--text);
  border-color: var(--line);
  box-shadow: none;
}
.native-surface .muted,
.native-surface .subtitle,
.native-surface .privacy {
  color: var(--muted);
}
.native-surface input,
.native-surface textarea,
.native-surface .input,
.native-surface .picker {
  background: var(--raised);
  color: var(--text);
  border-color: var(--line);
}
.native-surface .primary {
  background: var(--selected);
  color: var(--accent);
  border-color: var(--line);
}
.native-surface .danger {
  color: var(--danger);
}
.native-surface .pill,
.native-surface .chip {
  background: var(--raised);
  color: var(--muted);
  border-color: var(--line);
}
.native-surface .selected {
  background: var(--selected);
  color: var(--accent);
}
.native-surface .title,
.native-surface .point-title,
.native-surface .section-title {
  color: var(--text);
}
.native-surface label {
  display: flex;
  align-items: center;
  gap: 16rpx;
  line-height: 1.6;
}
.native-surface checkbox,
.native-surface radio {
  flex-shrink: 0;
  align-self: center;
  width: 44rpx;
  height: 44rpx;
  transform: scale(0.82);
  transform-origin: center;
}
.native-surface fieldset {
  min-width: 0;
  padding: 0;
  border: 0;
}
.reduce-motion,
.reduce-motion view,
.reduce-motion button {
  animation: none !important;
  transition: none !important;
}

.native-surface .label,
.native-surface .eyebrow {
  color: var(--muted);
}
.native-surface .link {
  color: var(--accent);
}
.field-placeholder {
  color: var(--muted, #6e808b);
  opacity: 1;
}
