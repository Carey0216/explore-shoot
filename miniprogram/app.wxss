@import 'styles/content73.wxss';
page {
  background-color: #f1f6f2;
  background-image:
    radial-gradient(ellipse at 8% 5%, rgba(204, 230, 227, 0.72), transparent 58%),
    radial-gradient(ellipse at 100% 44%, rgba(225, 233, 248, 0.68), transparent 60%),
    linear-gradient(160deg, #f7f8f2, #edf5f1 60%, #f9f3e9);
  background-attachment: fixed;
  color: #233d35;
  font-family: -apple-system, sans-serif;
  font-size: calc(28rpx * var(--font-scale, 1));
}
view,
text,
label,
input,
textarea,
button {
  box-sizing: border-box;
}
button {
  margin: 0;
  padding: 0 28rpx;
  border-radius: 24rpx;
  font-size: calc(28rpx * var(--font-scale, 1));
  line-height: 88rpx;
  color: #245b4c;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.96), rgba(218, 235, 228, 0.85));
  border: 1rpx solid rgba(255, 255, 255, 0.95);
  box-shadow:
    0 6rpx 20rpx rgba(44, 79, 66, 0.07),
    inset 0 2rpx 2rpx rgba(255, 255, 255, 0.95);
}
button::after {
  border: none;
}
button[disabled] {
  opacity: 0.5;
}
.page {
  padding: 32rpx 32rpx calc(180rpx + env(safe-area-inset-bottom));
  max-width: 1000rpx;
  margin: auto;
}
.title {
  font-size: calc(48rpx * var(--font-scale, 1));
  font-weight: 650;
  letter-spacing: -1rpx;
}
.subtitle,
.muted {
  color: #78847e;
  font-size: calc(25rpx * var(--font-scale, 1));
  line-height: 1.7;
}
.eyebrow {
  color: #a27445;
  font-size: calc(24rpx * var(--font-scale, 1));
  letter-spacing: 3rpx;
  margin-bottom: 12rpx;
}
.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.between {
  justify-content: space-between;
}
.wrap {
  flex-wrap: wrap;
}
.grow {
  flex: 1;
  min-width: 0;
}
.card {
  background: rgba(255, 255, 255, 0.83);
  background-image: linear-gradient(140deg, rgba(255, 255, 255, 0.55), rgba(240, 248, 245, 0.2));
  border: 2rpx solid rgba(255, 255, 255, 0.96);
  box-shadow:
    0 10rpx 34rpx rgba(47, 80, 67, 0.055),
    inset 0 2rpx 3rpx white;
  border-radius: 30rpx;
  padding: 28rpx;
  margin-top: 24rpx;
}
.section-title {
  font-size: calc(32rpx * var(--font-scale, 1));
  font-weight: 600;
  margin: 30rpx 0 20rpx;
}
.primary {
  background: linear-gradient(135deg, #347363, #245b4c);
  color: white;
  border-color: rgba(255, 255, 255, 0.65);
  box-shadow:
    0 8rpx 24rpx rgba(36, 91, 76, 0.16),
    inset 0 2rpx 2rpx rgba(255, 255, 255, 0.25);
}
.danger {
  color: #af4d50;
  background: #fbefed;
}
.small {
  font-size: calc(24rpx * var(--font-scale, 1));
  line-height: 64rpx;
  padding: 0 22rpx;
  border-radius: 20rpx;
}
.pill {
  display: inline-block;
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.65);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 3rpx 12rpx rgba(47, 80, 67, 0.04);
  border-radius: 99rpx;
  font-size: calc(25rpx * var(--font-scale, 1));
  white-space: nowrap;
}
.pill.active {
  background: #245b4c;
  color: white;
}
.tag {
  display: inline-block;
  padding: 6rpx 14rpx;
  margin: 10rpx 10rpx 0 0;
  font-size: calc(22rpx * var(--font-scale, 1));
  border-radius: 10rpx;
  background: #f0f3ee;
  color: #677b70;
}
.warning {
  padding: 22rpx;
  background: #fff4e4;
  color: #906132;
  border-radius: 20rpx;
  line-height: 1.7;
  margin: 20rpx 0;
}
.input {
  background: rgba(255, 255, 255, 0.88);
  box-shadow: inset 0 2rpx 4rpx rgba(45, 80, 66, 0.025);
  padding: 22rpx 26rpx;
  height: 90rpx;
  border-radius: 22rpx;
  border: 1rpx solid #e0e7df;
  margin: 12rpx 0 24rpx;
  width: 100%;
}
.label {
  display: block;
  margin-top: 24rpx;
  color: #52695e;
}
.search {
  margin: 24rpx 0;
}
.scroll-chips {
  white-space: nowrap;
  width: 100%;
  margin: 20rpx 0;
}
.scroll-chips .pill {
  margin-right: 12rpx;
}
.point-title {
  font-size: calc(32rpx * var(--font-scale, 1));
  font-weight: 600;
}
.photo {
  height: 320rpx;
  width: 100%;
  overflow: hidden;
  border-radius: 22rpx;
  display: block;
}
.point-card {
  padding: 18rpx;
}
.point-copy {
  padding: 20rpx 8rpx 8rpx;
}
.gap {
  margin-top: 24rpx;
}
.block {
  width: 100%;
}
.link {
  color: #245b4c;
  padding: 20rpx 0;
}
.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  text-align: center;
  gap: 16rpx;
}
.stat-number {
  font-size: calc(40rpx * var(--font-scale, 1));
  font-weight: 650;
  display: block;
}
.empty {
  text-align: center;
  padding: 60rpx 20rpx;
  color: #78847e;
}
.stack > button {
  margin-top: 20rpx;
}
.privacy {
  font-size: calc(23rpx * var(--font-scale, 1));
  line-height: 1.8;
  color: #78847e;
  margin: 24rpx 0;
}

.assistant-entry {
  width: 100%;
  box-sizing: border-box;
  padding: 16rpx 24rpx;
  font-size: calc(26rpx * var(--font-scale, 1));
  color: #245b4c;
  background: rgba(255, 255, 255, 0.72);
}

.wrap {
  flex-wrap: wrap;
}
.experience-card {
  padding: 24rpx;
  border-radius: 24rpx;
  background: #edf3ee;
  color: #285546;
}

/* v7.1: original photo proportions in cards and detail views. */
.photo,
.photo.hero {
  height: auto !important;
  min-height: 0 !important;
  aspect-ratio: auto !important;
  overflow: visible !important;
}

/* v7.1.3 editorial surfaces, shared by the native user and management pages. */
.feed-heading {
  font-size: calc(40rpx * var(--font-scale, 1));
  font-weight: 650;
  margin: 16rpx 0 24rpx;
}
.waterfall {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
}
.feed-column {
  flex: 1;
  min-width: 0;
}
.feed-tile {
  background: #fff;
  border: 1rpx solid #e4ecec;
  border-radius: 28rpx;
  overflow: hidden;
  margin-bottom: 22rpx;
  box-shadow: 0 3rpx 10rpx #29455505;
}
.feed-copy {
  padding: 18rpx;
}
.feed-title {
  font-size: calc(28rpx * var(--font-scale, 1));
  font-weight: 600;
  line-height: 1.5;
}
.feed-author {
  font-size: calc(21rpx * var(--font-scale, 1));
  color: #829198;
  margin: 10rpx 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.feed-foot {
  display: flex;
  justify-content: space-between;
  color: #819295;
  font-size: calc(21rpx * var(--font-scale, 1));
}
button {
  box-shadow:
    inset 0 2rpx 2rpx #fff,
    0 2rpx 5rpx #29455508;
}

/* Native semantic surfaces; pictures retain their original colors. */
.native-surface {
  min-height: 100vh;
  background: var(--bg);
  color: var(--text);
  font-size: inherit;
  transition:
    background-color 0.18s ease,
    color 0.18s ease;
}
.native-surface button {
  color: var(--accent);
  background: var(--raised);
  border-color: var(--line);
  box-shadow: none;
  line-height: 1.5;
  min-height: 80rpx;
  padding: 20rpx 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.native-surface .card,
.native-surface .feed-tile,
.native-surface .tool-grid,
.native-surface .panel,
.native-surface .sheet,
.native-surface .modal,
.native-surface .empty {
  background: var(--surface);
  color: var(--text);
  border-color: var(--line);
  box-shadow: none;
}
.native-surface .muted,
.native-surface .subtitle,
.native-surface .privacy {
  color: var(--muted);
}
.native-surface input,
.native-surface textarea,
.native-surface .input,
.native-surface .picker {
  background: var(--raised);
  color: var(--text);
  border-color: var(--line);
}
.native-surface .primary {
  background: var(--selected);
  color: var(--accent);
  border-color: var(--line);
}
.native-surface .danger {
  color: var(--danger);
}
.native-surface .pill,
.native-surface .chip {
  background: var(--raised);
  color: var(--muted);
  border-color: var(--line);
}
.native-surface .selected {
  background: var(--selected);
  color: var(--accent);
}
.native-surface .title,
.native-surface .point-title,
.native-surface .section-title {
  color: var(--text);
}
.native-surface label {
  display: flex;
  align-items: center;
  gap: 16rpx;
  line-height: 1.6;
}
.native-surface checkbox,
.native-surface radio {
  flex-shrink: 0;
  align-self: center;
  width: 44rpx;
  height: 44rpx;
  transform: scale(0.82);
  transform-origin: center;
}
.native-surface fieldset {
  min-width: 0;
  padding: 0;
  border: 0;
}
.reduce-motion,
.reduce-motion view,
.reduce-motion button {
  animation: none !important;
  transition: none !important;
}

.native-surface .label,
.native-surface .eyebrow {
  color: var(--muted);
}
.native-surface .link {
  color: var(--accent);
}
.field-placeholder {
  color: var(--muted, #6e808b);
  opacity: 1;
}

.jingyu-wordmark {
  display: block;
  width: 320rpx;
  height: 160rpx;
  margin: 0 0 12rpx;
}
.console-wordmark {
  width: 240rpx;
  height: 120rpx;
}

.locale-auth-action {
  display: flex;
  justify-content: flex-end;
  padding: 16rpx 28rpx 0;
}
.locale-note {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 12rpx 28rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.5;
}
.locale-note text {
  flex: 1;
  min-width: 0;
}
.locale-note button {
  flex-shrink: 0;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  margin: 0;
  line-height: 1.4;
  min-height: 56rpx;
}
.locale-en button,
.locale-en .u-button {
  white-space: normal;
  line-height: 1.4;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.locale-en .title,
.locale-en .point-title {
  overflow-wrap: anywhere;
}
.locale-en .muted {
  line-height: 1.6;
}

.language-picker-host {
  display: block;
  flex: 0 0 76rpx;
  width: 76rpx;
  min-width: 76rpx;
  height: 76rpx;
}

/* v8 visual parity: match the web's compact content and semantic button hierarchy. */
.native-surface .page {
  padding-top: 16rpx;
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
  max-width: 1000rpx;
}
.native-surface .title {
  font-size: calc(42rpx * var(--font-scale, 1));
  line-height: 1.35;
  letter-spacing: -0.5rpx;
}
.native-surface .primary {
  background: var(--accent);
  color: var(--onAccent, #fff);
  border-color: transparent;
}
.native-surface .text-button73,
.native-surface .route-link {
  background: transparent;
  border: 0;
  box-shadow: none;
  color: var(--muted);
  font-weight: 400;
  padding: 12rpx 8rpx;
  min-height: 72rpx;
  font-size: calc(25rpx * var(--font-scale, 1));
}
.native-surface .feature-title73 {
  font-size: calc(44rpx * var(--font-scale, 1));
  margin: 28rpx 0 12rpx;
  letter-spacing: -0.5rpx;
}
.native-surface .guide-banner {
  background: var(--raised);
  padding: 20rpx 24rpx;
  gap: 18rpx;
  margin: 4rpx 0 22rpx;
  border-radius: 28rpx;
}
.native-surface .guide-banner image {
  width: 48rpx;
  height: 48rpx;
}
.native-surface .guide-banner .point-title {
  font-size: calc(27rpx * var(--font-scale, 1));
  font-weight: 600;
}
.native-surface .guide-banner .muted {
  font-size: calc(22rpx * var(--font-scale, 1));
}
.native-surface .theme-items button.theme {
  font-size: calc(24rpx * var(--font-scale, 1));
  font-weight: 500;
  min-height: 72rpx;
  padding: 0 22rpx;
  border-radius: 24rpx;
}
.native-surface .theme-strip {
  margin: 18rpx 0;
}
.native-surface .card {
  border-width: 1rpx;
  border-radius: 28rpx;
}
.native-surface .input,
.native-surface .picker {
  border-radius: 22rpx;
  min-width: 0;
}
.native-surface .identity-name73 {
  font-size: calc(40rpx * var(--font-scale, 1));
}
.native-surface .passport-preview73 {
  padding: 30rpx;
  margin-bottom: 42rpx;
  border-radius: 32rpx;
}
.native-surface .tool-row73 {
  min-height: 92rpx;
  font-size: calc(27rpx * var(--font-scale, 1));
}
.native-surface .photo-remove {
  width: 54rpx;
  min-width: 54rpx;
  height: 54rpx;
  min-height: 54rpx;
  padding: 0;
  background: #6b727bd9;
  color: #fff;
  border: 2rpx solid var(--surface);
  border-radius: 50%;
  font-size: 30rpx;
  line-height: 1;
}
.native-surface .photo-confirm {
  max-width: calc(100vw - 90rpx);
}
.native-surface .photo-cell:nth-child(3n + 1) .photo-confirm {
  left: 0;
  right: auto;
}
.native-surface .photo-confirm button {
  min-height: 60rpx;
  padding: 10rpx;
  font-size: 23rpx;
}

.native-surface .locale-note {
  padding: 8rpx 0 16rpx;
  font-size: 20rpx;
  gap: 12rpx;
  line-height: 1.4;
}
.native-surface .locale-note button {
  flex: 0 0 auto;
  width: auto;
  min-width: 0;
  max-width: 220rpx;
  min-height: 48rpx;
  padding: 4rpx 8rpx;
  background: transparent;
  font-size: 20rpx;
  line-height: 1.4;
  border: 0;
}

.native-surface .activity-search {
  height: 88rpx;
  min-height: 88rpx;
  padding: 0 24rpx;
  line-height: normal;
  box-sizing: border-box;
}
.native-surface .activity-row {
  background: var(--surface);
  border: 1rpx solid var(--line);
  color: var(--text);
  padding: 24rpx;
  gap: 22rpx;
  border-radius: 30rpx;
}
.native-surface .activity-enter {
  background: var(--raised);
  color: var(--accent);
}
.native-surface .activity-poster {
  background: var(--raised);
}
.native-surface .selected-phase {
  background: var(--selected);
  color: var(--accent);
}
.native-surface .stamp-grid,
.native-surface .map-photo-list {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  columns: auto;
}
.native-surface .stamp-column,
.native-surface .map-photo-column {
  flex: 1;
  min-width: 0;
}
.native-surface .stamp {
  display: block;
  width: 100%;
  margin: 0 0 20rpx;
  background: var(--surface);
  color: var(--text);
  border: 1rpx dashed var(--line);
  border-radius: 26rpx;
  padding: 24rpx 16rpx;
}
.native-surface .stamp.earned {
  background: var(--raised);
  border-color: #b59b58;
}
.native-surface .stamp:not(.earned) .stamp-image {
  filter: grayscale(1);
  opacity: 0.5;
}
.native-surface .scroll-chips {
  white-space: nowrap;
  margin: 24rpx 0 16rpx;
}
.native-surface .scroll-chips .pill {
  display: inline-flex;
  width: auto;
  min-height: 72rpx;
  padding: 12rpx 24rpx;
  margin: 0 14rpx 0 0;
  vertical-align: middle;
  white-space: nowrap;
  line-height: 1.4;
  font-size: 25rpx;
  font-weight: 500;
}
.native-surface .chip-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  width: max-content;
  padding: 4rpx 0;
}
.native-surface .message-categories .small {
  width: auto;
  flex: none;
  min-height: 72rpx;
  font-size: 24rpx;
  padding: 12rpx 22rpx;
  white-space: nowrap;
}
.native-surface .empty {
  border: 1rpx dashed var(--line);
  border-radius: 26rpx;
}

.native-surface .photo-cell image,
.native-surface .photo-add {
  height: calc((100vw - 108rpx) / 3);
}

.native-surface input {
  width: 100%;
  min-width: 0;
  height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
  font-size: calc(28rpx * var(--font-scale, 1));
}
.native-surface textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
  font-size: calc(28rpx * var(--font-scale, 1));
  line-height: 1.65;
}
.native-surface .row > input {
  flex: 1;
  width: 0;
}
.native-surface .row > button {
  flex: none;
  width: auto;
  min-width: 112rpx;
}
.native-surface .photo-grid {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  gap: 18rpx;
}
.native-surface .photo-grid > .photo-cell,
.native-surface .photo-grid > .photo-add {
  flex: 0 0 calc((100% - 36rpx) / 3);
  width: calc((100% - 36rpx) / 3);
  min-width: 0;
  max-width: none;
  margin: 0;
}
.native-surface .compose-title {
  font-size: calc(34rpx * var(--font-scale, 1));
  height: 100rpx;
  background: transparent;
  border: 0;
  border-bottom: 1rpx solid var(--line);
  border-radius: 0;
  padding: 0;
}
.native-surface .compose-description {
  background: transparent;
  border: 0;
  border-radius: 0;
  padding: 24rpx 0;
  height: 240rpx;
}
.native-surface .compose-tag {
  background: var(--raised);
  color: var(--muted);
}
.native-surface .compose-tag.active {
  background: var(--selected);
  color: var(--accent);
}
.native-surface .compose-row {
  color: var(--text);
  border-color: var(--line);
}
.native-surface .compose-actions {
  background: var(--surface);
  border: 1rpx solid var(--line);
  backdrop-filter: none;
}
.native-surface .compose-submit {
  background: var(--accent);
  color: var(--onAccent, #fff);
  min-width: 0;
}
.native-surface .save-draft,
.native-surface .preview-action {
  color: var(--accent);
}
.native-surface .compose-page {
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}
.native-surface .locale-note {
  margin: 0 28rpx;
}

.native-surface .pill.active {
  background: var(--selected);
  color: var(--accent);
  border-color: var(--line);
}
