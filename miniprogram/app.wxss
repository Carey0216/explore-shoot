@import 'styles/content73.wxss';
@import 'styles/experience812.wxss';
@import './styles/experience815.wxss';
@import './styles/design-tokens.wxss';
page {
  --jy-rpx: 0.133333vw;
  background: #f5f8fa;
  color: #243846;
  font-family: -apple-system, sans-serif;
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 28) * var(--font-scale, 1));
}
@media (prefers-color-scheme: dark) {
  page {
    background: #101b24;
    color: #e7eef4;
  }
}
.native-surface {
  min-height: 100vh;
}
/* Legacy responsive dimensions follow the phone up to 430px, never the whole tablet. */
@media (min-width: 430px) {
  page {
    --jy-rpx: 0.573333px;
  }
}
@media (min-width: 600px) {
  .native-surface .page {
    max-width: none;
  }
}
view,
text,
label,
input,
textarea,
button {
  box-sizing: border-box;
}
button {
  margin: 0;
  padding: 0 calc(var(--jy-rpx, 1rpx) * 28);
  border-radius: calc(var(--jy-rpx, 1rpx) * 24);
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 28) * var(--font-scale, 1));
  line-height: calc(var(--jy-rpx, 1rpx) * 88);
  color: #245b4c;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.96), rgba(218, 235, 228, 0.85));
  border: calc(var(--jy-rpx, 1rpx) * 1) solid rgba(255, 255, 255, 0.95);
  box-shadow:
    0 calc(var(--jy-rpx, 1rpx) * 6) calc(var(--jy-rpx, 1rpx) * 20) rgba(44, 79, 66, 0.07),
    inset 0 calc(var(--jy-rpx, 1rpx) * 2) calc(var(--jy-rpx, 1rpx) * 2) rgba(255, 255, 255, 0.95);
}
button::after {
  border: none;
}
button[disabled] {
  opacity: 0.5;
}
.page {
  padding: calc(var(--jy-rpx, 1rpx) * 32) calc(var(--jy-rpx, 1rpx) * 32)
    calc(calc(var(--jy-rpx, 1rpx) * 180) + env(safe-area-inset-bottom));
  max-width: calc(var(--jy-rpx, 1rpx) * 1000);
  margin: auto;
}
.title {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 48) * var(--font-scale, 1));
  font-weight: 650;
  letter-spacing: calc(var(--jy-rpx, 1rpx) * -1);
}
.subtitle,
.muted {
  color: #78847e;
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 25) * var(--font-scale, 1));
  line-height: 1.7;
}
.eyebrow {
  color: #a27445;
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 24) * var(--font-scale, 1));
  letter-spacing: calc(var(--jy-rpx, 1rpx) * 3);
  margin-bottom: calc(var(--jy-rpx, 1rpx) * 12);
}
.row {
  display: flex;
  align-items: center;
  gap: calc(var(--jy-rpx, 1rpx) * 16);
}
.between {
  justify-content: space-between;
}
.wrap {
  flex-wrap: wrap;
}
.grow {
  flex: 1;
  min-width: 0;
}
.card {
  background: rgba(255, 255, 255, 0.83);
  background-image: linear-gradient(140deg, rgba(255, 255, 255, 0.55), rgba(240, 248, 245, 0.2));
  border: calc(var(--jy-rpx, 1rpx) * 2) solid rgba(255, 255, 255, 0.96);
  box-shadow:
    0 calc(var(--jy-rpx, 1rpx) * 10) calc(var(--jy-rpx, 1rpx) * 34) rgba(47, 80, 67, 0.055),
    inset 0 calc(var(--jy-rpx, 1rpx) * 2) calc(var(--jy-rpx, 1rpx) * 3) white;
  border-radius: calc(var(--jy-rpx, 1rpx) * 30);
  padding: calc(var(--jy-rpx, 1rpx) * 28);
  margin-top: calc(var(--jy-rpx, 1rpx) * 24);
}
.section-title {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 32) * var(--font-scale, 1));
  font-weight: 600;
  margin: calc(var(--jy-rpx, 1rpx) * 30) 0 calc(var(--jy-rpx, 1rpx) * 20);
}
.primary {
  background: linear-gradient(135deg, #347363, #245b4c);
  color: white;
  border-color: rgba(255, 255, 255, 0.65);
  box-shadow:
    0 calc(var(--jy-rpx, 1rpx) * 8) calc(var(--jy-rpx, 1rpx) * 24) rgba(36, 91, 76, 0.16),
    inset 0 calc(var(--jy-rpx, 1rpx) * 2) calc(var(--jy-rpx, 1rpx) * 2) rgba(255, 255, 255, 0.25);
}
.danger {
  color: #af4d50;
  background: #fbefed;
}
.small {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 24) * var(--font-scale, 1));
  line-height: calc(var(--jy-rpx, 1rpx) * 64);
  padding: 0 calc(var(--jy-rpx, 1rpx) * 22);
  border-radius: calc(var(--jy-rpx, 1rpx) * 20);
}
.pill {
  display: inline-block;
  padding: calc(var(--jy-rpx, 1rpx) * 12) calc(var(--jy-rpx, 1rpx) * 24);
  background: rgba(255, 255, 255, 0.65);
  border: calc(var(--jy-rpx, 1rpx) * 1) solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 calc(var(--jy-rpx, 1rpx) * 3) calc(var(--jy-rpx, 1rpx) * 12) rgba(47, 80, 67, 0.04);
  border-radius: calc(var(--jy-rpx, 1rpx) * 99);
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 25) * var(--font-scale, 1));
  white-space: nowrap;
}
.pill.active {
  background: #245b4c;
  color: white;
}
.tag {
  display: inline-block;
  padding: calc(var(--jy-rpx, 1rpx) * 6) calc(var(--jy-rpx, 1rpx) * 14);
  margin: calc(var(--jy-rpx, 1rpx) * 10) calc(var(--jy-rpx, 1rpx) * 10) 0 0;
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 22) * var(--font-scale, 1));
  border-radius: calc(var(--jy-rpx, 1rpx) * 10);
  background: #f0f3ee;
  color: #677b70;
}
.warning {
  padding: calc(var(--jy-rpx, 1rpx) * 22);
  background: #fff4e4;
  color: #906132;
  border-radius: calc(var(--jy-rpx, 1rpx) * 20);
  line-height: 1.7;
  margin: calc(var(--jy-rpx, 1rpx) * 20) 0;
}
.input {
  background: rgba(255, 255, 255, 0.88);
  box-shadow: inset 0 calc(var(--jy-rpx, 1rpx) * 2) calc(var(--jy-rpx, 1rpx) * 4)
    rgba(45, 80, 66, 0.025);
  padding: calc(var(--jy-rpx, 1rpx) * 22) calc(var(--jy-rpx, 1rpx) * 26);
  height: calc(var(--jy-rpx, 1rpx) * 90);
  border-radius: calc(var(--jy-rpx, 1rpx) * 22);
  border: calc(var(--jy-rpx, 1rpx) * 1) solid #e0e7df;
  margin: calc(var(--jy-rpx, 1rpx) * 12) 0 calc(var(--jy-rpx, 1rpx) * 24);
  width: 100%;
}
.label {
  display: block;
  margin-top: calc(var(--jy-rpx, 1rpx) * 24);
  color: #52695e;
}
.search {
  margin: calc(var(--jy-rpx, 1rpx) * 24) 0;
}
.scroll-chips {
  white-space: nowrap;
  width: 100%;
  margin: calc(var(--jy-rpx, 1rpx) * 20) 0;
}
.scroll-chips .pill {
  margin-right: calc(var(--jy-rpx, 1rpx) * 12);
}
.point-title {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 32) * var(--font-scale, 1));
  font-weight: 600;
}
.photo {
  height: calc(var(--jy-rpx, 1rpx) * 320);
  width: 100%;
  overflow: hidden;
  border-radius: calc(var(--jy-rpx, 1rpx) * 22);
  display: block;
}
.point-card {
  padding: calc(var(--jy-rpx, 1rpx) * 18);
}
.point-copy {
  padding: calc(var(--jy-rpx, 1rpx) * 20) calc(var(--jy-rpx, 1rpx) * 8)
    calc(var(--jy-rpx, 1rpx) * 8);
}
.gap {
  margin-top: calc(var(--jy-rpx, 1rpx) * 24);
}
.block {
  width: 100%;
}
.link {
  color: #245b4c;
  padding: calc(var(--jy-rpx, 1rpx) * 20) 0;
}
.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  text-align: center;
  gap: calc(var(--jy-rpx, 1rpx) * 16);
}
.stat-number {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 40) * var(--font-scale, 1));
  font-weight: 650;
  display: block;
}
.empty {
  text-align: center;
  padding: calc(var(--jy-rpx, 1rpx) * 60) calc(var(--jy-rpx, 1rpx) * 20);
  color: #78847e;
}
.stack > button {
  margin-top: calc(var(--jy-rpx, 1rpx) * 20);
}
.privacy {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 23) * var(--font-scale, 1));
  line-height: 1.8;
  color: #78847e;
  margin: calc(var(--jy-rpx, 1rpx) * 24) 0;
}

.assistant-entry {
  width: 100%;
  box-sizing: border-box;
  padding: calc(var(--jy-rpx, 1rpx) * 16) calc(var(--jy-rpx, 1rpx) * 24);
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 26) * var(--font-scale, 1));
  color: #245b4c;
  background: rgba(255, 255, 255, 0.72);
}

.wrap {
  flex-wrap: wrap;
}
.experience-card {
  padding: calc(var(--jy-rpx, 1rpx) * 24);
  border-radius: calc(var(--jy-rpx, 1rpx) * 24);
  background: #edf3ee;
  color: #285546;
}

/* v7.1: original photo proportions in cards and detail views. */
.photo,
.photo.hero {
  height: auto !important;
  min-height: 0 !important;
  aspect-ratio: auto !important;
  overflow: visible !important;
}

/* v7.1.3 editorial surfaces, shared by the native user and management pages. */
.feed-heading {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 40) * var(--font-scale, 1));
  font-weight: 650;
  margin: calc(var(--jy-rpx, 1rpx) * 16) 0 calc(var(--jy-rpx, 1rpx) * 24);
}
.waterfall {
  display: flex;
  gap: calc(var(--jy-rpx, 1rpx) * 20);
  align-items: flex-start;
}
.feed-column {
  flex: 1;
  min-width: 0;
}
.feed-tile {
  background: #fff;
  border: calc(var(--jy-rpx, 1rpx) * 1) solid #e4ecec;
  border-radius: calc(var(--jy-rpx, 1rpx) * 28);
  overflow: hidden;
  margin-bottom: calc(var(--jy-rpx, 1rpx) * 22);
  box-shadow: 0 calc(var(--jy-rpx, 1rpx) * 3) calc(var(--jy-rpx, 1rpx) * 10) #29455505;
}
.feed-copy {
  padding: calc(var(--jy-rpx, 1rpx) * 18);
}
.feed-title {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 28) * var(--font-scale, 1));
  font-weight: 600;
  line-height: 1.5;
}
.feed-author {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 21) * var(--font-scale, 1));
  color: #829198;
  margin: calc(var(--jy-rpx, 1rpx) * 10) 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.feed-foot {
  display: flex;
  justify-content: space-between;
  color: #819295;
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 21) * var(--font-scale, 1));
}
button {
  box-shadow:
    inset 0 calc(var(--jy-rpx, 1rpx) * 2) calc(var(--jy-rpx, 1rpx) * 2) #fff,
    0 calc(var(--jy-rpx, 1rpx) * 2) calc(var(--jy-rpx, 1rpx) * 5) #29455508;
}

/* Native semantic surfaces; pictures retain their original colors. */
.native-surface {
  min-height: 100vh;
  background: var(--bg);
  color: var(--text);
  font-size: inherit;
  transition:
    background-color 0.18s ease,
    color 0.18s ease;
}
.native-surface button {
  /* Explicitly reset the v2 platform width; a control fits its layout, not a 184px default. */
  width: auto;
  max-width: 100%;
  min-width: 0;
  color: var(--accent);
  background: var(--raised);
  border-color: var(--line);
  box-shadow: none;
  line-height: 1.5;
  min-height: var(--jy-touch, 44px);
  padding: calc(var(--jy-rpx, 1rpx) * 20) calc(var(--jy-rpx, 1rpx) * 26);
  display: flex;
  align-items: center;
  justify-content: center;
}
.native-surface .card,
.native-surface .feed-tile,
.native-surface .tool-grid,
.native-surface .panel,
.native-surface .sheet,
.native-surface .modal,
.native-surface .empty {
  background: var(--surface);
  color: var(--text);
  border-color: var(--line);
  box-shadow: none;
}
.native-surface .muted,
.native-surface .subtitle,
.native-surface .privacy {
  color: var(--muted);
}
.native-surface input,
.native-surface textarea,
.native-surface .input,
.native-surface .picker {
  background: var(--raised);
  color: var(--text);
  border-color: var(--line);
}
.native-surface .primary {
  background: var(--selected);
  color: var(--accent);
  border-color: var(--line);
}
.native-surface .danger {
  color: var(--danger);
}
.native-surface .pill,
.native-surface .chip {
  background: var(--raised);
  color: var(--muted);
  border-color: var(--line);
}
.native-surface .selected {
  background: var(--selected);
  color: var(--accent);
}
.native-surface .title,
.native-surface .point-title,
.native-surface .section-title {
  color: var(--text);
}
.native-surface label {
  display: flex;
  align-items: center;
  gap: calc(var(--jy-rpx, 1rpx) * 16);
  line-height: 1.6;
}
.native-surface checkbox,
.native-surface radio {
  flex-shrink: 0;
  align-self: center;
  width: calc(var(--jy-rpx, 1rpx) * 44);
  height: calc(var(--jy-rpx, 1rpx) * 44);
  transform: scale(0.82);
  transform-origin: center;
}
.native-surface fieldset {
  min-width: 0;
  padding: 0;
  border: 0;
}

.native-surface .label,
.native-surface .eyebrow {
  color: var(--muted);
}
.native-surface .link {
  color: var(--accent);
}
.field-placeholder {
  color: var(--muted, #6e808b);
  opacity: 1;
}

.jingyu-wordmark {
  display: block;
  width: calc(var(--jy-rpx, 1rpx) * 320);
  height: calc(var(--jy-rpx, 1rpx) * 160);
  margin: 0 0 calc(var(--jy-rpx, 1rpx) * 12);
}
.console-wordmark {
  width: calc(var(--jy-rpx, 1rpx) * 240);
  height: calc(var(--jy-rpx, 1rpx) * 120);
}

.locale-auth-action {
  display: flex;
  justify-content: flex-end;
  padding: calc(var(--jy-rpx, 1rpx) * 16) calc(var(--jy-rpx, 1rpx) * 28) 0;
}
.locale-note {
  display: flex;
  align-items: center;
  gap: calc(var(--jy-rpx, 1rpx) * 14);
  padding: calc(var(--jy-rpx, 1rpx) * 12) calc(var(--jy-rpx, 1rpx) * 28);
  color: var(--muted);
  font-size: calc(var(--jy-rpx, 1rpx) * 22);
  line-height: 1.5;
}
.locale-note text {
  flex: 1;
  min-width: 0;
}
.locale-note button {
  flex-shrink: 0;
  font-size: calc(var(--jy-rpx, 1rpx) * 22);
  padding: calc(var(--jy-rpx, 1rpx) * 8) calc(var(--jy-rpx, 1rpx) * 16);
  margin: 0;
  line-height: 1.4;
  min-height: calc(var(--jy-rpx, 1rpx) * 56);
}
.locale-en button,
.locale-en .u-button {
  white-space: normal;
  line-height: 1.4;
  min-height: calc(var(--jy-rpx, 1rpx) * 72);
  display: flex;
  align-items: center;
  justify-content: center;
}
.locale-en .title,
.locale-en .point-title {
  overflow-wrap: anywhere;
}
.locale-en .muted {
  line-height: 1.6;
}

.language-picker-host {
  display: block;
  flex: 0 0 44px;
  width: 44px;
  min-width: 44px;
  height: 44px;
}

/* v8 visual parity: match the web's compact content and semantic button hierarchy. */
.native-surface .page {
  padding-top: calc(var(--jy-rpx, 1rpx) * 16);
  padding-bottom: calc(calc(var(--jy-rpx, 1rpx) * 220) + env(safe-area-inset-bottom));
  max-width: calc(var(--jy-rpx, 1rpx) * 1000);
}
.native-surface .title {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 42) * var(--font-scale, 1));
  line-height: 1.35;
  letter-spacing: calc(var(--jy-rpx, 1rpx) * -0.5);
}
.native-surface .primary {
  background: var(--accent);
  color: var(--onAccent, #fff);
  border-color: transparent;
}
.native-surface .text-button73,
.native-surface .route-link {
  background: transparent;
  border: 0;
  box-shadow: none;
  color: var(--muted);
  font-weight: 400;
  padding: calc(var(--jy-rpx, 1rpx) * 12) calc(var(--jy-rpx, 1rpx) * 8);
  min-height: calc(var(--jy-rpx, 1rpx) * 72);
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 25) * var(--font-scale, 1));
}
.native-surface .feature-title73 {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 44) * var(--font-scale, 1));
  margin: calc(var(--jy-rpx, 1rpx) * 28) 0 calc(var(--jy-rpx, 1rpx) * 12);
  letter-spacing: calc(var(--jy-rpx, 1rpx) * -0.5);
}
.native-surface .guide-banner {
  background: var(--raised);
  padding: calc(var(--jy-rpx, 1rpx) * 20) calc(var(--jy-rpx, 1rpx) * 24);
  gap: calc(var(--jy-rpx, 1rpx) * 18);
  margin: calc(var(--jy-rpx, 1rpx) * 4) 0 calc(var(--jy-rpx, 1rpx) * 22);
  border-radius: calc(var(--jy-rpx, 1rpx) * 28);
}
.native-surface .guide-banner image {
  width: calc(var(--jy-rpx, 1rpx) * 48);
  height: calc(var(--jy-rpx, 1rpx) * 48);
}
.native-surface .guide-banner .point-title {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 27) * var(--font-scale, 1));
  font-weight: 600;
}
.native-surface .guide-banner .muted {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 22) * var(--font-scale, 1));
}
.native-surface .theme-items button.theme {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 24) * var(--font-scale, 1));
  font-weight: 500;
  min-height: calc(var(--jy-rpx, 1rpx) * 72);
  padding: 0 calc(var(--jy-rpx, 1rpx) * 22);
  border-radius: calc(var(--jy-rpx, 1rpx) * 24);
}
.native-surface .theme-strip {
  margin: calc(var(--jy-rpx, 1rpx) * 18) 0;
}
.native-surface .card {
  border-width: calc(var(--jy-rpx, 1rpx) * 1);
  border-radius: calc(var(--jy-rpx, 1rpx) * 28);
}
.native-surface .input,
.native-surface .picker {
  border-radius: calc(var(--jy-rpx, 1rpx) * 22);
  min-width: 0;
}
.native-surface .identity-name73 {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 40) * var(--font-scale, 1));
}
.native-surface .passport-preview73 {
  padding: calc(var(--jy-rpx, 1rpx) * 30);
  margin-bottom: calc(var(--jy-rpx, 1rpx) * 42);
  border-radius: calc(var(--jy-rpx, 1rpx) * 32);
}
.native-surface .tool-row73 {
  min-height: calc(var(--jy-rpx, 1rpx) * 92);
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 27) * var(--font-scale, 1));
}
.native-surface .photo-remove {
  width: calc(var(--jy-rpx, 1rpx) * 54);
  min-width: calc(var(--jy-rpx, 1rpx) * 54);
  height: calc(var(--jy-rpx, 1rpx) * 54);
  min-height: calc(var(--jy-rpx, 1rpx) * 54);
  padding: 0;
  background: #6b727bd9;
  color: #fff;
  border: calc(var(--jy-rpx, 1rpx) * 2) solid var(--surface);
  border-radius: 50%;
  font-size: calc(var(--jy-rpx, 1rpx) * 30);
  line-height: 1;
}
.native-surface .photo-confirm {
  max-width: calc(100vw - calc(var(--jy-rpx, 1rpx) * 90));
}
.native-surface .photo-cell:nth-child(3n + 1) .photo-confirm {
  left: 0;
  right: auto;
}
.native-surface .photo-confirm button {
  min-height: calc(var(--jy-rpx, 1rpx) * 60);
  padding: calc(var(--jy-rpx, 1rpx) * 10);
  font-size: calc(var(--jy-rpx, 1rpx) * 23);
}

.native-surface .locale-note {
