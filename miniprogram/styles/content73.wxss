/* Content-first pages; the split dock keeps its existing geometry. */
.native-surface .discover-feature73 {
  margin: calc(var(--jy-rpx, 1rpx) * 32) 0 calc(var(--jy-rpx, 1rpx) * 60);
}
.native-surface .feature-photo73 {
  height: 28vh;
  min-height: calc(var(--jy-rpx, 1rpx) * 300);
  max-height: calc(var(--jy-rpx, 1rpx) * 520);
  position: relative;
  overflow: hidden;
  border-radius: calc(var(--jy-rpx, 1rpx) * 36);
  background: var(--surface);
}
.native-surface .photo-caption73 {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: calc(var(--jy-rpx, 1rpx) * 30) calc(var(--jy-rpx, 1rpx) * 24)
    calc(var(--jy-rpx, 1rpx) * 20);
  font-size: calc(var(--jy-rpx, 1rpx) * 22);
  color: #fff;
  background: linear-gradient(transparent, #142536b0);
}
.native-surface .feature-title73 {
  font-size: calc(var(--jy-rpx, 1rpx) * 42);
  font-weight: 700;
  line-height: 1.4;
  margin: calc(var(--jy-rpx, 1rpx) * 28) 0 calc(var(--jy-rpx, 1rpx) * 12);
}
.native-surface .shooting-line73 {
  font-size: calc(var(--jy-rpx, 1rpx) * 28);
  line-height: 1.8;
  margin: calc(var(--jy-rpx, 1rpx) * 22) 0 calc(var(--jy-rpx, 1rpx) * 30);
}
.native-surface .stories-grid73 {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: calc(var(--jy-rpx, 1rpx) * 38) calc(var(--jy-rpx, 1rpx) * 28);
  margin-top: calc(var(--jy-rpx, 1rpx) * 30);
}
.native-surface .story-photo73 {
  height: calc(var(--jy-rpx, 1rpx) * 240);
  border-radius: calc(var(--jy-rpx, 1rpx) * 28);
  overflow: hidden;
  background: var(--surface);
}
.native-surface .story-title73 {
  font-size: calc(var(--jy-rpx, 1rpx) * 30);
  line-height: 1.5;
  font-weight: 600;
  margin: calc(var(--jy-rpx, 1rpx) * 20) 0 calc(var(--jy-rpx, 1rpx) * 10);
}
.native-surface .story-line73 {
  font-size: calc(var(--jy-rpx, 1rpx) * 24);
  color: var(--muted);
  line-height: 1.7;
}
.native-surface .quiet-heading73 {
  font-size: calc(var(--jy-rpx, 1rpx) * 36);
  font-weight: 600;
  margin: calc(var(--jy-rpx, 1rpx) * 42) 0 calc(var(--jy-rpx, 1rpx) * 22);
}
.native-surface .identity73 {
  display: flex;
  align-items: center;
  gap: calc(var(--jy-rpx, 1rpx) * 24);
  margin: calc(var(--jy-rpx, 1rpx) * 10) 0 calc(var(--jy-rpx, 1rpx) * 48);
}
.native-surface .identity-copy73 {
  flex: 1;
  min-width: 0;
}
.native-surface .identity-name73 {
  font-size: calc(var(--jy-rpx, 1rpx) * 44);
  font-weight: 700;
  line-height: 1.4;
  margin-bottom: calc(var(--jy-rpx, 1rpx) * 12);
  overflow-wrap: anywhere;
}
.native-surface .quiet-button73 {
  width: calc(var(--jy-rpx, 1rpx) * 80);
  min-width: calc(var(--jy-rpx, 1rpx) * 80);
  height: calc(var(--jy-rpx, 1rpx) * 80);
  min-height: calc(var(--jy-rpx, 1rpx) * 80);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  background: var(--raised);
  box-shadow: none;
  padding: calc(var(--jy-rpx, 1rpx) * 18);
  border-radius: 50%;
  margin: 0;
}
.native-surface .quiet-icon73 {
  width: calc(var(--jy-rpx, 1rpx) * 40);
  height: calc(var(--jy-rpx, 1rpx) * 40);
  flex: none;
}
.native-surface .passport-preview73 {
  padding: calc(var(--jy-rpx, 1rpx) * 38);
  background: var(--raised);
  border-radius: calc(var(--jy-rpx, 1rpx) * 40);
  margin-bottom: calc(var(--jy-rpx, 1rpx) * 56);
}
.native-surface .section-title73 {
  font-size: calc(var(--jy-rpx, 1rpx) * 36);
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: calc(var(--jy-rpx, 1rpx) * 24);
}
.native-surface .section-title73 > text {
  font-size: calc(var(--jy-rpx, 1rpx) * 24);
  font-weight: 400;
  color: var(--muted);
}
.native-surface .preview-stamps73 {
  display: flex;
  gap: calc(var(--jy-rpx, 1rpx) * 24);
  margin: calc(var(--jy-rpx, 1rpx) * 38) 0;
  min-height: calc(var(--jy-rpx, 1rpx) * 110);
}
.native-surface .preview-stamp73 {
  width: calc(var(--jy-rpx, 1rpx) * 116);
  height: calc(var(--jy-rpx, 1rpx) * 116);
}
.native-surface .preview-stamp73.locked {
  filter: grayscale(1);
  opacity: 0.35;
}
.native-surface .recent-preview73 {
  padding-bottom: calc(var(--jy-rpx, 1rpx) * 44);
  margin-bottom: calc(var(--jy-rpx, 1rpx) * 46);
  border-bottom: calc(var(--jy-rpx, 1rpx) * 1) solid var(--line);
}
.native-surface .recent-record73 {
  display: flex;
  gap: calc(var(--jy-rpx, 1rpx) * 28);
  align-items: center;
  margin-top: calc(var(--jy-rpx, 1rpx) * 30);
}
.native-surface .recent-photo73 {
  width: calc(var(--jy-rpx, 1rpx) * 164);
  height: calc(var(--jy-rpx, 1rpx) * 164);
  overflow: hidden;
  border-radius: calc(var(--jy-rpx, 1rpx) * 26);
  flex: none;
}
.native-surface .personal-toolbox73 {
  margin-bottom: calc(var(--jy-rpx, 1rpx) * 48);
}
.native-surface .tool-row73 {
  display: flex;
  align-items: center;
  gap: calc(var(--jy-rpx, 1rpx) * 24);
  min-height: calc(var(--jy-rpx, 1rpx) * 104);
  border-bottom: calc(var(--jy-rpx, 1rpx) * 1) solid var(--line);
  font-size: calc(var(--jy-rpx, 1rpx) * 28);
}
.native-surface .tool-row73 > text:first-of-type {
  flex: 1;
}
.native-surface .more-tools73 {
  padding: calc(var(--jy-rpx, 1rpx) * 30) 0;
  color: var(--muted);
  font-size: calc(var(--jy-rpx, 1rpx) * 26);
}
.native-surface .context-empty73 {
  padding: calc(var(--jy-rpx, 1rpx) * 40) 0;
  line-height: 1.8;
}
.native-surface .topic-next73 {
  margin: calc(var(--jy-rpx, 1rpx) * 36) 0;
  padding: calc(var(--jy-rpx, 1rpx) * 36) 0;
  border-top: calc(var(--jy-rpx, 1rpx) * 1) solid var(--line);
  border-bottom: calc(var(--jy-rpx, 1rpx) * 1) solid var(--line);
}
.native-surface .progress-track73 {
  height: calc(var(--jy-rpx, 1rpx) * 10);
  border-radius: calc(var(--jy-rpx, 1rpx) * 10);
  background: var(--raised);
  overflow: hidden;
  margin: calc(var(--jy-rpx, 1rpx) * 30) 0 calc(var(--jy-rpx, 1rpx) * 18);
}
.native-surface .progress-track73 > view {
  height: 100%;
  border-radius: calc(var(--jy-rpx, 1rpx) * 10);
  background: var(--accent);
}
.native-surface .activity-hero {
  height: 30vh;
  min-height: calc(var(--jy-rpx, 1rpx) * 300);
  max-height: calc(var(--jy-rpx, 1rpx) * 520);
  border-radius: calc(var(--jy-rpx, 1rpx) * 36);
  overflow: hidden;
}
.native-surface .activity-detail {
  background: none;
  border: 0;
  box-shadow: none;
  padding: calc(var(--jy-rpx, 1rpx) * 32) 0;
}

.native-surface .identity-avatar73 {
  width: calc(var(--jy-rpx, 1rpx) * 112);
  height: calc(var(--jy-rpx, 1rpx) * 112);
  overflow: hidden;
  border-radius: calc(var(--jy-rpx, 1rpx) * 32);
  background: var(--raised);
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
}
.native-surface .identity-avatar73 > image {
  width: 100%;
  height: 100%;
}
.native-surface .identity-avatar73 > text {
  display: block;
  max-width: 1em;
  overflow: hidden;
  white-space: nowrap;
  font-size: calc(var(--jy-rpx, 1rpx) * 42);
  font-weight: 600;
}
