/* One calm surface system around the illustrated family; preserve the split Dock silhouette. */
.native-surface { background-color:var(--bg,#f5f8fa); }
.native-impact812 { animation:world-impact812 420ms ease-out both; }
.native-impact812 .page button { animation:control-impact812 480ms ease-out both; }
.native-impact812 .page button:nth-child(2n) { animation-delay:35ms; }
.button-hover { transform:scale(.98);opacity:.9; }
@keyframes world-impact812 { 0%,100% { transform:none; } 18% {transform:translate(6rpx,8rpx)} 38% {transform:translate(-8rpx,-4rpx)} 62% {transform:translate(4rpx,2rpx)} 82% {transform:translate(-2rpx,0)} }
@keyframes control-impact812 { 0%,100% { transform:none; } 28% { transform:translateY(-5rpx) rotate(1.3deg); } 58% { transform:translateY(2rpx) rotate(-.6deg); } }

/* Full-screen impact: the reward scene is outside this page surface. */
.native-impact812{animation:world-impact814 1000ms both;transform-origin:50% 30vh}.native-impact812 .page button{animation:control-impact814 1100ms both}
@keyframes world-impact814{0%,100%{transform:none}14%{transform:translate(40rpx,64rpx) rotate(1.3deg)}32%{transform:translate(-48rpx,-32rpx) rotate(-1.2deg)}48%{transform:translate(36rpx,28rpx) rotate(.8deg)}64%{transform:translate(-28rpx,-20rpx) rotate(-.5deg)}78%{transform:translate(16rpx,12rpx)}90%{transform:translate(-8rpx,-4rpx)}}
@keyframes control-impact814{0%,100%{transform:none}12%{transform:translateY(-56rpx) rotate(10deg)}29%{transform:translateY(28rpx) rotate(-7deg)}46%{transform:translateY(-16rpx) rotate(4deg)}67%{transform:translateY(8rpx) rotate(-2deg)}85%{transform:translateY(-3rpx)}}
