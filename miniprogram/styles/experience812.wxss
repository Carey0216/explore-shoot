/* One calm surface system around the illustrated family; preserve the split Dock silhouette. */
.native-surface {
  background-color: var(--bg, #f5f8fa);
}
.native-impact812 {
  animation: world-impact812 420ms ease-out both;
}
.native-impact812 .page button {
  animation: control-impact812 480ms ease-out both;
}
.native-impact812 .page button:nth-child(2n) {
  animation-delay: 35ms;
}
.button-hover {
  transform: scale(0.98);
  opacity: 0.9;
}
@keyframes world-impact812 {
  0%,
  100% {
    transform: none;
  }
  18% {
    transform: translate(calc(var(--jy-rpx, 1rpx) * 6), calc(var(--jy-rpx, 1rpx) * 8));
  }
  38% {
    transform: translate(calc(var(--jy-rpx, 1rpx) * -8), calc(var(--jy-rpx, 1rpx) * -4));
  }
  62% {
    transform: translate(calc(var(--jy-rpx, 1rpx) * 4), calc(var(--jy-rpx, 1rpx) * 2));
  }
  82% {
    transform: translate(calc(var(--jy-rpx, 1rpx) * -2), 0);
  }
}
@keyframes control-impact812 {
  0%,
  100% {
    transform: none;
  }
  28% {
    transform: translateY(calc(var(--jy-rpx, 1rpx) * -5)) rotate(1.3deg);
  }
  58% {
    transform: translateY(calc(var(--jy-rpx, 1rpx) * 2)) rotate(-0.6deg);
  }
}

/* Full-screen impact: the reward scene is outside this page surface. */
.native-impact812 {
  animation: world-impact814 1000ms both;
  transform-origin: 50% 30vh;
}
.native-impact812 .page button {
  animation: control-impact814 1100ms both;
}
@keyframes world-impact814 {
  0%,
  100% {
    transform: none;
  }
  14% {
    transform: translate(calc(var(--jy-rpx, 1rpx) * 40), calc(var(--jy-rpx, 1rpx) * 64))
      rotate(1.3deg);
  }
  32% {
    transform: translate(calc(var(--jy-rpx, 1rpx) * -48), calc(var(--jy-rpx, 1rpx) * -32))
      rotate(-1.2deg);
  }
  48% {
    transform: translate(calc(var(--jy-rpx, 1rpx) * 36), calc(var(--jy-rpx, 1rpx) * 28))
      rotate(0.8deg);
  }
  64% {
    transform: translate(calc(var(--jy-rpx, 1rpx) * -28), calc(var(--jy-rpx, 1rpx) * -20))
      rotate(-0.5deg);
  }
  78% {
    transform: translate(calc(var(--jy-rpx, 1rpx) * 16), calc(var(--jy-rpx, 1rpx) * 12));
  }
  90% {
    transform: translate(calc(var(--jy-rpx, 1rpx) * -8), calc(var(--jy-rpx, 1rpx) * -4));
  }
}
@keyframes control-impact814 {
  0%,
  100% {
    transform: none;
  }
  12% {
    transform: translateY(calc(var(--jy-rpx, 1rpx) * -56)) rotate(10deg);
  }
  29% {
    transform: translateY(calc(var(--jy-rpx, 1rpx) * 28)) rotate(-7deg);
  }
  46% {
    transform: translateY(calc(var(--jy-rpx, 1rpx) * -16)) rotate(4deg);
  }
  67% {
    transform: translateY(calc(var(--jy-rpx, 1rpx) * 8)) rotate(-2deg);
  }
  85% {
    transform: translateY(calc(var(--jy-rpx, 1rpx) * -3));
  }
}
