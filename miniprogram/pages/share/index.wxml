<wxs src="/services/i18n.wxs" module="i18n"/>
<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{locale==='en-US'?'locale-en':''}} {{themeClass}} {{nativeImpact812?'native-impact812':''}}" style="{{themeStyle}}">
<view wx:if="{{localeTranslated}}" class="locale-note"><text>{{i18n.ui(localeTranslationUnavailable?'内容翻译暂时不可用，当前显示原文。':'内容由机器翻译，原文始终保留。',locale)}}</text><button bindtap="localeToggleOriginal">{{i18n.ui(localeOriginal?'显示译文':'查看原文',locale)}}</button></view>
<view class="share-page"><view wx:if="{{point}}" class="share-background"><remote-image source="{{point.photo}}" full/><view class="point-title">{{i18n.content(point.name,locale,localeTranslations,localeOriginal)}}</view></view><view class="share-shade"/><view class="share-sheet"><view class="share-head"><text>{{i18n.ui('分享给',locale)}}</text><button size="mini" aria-label="{{i18n.ui('关闭分享',locale)}}" bindtap="close">×</button></view><scroll-view scroll-y enhanced class="share-scroll"><view wx:if="{{point}}" class="share-context"><view class="context-photo"><remote-image source="{{point.photo}}"/></view><view><view class="point-title">{{i18n.content(point.name,locale,localeTranslations,localeOriginal)}}</view><text class="muted">{{i18n.ui('分享此地点，或保存为图片海报',locale)}}</text></view></view><view class="share-actions"><button size="mini" open-type="share" class="share-option wechat"><image src="/assets/brand/wechat-official.png"/><text>{{i18n.ui('微信',locale)}}</text></button><button size="mini" class="share-option qq" bindtap="qq"><image src="/assets/brand/qq-official.png"/><text>{{i18n.ui('QQ好友',locale)}}</text></button></view><view class="share-actions secondary"><button size="mini" bindtap="copy"><image src="{{i18n.icon('copy',themeDark || theme==='theme-dark')}}"/><text>{{i18n.ui('复制链接',locale)}}</text></button><button size="mini" bindtap="generate" disabled="{{busy}}"><image src="{{i18n.icon('camera',themeDark || theme==='theme-dark')}}"/><text>{{i18n.ui(busy?'生成中…':'分享图片',locale)}}</text></button><button size="mini" open-type="share"><image src="{{i18n.icon('share',themeDark || theme==='theme-dark')}}"/><text>{{i18n.ui('微信分享',locale)}}</text></button></view><view class="muted">{{i18n.ui('微信使用原生分享卡片；QQ可复制链接后粘贴发送。',locale)}}</view><state-view error="{{error}}"/></scroll-view></view><view wx:if="{{preview}}" class="poster-mask" catchtap="noop"><view class="poster-dialog"><view class="share-head"><text>{{i18n.ui('分享图片',locale)}}</text><button size="mini" aria-label="{{i18n.ui('关闭图片预览',locale)}}" bindtap="closePreview">×</button></view><scroll-view scroll-y enhanced class="poster-scroll"><image class="poster-image" src="{{poster}}" mode="aspectFit" show-menu-by-longpress/><view class="poster-buttons"><button class="primary" bindtap="save">{{i18n.ui('保存图片',locale)}}</button><button bindtap="sendImage">{{i18n.ui('发送图片',locale)}}</button></view><button wx:if="{{albumDenied}}" class="gap" bindtap="permissions">{{i18n.ui('打开相册权限设置',locale)}}</button><view class="muted">{{i18n.ui('也可长按图片保存，再发送给朋友。',locale)}}</view></scroll-view></view></view><canvas id="point-poster" type="2d" class="compression-canvas"/></view>

<experience-layer suspended="{{true}}" features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>

<reward-overlay id="reward-overlay812" items="{{nativeRewardItems812}}" bind:dismiss="dismissNativeRewards812" bind:impact="nativeImpact812"/>
