<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{themeClass}}" style="{{themeStyle}}">
<view class="share-page"><view wx:if="{{point}}" class="share-background"><remote-image source="{{point.photo}}" full/><view class="point-title">{{point.name}}</view></view><view class="share-shade"/><view class="share-sheet"><view class="share-head"><text>分享给</text><button size="mini" aria-label="关闭分享" bindtap="close">×</button></view><scroll-view scroll-y enhanced class="share-scroll"><view wx:if="{{point}}" class="share-context"><view class="context-photo"><remote-image source="{{point.photo}}"/></view><view><view class="point-title">{{point.name}}</view><text class="muted">分享此地点，或保存为图片海报</text></view></view><view class="share-actions"><button size="mini" open-type="share" class="share-option wechat"><image src="/assets/brand/wechat-official.png"/><text>微信</text></button><button size="mini" class="share-option qq" bindtap="qq"><image src="/assets/brand/qq-official.png"/><text>QQ好友</text></button></view><view class="share-actions secondary"><button size="mini" bindtap="copy"><image src="/assets/tools/copy{{themeDark ? '-dark' : ''}}.png"/><text>复制链接</text></button><button size="mini" bindtap="generate" disabled="{{busy}}"><image src="/assets/tools/camera{{themeDark ? '-dark' : ''}}.png"/><text>{{busy?'生成中…':'分享图片'}}</text></button><button size="mini" open-type="share"><image src="/assets/tools/share{{themeDark ? '-dark' : ''}}.png"/><text>微信分享</text></button></view><view class="muted">微信使用原生分享卡片；QQ可复制链接后粘贴发送。</view><state-view error="{{error}}"/></scroll-view></view><view wx:if="{{preview}}" class="poster-mask" catchtap="noop"><view class="poster-dialog"><view class="share-head"><text>分享图片</text><button size="mini" aria-label="关闭图片预览" bindtap="closePreview">×</button></view><scroll-view scroll-y enhanced class="poster-scroll"><image class="poster-image" src="{{poster}}" mode="aspectFit" show-menu-by-longpress/><view class="poster-buttons"><button class="primary" bindtap="save">保存图片</button><button bindtap="sendImage">发送图片</button></view><button wx:if="{{albumDenied}}" class="gap" bindtap="permissions">打开相册权限设置</button><view class="muted">也可长按图片保存，再发送给朋友。</view></scroll-view></view></view><canvas id="point-poster" type="2d" class="compression-canvas"/></view>

<experience-layer suspended="{{true}}" features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>
