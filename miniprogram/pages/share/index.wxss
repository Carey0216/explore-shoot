.share-page {
  height: 100vh;
  overflow: hidden;
  background: var(--bg);
}
.share-background {
  height: 70vh;
  overflow: hidden;
}
.share-background .point-title {
  padding: calc(var(--jy-rpx, 1rpx) * 30);
}
.share-shade {
  position: fixed;
  inset: 0;
  background: #0006;
}
.share-sheet {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  max-height: 78vh;
  display: flex;
  flex-direction: column;
  background: var(--surface);
  border-radius: calc(var(--jy-rpx, 1rpx) * 44) calc(var(--jy-rpx, 1rpx) * 44) 0 0;
  overflow: hidden;
  padding-bottom: env(safe-area-inset-bottom);
  animation: share-in 0.25s ease-out;
}
.share-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: calc(var(--jy-rpx, 1rpx) * 16);
  padding: calc(var(--jy-rpx, 1rpx) * 24) calc(var(--jy-rpx, 1rpx) * 30);
  flex-shrink: 0;
  border-bottom: calc(var(--jy-rpx, 1rpx) * 1) solid var(--line);
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 36) * var(--font-scale, 1));
  font-weight: 700;
}
.share-head button {
  width: calc(var(--jy-rpx, 1rpx) * 80);
  height: calc(var(--jy-rpx, 1rpx) * 80);
  line-height: calc(var(--jy-rpx, 1rpx) * 70);
  padding: 0;
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 42) * var(--font-scale, 1));
  border-radius: 50%;
  box-shadow: none;
}
.share-scroll {
  height: calc(var(--jy-rpx, 1rpx) * 650);
  max-height: 62vh;
  padding: calc(var(--jy-rpx, 1rpx) * 24) calc(var(--jy-rpx, 1rpx) * 34);
  box-sizing: border-box;
}
.share-context {
  display: flex;
  align-items: center;
  gap: calc(var(--jy-rpx, 1rpx) * 24);
  padding: calc(var(--jy-rpx, 1rpx) * 22);
  border: calc(var(--jy-rpx, 1rpx) * 1) solid var(--line);
  border-radius: calc(var(--jy-rpx, 1rpx) * 34);
}
.context-photo {
  width: calc(var(--jy-rpx, 1rpx) * 110);
  height: calc(var(--jy-rpx, 1rpx) * 110);
  overflow: hidden;
  border-radius: calc(var(--jy-rpx, 1rpx) * 23);
  flex-shrink: 0;
}
.share-context > view + view {
  min-width: 0;
}
.share-context .point-title {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 26) * var(--font-scale, 1));
}
.share-context .muted {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 22) * var(--font-scale, 1));
}
.share-actions {
  display: flex;
  gap: calc(var(--jy-rpx, 1rpx) * 34);
  padding: calc(var(--jy-rpx, 1rpx) * 32) 0;
}
.share-actions button {
  width: calc(var(--jy-rpx, 1rpx) * 145);
  padding: 0;
  background: none;
  box-shadow: none;
  border: 0;
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: calc(var(--jy-rpx, 1rpx) * 16);
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 23) * var(--font-scale, 1));
  line-height: 1.5;
}
.share-actions image {
  width: calc(var(--jy-rpx, 1rpx) * 100);
  height: calc(var(--jy-rpx, 1rpx) * 100);
  object-fit: contain;
  border-radius: 50%;
}
.share-actions button:after {
  border: 0;
}
.secondary {
  border-top: calc(var(--jy-rpx, 1rpx) * 1) solid var(--line);
}
.secondary image {
  padding: calc(var(--jy-rpx, 1rpx) * 26);
  background: var(--raised);
}
.share-scroll > .muted {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 22) * var(--font-scale, 1));
}
.poster-mask {
  position: fixed;
  inset: 0;
  z-index: 8000;
  background: #0007;
  display: flex;
  align-items: center;
  padding: calc(var(--jy-rpx, 1rpx) * 20);
}
.poster-dialog {
  width: 100%;
  max-height: calc(100vh - calc(var(--jy-rpx, 1rpx) * 40));
  overflow: hidden;
  border-radius: calc(var(--jy-rpx, 1rpx) * 42);
  background: var(--surface);
  display: flex;
  flex-direction: column;
}
.poster-scroll {
  height: calc(100vh - calc(var(--jy-rpx, 1rpx) * 220));
  max-height: calc(var(--jy-rpx, 1rpx) * 1250);
  padding: calc(var(--jy-rpx, 1rpx) * 22);
  box-sizing: border-box;
}
.poster-image {
  display: block;
  width: 100%;
  height: calc(100vh - calc(var(--jy-rpx, 1rpx) * 430));
  max-height: calc(var(--jy-rpx, 1rpx) * 950);
}
.poster-buttons {
  display: flex;
  gap: calc(var(--jy-rpx, 1rpx) * 20);
  margin: calc(var(--jy-rpx, 1rpx) * 18) 0;
}
.poster-buttons button {
  flex: 1;
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 27) * var(--font-scale, 1));
}
.poster-scroll > .muted {
  text-align: center;
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 22) * var(--font-scale, 1));
}
.compression-canvas {
  position: absolute;
  left: -2000px;
  top: -2000px;
  width: 900px;
  height: 1200px;
}
@keyframes share-in {
  from {
    transform: translateY(calc(var(--jy-rpx, 1rpx) * 16));
    opacity: 0;
  }
  to {
    transform: none;
    opacity: 1;
  }
}

.share-head button {
  flex: 0 0 calc(var(--jy-rpx, 1rpx) * 80);
  min-width: calc(var(--jy-rpx, 1rpx) * 80);
  max-width: calc(var(--jy-rpx, 1rpx) * 80);
  margin: 0;
}
.share-actions button {
  flex: 0 0 calc(var(--jy-rpx, 1rpx) * 145);
  min-width: calc(var(--jy-rpx, 1rpx) * 145);
  max-width: calc(var(--jy-rpx, 1rpx) * 145);
  margin: 0;
}
.share-actions image {
  box-sizing: border-box;
}
.share-option.wechat image {
  background: #07c160;
  padding: calc(var(--jy-rpx, 1rpx) * 18);
}
.share-option.qq image {
  background: #12b7f5;
  padding: calc(var(--jy-rpx, 1rpx) * 18);
}
.share-scroll {
  height: calc(var(--jy-rpx, 1rpx) * 800);
}
