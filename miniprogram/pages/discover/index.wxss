.theme-strip {
  white-space: nowrap;
  margin: 22rpx 0;
}
.theme-items {
  display: flex;
  gap: 14rpx;
  padding: 6rpx 0;
}
.theme {
  flex-shrink: 0;
  font-size: 23rpx;
  line-height: 64rpx;
  padding: 0 20rpx;
  box-shadow: inset 0 2rpx #fff;
}
.theme.chosen {
  background: #dbeaf1;
  color: #315f7a;
}
