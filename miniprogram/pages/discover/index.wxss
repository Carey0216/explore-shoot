.theme-strip {
  white-space: nowrap;
  margin: calc(var(--jy-rpx, 1rpx) * 22) 0;
}
.theme-items {
  display: flex;
  gap: calc(var(--jy-rpx, 1rpx) * 14);
  padding: calc(var(--jy-rpx, 1rpx) * 6) 0;
}
.theme {
  flex-shrink: 0;
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 23) * var(--font-scale, 1));
  line-height: calc(var(--jy-rpx, 1rpx) * 64);
  padding: 0 calc(var(--jy-rpx, 1rpx) * 20);
  box-shadow: inset 0 calc(var(--jy-rpx, 1rpx) * 2) #fff;
}
.theme.chosen {
  background: #dbeaf1;
  color: #315f7a;
}

.guide-banner {
  display: flex;
  align-items: center;
  gap: calc(var(--jy-rpx, 1rpx) * 24);
  padding: calc(var(--jy-rpx, 1rpx) * 28);
  margin: calc(var(--jy-rpx, 1rpx) * 4) 0 calc(var(--jy-rpx, 1rpx) * 28);
  border: calc(var(--jy-rpx, 1rpx) * 1) solid var(--line);
  border-radius: calc(var(--jy-rpx, 1rpx) * 36);
  background: var(--selected);
}
.guide-banner image {
  width: calc(var(--jy-rpx, 1rpx) * 64);
  height: calc(var(--jy-rpx, 1rpx) * 64);
  flex-shrink: 0;
}
.guide-banner > view {
  flex: 1;
  min-width: 0;
}
.guide-banner > text {
  font-size: calc(var(--jy-rpx, 1rpx) * 36);
  color: var(--accent);
}
.theme.chosen {
  background: var(--selected);
  color: var(--accent);
}

.theme-items button.theme {
  width: auto;
  flex: 0 0 auto;
  min-width: calc(var(--jy-rpx, 1rpx) * 100);
  min-height: calc(var(--jy-rpx, 1rpx) * 76);
  padding: 0 calc(var(--jy-rpx, 1rpx) * 24);
  margin: 0;
}
.theme-items {
  width: max-content;
}
