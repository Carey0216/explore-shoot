<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{themeClass}}" style="{{themeStyle}}">

<view class="page"><community-header id="community-header" active="discover"/>
<view wx:if="{{siteContent.notice}}" class="notice gap">{{siteContent.notice}}</view><view class="row between"><view class="feed-heading">发现校园</view><button size="mini" class="small" wx:if="{{features['exploration'].visible!==false}}" bindtap="routes">探索路线 ↗</button></view><view class="guide-banner" wx:if="{{features['exploration'].visible!==false}}" bindtap="guides"><image src="/assets/tools/book{{themeDark ? '-dark' : ''}}.png"/><view><view class="point-title">从哪里开始拍？</view><text class="muted">新生入门 · 课间 · 饭后 · 周末</text></view><text>↗</text></view>
<scroll-view scroll-x class="theme-strip"><view class="theme-items"><button size="mini" wx:for="{{themes}}" wx:key="*this" class="theme {{theme===item?'chosen':''}}" data-id="{{item}}" bindtap="filter">{{item==='全部'?'为你推荐':item}}</button></view></scroll-view>
<view wx:if="{{lead}}" class="discover-feature73"><view class="feature-photo73" data-id="{{lead.id}}" bindtap="open"><remote-image source="{{lead.photo}}" mode="aspectFill" eager/><text class="photo-caption73">{{lead.theme}} / {{lead.name}}</text></view><view class="feature-title73">{{lead.name}}</view><view class="muted">{{lead.photoIsReference?'校园参考配图':lead.authorName}}</view><view class="shooting-line73">{{lead.shootingLine}}</view><view class="row"><button size="mini" class="primary" data-id="{{lead.id}}" bindtap="open">去拍这张 →</button><button size="mini" class="text-button73" bindtap="routes" wx:if="{{features.exploration.visible!==false}}">沿路再走走 →</button></view></view><view class="section-title" wx:if="{{stories.length}}">换个方向看看</view><view class="stories-grid73"><view wx:for="{{stories}}" wx:key="id" class="content-story73" data-id="{{item.id}}" bindtap="open"><view class="story-photo73"><remote-image source="{{item.photo}}" mode="aspectFill" eager/></view><view class="story-title73">{{item.name}}</view><view class="story-line73">{{item.shootingLine}}</view><view class="privacy">{{item.photoIsReference?'校园参考配图':item.authorName}}</view></view></view>
<button wx:if="{{hasMore}}" class="gap" bindtap="more">加载更多发现</button><state-view loading="{{loading}}" error="{{error}}" empty="{{!points.length}}" bind:retry="load"/></view>
<site-overlay id="site-overlay" content="{{siteContent}}" runtime="{{runtime}}" announcement="{{announcement}}" page="discover" bind:dismiss="dismissPublicOverlay" bind:overlay="publicOverlay"/>

<experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>
