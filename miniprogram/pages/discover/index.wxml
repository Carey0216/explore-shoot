<page-meta page-style="{{publicOverlayOpen ? 'overflow: hidden;' : ''}}"/>
<view class="page"><view wx:if="{{siteContent.notice}}" class="notice gap">{{siteContent.notice}}</view><view class="eyebrow">CAMPUS COLLECTION</view><view class="title">校园里的好去处</view>
  <view class="card passport-entry" bindtap="passport"><view class="point-title">校园打卡护照</view><view class="muted gap">查看收集进度、主题印章与点亮楼宇 →</view></view>
  <view class="row wrap gap"><text wx:for="{{themes}}" wx:key="*this" class="tag">{{item}}</text></view>
  <view class="section-title">看看这些地方</view>
  <view wx:for="{{points}}" wx:key="id" class="card point-card" bindtap="open" data-id="{{item.id}}"><view class="photo"><remote-image source="{{item.photo}}"/></view><view class="point-copy"><view class="point-title">{{item.name}} ›</view><view wx:if="{{item.photoIsReference}}" class="muted">校园参考配图 · 非该机位实拍</view></view></view>
  <state-view loading="{{loading}}" error="{{error}}" empty="{{!points.length}}" bind:retry="load"/>
</view>

<site-overlay id="site-overlay" content="{{siteContent}}" runtime="{{runtime}}" announcement="{{announcement}}" page="discover" bind:dismiss="dismissPublicOverlay" bind:overlay="publicOverlay"/>
