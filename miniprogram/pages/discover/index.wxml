<wxs src="/services/i18n.wxs" module="i18n"/>
<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{locale==='en-US'?'locale-en':''}} {{themeClass}} {{nativeImpact812?'native-impact812':''}}" style="{{themeStyle}}">


<view class="page"><community-header id="community-header" active="discover"/>
<view wx:if="{{localeTranslated}}" class="locale-note"><text>{{i18n.ui(localeTranslationUnavailable?'内容翻译暂时不可用，当前显示原文。':'内容由机器翻译，原文始终保留。',locale)}}</text><button bindtap="localeToggleOriginal">{{i18n.ui(localeOriginal?'显示译文':'查看原文',locale)}}</button></view>
<view wx:if="{{siteContent.notice}}" class="notice gap">{{i18n.content(siteContent.notice,locale,localeTranslations,localeOriginal)}}</view><view class="row between"><view class="feed-heading">{{i18n.ui('发现校园',locale)}}</view><button size="mini" class="small route-link" wx:if="{{features['exploration'].visible!==false}}" bindtap="routes">{{i18n.ui('探索路线 ↗',locale)}}</button></view><view class="guide-banner" wx:if="{{features['exploration'].visible!==false}}" bindtap="guides"><image src="{{i18n.icon('book',themeDark || theme==='theme-dark')}}"/><view><view class="point-title">{{i18n.ui('从哪里开始拍？',locale)}}</view><text class="muted">{{i18n.ui('新生入门 · 短途路线',locale)}}</text></view><text>↗</text></view>
<campus-collection wx:if="{{!nativeRewardItems812.length && !nativeOverlayOpen && !publicOverlayOpen && features.passport.visible!==false}}"/><scroll-view scroll-x class="theme-strip"><view class="theme-items"><button size="mini" wx:for="{{themes}}" wx:key="*this" class="theme {{theme===item?'chosen':''}}" data-id="{{item}}" bindtap="filter">{{i18n.ui(item==='全部'?'为你推荐':item,locale)}}</button></view></scroll-view>
<view wx:if="{{lead}}" class="discover-feature73"><view class="feature-photo73" data-id="{{lead.id}}" bindtap="open"><remote-image source="{{lead.photo}}" mode="aspectFill" eager/><text class="photo-caption73">{{i18n.content(lead.theme,locale,localeTranslations,localeOriginal)}} / {{i18n.content(lead.name,locale,localeTranslations,localeOriginal)}}</text></view><view class="feature-title73">{{i18n.content(lead.name,locale,localeTranslations,localeOriginal)}}</view><view class="muted">{{i18n.ui(lead.photoIsReference?'校园参考配图':lead.authorName,locale)}}</view><view class="shooting-line73">{{i18n.content(lead.shootingLine,locale,localeTranslations,localeOriginal)}}</view><view class="row"><button size="mini" class="primary" data-id="{{lead.id}}" bindtap="open">{{i18n.ui('去拍这张 →',locale)}}</button><button size="mini" class="text-button73" bindtap="routes" wx:if="{{features.exploration.visible!==false}}">{{i18n.ui('沿路再走走 →',locale)}}</button></view></view><view class="section-title" wx:if="{{stories.length}}">{{i18n.ui('换个方向看看',locale)}}</view><view class="stories-grid73"><view wx:for="{{stories}}" wx:key="id" class="content-story73" data-id="{{item.id}}" bindtap="open"><view class="story-photo73"><remote-image source="{{item.photo}}" mode="aspectFill" eager/></view><view class="story-title73">{{i18n.content(item.name,locale,localeTranslations,localeOriginal)}}</view><view class="story-line73">{{i18n.content(item.shootingLine,locale,localeTranslations,localeOriginal)}}</view><view class="privacy">{{i18n.ui(item.photoIsReference?'校园参考配图':item.authorName,locale)}}</view></view></view>
<button wx:if="{{hasMore}}" class="gap" bindtap="more">{{i18n.ui('加载更多发现',locale)}}</button><state-view skeleton="{{loading&&!points.length}}" loading="{{loading}}" error="{{error}}" empty="{{!points.length}}" bind:retry="load"/></view>
<site-overlay id="site-overlay" content="{{siteContent}}" runtime="{{runtime}}" announcement="{{announcement}}" page="discover" bind:dismiss="dismissPublicOverlay" bind:overlay="publicOverlay"/>

<experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>

<reward-overlay id="reward-overlay812" items="{{nativeRewardItems812}}" bind:dismiss="dismissNativeRewards812" bind:impact="nativeImpact812"/>
