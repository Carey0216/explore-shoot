<view class="page"><view wx:if="{{topic}}" class="card"><view class="title">{{topic.title}}</view><view class="muted gap">{{topic.startsAt}} — {{topic.endsAt}}</view><view class="gap">{{topic.description}}</view><button wx:for="{{topic.points}}" wx:key="id" class="gap" data-id="{{item.id}}" bindtap="place">{{item.name}} ↗</button><button wx:if="{{topic.phase!=='ended'}}" class="gap" bindtap="remind">{{subscribed?'取消活动提醒':'提醒我参加'}}</button><button class="primary gap" bindtap="passport">查看我的护照</button></view><state-view error="{{error}}"/></view>