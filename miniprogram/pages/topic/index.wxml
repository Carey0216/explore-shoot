<view class="page"><block wx:if="{{topic}}"><view class="activity-hero"><remote-image source="{{topic.photo}}" full/><text>{{topic.credit}} · 非活动现场照片</text></view><view class="card activity-detail"><view class="pill">{{topic.phaseText}}</view><view class="title gap">{{topic.title}}</view><view class="muted gap">时间　{{topic.time}}</view><view class="gap">主题　{{topic.themeText}}</view><view class="gap">活动期间你已打卡 {{topic.visited}} 个地点</view><view class="activity-description gap">{{topic.description}}</view><button wx:if="{{topic.phase!=='ended'}}" class="primary gap" bindtap="remind">{{subscribed?'取消活动提醒':'提醒我参加'}}</button><button class="gap" bindtap="passport">查看我的护照</button><view class="section-title">活动地点 · {{topic.points.length}}</view><view wx:for="{{topic.points}}" wx:key="id" class="location-row" data-id="{{item.id}}" bindtap="place">{{item.name}} ↗</view><view class="section-title">主题印章 · {{topic.stamps.length}}</view><view wx:for="{{topic.stamps}}" wx:key="id" class="pill gap">{{item.title}} {{item.progress}}/{{item.target}} {{item.earned?'✓':''}}</view><view class="muted gap">按活动期间真实打卡统计，完成拍摄计划不代替打卡。</view></view></block><state-view error="{{error}}"/></view>