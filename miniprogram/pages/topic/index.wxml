<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{themeClass}}" style="{{themeStyle}}">
<view wx:if="{{featureBlocked}}" class="page"><view class="empty" role="status">功能正在维护中，敬请期待…</view></view><block wx:else>
<view class="page"><block wx:if="{{topic}}"><view class="activity-hero"><remote-image source="{{topic.photo}}" full/><text>{{topic.credit}} · 非活动现场照片</text></view><view class="card activity-detail"><view class="pill">{{topic.phaseText}}</view><view class="title gap">{{topic.title}}</view><view class="muted gap">时间　{{topic.time}}</view><view class="gap">主题　{{topic.themeText}}</view><view class="gap">活动期间你已打卡 {{topic.visited}} 个地点</view><view class="topic-next73" wx:if="{{topic.points.length}}"><view class="section-title73">{{topic.complete?'这段足迹，已经留下':topic.phase==='active'?'从下一站开始':topic.phase==='upcoming'?'先收下一份出发计划':'回看这次校园探索'}}</view><view class="progress-track73"><view style="width:{{topic.progress}}%"/></view><text class="muted">真实打卡进度 {{topic.progress}}%</text><button wx:if="{{topic.next}}" class="primary gap" data-id="{{topic.next.id}}" bindtap="place">下一站 · {{topic.next.name}} →</button></view><view class="activity-description gap">{{topic.description}}</view><button wx:if="{{topic.phase!=='ended'}}" class="primary gap" bindtap="remind">{{subscribed?'取消活动提醒':'提醒我参加'}}</button><button class="gap" wx:if="{{features['passport'].visible!==false}}" bindtap="passport">查看我的护照</button><view class="section-title">活动地点 · {{topic.points.length}}</view><view wx:for="{{topic.points}}" wx:key="id" class="location-row" data-id="{{item.id}}" bindtap="place">{{item.name}} ↗</view><view class="section-title">主题印章 · {{topic.stamps.length}}</view><view class="stamp-grid"><view wx:for="{{topic.stamps}}" wx:key="id" class="stamp-card"><image class="{{item.earned?'':'locked'}}" src="{{item.badge}}"/><view><view>{{item.title}}</view><text class="muted">{{item.earned?'已获得':'进度'}} {{item.progress}}/{{item.target}}</text></view></view></view><view class="muted gap">按活动期间真实打卡统计，完成拍摄计划不代替打卡。</view></view></block><state-view error="{{error}}"/></view>
</block>
<experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>
