<wxs src="/services/i18n.wxs" module="i18n"/>
<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{locale==='en-US'?'locale-en':''}} {{themeClass}} {{nativeImpact812?'native-impact812':''}}" style="{{themeStyle}}">
<view wx:if="{{localeTranslated}}" class="locale-note"><text>{{i18n.ui(localeTranslationUnavailable?'内容翻译暂时不可用，当前显示原文。':'内容由机器翻译，原文始终保留。',locale)}}</text><button bindtap="localeToggleOriginal">{{i18n.ui(localeOriginal?'显示译文':'查看原文',locale)}}</button></view>
<view wx:if="{{featureBlocked}}" class="page"><view class="empty" role="status">{{i18n.ui('功能正在维护中，敬请期待…',locale)}}</view></view><block wx:else>
<view class="page"><campus-collection wx:if="{{!nativeRewardItems812.length && !nativeOverlayOpen && !publicOverlayOpen && features.passport.visible!==false}}"/><block wx:if="{{topic}}"><view class="activity-hero"><remote-image source="{{topic.photo}}" full/><text>{{i18n.content(topic.credit,locale,localeTranslations,localeOriginal)}} {{i18n.ui('· 非活动现场照片',locale)}}</text></view><view class="card activity-detail"><view class="pill">{{i18n.content(topic.phaseText,locale,localeTranslations,localeOriginal)}}</view><view class="title gap">{{i18n.content(topic.title,locale,localeTranslations,localeOriginal)}}</view><view class="muted gap">{{i18n.ui('时间',locale)}}　{{i18n.content(topic.time,locale,localeTranslations,localeOriginal)}}</view><view class="gap">{{i18n.ui('主题',locale)}}　{{i18n.content(topic.themeText,locale,localeTranslations,localeOriginal)}}</view><view class="gap">{{i18n.ui('活动期间你已打卡',locale)}} {{i18n.content(topic.visited,locale,localeTranslations,localeOriginal)}} {{i18n.ui('个地点',locale)}}</view><view class="topic-next73" wx:if="{{topic.points.length}}"><view class="section-title73">{{i18n.ui(topic.complete?'这段足迹，已经留下':topic.phase==='active'?'从下一站开始':topic.phase==='upcoming'?'先收下一份出发计划':'回看这次校园探索',locale)}}</view><view class="progress-track73"><view style="width:{{topic.progress}}%"/></view><text class="muted">{{i18n.ui('真实打卡进度',locale)}} {{i18n.content(topic.progress,locale,localeTranslations,localeOriginal)}}%</text><button wx:if="{{topic.next}}" class="primary gap" data-id="{{topic.next.id}}" bindtap="place">{{i18n.ui('下一站 ·',locale)}} {{i18n.content(topic.next.name,locale,localeTranslations,localeOriginal)}} →</button></view><view class="activity-description gap">{{i18n.content(topic.description,locale,localeTranslations,localeOriginal)}}</view><button wx:if="{{topic.phase!=='ended'}}" class="primary gap" bindtap="remind">{{i18n.ui(subscribed?'取消活动提醒':'提醒我参加',locale)}}</button><button class="gap" wx:if="{{features['passport'].visible!==false}}" bindtap="passport">{{i18n.ui('查看我的护照',locale)}}</button><view class="section-title">{{i18n.ui('活动地点 ·',locale)}} {{i18n.content(topic.points.length,locale,localeTranslations,localeOriginal)}}</view><view wx:for="{{topic.points}}" wx:key="id" class="location-row" data-id="{{item.id}}" bindtap="place">{{i18n.content(item.name,locale,localeTranslations,localeOriginal)}} ↗</view><view class="section-title">{{i18n.ui('主题印章 ·',locale)}} {{i18n.content(topic.stamps.length,locale,localeTranslations,localeOriginal)}}</view><view class="stamp-grid"><view wx:for="{{topic.stamps}}" wx:key="id" class="stamp-card"><image class="{{item.earned?'':'locked'}}" src="{{item.badge}}"/><view><view>{{i18n.content(item.title,locale,localeTranslations,localeOriginal)}}</view><text class="muted">{{i18n.ui(item.earned?'已获得':'进度',locale)}} {{i18n.content(item.progress,locale,localeTranslations,localeOriginal)}}/{{i18n.content(item.target,locale,localeTranslations,localeOriginal)}}</text></view></view></view><view class="muted gap">{{i18n.ui('按活动期间真实打卡统计，完成拍摄计划不代替打卡。',locale)}}</view></view></block><state-view error="{{error}}"/></view>
</block>
<experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>

<reward-overlay id="reward-overlay812" items="{{nativeRewardItems812}}" bind:dismiss="dismissNativeRewards812" bind:impact="nativeImpact812"/>
