.activity-hero {
  position: relative;
  overflow: hidden;
  border-radius: 36rpx;
  margin-bottom: -32rpx;
}
.activity-hero text {
  position: absolute;
  bottom: 40rpx;
  left: 20rpx;
  font-size: calc(20rpx * var(--font-scale, 1));
  background: #fffd;
  padding: 8rpx 14rpx;
  border-radius: 18rpx;
}
.activity-detail {
  position: relative;
}
.activity-detail .title {
  font-size: calc(40rpx * var(--font-scale, 1));
}
.activity-description {
  white-space: pre-wrap;
  line-height: 1.9;
}
.location-row {
  padding: 22rpx;
  background: #edf3f4;
  margin-top: 12rpx;
  border-radius: 22rpx;
}

.stamp-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.stamp-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  border-radius: 28rpx;
  background: var(--raised);
  padding: 20rpx;
  font-size: calc(26rpx * var(--font-scale, 1));
}
.stamp-card image {
  flex-shrink: 0;
  width: 82rpx;
  height: 82rpx;
}
.stamp-card .locked {
  filter: grayscale(1);
  opacity: 0.45;
}
.stamp-card > view {
  min-width: 0;
  overflow-wrap: anywhere;
}
