.activity-hero {
  position: relative;
  overflow: hidden;
  border-radius: 36rpx;
  margin-bottom: -32rpx;
}
.activity-hero text {
  position: absolute;
  bottom: 40rpx;
  left: 20rpx;
  font-size: 20rpx;
  background: #fffd;
  padding: 8rpx 14rpx;
  border-radius: 18rpx;
}
.activity-detail {
  position: relative;
}
.activity-detail .title {
  font-size: 40rpx;
}
.activity-description {
  white-space: pre-wrap;
  line-height: 1.9;
}
.location-row {
  padding: 22rpx;
  background: #edf3f4;
  margin-top: 12rpx;
  border-radius: 22rpx;
}
