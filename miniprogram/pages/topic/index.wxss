.activity-hero {
  position: relative;
  overflow: hidden;
  border-radius: calc(var(--jy-rpx, 1rpx) * 36);
  margin-bottom: calc(var(--jy-rpx, 1rpx) * -32);
}
.activity-hero text {
  position: absolute;
  bottom: calc(var(--jy-rpx, 1rpx) * 40);
  left: calc(var(--jy-rpx, 1rpx) * 20);
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 20) * var(--font-scale, 1));
  background: #fffd;
  padding: calc(var(--jy-rpx, 1rpx) * 8) calc(var(--jy-rpx, 1rpx) * 14);
  border-radius: calc(var(--jy-rpx, 1rpx) * 18);
}
.activity-detail {
  position: relative;
}
.activity-detail .title {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 40) * var(--font-scale, 1));
}
.activity-description {
  white-space: pre-wrap;
  line-height: 1.9;
}
.location-row {
  padding: calc(var(--jy-rpx, 1rpx) * 22);
  background: #edf3f4;
  margin-top: calc(var(--jy-rpx, 1rpx) * 12);
  border-radius: calc(var(--jy-rpx, 1rpx) * 22);
}

.stamp-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: calc(var(--jy-rpx, 1rpx) * 16);
}
.stamp-card {
  display: flex;
  align-items: center;
  gap: calc(var(--jy-rpx, 1rpx) * 16);
  border-radius: calc(var(--jy-rpx, 1rpx) * 28);
  background: var(--raised);
  padding: calc(var(--jy-rpx, 1rpx) * 20);
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 26) * var(--font-scale, 1));
}
.stamp-card image {
  flex-shrink: 0;
  width: calc(var(--jy-rpx, 1rpx) * 82);
  height: calc(var(--jy-rpx, 1rpx) * 82);
}
.stamp-card .locked {
  filter: grayscale(1);
  opacity: 0.45;
}
.stamp-card > view {
  min-width: 0;
  overflow-wrap: anywhere;
}
