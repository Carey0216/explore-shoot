<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{themeClass}}" style="{{themeStyle}}">
<view wx:if="{{featureBlocked}}" class="page"><view class="empty" role="status">功能正在维护中，敬请期待…</view></view><block wx:else>
<view class="page"><view class="eyebrow">发现身边，拍好一张</view><view class="title">{{guide?guide.title:'校园拍摄指南'}}</view><view class="muted gap">从一个角落开始，把今天的校园收进镜头。</view><block wx:if="{{!guide}}"><scroll-view scroll-x class="scroll-chips"><button wx:for="{{scenes}}" wx:key="id" class="pill {{scene===item.id?'active':''}}" data-id="{{item.id}}" bindtap="filter">{{item.name}}</button></scroll-view><view class="card guide-card" wx:for="{{visible}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view class="muted">{{item.minutes}} 分钟 · {{item.points.length}} 个地点</view><view class="point-title gap">{{item.title}}</view><text class="copy">{{item.description}}</text><text class="link">查看拍摄步骤 ↗</text></view></block><block wx:else><view class="card"><text class="copy">{{guide.description}}</text><view class="guide-step" wx:for="{{guide.steps}}" wx:key="index"><text class="step-number">{{index+1}}</text><text>{{item}}</text></view></view><view class="section-title">去这些地方试试</view><button class="gap" wx:for="{{guide.points}}" wx:key="id" data-id="{{item.id}}" bindtap="place">{{item.name}} ↗</button></block><button class="primary gap" bindtap="compose">帮我安排一次拍摄</button><view wx:if="{{compose}}" class="card"><view class="point-title">先预览，再决定出发</view><textarea value="{{question}}" data-key="question" bindinput="field" maxlength="300" placeholder-class="field-placeholder" placeholder="例如：饭后想用手机拍一点建筑细节"/><view class="row"><text>时间预算（分钟）</text><input type="number" value="{{budget}}" data-key="budget" bindinput="field"/></view><button class="primary" bindtap="preview" loading="{{busy}}">生成预览</button></view><view wx:if="{{preview}}" class="card"><view class="pill">预览 · 尚未保存</view><view class="point-title gap">{{preview.plan.title}}</view><text class="copy muted">{{preview.notice}}</text><view wx:for="{{preview.plan.items}}" wx:key="id" class="guide-step"><text class="step-number">{{index+1}}</text><view><view class="point-title">{{item.title}}</view><text>{{item.composition}}</text><text class="muted">约 {{item.minutes}} 分钟</text></view></view><view class="muted">{{preview.schedule.estimateNotice}}</view><button wx:if="{{preview.canSave}}" bindtap="save" class="primary gap" disabled="{{busy}}">确认加入我的清单</button></view><state-view error="{{error}}" loading="{{loading}}" bind:retry="load"/></view>

</block>
<experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>
