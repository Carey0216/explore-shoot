<wxs src="/services/i18n.wxs" module="i18n"/>
<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen || compose ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{locale==='en-US'?'locale-en':''}} {{themeClass}} {{nativeImpact812?'native-impact812':''}}" style="{{themeStyle}}">
<view wx:if="{{localeTranslated}}" class="locale-note"><text>{{i18n.ui(localeTranslationUnavailable?'内容翻译暂时不可用，当前显示原文。':'内容由机器翻译，原文始终保留。',locale)}}</text><button bindtap="localeToggleOriginal">{{i18n.ui(localeOriginal?'显示译文':'查看原文',locale)}}</button></view>
<view wx:if="{{featureBlocked}}" class="page"><view class="empty" role="status">{{i18n.ui('功能正在维护中，敬请期待…',locale)}}</view></view><block wx:else>
<view class="page"><view class="eyebrow">{{i18n.ui('发现身边，拍好一张',locale)}}</view><view class="title">{{i18n.ui(guide?guide.title:'校园拍摄指南',locale)}}</view><view class="muted gap">{{i18n.ui('从一个角落开始，把今天的校园收进镜头。',locale)}}</view><block wx:if="{{!guide}}"><scroll-view scroll-x class="scroll-chips"><button wx:for="{{scenes}}" wx:key="id" class="pill {{scene===item.id?'active':''}}" data-id="{{item.id}}" bindtap="filter">{{i18n.content(item.name,locale,localeTranslations,localeOriginal)}}</button></scroll-view><view class="card guide-card" wx:for="{{visible}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view class="muted">{{i18n.content(item.minutes,locale,localeTranslations,localeOriginal)}} {{i18n.ui('分钟 ·',locale)}} {{i18n.content(item.points.length,locale,localeTranslations,localeOriginal)}} {{i18n.ui('个地点',locale)}}</view><view class="point-title gap">{{i18n.content(item.title,locale,localeTranslations,localeOriginal)}}</view><text class="copy">{{i18n.content(item.description,locale,localeTranslations,localeOriginal)}}</text><text class="link">{{i18n.ui('查看拍摄步骤 ↗',locale)}}</text></view></block><block wx:else><view class="card"><text class="copy">{{i18n.content(guide.description,locale,localeTranslations,localeOriginal)}}</text><view class="guide-step" wx:for="{{guide.steps}}" wx:key="index"><text class="step-number">{{i18n.content(index+1,locale,localeTranslations,localeOriginal)}}</text><text>{{i18n.content(item,locale,localeTranslations,localeOriginal)}}</text></view></view><view class="section-title">{{i18n.ui('去这些地方试试',locale)}}</view><button class="gap" wx:for="{{guide.points}}" wx:key="id" data-id="{{item.id}}" bindtap="place">{{i18n.content(item.name,locale,localeTranslations,localeOriginal)}} ↗</button></block><button class="primary gap" bindtap="compose">{{i18n.ui('帮我安排一次拍摄',locale)}}</button><state-view error="{{error}}" loading="{{loading}}" bind:retry="load"/></view>

</block>
<view wx:if="{{compose}}" class="plan-popover-mask" style="bottom:{{planKeyboardHeight}}px" catchtap="closeCompose"><view class="plan-popover-card" catchtap="noop"><view class="plan-popover-title">{{i18n.ui('安排一次拍摄',locale)}}</view><scroll-view scroll-y class="plan-popover-body" style="height:{{preview?'55vh':'590rpx'}};max-height:calc(100vh - {{planKeyboardHeight}}px - 220rpx)"><view class="plan-compose-fields"><view class="point-title">{{i18n.ui('先预览，再决定出发',locale)}}</view><text class="plan-how812">{{i18n.ui('说说想拍的画面 → 预览机位 → 保存清单 → 导航和打卡',locale)}}</text><view class="plan-examples812"><button size="mini" data-question="想拍湖边花草，轻松走走" bindtap="example812">{{i18n.ui('湖边花草',locale)}}</button><button size="mini" data-question="第一次来，想随便走走拍一张" bindtap="example812">{{i18n.ui('第一次来',locale)}}</button></view><input value="{{question}}" bindkeyboardheightchange="planKeyboard" adjust-position="{{false}}" data-key="question" bindinput="field" maxlength="300" placeholder-class="field-placeholder" placeholder="{{i18n.ui('例如：饭后想用手机拍一点建筑细节',locale)}}"/><view class="row"><text>{{i18n.ui('时间预算（分钟）',locale)}}</text><input type="number" value="{{budget}}" data-key="budget" bindinput="field"/></view><button class="primary" bindtap="preview" loading="{{busy}}">{{i18n.ui('生成预览',locale)}}</button></view><view wx:if="{{preview}}" class="card"><view class="pill">{{i18n.ui('预览 · 尚未保存',locale)}}</view><view class="point-title gap">{{i18n.content(preview.plan.title,locale,localeTranslations,localeOriginal)}}</view><text class="copy muted">{{i18n.content(preview.notice,locale,localeTranslations,localeOriginal)}}</text><view wx:for="{{preview.plan.items}}" wx:key="id" class="guide-step"><text class="step-number">{{i18n.content(index+1,locale,localeTranslations,localeOriginal)}}</text><view><view class="point-title">{{i18n.content(item.title,locale,localeTranslations,localeOriginal)}}</view><text>{{i18n.content(item.composition,locale,localeTranslations,localeOriginal)}}</text><text class="muted">{{i18n.ui('约',locale)}} {{i18n.content(item.minutes,locale,localeTranslations,localeOriginal)}} {{i18n.ui('分钟',locale)}}</text></view></view><view class="muted">{{i18n.content(preview.schedule.estimateNotice,locale,localeTranslations,localeOriginal)}}</view><button wx:if="{{preview.canSave}}" bindtap="save" class="primary gap" disabled="{{busy}}">{{i18n.ui('确认加入我的清单',locale)}}</button></view><view wx:if="{{error}}" class="warning">{{i18n.content(error,locale,localeTranslations,localeOriginal)}}</view></scroll-view></view></view>
<experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>

<reward-overlay id="reward-overlay812" items="{{nativeRewardItems812}}" bind:dismiss="dismissNativeRewards812" bind:impact="nativeImpact812"/>
