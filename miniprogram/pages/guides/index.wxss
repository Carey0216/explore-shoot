.guide-step {
  display: flex;
  align-items: flex-start;
  gap: calc(var(--jy-rpx, 1rpx) * 22);
  margin-top: calc(var(--jy-rpx, 1rpx) * 30);
  line-height: 1.9;
}
.step-number {
  display: block;
  flex-shrink: 0;
  width: calc(var(--jy-rpx, 1rpx) * 48);
  height: calc(var(--jy-rpx, 1rpx) * 48);
  border-radius: 50%;
  background: var(--selected);
  color: var(--accent);
  text-align: center;
  line-height: calc(var(--jy-rpx, 1rpx) * 48);
}
.copy {
  white-space: pre-wrap;
  line-height: 1.9;
  display: block;
  margin: calc(var(--jy-rpx, 1rpx) * 16) 0;
}
.link {
  display: block;
  margin-top: calc(var(--jy-rpx, 1rpx) * 24);
  color: var(--accent);
}
.guide-card {
  padding: calc(var(--jy-rpx, 1rpx) * 34);
}

.plan-popover-mask {
  position: fixed;
  inset: 0;
  z-index: 9800;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: calc(var(--jy-rpx, 1rpx) * 24);
  background: transparent;
}
.plan-popover-card {
  width: 100%;
  max-width: calc(var(--jy-rpx, 1rpx) * 680);
  padding: calc(var(--jy-rpx, 1rpx) * 32);
  border-radius: calc(var(--jy-rpx, 1rpx) * 46);
  background: var(--surface);
  color: var(--text);
  border: calc(var(--jy-rpx, 1rpx) * 1) solid var(--line);
  box-shadow: 0 calc(var(--jy-rpx, 1rpx) * 24) calc(var(--jy-rpx, 1rpx) * 90) #0003;
}
.plan-popover-title {
  font-size: calc(var(--jy-rpx, 1rpx) * 32);
  font-weight: 600;
  line-height: 1.5;
  margin-bottom: calc(var(--jy-rpx, 1rpx) * 20);
}
.plan-popover-body {
  min-height: calc(var(--jy-rpx, 1rpx) * 160);
}
.plan-compose-fields > .point-title {
  font-size: calc(var(--jy-rpx, 1rpx) * 23);
  font-weight: 400;
  color: var(--muted);
  margin-bottom: calc(var(--jy-rpx, 1rpx) * 18);
}
.plan-compose-fields .row {
  margin: calc(var(--jy-rpx, 1rpx) * 18) 0;
}
.plan-compose-fields .row > text {
  font-size: calc(var(--jy-rpx, 1rpx) * 23);
  max-width: 50%;
}
.plan-compose-fields .row > input {
  max-width: 45%;
}

.native-surface .plan-compose-fields button {
  width: 100%;
  max-width: none;
  margin: 0;
}

.plan-how812 {
  display: block;
  font-size: calc(var(--jy-rpx, 1rpx) * 23);
  line-height: 1.6;
  color: var(--muted);
  margin: calc(var(--jy-rpx, 1rpx) * 8) 0 calc(var(--jy-rpx, 1rpx) * 16);
}
.plan-examples812 {
  display: flex;
  flex-wrap: wrap;
  gap: calc(var(--jy-rpx, 1rpx) * 12);
  margin-bottom: calc(var(--jy-rpx, 1rpx) * 16);
}
.plan-examples812 button {
  min-height: calc(var(--jy-rpx, 1rpx) * 60);
  line-height: 1.4;
  padding: calc(var(--jy-rpx, 1rpx) * 12) calc(var(--jy-rpx, 1rpx) * 18);
  font-size: calc(var(--jy-rpx, 1rpx) * 23);
}
