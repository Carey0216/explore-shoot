<page-meta page-style="{{publicOverlayOpen || passportRewards.length ? 'overflow: hidden;' : ''}}"/>
<view class="page"><community-header/><view class="row between"><view class="title">{{account ? account.nickname : '我的'}}</view><button class="small" bindtap="settings">账户设置</button></view>
  <view wx:if="{{!account}}" class="card"><view class="point-title">收下你的校园足迹</view><view class="muted gap">登录后查看打卡、印章和审核通知</view><button class="primary gap" bindtap="login">登录 / 注册</button></view>
  <block wx:else><view class="stats card"><view><text class="stat-number">{{summary.visits || 0}}</text><text class="muted">次打卡</text></view><view><text class="stat-number">{{summary.unique || 0}}</text><text class="muted">个地点</text></view><view><text class="stat-number">{{summary.photos || 0}}</text><text class="muted">张照片</text></view></view>
    <view class="tool-grid"><view bindtap="passport"><image class="tool-glyph" src="/assets/tools/shield.png" mode="aspectFit"/><text>校园护照</text></view><view bindtap="plans" wx:if="{{features.plans.enabled!==false && features.plans.visible!==false}}"><image class="tool-glyph" src="/assets/tools/camera.png" mode="aspectFit"/><text>拍摄清单</text></view><view bindtap="collections" wx:if="{{features.plans.enabled!==false && features.plans.visible!==false}}"><image class="tool-glyph" src="/assets/tools/heart.png" mode="aspectFit"/><text>收藏分组</text></view><view bindtap="contact" wx:if="{{features.messages.enabled!==false && features.messages.visible!==false}}"><image class="tool-glyph" src="/assets/tools/message.png" mode="aspectFit"/><text>联系管理员</text></view><view bindtap="settings"><image class="tool-glyph" src="/assets/tools/settings.png" mode="aspectFit"/><text>账户设置</text></view><view bindtap="administration"><image class="tool-glyph" src="/assets/tools/list.png" mode="aspectFit"/><text>管理工作台</text></view><view wx:if="{{features.support.enabled && features.support.visible}}" bindtap="support"><image class="tool-glyph" src="/assets/tools/search.png" mode="aspectFit"/><text>AI客服</text></view></view>
    <view class="section-title">我的打卡 · 仅自己可见</view><view class="waterfall"><view wx:for="{{recordColumns}}" wx:key="index" wx:for-item="column" class="feed-column"><view wx:for="{{column}}" wx:key="id" class="feed-tile private-tile"><view class="row between"><view class="point-title grow">{{item.pointName}}</view><text class="muted">{{item.date}}</text></view><view wx:if="{{item.photo}}" class="photo gap" data-photo="{{item.photo}}" bindtap="preview"><remote-image source="{{item.photo}}"/></view><view class="gap">{{item.note}}</view><view class="muted">{{item.spotTitle}}</view><button wx:if="{{item.kind === 'checkin'}}" class="small danger gap" data-id="{{item.id}}" bindtap="remove">删除打卡</button></view>
</view></view>
    <view wx:if="{{!records.length && !loading}}" class="empty">还没有打卡记录</view>
    <view wx:if="{{works.length}}" class="section-title">我的作品投稿</view><view wx:for="{{works}}" wx:key="id" class="card"><view>{{item.caption || '机位作品'}}</view><view class="muted gap">{{item.statusText}}</view><button wx:if="{{item.status !== 'withdrawn'}}" class="small gap" data-id="{{item.checkinId}}" bindtap="withdraw">撤回公开</button></view>
  </block><state-view loading="{{loading}}" error="{{error}}" bind:retry="load"/>
</view>

<site-overlay id="site-overlay" content="{{siteContent}}" runtime="{{runtime}}" announcement="{{announcement}}" page="my" bind:dismiss="dismissPublicOverlay" bind:overlay="publicOverlay"/>

<reward-overlay items="{{passportRewards}}" bind:dismiss="dismissRewards"/>
