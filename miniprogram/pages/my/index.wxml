<wxs src="/services/i18n.wxs" module="i18n"/>
<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen || passportRewards.length ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{locale==='en-US'?'locale-en':''}} {{themeClass}} {{nativeImpact812?'native-impact812':''}}" style="{{themeStyle}}">


<view class="page"><community-header id="community-header"/>
<view wx:if="{{localeTranslated}}" class="locale-note"><text>{{i18n.ui(localeTranslationUnavailable?'内容翻译暂时不可用，当前显示原文。':'内容由机器翻译，原文始终保留。',locale)}}</text><button bindtap="localeToggleOriginal">{{i18n.ui(localeOriginal?'显示译文':'查看原文',locale)}}</button></view><view class="my-heading">{{i18n.ui('我的',locale)}}</view>
  <view wx:if="{{!account}}" class="card"><view class="point-title">{{i18n.ui('收下你的校园足迹',locale)}}</view><view class="muted gap">{{i18n.ui('登录后查看打卡、印章和审核通知',locale)}}</view><button class="primary gap" bindtap="login">{{i18n.ui('登录 / 注册',locale)}}</button></view>
  <block wx:else>
    <view class="identity73"><view class="identity-avatar73"><image wx:if="{{account.avatarPreset}}" src="/assets/avatars/{{account.avatarPreset}}.png" mode="aspectFill"/><text wx:else>{{account.nickname||account.username}}</text></view><view class="identity-copy73"><view class="identity-name73">{{account.nickname||account.username}}</view><text class="muted">{{i18n.ui(account.scoutStatus==='approved'?'校园探索官':'校园探索者',locale)}} {{i18n.ui('· 北方民族大学',locale)}}</text></view><button class="quiet-button73" bindtap="settings" aria-label="{{i18n.ui('账户设置',locale)}}"><image class="quiet-icon73" src="{{i18n.icon('settings',themeDark || theme==='theme-dark')}}"/></button></view>
    <view class="passport-preview73" wx:if="{{features['passport'].visible!==false}}" bindtap="passport"><view class="section-title73">{{i18n.ui('我的校园护照',locale)}} <text>↗</text></view><view class="muted gap">{{i18n.ui('把走过的地方，收进自己的校园。',locale)}}</view><view class="preview-stamps73"><image wx:for="{{passportPreview.stamps}}" wx:key="id" class="preview-stamp73 {{item.earned?'':'locked'}}" src="{{item.badge}}" mode="aspectFit" aria-label="{{i18n.content(item.title,locale,localeTranslations,localeOriginal)}} · {{i18n.ui(item.earned?'已获得':'未获得',locale)}}"/></view><view class="row between"><text class="muted">{{i18n.content(summary.unique||0,locale,localeTranslations,localeOriginal)}} {{i18n.ui('个地点 ·',locale)}} {{i18n.content(passportPreview.earned||0,locale,localeTranslations,localeOriginal)}} {{i18n.ui('枚印章',locale)}}</text><text>{{i18n.ui('翻开看看 ↗',locale)}}</text></view></view>
    <campus-collection wx:if="{{!nativeRewardItems812.length && !nativeOverlayOpen && !publicOverlayOpen && features.passport.visible!==false}}"/><view class="recent-preview73"><view class="section-title73">{{i18n.ui('最近的探索',locale)}} <text bindtap="passport" wx:if="{{features['passport'].visible!==false}}">{{i18n.ui('全部 →',locale)}}</text></view><view wx:if="{{records.length}}" class="recent-record73"><view wx:if="{{records[0].photo}}" class="recent-photo73" data-photo="{{records[0].photo}}" bindtap="preview"><remote-image source="{{records[0].photo}}" mode="aspectFill"/></view><view><view class="point-title">{{i18n.ui(records[0].pointName||'校园探索',locale)}}</view><text class="muted">{{i18n.content(records[0].date,locale,localeTranslations,localeOriginal)}}</text></view></view><view wx:else class="muted gap">{{i18n.ui('从一个校园角落开始，留下第一张自己的记录。',locale)}}</view></view>
    <view class="personal-toolbox73"><view class="section-title73">{{i18n.ui('常用工具',locale)}}</view><view class="tool-buttons81"><block wx:for="{{shortcuts}}" wx:key="id"><button wx:if="{{!item.feature||features[item.feature].visible!==false}}" class="tool-button81" data-id="{{item.id}}" bindtap="shortcut"><image class="quiet-icon73" src="{{i18n.icon(item.icon,themeDark || theme==='theme-dark')}}"/><text>{{i18n.content(item.label,locale,localeTranslations,localeOriginal)}}</text></button></block></view><view class="my-onboarding"><view class="onboarding-copy"><view>{{i18n.ui('功能引导与更新',locale)}}</view><text>{{i18n.ui('认识新布局，查看版本变化',locale)}}</text></view><button class="onboarding-button" bindtap="tour">{{i18n.ui('重新认识 →',locale)}}</button><view class="onboarding-updates" bindtap="updates">{{i18n.ui('查看已发布更新 ↗',locale)}}</view></view></view>
    <view class="scout-entry" wx:if="{{account.scoutStatus!=='approved'}}"><text>{{i18n.ui(account.scoutStatus==='pending'?'探索官申请审核中':'一起分享校园的新发现',locale)}}</text><button wx:if="{{account.scoutStatus!=='pending'}}" bindtap="scout">{{i18n.ui('答题成为探索官 ↗',locale)}}</button></view>
    <view class="my-content-tabs">
      <button class="content-tab {{contentTab==='saved'?'selected':''}}" wx:if="{{features['bookmarks'].visible!==false}}" data-id="saved" bindtap="contentTab">{{i18n.ui('收藏',locale)}}</button>
      <button class="content-tab {{contentTab==='posts'?'selected':''}}" wx:if="{{features['publishing'].visible!==false}}" data-id="posts" bindtap="contentTab">{{i18n.ui('社区发现',locale)}}</button>
      <button class="content-tab {{contentTab==='reports'?'selected':''}}" wx:if="{{features['feedback'].visible!==false}}" data-id="reports" bindtap="contentTab">{{i18n.ui('问题反馈',locale)}}</button>
    </view>
    <view wx:if="{{contentTab==='records'||contentTab==='works'}}" class="my-secondary-heading">{{i18n.ui(contentTab==='records'?'私人打卡':'公开作品',locale)}}</view>
    <view class="my-search"><input value="{{contentQuery}}" bindinput="contentQuery" bindconfirm="loadContent" maxlength="100" placeholder-class="field-placeholder" placeholder="{{i18n.ui('搜索',locale)}}{{i18n.ui(contentTab==='saved'?'收藏':contentTab==='posts'?'我的发现':contentTab==='reports'?'反馈':contentTab==='works'?'公开作品':'私人打卡',locale)}}"/><button bindtap="loadContent" aria-label="{{i18n.ui('搜索',locale)}}"><image src="{{i18n.icon('search',themeDark || theme==='theme-dark')}}" mode="aspectFit"/></button></view>
    <view class="my-total">{{i18n.ui('共',locale)}} {{i18n.content(contentTotal,locale,localeTranslations,localeOriginal)}} {{i18n.ui('条',locale)}}</view>
<view class="waterfall"><view wx:for="{{contentColumns}}" wx:key="index" wx:for-item="column" class="feed-column"><view wx:for="{{column}}" wx:key="id" class="card private-tile"><view wx:if="{{item.photo}}" data-photo="{{item.photo}}" bindtap="preview"><remote-image source="{{item.photo}}"/></view><view class="point-title gap" data-id="{{item.id}}" bindtap="contentOpen">{{i18n.ui(item.name||item.pointName||item.caption||item.category||'我的记录',locale)}}</view><view class="muted gap">{{i18n.content(item.date||item.description||item.statusText,locale,localeTranslations,localeOriginal)}}</view><text>{{i18n.content(item.note||item.body||item.reason||'',locale,localeTranslations,localeOriginal)}}</text><button size="mini" wx:if="{{contentTab==='records'&&item.kind==='checkin'}}" class="small danger gap" data-id="{{item.id}}" bindtap="remove">{{i18n.ui('删除私人打卡',locale)}}</button><button size="mini" wx:if="{{contentTab==='works'&&item.status!=='withdrawn'}}" class="small gap" data-id="{{item.checkinId}}" bindtap="withdraw">{{i18n.ui('撤回公开作品',locale)}}</button></view></view></view><button wx:if="{{contentMore}}" bindtap="contentMore" loading="{{contentLoading}}">{{i18n.ui('加载更多',locale)}}</button><view wx:if="{{!contentRows.length&&!contentLoading}}" class="context-empty73"><view class="point-title">{{i18n.content(emptyCopy[0],locale,localeTranslations,localeOriginal)}}</view><view class="muted gap">{{i18n.content(emptyCopy[1],locale,localeTranslations,localeOriginal)}}</view><button class="primary gap" bindtap="emptyAction">{{i18n.content(emptyCopy[2],locale,localeTranslations,localeOriginal)}} →</button></view>
  </block><view class="my-help" bindtap="intro">{{i18n.ui('项目介绍与拍摄帮助',locale)}}</view><state-view loading="{{loading}}" error="{{error}}" bind:retry="load"/>
</view>

<site-overlay id="site-overlay" content="{{siteContent}}" runtime="{{runtime}}" announcement="{{announcement}}" page="my" bind:dismiss="dismissPublicOverlay" bind:overlay="publicOverlay"/>

<reward-overlay id="reward-overlay812" items="{{passportRewards}}" bind:dismiss="dismissRewards"/>

<experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>

<reward-overlay id="reward-overlay812" items="{{nativeRewardItems812}}" bind:dismiss="dismissNativeRewards812" bind:impact="nativeImpact812"/>
