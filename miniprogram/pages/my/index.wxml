<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen || passportRewards.length ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{themeClass}}" style="{{themeStyle}}">

<view class="page"><community-header id="community-header"/><view class="my-heading">我的</view>
  <view wx:if="{{!account}}" class="card"><view class="point-title">收下你的校园足迹</view><view class="muted gap">登录后查看打卡、印章和审核通知</view><button class="primary gap" bindtap="login">登录 / 注册</button></view>
  <block wx:else>
    <view class="identity73"><view class="identity-avatar73"><image wx:if="{{account.avatarPreset}}" src="/assets/avatars/{{account.avatarPreset}}.png" mode="aspectFill"/><text wx:else>{{account.nickname||account.username}}</text></view><view class="identity-copy73"><view class="identity-name73">{{account.nickname||account.username}}</view><text class="muted">{{account.scoutStatus==='approved'?'校园探索官':'校园探索者'}} · 北方民族大学</text></view><button class="quiet-button73" bindtap="settings" aria-label="账户设置"><image class="quiet-icon73" src="/assets/tools/settings{{themeDark?'-dark':''}}.png"/></button></view>
    <view class="passport-preview73" wx:if="{{features['passport'].visible!==false}}" bindtap="passport"><view class="section-title73">我的校园护照 <text>↗</text></view><view class="muted gap">把走过的地方，收进自己的校园。</view><view class="preview-stamps73"><image wx:for="{{passportPreview.stamps}}" wx:key="id" class="preview-stamp73 {{item.earned?'':'locked'}}" src="{{item.badge}}" mode="aspectFit" aria-label="{{item.title}} · {{item.earned?'已获得':'未获得'}}"/></view><view class="row between"><text class="muted">{{summary.unique||0}} 个地点 · {{passportPreview.earned||0}} 枚印章</text><text>翻开看看 ↗</text></view></view>
    <view class="recent-preview73"><view class="section-title73">最近的探索 <text bindtap="passport" wx:if="{{features['passport'].visible!==false}}">全部 →</text></view><view wx:if="{{records.length}}" class="recent-record73"><view wx:if="{{records[0].photo}}" class="recent-photo73" data-photo="{{records[0].photo}}" bindtap="preview"><remote-image source="{{records[0].photo}}" mode="aspectFill"/></view><view><view class="point-title">{{records[0].pointName||'校园探索'}}</view><text class="muted">{{records[0].date}}</text></view></view><view wx:else class="muted gap">从一个校园角落开始，留下第一张自己的记录。</view></view>
    <view class="personal-toolbox73"><view class="section-title73">常用工具</view><block wx:for="{{shortcuts}}" wx:key="id"><view wx:if="{{(item.id==='plans'||item.id==='collections'||item.id==='notes'||item.id==='works') && (!item.feature||features[item.feature].visible!==false)}}" class="tool-row73" data-id="{{item.id}}" bindtap="shortcut"><image class="quiet-icon73" src="/assets/tools/{{item.icon}}{{themeDark?'-dark':''}}.png"/><text>{{item.label}}</text><text class="muted">→</text></view></block><view class="more-tools73" bindtap="toggleTools">更多工具与帮助 {{moreTools?'⌃':'⌄'}}</view><view wx:if="{{moreTools}}"><block wx:for="{{shortcuts}}" wx:key="id"><view wx:if="{{(item.id==='guides'||item.id==='contact'||item.id==='settings') && (!item.feature||features[item.feature].visible!==false)}}" class="tool-row73" data-id="{{item.id}}" bindtap="shortcut"><image class="quiet-icon73" src="/assets/tools/{{item.icon}}{{themeDark?'-dark':''}}.png"/><text>{{item.label}}</text><text>→</text></view></block><view class="my-onboarding"><view class="onboarding-copy"><view>功能引导与更新</view><text>认识新布局，查看版本变化</text></view><button class="onboarding-button" bindtap="tour">重新认识 →</button><view class="onboarding-updates" bindtap="updates">查看已发布更新 ↗</view></view></view></view>
    <view class="scout-entry" wx:if="{{account.scoutStatus!=='approved'}}"><text>{{account.scoutStatus==='pending'?'探索官申请审核中':'一起分享校园的新发现'}}</text><button wx:if="{{account.scoutStatus!=='pending'}}" bindtap="scout">答题成为探索官 ↗</button></view>
    <view class="my-content-tabs">
      <button class="content-tab {{contentTab==='saved'?'selected':''}}" wx:if="{{features['bookmarks'].visible!==false}}" data-id="saved" bindtap="contentTab">收藏</button>
      <button class="content-tab {{contentTab==='posts'?'selected':''}}" wx:if="{{features['publishing'].visible!==false}}" data-id="posts" bindtap="contentTab">社区发现</button>
      <button class="content-tab {{contentTab==='reports'?'selected':''}}" wx:if="{{features['feedback'].visible!==false}}" data-id="reports" bindtap="contentTab">问题反馈</button>
    </view>
    <view wx:if="{{contentTab==='records'||contentTab==='works'}}" class="my-secondary-heading">{{contentTab==='records'?'私人打卡':'公开作品'}}</view>
    <view class="my-search"><input value="{{contentQuery}}" bindinput="contentQuery" bindconfirm="loadContent" maxlength="100" placeholder-class="field-placeholder" placeholder="搜索{{contentTab==='saved'?'收藏':contentTab==='posts'?'我的发现':contentTab==='reports'?'反馈':contentTab==='works'?'公开作品':'私人打卡'}}"/><button bindtap="loadContent" aria-label="搜索"><image src="/assets/tools/search{{themeDark ? '-dark' : ''}}.png" mode="aspectFit"/></button></view>
    <view class="my-total">共 {{contentTotal}} 条</view>
<view class="waterfall"><view wx:for="{{contentColumns}}" wx:key="index" wx:for-item="column" class="feed-column"><view wx:for="{{column}}" wx:key="id" class="card private-tile"><view wx:if="{{item.photo}}" data-photo="{{item.photo}}" bindtap="preview"><remote-image source="{{item.photo}}"/></view><view class="point-title gap" data-id="{{item.id}}" bindtap="contentOpen">{{item.name||item.pointName||item.caption||item.category||'我的记录'}}</view><view class="muted gap">{{item.date||item.description||item.statusText}}</view><text>{{item.note||item.body||item.reason||''}}</text><button size="mini" wx:if="{{contentTab==='records'&&item.kind==='checkin'}}" class="small danger gap" data-id="{{item.id}}" bindtap="remove">删除私人打卡</button><button size="mini" wx:if="{{contentTab==='works'&&item.status!=='withdrawn'}}" class="small gap" data-id="{{item.checkinId}}" bindtap="withdraw">撤回公开作品</button></view></view></view><button wx:if="{{contentMore}}" bindtap="contentMore" loading="{{contentLoading}}">加载更多</button><view wx:if="{{!contentRows.length&&!contentLoading}}" class="context-empty73"><view class="point-title">{{emptyCopy[0]}}</view><view class="muted gap">{{emptyCopy[1]}}</view><button class="primary gap" bindtap="emptyAction">{{emptyCopy[2]}} →</button></view>
  </block><view class="my-help" bindtap="intro">项目介绍与拍摄帮助</view><state-view loading="{{loading}}" error="{{error}}" bind:retry="load"/>
</view>

<site-overlay id="site-overlay" content="{{siteContent}}" runtime="{{runtime}}" announcement="{{announcement}}" page="my" bind:dismiss="dismissPublicOverlay" bind:overlay="publicOverlay"/>

<reward-overlay items="{{passportRewards}}" bind:dismiss="dismissRewards"/>

<experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>
