<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{themeClass}}" style="{{themeStyle}}">
<view wx:if="{{featureBlocked}}" class="page"><view class="empty" role="status">功能正在维护中，敬请期待…</view></view><block wx:else>

<view wx:if="{{signedIn}}" class="page"><view wx:if="{{draftMessage}}" class="warning">{{draftMessage}}</view><view class="title">{{title || '拍照打卡'}}</view><view class="muted gap">{{spotTitle}}</view>
  <view class="card"><image wx:if="{{photo}}" class="photo" src="{{photo}}" mode="aspectFit"/><button class="gap" bindtap="choose" disabled="{{saving}}">{{photo ? '更换照片' : '拍照 / 从相册选择'}}</button><view class="privacy">选图和压缩在本机完成，提交时才上传。</view></view>
  <label class="label">这次的感受（仅自己可见）</label><textarea class="input note" value="{{note}}" bindinput="note" maxlength="1000" placeholder-class="field-placeholder" placeholder="写一点记录…" disabled="{{saving}}"/>
  <button bindtap="locate" disabled="{{saving}}">{{located ? '重新获取位置' : '附上本次定位（可选）'}}</button>
  <view wx:if="{{canShare&&features['work-wall'].visible!==false}}" class="card"><view class="row between"><view class="grow">公开到此机位的作品墙</view><switch checked="{{share}}" bindchange="share" color="#245b4c" disabled="{{saving}}"/></view><view class="privacy">默认仅自己可见；选择公开后需要审核。私人感受和精确定位不会公开。</view><block wx:if="{{share}}"><label class="label">公开配文</label><textarea class="input note" value="{{caption}}" bindinput="caption" maxlength="500" placeholder-class="field-placeholder" placeholder="给后来的人一点参考" disabled="{{saving}}"/></block></view>
  <button class="primary gap" loading="{{saving || choosing}}" disabled="{{saving || choosing}}" bindtap="submit">保存打卡</button><view wx:if="{{share && features.experience.visible!==false}}" data-feature="experience" bindtap="featureTap" class="card"><view class="point-title">作品经验卡（选填，公开可见）</view><input class="input gap" data-key="takenAt" value="{{takenAt}}" placeholder-class="field-placeholder" placeholder="时间，例如 2026-10-17T18:30:00+08:00" disabled="{{features.experience.enabled===false}}" bindinput="experience"/><input class="input gap" data-key="device" value="{{device}}" maxlength="100" placeholder-class="field-placeholder" placeholder="设备型号" disabled="{{features.experience.enabled===false}}" bindinput="experience"/><input class="input gap" data-key="focalLength" value="{{focalLength}}" maxlength="50" placeholder-class="field-placeholder" placeholder="焦段，例如等效35mm" disabled="{{features.experience.enabled===false}}" bindinput="experience"/><textarea class="input note" data-key="tips" value="{{tips}}" maxlength="1000" placeholder-class="field-placeholder" placeholder="愿意公开的拍摄心得" disabled="{{features.experience.enabled===false}}" bindinput="experience"/></view><button wx:if="{{retry}}" class="primary gap" bindtap="submit" loading="{{saving}}">重试提交（保留草稿）</button><canvas type="2d" id="photo-export" class="photo-export"/>
</view>

<site-overlay id="site-overlay" content="{{siteContent}}" runtime="{{runtime}}" announcement="{{announcement}}" page="checkin" bind:dismiss="dismissPublicOverlay" bind:overlay="publicOverlay"/>

</block>
<experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>
