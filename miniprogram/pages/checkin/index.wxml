<wxs src="/services/i18n.wxs" module="i18n"/>
<page-meta page-style="{{pageStyle}} {{nativeRewardItems812.length || publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen ? 'overflow:hidden;' : ''}}"/>
<view bindtouchstart="cancelNativeDemoHint" class="native-surface {{locale==='en-US'?'locale-en':''}} {{themeClass}} {{nativeImpact812?'native-impact812':''}}" style="{{themeStyle}}">
<view wx:if="{{localeTranslated}}" class="locale-note"><text>{{i18n.ui(localeTranslationUnavailable?'内容翻译暂时不可用，当前显示原文。':'内容由机器翻译，原文始终保留。',locale)}}</text><button bindtap="localeToggleOriginal">{{i18n.ui(localeOriginal?'显示译文':'查看原文',locale)}}</button></view>
<view wx:if="{{featureBlocked}}" class="page"><view class="empty" role="status">{{i18n.ui('功能正在维护中，敬请期待…',locale)}}</view></view><block wx:else>

<view wx:if="{{signedIn}}" class="page"><view wx:if="{{draftMessage}}" class="warning">{{i18n.content(draftMessage,locale,localeTranslations,localeOriginal)}}</view><view class="title">{{i18n.ui(title || '拍照打卡',locale)}}</view><view class="muted gap">{{i18n.content(spotTitle,locale,localeTranslations,localeOriginal)}}</view>
  <view class="card"><image wx:if="{{photo}}" class="checkin-photo821" src="{{photo}}" mode="aspectFit" bindtap="previewPhoto" binderror="photoError"/><view wx:if="{{photo}}" class="photo-status821">{{i18n.ui(photoPreviewError ? '照片预览失败，请重新选择；尚未提交上传' : '照片已选好 · 点击可查看大图 · 保存打卡后才会上传',locale)}}</view><button class="gap" bindtap="choose" disabled="{{saving}}"><image class="button-icon" src="{{i18n.icon('camera',themeDark)}}" mode="aspectFit"/><text>{{i18n.ui(photo ? '更换照片' : '拍照 / 从相册选择',locale)}}</text></button><view class="privacy">{{i18n.ui('选图和压缩在本机完成，提交时才上传。',locale)}}</view></view>
  <label class="label">{{i18n.ui('这次的感受（仅自己可见）',locale)}}</label><textarea class="input note" value="{{note}}" bindinput="note" maxlength="1000" placeholder-class="field-placeholder" placeholder="{{i18n.ui('写一点记录…',locale)}}" disabled="{{saving}}"/>
  <view class="card checkin-fix">
    <view class="point-title">{{locale==='en-US'?'Check-in location':'打卡定位'}}</view>
    <view wx:if="{{locationInfo}}" class="checkin-fix-details" role="status">
      <text>{{locale==='en-US'?'Location attached':'已附上本次定位'}} · {{locale==='en-US'?'Accuracy':'精度约'}} {{locationInfo.accuracy}} {{locale==='en-US'?'m':'米'}}</text>
      <text class="muted">{{locale==='en-US'?'Latitude':'纬度'}} {{locationInfo.lat}} · {{locale==='en-US'?'Longitude':'经度'}} {{locationInfo.lng}}</text>
    </view>
    <view wx:elif="{{locationExpired}}" class="muted checkin-fix-details" role="status">{{locale==='en-US'?'Location expired. Refresh it or continue without it.':'定位已过期，请重新获取或选择不使用定位。'}}</view>
    <view wx:else class="muted checkin-fix-details">{{locale==='en-US'?'Optional. Coordinates are shown here only.':'定位选填，坐标仅在此处显示。'}}</view>
    <view wx:if="{{locationError}}" class="error" role="status">{{i18n.content(locationError,locale,localeTranslations,localeOriginal)}}</view>
    <view class="checkin-fix-actions">
      <button bindtap="locate" disabled="{{saving || locating}}" loading="{{locating}}"><image wx:if="{{!locating}}" class="button-icon" src="{{i18n.icon('pin',themeDark)}}" mode="aspectFit"/><text>{{i18n.ui(locationInfo || locationExpired ? '重新获取位置' : '附上本次定位（可选）',locale)}}</text></button>
      <button wx:if="{{locationInfo || locationExpired}}" bindtap="removeLocation" disabled="{{saving}}">{{locale==='en-US'?'Remove location':'不使用定位'}}</button>
    </view>
  </view>
  <view wx:if="{{canShare&&features['work-wall'].visible!==false}}" class="card"><view class="row between"><view class="grow">{{i18n.ui('公开到此机位的作品墙',locale)}}</view><switch checked="{{share}}" bindchange="share" color="#245b4c" disabled="{{saving}}"/></view><view class="privacy">{{i18n.ui('默认仅自己可见；选择公开后需要审核。私人感受和精确定位不会公开。',locale)}}</view><block wx:if="{{share}}"><label class="label">{{i18n.ui('公开配文',locale)}}</label><textarea class="input note" value="{{caption}}" bindinput="caption" maxlength="500" placeholder-class="field-placeholder" placeholder="{{i18n.ui('给后来的人一点参考',locale)}}" disabled="{{saving}}"/></block></view>
  <button class="primary gap" loading="{{saving || choosing}}" disabled="{{saving || choosing || locating}}" bindtap="submit"><image class="button-icon" src="{{i18n.icon('check',themeDark,true)}}" mode="aspectFit"/><text>{{i18n.ui('保存打卡',locale)}}</text></button><view wx:if="{{share && features.experience.visible!==false}}" data-feature="experience" bindtap="featureTap" class="card"><view class="point-title">{{i18n.ui('作品经验卡（选填，公开可见）',locale)}}</view><input class="input gap" data-key="takenAt" value="{{takenAt}}" placeholder-class="field-placeholder" placeholder="{{i18n.ui('时间，例如 2026-10-17T18:30:00+08:00',locale)}}" disabled="{{features.experience.enabled===false}}" bindinput="experience"/><input class="input gap" data-key="device" value="{{device}}" maxlength="100" placeholder-class="field-placeholder" placeholder="{{i18n.ui('设备型号',locale)}}" disabled="{{features.experience.enabled===false}}" bindinput="experience"/><input class="input gap" data-key="focalLength" value="{{focalLength}}" maxlength="50" placeholder-class="field-placeholder" placeholder="{{i18n.ui('焦段，例如等效35mm',locale)}}" disabled="{{features.experience.enabled===false}}" bindinput="experience"/><textarea class="input note" data-key="tips" value="{{tips}}" maxlength="1000" placeholder-class="field-placeholder" placeholder="{{i18n.ui('愿意公开的拍摄心得',locale)}}" disabled="{{features.experience.enabled===false}}" bindinput="experience"/></view><button wx:if="{{retry}}" class="primary gap" bindtap="submit" loading="{{saving}}" disabled="{{saving || locating}}"><image class="button-icon" src="{{i18n.icon('check',themeDark,true)}}" mode="aspectFit"/><text>{{i18n.ui('重试提交（保留草稿）',locale)}}</text></button><canvas type="2d" id="photo-export" class="photo-export"/>
</view>

<site-overlay id="site-overlay" content="{{siteContent}}" runtime="{{runtime}}" announcement="{{announcement}}" page="checkin" bind:dismiss="dismissPublicOverlay" bind:overlay="publicOverlay"/>

</block>
<experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>

<reward-overlay id="reward-overlay812" items="{{nativeRewardItems812}}" bind:dismiss="dismissNativeRewards812" bind:impact="nativeImpact812"/>
