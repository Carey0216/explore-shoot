<wxs src="/services/i18n.wxs" module="i18n"/>
<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{locale==='en-US'?'locale-en':''}} {{themeClass}}" style="{{themeStyle}}">
<view wx:if="{{localeTranslated}}" class="locale-note"><text>{{i18n.ui(localeTranslationUnavailable?'内容翻译暂时不可用，当前显示原文。':'内容由机器翻译，原文始终保留。',locale)}}</text><button bindtap="localeToggleOriginal">{{i18n.ui(localeOriginal?'显示译文':'查看原文',locale)}}</button></view>
<view wx:if="{{featureBlocked}}" class="page"><view class="empty" role="status">{{i18n.ui('功能正在维护中，敬请期待…',locale)}}</view></view><block wx:else>

<view wx:if="{{signedIn}}" class="page"><view wx:if="{{draftMessage}}" class="warning">{{i18n.content(draftMessage,locale,localeTranslations,localeOriginal)}}</view><view class="title">{{i18n.ui(title || '拍照打卡',locale)}}</view><view class="muted gap">{{i18n.content(spotTitle,locale,localeTranslations,localeOriginal)}}</view>
  <view class="card"><image wx:if="{{photo}}" class="photo" src="{{photo}}" mode="aspectFit"/><button class="gap" bindtap="choose" disabled="{{saving}}">{{i18n.ui(photo ? '更换照片' : '拍照 / 从相册选择',locale)}}</button><view class="privacy">{{i18n.ui('选图和压缩在本机完成，提交时才上传。',locale)}}</view></view>
  <label class="label">{{i18n.ui('这次的感受（仅自己可见）',locale)}}</label><textarea class="input note" value="{{note}}" bindinput="note" maxlength="1000" placeholder-class="field-placeholder" placeholder="{{i18n.ui('写一点记录…',locale)}}" disabled="{{saving}}"/>
  <button bindtap="locate" disabled="{{saving}}">{{i18n.ui(located ? '重新获取位置' : '附上本次定位（可选）',locale)}}</button>
  <view wx:if="{{canShare&&features['work-wall'].visible!==false}}" class="card"><view class="row between"><view class="grow">{{i18n.ui('公开到此机位的作品墙',locale)}}</view><switch checked="{{share}}" bindchange="share" color="#245b4c" disabled="{{saving}}"/></view><view class="privacy">{{i18n.ui('默认仅自己可见；选择公开后需要审核。私人感受和精确定位不会公开。',locale)}}</view><block wx:if="{{share}}"><label class="label">{{i18n.ui('公开配文',locale)}}</label><textarea class="input note" value="{{caption}}" bindinput="caption" maxlength="500" placeholder-class="field-placeholder" placeholder="{{i18n.ui('给后来的人一点参考',locale)}}" disabled="{{saving}}"/></block></view>
  <button class="primary gap" loading="{{saving || choosing}}" disabled="{{saving || choosing}}" bindtap="submit">{{i18n.ui('保存打卡',locale)}}</button><view wx:if="{{share && features.experience.visible!==false}}" data-feature="experience" bindtap="featureTap" class="card"><view class="point-title">{{i18n.ui('作品经验卡（选填，公开可见）',locale)}}</view><input class="input gap" data-key="takenAt" value="{{takenAt}}" placeholder-class="field-placeholder" placeholder="{{i18n.ui('时间，例如 2026-10-17T18:30:00+08:00',locale)}}" disabled="{{features.experience.enabled===false}}" bindinput="experience"/><input class="input gap" data-key="device" value="{{device}}" maxlength="100" placeholder-class="field-placeholder" placeholder="{{i18n.ui('设备型号',locale)}}" disabled="{{features.experience.enabled===false}}" bindinput="experience"/><input class="input gap" data-key="focalLength" value="{{focalLength}}" maxlength="50" placeholder-class="field-placeholder" placeholder="{{i18n.ui('焦段，例如等效35mm',locale)}}" disabled="{{features.experience.enabled===false}}" bindinput="experience"/><textarea class="input note" data-key="tips" value="{{tips}}" maxlength="1000" placeholder-class="field-placeholder" placeholder="{{i18n.ui('愿意公开的拍摄心得',locale)}}" disabled="{{features.experience.enabled===false}}" bindinput="experience"/></view><button wx:if="{{retry}}" class="primary gap" bindtap="submit" loading="{{saving}}">{{i18n.ui('重试提交（保留草稿）',locale)}}</button><canvas type="2d" id="photo-export" class="photo-export"/>
</view>

<site-overlay id="site-overlay" content="{{siteContent}}" runtime="{{runtime}}" announcement="{{announcement}}" page="checkin" bind:dismiss="dismissPublicOverlay" bind:overlay="publicOverlay"/>

</block>
<experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>
