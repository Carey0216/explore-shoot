.note {
  height: calc(var(--jy-rpx, 1rpx) * 220);
  line-height: 1.7;
}
.native-surface .checkin-photo821 {
  display: block;
  width: 100%;
  height: calc(var(--jy-rpx, 1rpx) * 380) !important;
  min-height: calc(var(--jy-rpx, 1rpx) * 240) !important;
  border-radius: calc(var(--jy-rpx, 1rpx) * 22);
  background: var(--raised);
}
.photo-status821 {
  margin-top: calc(var(--jy-rpx, 1rpx) * 18);
  color: var(--muted);
  font-size: calc(var(--jy-rpx, 1rpx) * 24);
  line-height: 1.6;
}
.checkin-fix-details {
  display: grid;
  gap: 4px;
  margin: 8px 0;
  line-height: 1.5;
  overflow-wrap: anywhere;
}
.checkin-fix-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 12px;
}
.native-surface .checkin-fix-actions button {
  flex: 1 1 130px;
  min-width: 0;
  margin: 0;
  line-height: 1.4;
}
.photo-export {
  position: fixed;
  top: -2000px;
  left: -2000px;
  width: 300px;
  height: 300px;
}
