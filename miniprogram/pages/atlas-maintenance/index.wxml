<wxs src="/services/i18n.wxs" module="i18n"/>
<view class="native-surface {{locale==='en-US'?'locale-en':''}} {{themeClass}}" style="{{themeStyle}}">
<view wx:if="{{localeTranslated}}" class="locale-note"><text>{{i18n.ui('内容由机器翻译，原文始终保留。',locale)}}</text><button bindtap="localeToggleOriginal">{{i18n.ui(localeOriginal?'显示译文':'查看原文',locale)}}</button></view><view class="page">
 <view class="title">{{i18n.ui('校园收集图 · 维护',locale)}}</view><view class="row gap"><button class="small" data-tab="people" bindtap="tab">{{i18n.ui('点位打卡',locale)}}</button><button class="small" data-tab="history" bindtap="tab">{{i18n.ui('编辑历史',locale)}}</button></view>
 <state-view loading="{{loading}}" error="{{error}}" bind:retry="load"/>
 <block wx:if="{{!snapshot && tab==='people'}}"><view class="card"><view class="muted">{{i18n.ui('取消统计后，重新真实打卡可再次点亮；原始照片和留言保留。',locale)}}</view><picker range="{{i18n.options(points,locale)}}" range-key="name" value="{{selectedPoint}}" bindchange="point"><view class="input gap">{{i18n.ui(points[selectedPoint].name || '选择点位',locale)}} ⌄</view></picker></view><view class="card" wx:for="{{participants}}" wx:key="userId"><view class="point-title">{{item.nickname}} · @{{item.username}}</view><view class="muted gap">{{item.activeCount}} {{i18n.ui('条计入收集',locale)}}</view><view class="row gap"><button size="mini" wx:if="{{item.activeCount}}" data-id="{{item.userId}}" data-action="reset" bindtap="credit" disabled="{{loading}}">{{i18n.ui('取消收集统计',locale)}}</button><button size="mini" wx:if="{{item.reset}}" data-id="{{item.userId}}" data-action="restore" bindtap="credit" disabled="{{loading}}">{{i18n.ui('恢复原统计',locale)}}</button></view></view><view wx:if="{{!participants.length && !loading}}" class="empty">{{i18n.ui('此点位暂无打卡用户。',locale)}}</view></block>
 <block wx:if="{{!snapshot && tab==='history'}}"><view class="card" wx:for="{{history}}" wx:key="snapshotId"><view class="point-title">{{i18n.content(item.name,locale,localeTranslations,localeOriginal)}}</view><view class="muted gap">{{i18n.content(item.savedAt,locale,localeTranslations,localeOriginal)}} · {{i18n.content(item.actorName,locale,localeTranslations,localeOriginal)}}</view><view class="muted">v{{i18n.content(item.fromRevision,locale,localeTranslations,localeOriginal)}} → v{{i18n.content(item.toRevision,locale,localeTranslations,localeOriginal)}}</view><button class="small gap" data-id="{{item.snapshotId}}" bindtap="preview">{{i18n.ui('预览 / 恢复',locale)}}</button></view><view wx:if="{{!history.length && !loading}}" class="empty">{{i18n.ui('尚无编辑备份。',locale)}}</view></block>
 <view wx:if="{{snapshot}}" class="card"><view class="row"><button size="mini" data-side="before" bindtap="side">{{i18n.ui('修改前',locale)}}</button><button size="mini" data-side="after" bindtap="side">{{i18n.ui('修改后',locale)}}</button></view><view class="point-title gap">{{i18n.content(snapshot[previewSide].name,locale,localeTranslations,localeOriginal)}}</view><canvas type="2d" id="history-preview" style="width:100%;height:{{previewHeight}}px"/><view class="muted gap">{{i18n.ui('恢复前会再次备份当前版本，发生冲突时停止保存。',locale)}}</view><button class="primary gap" bindtap="restore" disabled="{{loading}}">{{i18n.ui('恢复为修改前版本',locale)}}</button><button class="small gap" bindtap="closePreview">{{i18n.ui('返回历史',locale)}}</button></view>
</view><experience-layer id="experience" administrator="{{true}}" account="{{nativeAccount}}" features="{{features}}" page="{{nativePage}}"/></view>
