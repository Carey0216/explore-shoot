<view class="page"><view class="title">季节与活动专题</view><view class="muted gap">专题期间真实打卡，与校园护照联动。</view><state-view loading="{{loading}}" error="{{error}}" bind:retry="load"/><view wx:for="{{items}}" wx:key="id" class="card"><view class="pill">{{item.phaseText}}</view><view class="point-title gap">{{item.title}}</view><view class="gap">{{item.description}}</view><view class="muted gap">{{item.time}}</view><view>专题期间打卡 {{item.visited}} 个地点</view><view wx:for="{{item.stamps}}" wx:key="id" wx:for-item="stamp" class="pill gap">{{stamp.title}} {{stamp.progress}}/{{stamp.target}} {{stamp.earned?'✓':''}}</view><view class="row wrap gap"><button wx:for="{{item.points}}" wx:for-item="point" wx:key="id" class="small" data-id="{{point.id}}" bindtap="point">{{point.name}}</button></view><button class="gap" bindtap="passport">查看我的护照</button></view><view wx:if="{{!items.length && !loading}}" class="empty">暂无已发布专题</view></view>
