<wxs src="/services/i18n.wxs" module="i18n"/>
<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{locale==='en-US'?'locale-en':''}} {{themeClass}}" style="{{themeStyle}}">

<view wx:if="{{featureBlocked}}" class="page"><view class="empty" role="status">{{i18n.ui('功能正在维护中，敬请期待…',locale)}}</view></view><block wx:else>
<view class="page"><community-header id="community-header"/>
<view wx:if="{{localeTranslated}}" class="locale-note"><text>{{i18n.ui(localeTranslationUnavailable?'内容翻译暂时不可用，当前显示原文。':'内容由机器翻译，原文始终保留。',locale)}}</text><button bindtap="localeToggleOriginal">{{i18n.ui(localeOriginal?'显示译文':'查看原文',locale)}}</button></view><view class="feed-heading">{{i18n.ui('校园活动',locale)}}</view><input class="activity-search" placeholder-class="field-placeholder" placeholder="{{i18n.ui('搜索活动名称、主题',locale)}}" bindinput="search" maxlength="100"/><view class="row wrap gap"><button size="mini" wx:for="{{phases}}" wx:key="id" class="small phase {{phase===item.id?'selected-phase':''}}" data-id="{{item.id}}" bindtap="filter">{{i18n.content(item.name,locale,localeTranslations,localeOriginal)}}</button></view><state-view loading="{{loading}}" error="{{error}}" bind:retry="load"/><view wx:for="{{visible}}" wx:key="id" class="activity-row" bindtap="open" data-id="{{item.id}}"><view class="activity-poster"><remote-image source="{{item.photo}}"/><text>{{i18n.content(item.themeText,locale,localeTranslations,localeOriginal)}}</text></view><view class="activity-copy"><view class="pill">{{i18n.content(item.phaseText,locale,localeTranslations,localeOriginal)}}</view><view class="point-title gap">{{i18n.content(item.title,locale,localeTranslations,localeOriginal)}}</view><view class="muted gap">{{i18n.content(item.time,locale,localeTranslations,localeOriginal)}}</view><view class="muted gap">{{i18n.content(item.points.length,locale,localeTranslations,localeOriginal)}} {{i18n.ui('个地点 ·',locale)}} {{i18n.content(item.stamps.length,locale,localeTranslations,localeOriginal)}} {{i18n.ui('枚印章',locale)}}</view><view class="activity-enter">{{i18n.ui('查看活动 ↗',locale)}}</view></view></view><view wx:if="{{!visible.length&&!loading}}" class="empty">{{i18n.ui('暂无匹配的活动',locale)}}</view></view>
</block>
<experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>
