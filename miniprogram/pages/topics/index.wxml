<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{themeClass}}" style="{{themeStyle}}">
<view wx:if="{{featureBlocked}}" class="page"><view class="empty" role="status">功能正在维护中，敬请期待…</view></view><block wx:else>
<view class="page"><community-header id="community-header"/><view class="feed-heading">校园活动</view><input class="activity-search" placeholder-class="field-placeholder" placeholder="搜索活动名称、主题" bindinput="search" maxlength="100"/><view class="row wrap gap"><button size="mini" wx:for="{{phases}}" wx:key="id" class="small phase {{phase===item.id?'selected-phase':''}}" data-id="{{item.id}}" bindtap="filter">{{item.name}}</button></view><state-view loading="{{loading}}" error="{{error}}" bind:retry="load"/><view wx:for="{{visible}}" wx:key="id" class="activity-row" bindtap="open" data-id="{{item.id}}"><view class="activity-poster"><remote-image source="{{item.photo}}"/><text>{{item.themeText}}</text></view><view class="activity-copy"><view class="pill">{{item.phaseText}}</view><view class="point-title gap">{{item.title}}</view><view class="muted gap">{{item.time}}</view><view class="muted gap">{{item.points.length}} 个地点 · {{item.stamps.length}} 枚印章</view><view class="activity-enter">查看活动 ↗</view></view></view><view wx:if="{{!visible.length&&!loading}}" class="empty">暂无匹配的活动</view></view>
</block>
<experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>
