<view class="page"><community-header/><view class="feed-heading">校园活动</view><input class="activity-search" placeholder="搜索活动名称、主题" bindinput="search" maxlength="100"/><view class="row wrap gap"><button wx:for="{{phases}}" wx:key="id" class="small phase {{phase===item.id?'selected-phase':''}}" data-id="{{item.id}}" bindtap="filter">{{item.name}}</button></view><state-view loading="{{loading}}" error="{{error}}" bind:retry="load"/><view wx:for="{{visible}}" wx:key="id" class="activity-row" bindtap="open" data-id="{{item.id}}"><view class="activity-poster"><remote-image source="{{item.photo}}"/><text>{{item.themeText}}</text></view><view class="activity-copy"><view class="pill">{{item.phaseText}}</view><view class="point-title gap">{{item.title}}</view><view class="muted gap">{{item.time}}</view><view class="muted gap">{{item.points.length}} 个地点 · {{item.stamps.length}} 枚印章</view><view class="activity-enter">查看活动 ↗</view></view></view><view wx:if="{{!visible.length&&!loading}}" class="empty">暂无匹配的活动</view></view>