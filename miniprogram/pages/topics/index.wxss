.activity-search {
  padding: 24rpx 28rpx;
  background: #e9eff0;
  border: 2rpx solid #fff;
  border-radius: 32rpx;
  margin-top: 24rpx;
}
.activity-row {
  display: flex;
  gap: 24rpx;
  padding: 24rpx;
  border-radius: 36rpx;
  background: #ffffffe0;
  border: 2rpx solid #fff;
  margin-top: 24rpx;
}
.activity-poster {
  position: relative;
  width: 200rpx;
  flex-shrink: 0;
  min-height: 250rpx;
  max-height: 340rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: #e3eeeb;
}
.activity-poster text {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #28465190;
  color: white;
  padding: 12rpx;
  font-size: calc(20rpx * var(--font-scale, 1));
}
.activity-copy {
  flex: 1;
  min-width: 0;
}
.activity-copy .point-title {
  font-size: calc(30rpx * var(--font-scale, 1));
}
.activity-copy .muted {
  font-size: calc(22rpx * var(--font-scale, 1));
}
.activity-enter {
  padding: 12rpx 24rpx;
  display: inline-block;
  border-radius: 24rpx;
  background: #edf3f5;
  font-size: calc(23rpx * var(--font-scale, 1));
  color: #456f86;
  margin-top: 16rpx;
}
.selected-phase {
  background: #dbeaf1;
}
