.activity-search {
  padding: calc(var(--jy-rpx, 1rpx) * 24) calc(var(--jy-rpx, 1rpx) * 28);
  background: #e9eff0;
  border: calc(var(--jy-rpx, 1rpx) * 2) solid #fff;
  border-radius: calc(var(--jy-rpx, 1rpx) * 32);
  margin-top: calc(var(--jy-rpx, 1rpx) * 24);
}
.activity-row {
  display: flex;
  gap: calc(var(--jy-rpx, 1rpx) * 24);
  padding: calc(var(--jy-rpx, 1rpx) * 24);
  border-radius: calc(var(--jy-rpx, 1rpx) * 36);
  background: #ffffffe0;
  border: calc(var(--jy-rpx, 1rpx) * 2) solid #fff;
  margin-top: calc(var(--jy-rpx, 1rpx) * 24);
}
.activity-poster {
  position: relative;
  width: calc(var(--jy-rpx, 1rpx) * 200);
  flex-shrink: 0;
  min-height: calc(var(--jy-rpx, 1rpx) * 250);
  max-height: calc(var(--jy-rpx, 1rpx) * 340);
  overflow: hidden;
  border-radius: calc(var(--jy-rpx, 1rpx) * 24);
  background: #e3eeeb;
}
.activity-poster text {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #28465190;
  color: white;
  padding: calc(var(--jy-rpx, 1rpx) * 12);
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 20) * var(--font-scale, 1));
}
.activity-copy {
  flex: 1;
  min-width: 0;
}
.activity-copy .point-title {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 30) * var(--font-scale, 1));
}
.activity-copy .muted {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 22) * var(--font-scale, 1));
}
.activity-enter {
  padding: calc(var(--jy-rpx, 1rpx) * 12) calc(var(--jy-rpx, 1rpx) * 24);
  display: inline-block;
  border-radius: calc(var(--jy-rpx, 1rpx) * 24);
  background: #edf3f5;
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 23) * var(--font-scale, 1));
  color: #456f86;
  margin-top: calc(var(--jy-rpx, 1rpx) * 16);
}
.selected-phase {
  background: #dbeaf1;
}

.season-map81 {
  width: 100%;
  height: calc(var(--jy-rpx, 1rpx) * 420);
  border-radius: calc(var(--jy-rpx, 1rpx) * 24);
  overflow: hidden;
}
.season-toggle81 {
  text-align: left;
  background: transparent;
  box-shadow: none;
  border: 0;
  padding: 0;
}
