<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{themeClass}}" style="{{themeStyle}}">
<view wx:if="{{featureBlocked}}" class="page"><view class="empty" role="status">功能正在维护中，敬请期待…</view></view><block wx:else>
<view class="page"><view class="row between"><view class="title">拍摄清单</view><button disabled="{{busy}}" size="mini" class="small primary" bindtap="create">新建</button></view><view class="muted gap">默认仅自己可见；主动分享可生成7天有效、可撤销的快照。完成计划不会代替真实打卡。</view><view wx:if="{{shareToken}}" class="card"><view class="point-title">{{shareTitle}} · 分享已就绪</view><view class="row wrap gap plan-actions"><button disabled="{{busy}}" class="primary" open-type="share">发给微信朋友</button><button disabled="{{busy}}" bindtap="copyShare">复制网页链接</button></view></view><state-view loading="{{loading}}" error="{{error}}" bind:retry="load"/><view wx:for="{{items}}" wx:key="id" wx:for-item="plan" class="card"><view class="point-title">{{plan.title}} · {{plan.completed}}/{{plan.items.length}}</view><view class="muted gap">预留 {{plan.schedule.estimatedMinutes}} 分钟 · {{plan.departure||'未设置出发时间'}}</view><button disabled="{{busy}}" size="mini" class="small gap" data-id="{{plan.id}}" bindtap="departure">设置出发时间</button><view wx:for="{{plan.schedule.warnings}}" wx:key="index" wx:for-item="warning" class="warning">{{warning.message}}</view><checkbox-group data-id="{{plan.id}}" bindchange="checklist"><label class="gap"><checkbox disabled="{{busy}}" value="battery" checked="{{plan.checklist.battery}}"/>电量充足</label><label class="gap"><checkbox disabled="{{busy}}" value="storage" checked="{{plan.checklist.storage}}"/>存储充足</label><label class="gap"><checkbox disabled="{{busy}}" value="weather" checked="{{plan.checklist.weather}}"/>已确认天气</label><label class="gap"><checkbox disabled="{{busy}}" value="access" checked="{{plan.checklist.access}}"/>已核对通行</label><label class="gap"><checkbox disabled="{{busy}}" value="gear" checked="{{plan.checklist.gear}}"/>设备已备齐</label></checkbox-group><button disabled="{{busy}}" wx:if="{{addSpot}}" class="primary gap" data-id="{{plan.id}}" bindtap="add">加入当前机位</button><view wx:for="{{plan.items}}" wx:key="id" class="plan-row"><view data-point="{{item.pointId}}" data-spot="{{item.spotId}}" bindtap="open" class="point-title">{{item.title}} ↗</view><view class="muted gap">{{item.composition || '尚未填写构图'}}</view><view class="row wrap gap plan-actions"><button disabled="{{busy}}" size="mini" class="small" data-id="{{plan.id}}" data-index="{{index}}" data-action="minutes" bindtap="action">停留 {{item.minutes||5}} 分钟</button><button size="mini" class="small" data-id="{{plan.id}}" data-index="{{index}}" data-action="done" bindtap="action" disabled="{{busy}}">{{item.done?'已完成 ✓':'标记完成'}}</button><button disabled="{{busy}}" size="mini" class="small" data-id="{{plan.id}}" data-index="{{index}}" data-action="edit" bindtap="action">构图</button><button size="mini" class="small" data-id="{{plan.id}}" data-index="{{index}}" data-action="up" bindtap="action" disabled="{{index===0 || busy}}">↑</button><button size="mini" class="small" data-id="{{plan.id}}" data-index="{{index}}" data-action="down" bindtap="action" disabled="{{index===plan.items.length-1 || busy}}">↓</button><button disabled="{{busy}}" size="mini" class="small" data-id="{{plan.id}}" data-index="{{index}}" data-action="remove" bindtap="action">移除</button></view></view><view class="row wrap gap plan-actions"><button size="mini" class="small" data-id="{{plan.id}}" data-action="share" bindtap="action" disabled="{{busy}}">分享</button><button size="mini" class="small" data-id="{{plan.id}}" data-action="revoke" bindtap="action" disabled="{{busy}}">撤销分享</button><button disabled="{{busy}}" size="mini" class="small" data-id="{{plan.id}}" data-action="rename" bindtap="action">重命名</button><button disabled="{{busy}}" size="mini" class="small danger" data-id="{{plan.id}}" data-action="delete" bindtap="action">删除清单</button></view></view><view wx:if="{{!items.length && !loading}}" class="empty">创建清单后，从真实机位加入想拍的位置。</view></view>

</block>
<experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>
