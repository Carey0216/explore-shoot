<view class="page"><view class="row between"><view class="title">拍摄清单</view><button class="small primary" bindtap="create">新建</button></view><view class="muted gap">仅自己可见；完成计划不会代替真实打卡。</view><state-view loading="{{loading}}" error="{{error}}" bind:retry="load"/><view wx:for="{{items}}" wx:key="id" wx:for-item="plan" class="card"><view class="point-title">{{plan.title}} · {{plan.completed}}/{{plan.items.length}}</view><button wx:if="{{addSpot}}" class="primary gap" data-id="{{plan.id}}" bindtap="add">加入当前机位</button><view wx:for="{{plan.items}}" wx:key="id" class="plan-row"><view data-point="{{item.pointId}}" data-spot="{{item.spotId}}" bindtap="open" class="point-title">{{item.title}} ↗</view><view class="muted gap">{{item.composition || '尚未填写构图'}}</view><view class="row wrap gap"><button class="small" data-id="{{plan.id}}" data-index="{{index}}" data-action="done" bindtap="action" disabled="{{busy}}">{{item.done?'已完成 ✓':'标记完成'}}</button><button class="small" data-id="{{plan.id}}" data-index="{{index}}" data-action="edit" bindtap="action">构图</button><button class="small" data-id="{{plan.id}}" data-index="{{index}}" data-action="up" bindtap="action" disabled="{{index===0 || busy}}">↑</button><button class="small" data-id="{{plan.id}}" data-index="{{index}}" data-action="down" bindtap="action" disabled="{{index===plan.items.length-1 || busy}}">↓</button><button class="small" data-id="{{plan.id}}" data-index="{{index}}" data-action="remove" bindtap="action">移除</button></view></view><view class="row gap"><button class="small" data-id="{{plan.id}}" data-action="rename" bindtap="action">重命名</button><button class="small danger" data-id="{{plan.id}}" data-action="delete" bindtap="action">删除清单</button></view></view><view wx:if="{{!items.length && !loading}}" class="empty">创建清单后，从真实机位加入想拍的位置。</view></view>
