<wxs src="/services/i18n.wxs" module="i18n"/>
<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{locale==='en-US'?'locale-en':''}} {{themeClass}} {{nativeImpact812?'native-impact812':''}}" style="{{themeStyle}}">
<view wx:if="{{localeTranslated}}" class="locale-note"><text>{{i18n.ui(localeTranslationUnavailable?'内容翻译暂时不可用，当前显示原文。':'内容由机器翻译，原文始终保留。',locale)}}</text><button bindtap="localeToggleOriginal">{{i18n.ui(localeOriginal?'显示译文':'查看原文',locale)}}</button></view>
<view wx:if="{{featureBlocked}}" class="page"><view class="empty" role="status">{{i18n.ui('功能正在维护中，敬请期待…',locale)}}</view></view><block wx:else>
<view class="page"><campus-collection wx:if="{{!nativeRewardItems812.length && !nativeOverlayOpen && !publicOverlayOpen && features.passport.visible!==false}}"/><view class="row between"><view class="title">{{i18n.ui('拍摄清单',locale)}}</view><button disabled="{{busy}}" size="mini" class="small primary" bindtap="create">{{i18n.ui('新建',locale)}}</button></view><view class="muted gap">{{i18n.ui('默认仅自己可见；主动分享可生成7天有效、可撤销的快照。完成计划不会代替真实打卡。',locale)}}</view><view wx:if="{{shareToken}}" class="card"><view class="point-title">{{i18n.content(shareTitle,locale,localeTranslations,localeOriginal)}} {{i18n.ui('· 分享已就绪',locale)}}</view><view wx:if="{{features.weather.visible!==false}}" class="muted gap">{{i18n.content(departureWeather||'天气正在准备…',locale,localeTranslations,localeOriginal)}}</view><view class="row wrap gap plan-actions"><button disabled="{{busy}}" class="primary" open-type="share">{{i18n.ui('发给微信朋友',locale)}}</button><button disabled="{{busy}}" bindtap="copyShare">{{i18n.ui('复制网页链接',locale)}}</button></view></view><state-view loading="{{loading}}" error="{{error}}" bind:retry="load"/><view wx:for="{{items}}" wx:key="id" wx:for-item="plan" class="card"><view class="muted">{{i18n.ui('出发准备卡',locale)}}</view><view class="point-title">{{i18n.content(plan.title,locale,localeTranslations,localeOriginal)}} · {{i18n.content(plan.completed,locale,localeTranslations,localeOriginal)}}/{{i18n.content(plan.items.length,locale,localeTranslations,localeOriginal)}}</view><view wx:if="{{plan.draftNotice}}" class="warning gap">{{i18n.content(plan.draftNotice,locale,localeTranslations,localeOriginal)}}<button wx:if="{{!plan.staleDraft}}" size="mini" data-id="{{plan.id}}" bindtap="retryPlan">{{i18n.ui('重试保存',locale)}}</button><button wx:else size="mini" data-id="{{plan.id}}" bindtap="discardPlanDraft">{{i18n.ui('使用账号最新安排',locale)}}</button></view><view class="muted gap">{{i18n.ui('预留',locale)}} {{i18n.content(plan.schedule.estimatedMinutes,locale,localeTranslations,localeOriginal)}} {{i18n.ui('分钟 ·',locale)}} {{i18n.ui(plan.departure||'未设置出发时间',locale)}}</view><button disabled="{{busy}}" size="mini" class="small gap" data-id="{{plan.id}}" bindtap="departure">{{i18n.ui('设置出发时间',locale)}}</button><view wx:for="{{plan.schedule.warnings}}" wx:key="index" wx:for-item="warning" class="warning">{{i18n.content(warning.message,locale,localeTranslations,localeOriginal)}}</view><view class="next-stop813" wx:if="{{plan.next}}"><view class="muted">{{i18n.ui('下一站',locale)}} · {{plan.next.minutes||5}} {{i18n.ui('分钟',locale)}}</view><view class="point-title">{{i18n.content(plan.next.title,locale,localeTranslations,localeOriginal)}}</view><view class="muted gap">{{i18n.content(plan.next.opening,locale,localeTranslations,localeOriginal)}}</view><view class="row wrap gap"><button size="mini" class="primary" data-id="{{plan.id}}" data-stage="prepare" bindtap="nextAction" disabled="{{plan.next.closed}}">{{i18n.ui('导航出发',locale)}}</button><button size="mini" data-id="{{plan.id}}" data-stage="arrived" bindtap="nextAction">{{i18n.ui('我已到达 · 去取景',locale)}}</button><button size="mini" data-id="{{plan.id}}" data-stage="captured" bindtap="nextAction">{{i18n.ui('拍好了，去记录',locale)}}</button></view></view><checkbox-group data-id="{{plan.id}}" bindchange="checklist"><label class="gap"><checkbox disabled="{{busy}}" value="battery" checked="{{plan.checklist.battery}}"/>{{i18n.ui('电量充足',locale)}}</label><label class="gap"><checkbox disabled="{{busy}}" value="storage" checked="{{plan.checklist.storage}}"/>{{i18n.ui('存储充足',locale)}}</label><label class="gap"><checkbox disabled="{{busy}}" value="weather" checked="{{plan.checklist.weather}}"/>{{i18n.ui('已确认天气',locale)}}</label><label class="gap"><checkbox disabled="{{busy}}" value="access" checked="{{plan.checklist.access}}"/>{{i18n.ui('已核对通行',locale)}}</label><label class="gap"><checkbox disabled="{{busy}}" value="gear" checked="{{plan.checklist.gear}}"/>{{i18n.ui('设备已备齐',locale)}}</label></checkbox-group><button disabled="{{busy}}" wx:if="{{addSpot}}" class="primary gap" data-id="{{plan.id}}" bindtap="add">{{i18n.ui('加入当前机位',locale)}}</button><view wx:for="{{plan.items}}" wx:key="id" class="plan-row"><view data-point="{{item.pointId}}" data-spot="{{item.spotId}}" bindtap="open" class="point-title">{{i18n.content(item.title,locale,localeTranslations,localeOriginal)}} ↗</view><view class="muted gap">{{i18n.ui(item.composition || '尚未填写构图',locale)}}</view><view wx:if="{{features.weather.visible!==false}}" class="muted gap">{{i18n.content(departureWeather||'天气正在准备…',locale,localeTranslations,localeOriginal)}}</view><view class="row wrap gap plan-actions"><button disabled="{{busy}}" size="mini" class="small" data-id="{{plan.id}}" data-index="{{index}}" data-action="minutes" bindtap="action">{{i18n.ui('停留',locale)}} {{i18n.content(item.minutes||5,locale,localeTranslations,localeOriginal)}} {{i18n.ui('分钟',locale)}}</button><button size="mini" class="small" data-id="{{plan.id}}" data-index="{{index}}" data-action="done" bindtap="action" disabled="{{busy}}">{{i18n.ui(item.done?'已完成 ✓':'标记完成',locale)}}</button><button disabled="{{busy}}" size="mini" class="small" data-id="{{plan.id}}" data-index="{{index}}" data-action="edit" bindtap="action">{{i18n.ui('构图',locale)}}</button><button size="mini" class="small" data-id="{{plan.id}}" data-index="{{index}}" data-action="up" bindtap="action" disabled="{{index===0 || busy}}">↑</button><button size="mini" class="small" data-id="{{plan.id}}" data-index="{{index}}" data-action="down" bindtap="action" disabled="{{index===plan.items.length-1 || busy}}">↓</button><button disabled="{{busy}}" size="mini" class="small" data-id="{{plan.id}}" data-index="{{index}}" bindtap="replaceOpen">{{i18n.ui('换一站',locale)}}</button><button disabled="{{busy}}" size="mini" class="small" data-id="{{plan.id}}" data-index="{{index}}" data-action="remove" bindtap="action">{{i18n.ui('移除',locale)}}</button></view></view><view wx:if="{{features.weather.visible!==false}}" class="muted gap">{{i18n.content(departureWeather||'天气正在准备…',locale,localeTranslations,localeOriginal)}}</view><view class="row wrap gap plan-actions"><button size="mini" class="small" data-id="{{plan.id}}" data-action="share" bindtap="action" disabled="{{busy}}">{{i18n.ui('分享',locale)}}</button><button size="mini" class="small" data-id="{{plan.id}}" data-action="revoke" bindtap="action" disabled="{{busy}}">{{i18n.ui('撤销分享',locale)}}</button><button disabled="{{busy}}" size="mini" class="small" data-id="{{plan.id}}" data-action="rename" bindtap="action">{{i18n.ui('重命名',locale)}}</button><button disabled="{{busy}}" size="mini" class="small danger" data-id="{{plan.id}}" data-action="delete" bindtap="action">{{i18n.ui('删除清单',locale)}}</button></view></view><view wx:if="{{!items.length && !loading}}" class="empty">{{i18n.ui('创建清单后，从真实机位加入想拍的位置。',locale)}}</view></view>

</block>
<view wx:if="{{replacing}}" class="replace-mask813" bindtap="replaceClose"><view class="replace-sheet813" catchtap="noop"><view class="point-title">{{i18n.ui('给这一站换个机位',locale)}}</view><picker class="gap" range="{{i18n.options(replacePoints,locale)}}" range-key="name" value="{{replacePoint}}" bindchange="replacePointChange"><view class="field813">{{i18n.content(replacePoints[replacePoint].name,locale,localeTranslations,localeOriginal)}} ⌄</view></picker><picker class="gap" range="{{i18n.options(replaceSpots,locale)}}" range-key="title" value="{{replaceSpot}}" bindchange="replaceSpotChange"><view class="field813">{{replaceSpots[replaceSpot].title||i18n.ui('请选择机位',locale)}} ⌄</view></picker><view class="muted gap">{{i18n.content(replaceHint,locale,localeTranslations,localeOriginal)}}</view><button class="primary gap" bindtap="replaceSave" disabled="{{busy||!replaceSpots.length}}">{{i18n.ui('替换这一站',locale)}}</button></view></view><experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>

<reward-overlay id="reward-overlay812" items="{{nativeRewardItems812}}" bind:dismiss="dismissNativeRewards812" bind:impact="nativeImpact812"/>
