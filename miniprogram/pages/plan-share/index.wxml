<view class="page"><state-view loading="{{loading}}" error="{{error}}" bind:retry="load"/><block wx:if="{{plan}}"><view class="title">{{plan.title}}</view><view class="muted gap">分享者主动公开的计划快照；不包含身份、照片与完成进度。仅展示当前仍发布的机位。</view><view wx:for="{{plan.items}}" wx:key="spotId" class="card" data-id="{{item.spotId}}" bindtap="open"><view class="point-title">{{item.title}} ↗</view><view class="gap">{{item.composition}}</view></view><button class="primary gap" disabled="{{busy || !plan.items.length}}" bindtap="importPlan">保存到我的拍摄清单</button></block></view>
