<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{themeClass}}" style="{{themeStyle}}">
<view wx:if="{{featureBlocked}}" class="page"><view class="empty" role="status">功能正在维护中，敬请期待…</view></view><block wx:else>

<view wx:if="{{signedIn}}" class="page"><view class="title">消息中心 {{unread ? '(' + unread + ')' : ''}}</view>
<view class="row wrap gap"><button size="mini" wx:for="{{categories}}" wx:key="id" class="small {{category===item.id?'primary':''}}" data-id="{{item.id}}" bindtap="category">{{item.title}}</button></view>
<view class="muted gap">暂停角标，消息仍保留；不屏蔽独立投放的开屏公告。</view>
<view class="row wrap gap"><button size="mini" class="small" disabled="{{!selected.length}}" bindtap="batch">所选已读 {{selected.length||''}}</button><button size="mini" class="small" disabled="{{!unread}}" bindtap="all">本分类全部已读</button></view>
<checkbox-group bindchange="selection"><view wx:for="{{items}}" wx:key="id" class="card {{item.readAt ? '' : 'unread'}}"><label class="row"><checkbox checked="{{selectedMap[item.id]}}" value="{{item.id}}" disabled="{{!!item.readAt}}"/>{{item.readAt?'已读':'选择此消息'}}</label><view data-id="{{item.id}}" bindtap="open"><view class="point-title gap">{{item.title}}</view><view class="gap">{{item.message}}</view><view class="muted gap">{{item.time}} · 查看完整消息 ↗</view></view></view></checkbox-group>
<state-view loading="{{loading}}" error="{{error}}" empty="{{!items.length}}" bind:retry="load"/></view>
<site-overlay id="site-overlay" content="{{siteContent}}" runtime="{{runtime}}" announcement="{{announcement}}" page="notifications" bind:dismiss="dismissPublicOverlay" bind:overlay="publicOverlay"/>

</block>
<experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>
