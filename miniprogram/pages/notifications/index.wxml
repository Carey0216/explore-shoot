<page-meta page-style="{{publicOverlayOpen ? 'overflow: hidden;' : ''}}"/>
<view wx:if="{{signedIn}}" class="page"><view class="row between"><view class="title">通知 {{unread ? '(' + unread + ')' : ''}}</view><button class="small" disabled="{{!unread}}" bindtap="all">全部已读</button></view>
  <view wx:for="{{items}}" wx:key="id" class="card {{item.readAt ? '' : 'unread'}}" data-id="{{item.id}}" bindtap="open"><view class="point-title">{{item.title}}</view><view class="gap">{{item.message}}</view><view class="muted gap">{{item.createdAt}} · {{item.readAt ? '已读' : '未读'}}</view></view>
  <state-view loading="{{loading}}" error="{{error}}" empty="{{!items.length}}" bind:retry="load"/>
</view>

<site-overlay id="site-overlay" content="{{siteContent}}" runtime="{{runtime}}" announcement="{{announcement}}" page="notifications" bind:dismiss="dismissPublicOverlay" bind:overlay="publicOverlay"/>
