<wxs src="/services/i18n.wxs" module="i18n"/>
<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{locale==='en-US'?'locale-en':''}} {{themeClass}}" style="{{themeStyle}}">
<view wx:if="{{localeTranslated}}" class="locale-note"><text>{{i18n.ui(localeTranslationUnavailable?'内容翻译暂时不可用，当前显示原文。':'内容由机器翻译，原文始终保留。',locale)}}</text><button bindtap="localeToggleOriginal">{{i18n.ui(localeOriginal?'显示译文':'查看原文',locale)}}</button></view>
<view wx:if="{{featureBlocked}}" class="page"><view class="empty" role="status">{{i18n.ui('功能正在维护中，敬请期待…',locale)}}</view></view><block wx:else>

<view wx:if="{{signedIn}}" class="page"><view class="title">{{i18n.ui('消息中心',locale)}} {{i18n.content(unread ? '(' + unread + ')' : '',locale,localeTranslations,localeOriginal)}}</view>
<scroll-view scroll-x class="scroll-chips message-categories gap"><view class="chip-row"><button size="mini" wx:for="{{categories}}" wx:key="id" class="small {{category===item.id?'primary':''}}" data-id="{{item.id}}" bindtap="category">{{i18n.content(item.title,locale,localeTranslations,localeOriginal)}}</button></view></scroll-view>
<view class="muted gap">{{i18n.ui('公告、活动与更新各归各类，想回看时更好找。',locale)}}</view>
<view class="row wrap gap"><button size="mini" class="small" disabled="{{!selected.length}}" bindtap="batch">{{i18n.ui('所选已读',locale)}} {{i18n.content(selected.length||'',locale,localeTranslations,localeOriginal)}}</button><button size="mini" class="small" disabled="{{!unread}}" bindtap="all">{{i18n.ui('本分类全部已读',locale)}}</button></view>
<checkbox-group bindchange="selection"><view wx:for="{{items}}" wx:key="id" class="card {{item.readAt ? '' : 'unread'}}"><label class="row"><checkbox checked="{{selectedMap[item.id]}}" value="{{item.id}}" disabled="{{!!item.readAt}}"/>{{i18n.ui(item.readAt?'已读':'选择此消息',locale)}}</label><view data-id="{{item.id}}" bindtap="open"><view class="point-title gap">{{i18n.content(item.title,locale,localeTranslations,localeOriginal)}}</view><view class="gap">{{i18n.content(item.message,locale,localeTranslations,localeOriginal)}}</view><view class="muted gap">{{i18n.content(item.time,locale,localeTranslations,localeOriginal)}} {{i18n.ui('· 查看完整消息 ↗',locale)}}</view></view></view></checkbox-group>
<state-view loading="{{loading}}" error="{{error}}" empty="{{!items.length}}" bind:retry="load"/></view>
<site-overlay id="site-overlay" content="{{siteContent}}" runtime="{{runtime}}" announcement="{{announcement}}" page="notifications" bind:dismiss="dismissPublicOverlay" bind:overlay="publicOverlay"/>

</block>
<experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>
