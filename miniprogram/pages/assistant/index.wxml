<wxs src="/services/i18n.wxs" module="i18n"/>
<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{locale==='en-US'?'locale-en':''}} {{themeClass}} {{nativeImpact812?'native-impact812':''}}" style="{{themeStyle}}">
<view wx:if="{{localeTranslated}}" class="locale-note"><text>{{i18n.ui(localeTranslationUnavailable?'内容翻译暂时不可用，当前显示原文。':'内容由机器翻译，原文始终保留。',locale)}}</text><button bindtap="localeToggleOriginal">{{i18n.ui(localeOriginal?'显示译文':'查看原文',locale)}}</button></view>
<view wx:if="{{featureBlocked}}" class="page"><view class="empty" role="status">{{i18n.ui('功能正在维护中，敬请期待…',locale)}}</view></view><block wx:else>

<view class="page">
  <view class="eyebrow">{{i18n.ui('校园资料 · 有据可查',locale)}}</view><view class="title">{{i18n.ui('校园拍照助手',locale)}}</view>
  <view class="card"><label class="label">{{i18n.ui('想了解什么？',locale)}}</label><textarea class="input" value="{{question}}" maxlength="300" bindinput="question" placeholder-class="field-placeholder" placeholder="{{i18n.ui('例如：图书馆适合怎么拍？',locale)}}"/><view class="row gap"><switch checked="{{generate}}" disabled="{{!available || loading}}" bindchange="generate" color="#245b4c"/><text>{{i18n.ui('使用模型整理回答',locale)}}</text></view><view class="privacy">{{i18n.ui(available ? '开启后会将问题及匹配的公开校园资料发送给已配置的模型服务，不发送私人打卡或照片。' : '当前可使用本地资料检索，尚未配置生成模型。',locale)}}</view><button class="primary block" bindtap="search" loading="{{loading}}" disabled="{{loading}}">{{i18n.ui('查找资料',locale)}}</button></view>
  <state-view loading="{{loading}}" error="{{error}}" bind:retry="search"/>
  <block wx:if="{{answer}}"><view class="card"><view class="tag">{{i18n.ui(answer.mode === 'generated' ? 'AI依据资料整理' : '资料检索结果',locale)}}</view><text class="assistant-copy">{{i18n.content(answer.answer,locale,localeTranslations,localeOriginal)}}</text><view wx:for="{{answer.notices}}" wx:key="*this" class="privacy">{{i18n.content(item,locale,localeTranslations,localeOriginal)}}</view></view><view wx:if="{{answer.places.length}}" class="section-title">{{i18n.ui('相关地点',locale)}}</view><button wx:for="{{answer.places}}" wx:key="id" class="gap" data-id="{{item.id}}" bindtap="open">{{i18n.content(item.name,locale,localeTranslations,localeOriginal)}} ›</button><view class="section-title">{{i18n.ui('资料来源',locale)}}</view><view wx:for="{{answer.sources}}" wx:key="id" class="card"><view class="point-title">{{i18n.content(item.title,locale,localeTranslations,localeOriginal)}}</view><text class="assistant-copy muted">{{i18n.content(item.excerpt,locale,localeTranslations,localeOriginal)}}</text><view wx:if="{{item.sourceUrl}}" class="privacy">{{i18n.content(item.sourceUrl,locale,localeTranslations,localeOriginal)}}</view></view></block>
</view>
<site-overlay id="site-overlay" content="{{siteContent}}" runtime="{{runtime}}" announcement="{{announcement}}" page="assistant" bind:dismiss="dismissPublicOverlay" bind:overlay="publicOverlay"/>

</block>
<experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>

<reward-overlay id="reward-overlay812" items="{{nativeRewardItems812}}" bind:dismiss="dismissNativeRewards812" bind:impact="nativeImpact812"/>
