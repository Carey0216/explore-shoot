<wxs src="/services/i18n.wxs" module="i18n"/>
<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{locale==='en-US'?'locale-en':''}} {{themeClass}} {{nativeImpact812?'native-impact812':''}}" style="{{themeStyle}}">
<view wx:if="{{localeTranslated}}" class="locale-note"><text>{{i18n.ui(localeTranslationUnavailable?'内容翻译暂时不可用，当前显示原文。':'内容由机器翻译，原文始终保留。',locale)}}</text><button bindtap="localeToggleOriginal">{{i18n.ui(localeOriginal?'显示译文':'查看原文',locale)}}</button></view>
<view wx:if="{{featureBlocked}}" class="page"><view class="empty" role="status">{{i18n.ui('功能正在维护中，敬请期待…',locale)}}</view></view><block wx:else>

<view wx:if="{{signedIn}}" class="page"><view class="eyebrow">CAMPUS PASSPORT</view><view class="title">{{i18n.ui('校园打卡护照',locale)}}</view>
  <state-view loading="{{loading}}" error="{{error}}" bind:retry="load"/>
  <view class="card"><view class="stat-number">{{i18n.content(summary.current || 0,locale,localeTranslations,localeOriginal)}} / {{i18n.content(summary.total || 0,locale,localeTranslations,localeOriginal)}}</view><view class="muted">{{i18n.ui('已收集地点',locale)}}</view></view>
  <view class="section-title">{{i18n.ui('主题印章',locale)}}</view><view class="stamp-grid"><view class="stamp-column" wx:for="{{achievementColumns}}" wx:for-item="column" wx:key="index"><view wx:for="{{column}}" wx:key="id" class="stamp {{item.earned ? 'earned' : ''}}"><image class="stamp-image" src="{{item.badge}}" mode="aspectFit"/><view>{{i18n.content(item.title,locale,localeTranslations,localeOriginal)}}</view><view class="muted">{{i18n.content(item.progress,locale,localeTranslations,localeOriginal)}} / {{i18n.content(item.target,locale,localeTranslations,localeOriginal)}}</view><view class="muted">{{i18n.content(item.description,locale,localeTranslations,localeOriginal)}}</view></view></view></view>
  <view wx:if="{{!achievements.length && !loading}}" class="empty">{{i18n.ui('管理员尚未发布主题印章',locale)}}</view>
  <button wx:if="{{features['campus-3d'].visible!==false}}" class="gap" bindtap="scene">{{i18n.ui('查看三维楼宇点亮图 ↗',locale)}}</button><view class="section-title">{{i18n.ui('楼宇点亮图',locale)}}</view><view class="row"><view class="pill {{frame === 'photo' ? 'active' : ''}}" data-id="photo" bindtap="frame">{{i18n.ui('校园影像',locale)}}</view><view class="pill {{frame === 'plan' ? 'active' : ''}}" data-id="plan" bindtap="frame">{{i18n.ui('楼宇编号图',locale)}}</view></view>
  <view class="card atlas-card"><canvas type="2d" id="atlas" bindtap="atlasTap" style="width: 100%; height: {{atlasHeight}}px;"/><view wx:if="{{atlasError}}" class="warning">{{i18n.content(atlasError,locale,localeTranslations,localeOriginal)}}</view></view>
  <view class="privacy">{{i18n.ui('未打卡楼宇为灰色，已打卡楼宇显示原色；待管理员关联点位的楼宇保持灰色。影像位置不是导航坐标。',locale)}}</view>
  <view wx:if="{{selectedBuilding}}" class="card selected-building"><view class="point-title">{{i18n.content(selectedBuilding.name,locale,localeTranslations,localeOriginal)}}</view><view class="muted gap">{{i18n.ui(selectedBuilding.collected?'已点亮':'尚未点亮',locale)}} · {{i18n.ui(selectedBuilding.pointIds.length ? '到关联地点完成打卡即可点亮' : '等待管理员关联地点',locale)}}</view><button wx:for="{{selectedBuilding.pointIds}}" wx:key="*this" class="gap" data-id="{{item}}" bindtap="buildingPoint">{{i18n.ui('查看关联地点',locale)}} {{i18n.content(index+1,locale,localeTranslations,localeOriginal)}} ↗</button><view class="row wrap gap" wx:for="{{selectedBuilding.pointIds}}" wx:key="*this"><button size="mini" data-id="{{item}}" bindtap="buildingRoute">{{i18n.ui('规划路线',locale)}}</button><button size="mini" class="primary" data-id="{{item}}" bindtap="buildingCheckin">{{i18n.ui('到达后打卡',locale)}}</button></view></view><view class="building-list"><view wx:for="{{buildings}}" wx:key="id" data-id="{{item.id}}" bindtap="buildingTap" class="building {{item.collected ? 'lit' : ''}}"><text>{{i18n.content(item.collected ? '●' : '○',locale,localeTranslations,localeOriginal)}} {{i18n.content(item.name,locale,localeTranslations,localeOriginal)}}</text><text class="muted">{{i18n.ui(item.collected ? '已点亮' : item.pointIds.length ? '未打卡' : '待关联',locale)}}</text></view></view>
  <view class="section-title gap">{{i18n.ui('我的收集里程碑',locale)}}</view><view wx:for="{{milestones}}" wx:key="id" class="card gap milestone820"><image class="milestone-badge820 {{item.earned?'earned':''}}" src="{{item.badge}}" mode="aspectFit"/><view class="grow"><view>{{i18n.content(locale==='en-US'?item.titleEn:item.title,locale,localeTranslations,localeOriginal)}}</view><view class="muted">{{i18n.content(locale==='en-US'?item.descriptionEn:item.description,locale,localeTranslations,localeOriginal)}}</view><progress percent="{{item.progress/item.target*100}}" activeColor="#366c96"/><view class="muted">{{i18n.content(item.progress,locale,localeTranslations,localeOriginal)}} / {{i18n.content(item.target,locale,localeTranslations,localeOriginal)}}</view><button wx:if="{{item.nextPointIds.length}}" size="mini" data-id="{{item.nextPointIds[0]}}" bindtap="milestoneNext">{{i18n.ui('下一处可以去这里',locale)}} →</button></view></view><button class="gap" bindtap="timeline">{{i18n.ui('同一个地方，不同的时间',locale)}} →</button>
  <button class="primary gap" bindtap="generate" loading="{{generating}}">{{i18n.ui('生成分享卡片',locale)}}</button><view class="privacy">{{i18n.ui('分享卡仅包含收集数量与已获得印章，不包含私人照片、定位和打卡感受。',locale)}}</view><image wx:if="{{card}}" class="share-preview" src="{{card}}" mode="widthFix"/><view wx:if="{{canSave}}" class="row gap"><button class="grow" bindtap="changeStyle" disabled="{{generating}}">{{i18n.ui('换一个样式',locale)}}</button><button class="grow primary" bindtap="save">{{i18n.ui('保存卡片',locale)}}</button></view><view wx:if="{{canSave}}" class="muted gap">{{i18n.content(styleName,locale,localeTranslations,localeOriginal)}} · {{i18n.content(style+1,locale,localeTranslations,localeOriginal)}} / 11</view><canvas id="share-card" type="2d" class="offscreen"/>
</view>

<site-overlay id="site-overlay" content="{{siteContent}}" runtime="{{runtime}}" announcement="{{announcement}}" page="passport" bind:dismiss="dismissPublicOverlay" bind:overlay="publicOverlay"/>

</block>
<experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>

<reward-overlay id="reward-overlay812" items="{{nativeRewardItems812}}" bind:dismiss="dismissNativeRewards812" bind:impact="nativeImpact812"/>
