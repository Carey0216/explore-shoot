<wxs src="/services/i18n.wxs" module="i18n"/>
<page-meta page-style="{{pageStyle}} {{nativeRewardItems812.length || publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen ? 'overflow:hidden;' : ''}}"/>
<view bindtouchstart="cancelNativeDemoHint" class="native-surface {{locale==='en-US'?'locale-en':''}} {{themeClass}} {{nativeImpact812?'native-impact812':''}}" style="{{themeStyle}}">
<view wx:if="{{localeTranslated}}" class="locale-note"><text>{{i18n.ui(localeTranslationUnavailable?'内容翻译暂时不可用，当前显示原文。':'内容由机器翻译，原文始终保留。',locale)}}</text><button bindtap="localeToggleOriginal">{{i18n.ui(localeOriginal?'显示译文':'查看原文',locale)}}</button></view>
<view wx:if="{{featureBlocked}}" class="page"><view class="empty" role="status">{{i18n.ui('功能正在维护中，敬请期待…',locale)}}</view></view><block wx:else>

<view wx:if="{{signedIn}}" class="page"><view class="eyebrow">CAMPUS PASSPORT</view><view class="title">{{i18n.ui('校园打卡护照',locale)}}</view>
  <state-view loading="{{loading}}" error="{{error}}" bind:retry="load"/>
  <view class="card"><view class="stat-number">{{i18n.content(summary.current || 0,locale,localeTranslations,localeOriginal)}} / {{i18n.content(summary.total || 0,locale,localeTranslations,localeOriginal)}}</view><view class="muted">{{i18n.ui('已收集地点',locale)}}</view></view>
  <view class="section-title">{{i18n.ui('主题印章',locale)}}</view><view class="stamp-grid"><view class="stamp-column" wx:for="{{achievementColumns}}" wx:for-item="column" wx:key="index"><view wx:for="{{column}}" wx:key="id" class="stamp {{item.earned ? 'earned' : ''}}"><image class="stamp-image" src="{{item.badge}}" mode="aspectFit"/><view>{{i18n.content(item.title,locale,localeTranslations,localeOriginal)}}</view><view class="muted">{{i18n.content(item.progress,locale,localeTranslations,localeOriginal)}} / {{i18n.content(item.target,locale,localeTranslations,localeOriginal)}}</view><view class="muted">{{i18n.content(item.description,locale,localeTranslations,localeOriginal)}}</view></view></view></view>
  <view wx:if="{{!achievements.length && !loading}}" class="empty">{{i18n.ui('管理员尚未发布主题印章',locale)}}</view>
  <button wx:if="{{features['campus-3d'].visible!==false}}" class="gap" bindtap="scene">{{i18n.ui('查看三维楼宇点亮图 ↗',locale)}}</button><view class="section-title">{{i18n.ui('楼宇点亮图',locale)}}</view><view class="row"><view class="pill {{frame === 'photo' ? 'active' : ''}}" data-id="photo" bindtap="frame">{{i18n.ui('校园影像',locale)}}</view><view class="pill {{frame === 'plan' ? 'active' : ''}}" data-id="plan" bindtap="frame">{{i18n.ui('楼宇编号图',locale)}}</view></view>
  <view wx:if="{{recommendation}}" class="card selected-building">
    <view class="muted">{{locale==='en-US'?'Next building':'下一栋'}}</view>
    <view class="point-title">{{i18n.content(recommendation.name,locale,localeTranslations,localeOriginal)}}</view>
    <view wx:if="{{recommendation.metres >= 0}}" class="muted gap">{{locale==='en-US'?'Straight-line distance':'直线距离约'}} {{recommendation.metres}} m</view>
    <view wx:elif="{{recommendation.reason==='plan'}}" class="muted gap">{{locale==='en-US'?'Next stop in your saved plan':'是你拍摄计划中的下一站'}}</view>
    <view wx:else class="muted gap">{{locale==='en-US'?'Check in at this linked place to light it up.':'已关联可前往地点，完成打卡即可点亮。'}}</view>
    <view class="row wrap gap"><button size="mini" bindtap="showRecommendation">{{locale==='en-US'?'Show on map':'在图上查看'}}</button><button size="mini" bindtap="recommendNearby" loading="{{locatingRecommendation}}" disabled="{{locatingRecommendation}}">{{locale==='en-US'?'Find near me':'按我的位置推荐'}}</button></view>
  </view>
  <view class="card atlas-card"><canvas wx:if="{{!nativeRewardItems812.length}}" type="2d" id="atlas" bindtap="atlasTap" style="width: 100%; height: {{atlasHeight}}px;"/><image wx:else class="atlas-backdrop" src="{{atlasBackdrop}}" mode="scaleToFill" style="height:{{atlasHeight}}px"/><view wx:if="{{atlasError}}" class="warning">{{i18n.content(atlasError,locale,localeTranslations,localeOriginal)}}</view></view>
  <view wx:if="{{selectedBuilding}}" id="atlas-building-guide" class="card atlas-building-guide">
    <view class="atlas-guide-header">
      <text class="atlas-guide-label">{{locale==='en-US'?'Selected building':'已选楼宇'}}</text>
      <text class="atlas-guide-status {{selectedBuilding.collected?'is-lit':''}}">{{i18n.ui(selectedBuilding.collected?'已点亮':'尚未点亮',locale)}}</text>
    </view>
    <view class="point-title atlas-guide-name">{{i18n.content(selectedBuilding.displayName || selectedBuilding.name,locale,localeTranslations,localeOriginal)}}</view>
    <block wx:if="{{selectedBuilding.points.length}}">
      <view class="muted atlas-guide-help">{{locale==='en-US'?'Open directions, then check in at the place.':'先查看路线，到达关联地点后即可打卡。'}}</view>
      <view wx:for="{{selectedBuilding.points}}" wx:key="id" class="atlas-guide-stop">
        <view wx:if="{{selectedBuilding.points.length>1}}" class="atlas-stop-name">{{i18n.content(item.name,locale,localeTranslations,localeOriginal)}}</view>
        <view wx:if="{{!item.open}}" class="muted">{{locale==='en-US'?'Marked closed':'当前标记为关闭'}}</view>
        <view class="atlas-guide-actions">
          <button wx:if="{{item.open}}" class="primary" data-id="{{item.id}}" bindtap="buildingRoute">{{locale==='en-US'?'Get directions':'去这里 · 看路线'}}</button>
          <button class="atlas-guide-detail" data-id="{{item.id}}" bindtap="buildingPoint">{{locale==='en-US'?'View place':'查看点位'}}</button>
        </view>
        <button wx:if="{{item.open}}" class="atlas-guide-checkin" size="mini" data-id="{{item.id}}" bindtap="buildingCheckin">{{i18n.ui('到达后打卡',locale)}} ↗</button>
      </view>
    </block>
    <block wx:elif="{{selectedBuilding.pointLookupFailed}}">
      <view class="muted atlas-guide-help">{{locale==='en-US'?'Linked places could not be loaded.':'暂时未能载入关联点位。'}}</view>
      <button class="gap" bindtap="load">{{i18n.ui('重试',locale)}}</button>
    </block>
    <view wx:else class="muted atlas-guide-help">{{selectedBuilding.pointIds.length ? (locale==='en-US'?'No public place to open yet.':'暂无可查看的公开点位。') : (locale==='en-US'?'Waiting for a linked campus place.':'这栋楼还在等待关联校园点位。')}}</view>
  </view>
  <view class="atlas-legend821"><view class="atlas-key821"/><text>{{i18n.ui('未打卡',locale)}}</text><view class="atlas-key821 atlas-key-selected821"/><text>{{i18n.ui('已选中',locale)}}</text><view class="atlas-key821 atlas-key-lit821"/><text>{{i18n.ui('已点亮',locale)}}</text></view><view class="privacy">{{i18n.ui('未打卡楼宇为灰色，已打卡楼宇显示原色；待管理员关联点位的楼宇保持灰色。影像位置不是导航坐标。',locale)}}</view>
  <view class="section-title gap">{{i18n.ui('我的收集里程碑',locale)}}</view><view wx:for="{{milestones}}" wx:key="id" class="card gap milestone820"><image class="milestone-badge820 {{item.earned?'earned':''}}" src="{{item.badge}}" mode="aspectFit"/><view class="grow"><view>{{i18n.content(locale==='en-US'?item.titleEn:item.title,locale,localeTranslations,localeOriginal)}}</view><view class="muted">{{i18n.content(locale==='en-US'?item.descriptionEn:item.description,locale,localeTranslations,localeOriginal)}}</view><progress percent="{{item.progress/item.target*100}}" activeColor="#366c96"/><view class="muted">{{i18n.content(item.progress,locale,localeTranslations,localeOriginal)}} / {{i18n.content(item.target,locale,localeTranslations,localeOriginal)}}</view><button wx:if="{{item.nextPointIds.length}}" size="mini" data-id="{{item.nextPointIds[0]}}" bindtap="milestoneNext">{{i18n.ui('下一处可以去这里',locale)}} →</button></view></view><view class="building-list"><view wx:for="{{buildings}}" wx:if="{{index<buildingLimit}}" wx:key="id" data-id="{{item.id}}" bindtap="buildingTap" class="building {{item.collected ? 'lit' : ''}} {{selectedBuilding.id===item.id?'building-selected821':''}}" aria-role="button" aria-pressed="{{selectedBuilding.id===item.id}}"><text>{{i18n.content(item.collected ? '●' : '○',locale,localeTranslations,localeOriginal)}} {{i18n.content(item.displayName || item.name,locale,localeTranslations,localeOriginal)}}</text><text class="muted">{{i18n.ui(item.collected ? '已点亮' : item.pointIds.length ? '未打卡' : '待关联',locale)}}</text></view></view>
<button wx:if="{{buildings.length>buildingLimit}}" class="gap" bindtap="moreBuildings">{{locale==='en-US'?'Show five more':'再显示五栋'}}</button><button class="gap" bindtap="timeline">{{i18n.ui('同一个地方，不同的时间',locale)}} →</button>
  <button class="primary gap" bindtap="generate" loading="{{generating}}">{{i18n.ui('生成分享卡片',locale)}}</button><view class="privacy">{{i18n.ui('分享卡仅包含收集数量与已获得印章，不包含私人照片、定位和打卡感受。',locale)}}</view><share-art-editor wx:if="{{card}}" id="passport-art" source="{{card}}" codes="{{cardCodes}}" locale="{{locale}}" dark="{{themeDark}}"/><view wx:if="{{canSave}}" class="row gap"><button class="grow" bindtap="changeStyle" disabled="{{generating}}">{{i18n.ui('换一个样式',locale)}}</button><button class="grow primary" bindtap="save" disabled="{{generating}}">{{i18n.ui('保存卡片',locale)}}</button></view><view wx:if="{{canSave}}" class="muted gap">{{i18n.content(styleName,locale,localeTranslations,localeOriginal)}} · {{i18n.content(style+1,locale,localeTranslations,localeOriginal)}} / 11</view><canvas id="share-card" type="2d" class="offscreen"/>
</view>

<site-overlay id="site-overlay" content="{{siteContent}}" runtime="{{runtime}}" announcement="{{announcement}}" page="passport" bind:dismiss="dismissPublicOverlay" bind:overlay="publicOverlay"/>

</block>
<experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>

<reward-overlay id="reward-overlay812" items="{{nativeRewardItems812}}" bind:dismiss="dismissPassportReward" bind:impact="nativeImpact812"/>
