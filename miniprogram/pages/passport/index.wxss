.stamp {
  display: block;
  width: 100%;
  box-sizing: border-box;
  margin: 0 0 calc(var(--jy-rpx, 1rpx) * 20);
  padding: calc(var(--jy-rpx, 1rpx) * 24) calc(var(--jy-rpx, 1rpx) * 16);
  text-align: center;
  border: calc(var(--jy-rpx, 1rpx) * 2) dashed #c5cec4;
  border-radius: calc(var(--jy-rpx, 1rpx) * 28);
  background: #edf0ec;
  color: #7d897f;
}
.earned {
  background: #fbf0d2;
  border-color: #c6a66a;
  color: #785b2a;
}
.stamp-image {
  width: calc(var(--jy-rpx, 1rpx) * 108);
  height: calc(var(--jy-rpx, 1rpx) * 108);
}
.atlas-card {
  padding: 0;
  background: transparent;
  overflow: hidden;
}
.atlas-backdrop {
  display: block;
  width: 100%;
  filter: grayscale(1);
}
.atlas-building-guide {
  margin-top: 12px;
  padding: 16px;
  border: 1px solid var(--jy-color-atlas-outline);
  background: var(--surface);
}
.atlas-guide-header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 8px;
  font-size: 12px;
}
.atlas-guide-label {
  color: var(--accent);
  font-weight: 650;
}
.atlas-guide-status {
  color: var(--muted);
}
.atlas-guide-status.is-lit {
  color: var(--text);
}
.atlas-guide-name,
.atlas-stop-name {
  overflow-wrap: anywhere;
}
.atlas-guide-help {
  margin: 6px 0 0;
}
.atlas-guide-stop {
  margin-top: 12px;
}
.atlas-guide-stop + .atlas-guide-stop {
  padding-top: 12px;
  border-top: 1px solid var(--line);
}
.atlas-stop-name {
  margin-bottom: 8px;
  font-weight: 600;
}
.atlas-guide-actions {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(132px, 100%), 1fr));
  gap: 8px;
}
.atlas-guide-actions button {
  min-height: var(--jy-touch);
  margin: 0;
  padding: 8px;
  white-space: normal;
  line-height: 1.35;
}
.atlas-building-guide .atlas-guide-checkin {
  display: inline-flex;
  width: auto;
  align-items: center;
  margin: 6px 0 0;
  padding: 0 6px;
  min-height: var(--jy-touch);
  border: 0;
  background: transparent;
  box-shadow: none;
}
.building-list {
  margin-top: calc(var(--jy-rpx, 1rpx) * 24);
}
.building {
  display: flex;
  justify-content: space-between;
  gap: calc(var(--jy-rpx, 1rpx) * 16);
  padding: calc(var(--jy-rpx, 1rpx) * 18);
  color: var(--muted, #88928b);
  border-bottom: calc(var(--jy-rpx, 1rpx) * 1) solid var(--line, #e2e8df);
}
.lit {
  color: #9c762d;
}
.building-selected821 {
  background: var(--selected, #dfeaf4);
  box-shadow: inset 0 0 0 1px var(--jy-color-atlas-outline, #6198b8);
  border-radius: calc(var(--jy-rpx, 1rpx) * 16);
}
.atlas-legend821 {
  display: flex;
  align-items: center;
  gap: calc(var(--jy-rpx, 1rpx) * 8);
  margin: calc(var(--jy-rpx, 1rpx) * 14) 0;
  font-size: 12px;
  color: var(--muted, #657985);
}
.atlas-key821 {
  width: 10px;
  height: 10px;
  border-radius: 3px;
  background: #a4adaa;
  margin-left: calc(var(--jy-rpx, 1rpx) * 10);
}
.atlas-key-selected821 {
  background: var(--jy-color-atlas-fill, #bfd9ea);
  border: 1px solid var(--jy-color-atlas-outline, #6198b8);
}
.atlas-key-lit821 {
  background: #e4b23c;
}
.share-preview {
  display: block;
  width: 100%;
  margin-top: calc(var(--jy-rpx, 1rpx) * 24);
  border-radius: calc(var(--jy-rpx, 1rpx) * 24);
}
.offscreen {
  position: fixed;
  top: -2000px;
  left: -2000px;
  width: 375px;
  height: 500px;
}
.milestone820 {
  display: flex;
  gap: 12px;
  align-items: flex-start;
}
.milestone-badge820 {
  width: 56px;
  height: 56px;
  flex: none;
  filter: grayscale(1);
  opacity: 0.6;
}
.milestone-badge820.earned {
  filter: none;
  opacity: 1;
}
