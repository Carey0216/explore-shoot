<wxs src="/services/i18n.wxs" module="i18n"/>
<page-meta page-style="{{pageStyle}} {{deleteConfirm||nativeOverlayOpen||publicOverlayOpen?'overflow:hidden;':''}}"/>
<view class="native-surface {{locale==='en-US'?'locale-en':''}} {{themeClass}} {{locale==='en-US'?'locale-en':''}}" style="{{themeStyle}}">
<view wx:if="{{localeTranslated}}" class="locale-note"><text>{{i18n.ui('内容由机器翻译，原文始终保留。',locale)}}</text><button bindtap="localeToggleOriginal">{{i18n.ui(localeOriginal?'显示译文':'查看原文',locale)}}</button></view><view class="page">
  <view wx:if="{{!signedIn}}" class="card"><view class="title">{{i18n.ui('校园回忆册',locale)}}</view><view class="muted gap">{{i18n.ui('从自己主动选中的照片里，留住一段校园时光。',locale)}}</view><button class="primary gap" bindtap="login">{{i18n.ui('登录后开始',locale)}}</button></view>
  <block wx:elif="{{mode==='list'}}"><view class="memory-heading81"><view class="title">{{i18n.ui('校园回忆册',locale)}}</view><button class="small primary" bindtap="newAlbum">{{i18n.ui('新建回忆册',locale)}}</button></view><view class="muted">{{i18n.ui('只收进你主动选择的照片，默认仅自己可见。',locale)}}</view><view class="memory-albums81"><view class="card memory-cover81" wx:for="{{albums}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view class="memory-cover-photos81"><block wx:for="{{item.items}}" wx:for-item="photo" wx:key="mediaId"><remote-image wx:if="{{index<4&&photo.available}}" source="{{photo.photo}}" mode="aspectFill"/></block></view><view class="point-title gap">{{i18n.content(item.title,locale,localeTranslations,localeOriginal)}}</view><text class="muted">{{item.items.length}} {{i18n.ui('张照片 · 仅自己可见',locale)}}</text></view></view><view wx:if="{{!albums.length&&!loading}}" class="empty"><view class="point-title">{{i18n.ui('把一学期，装进一本回忆',locale)}}</view><view class="muted gap">{{i18n.ui('选择自己的照片与打卡，添上地点、日期和想留下的话。',locale)}}</view><button class="gap" bindtap="newAlbum">{{i18n.ui('开始挑选照片',locale)}}</button></view></block>
  <block wx:elif="{{mode==='edit'}}"><button class="memory-back81" bindtap="list">← {{i18n.ui('回忆册',locale)}}</button><view class="title gap">{{i18n.ui('把校园，收进回忆',locale)}}</view><view class="field"><text>{{i18n.ui('主题',locale)}}</text><picker range="{{i18n.options(themes,locale)}}" value="{{themeIndex}}" bindchange="theme"><view class="picker">{{i18n.ui(themes[themeIndex],locale)}} ⌄</view></picker></view><view class="field"><text>{{i18n.ui('影集名称',locale)}}</text><input data-field="title" value="{{form.title}}" maxlength="80" bindinput="field"/></view><view class="field"><text>{{i18n.ui('扉页留言',locale)}}</text><textarea data-field="message" value="{{form.message}}" maxlength="500" bindinput="field" auto-height placeholder="{{i18n.ui('想对这段时光说些什么？',locale)}}"/></view><view class="section-title73">{{i18n.ui('主动选中，才会加入',locale)}}<text class="muted">{{i18n.content(selectedCount,locale,localeTranslations,localeOriginal)}} / 24</text></view><view class="muted gap">{{i18n.ui('不会自动选中照片，也不会带入打卡里的私人感受和定位。',locale)}}</view><view class="memory-choices81"><button class="memory-choice81 {{item.selected?'chosen':''}}" wx:for="{{candidates}}" wx:key="mediaId" data-id="{{item.mediaId}}" bindtap="choose" aria-label="{{i18n.ui(item.selected?'取消选择这张照片':'选择这张照片',locale)}}"><remote-image source="{{item.photo}}" mode="aspectFill"/><text class="choice-mark81">{{i18n.content(item.selected?'✓':'+',locale,localeTranslations,localeOriginal)}}</text><text class="choice-place81">{{i18n.content(item.place,locale,localeTranslations,localeOriginal)}}</text></button></view><button wx:if="{{more}}" bindtap="morePhotos" loading="{{loading}}">{{i18n.ui('更多本人照片',locale)}}</button><view class="point-title gap">{{i18n.ui('排列照片，写下留言',locale)}}</view><view class="memory-selected-row81" wx:for="{{selectedRows}}" wx:key="mediaId"><remote-image source="{{item.photo}}" mode="aspectFill"/><view class="memory-caption81"><text>{{index+1}}. {{i18n.content(item.place,locale,localeTranslations,localeOriginal)}}</text><textarea value="{{item.caption}}" data-id="{{item.mediaId}}" bindinput="caption" maxlength="140" auto-height placeholder="{{i18n.ui('写一句想留下的话，可留空',locale)}}"/></view><button class="tiny" data-id="{{item.mediaId}}" disabled="{{!index}}" bindtap="move" aria-label="{{i18n.ui('将这张照片前移',locale)}}">↑</button><button class="tiny" data-id="{{item.mediaId}}" bindtap="remove" aria-label="{{i18n.ui('从回忆册移除照片',locale)}}">×</button></view><button class="primary gap" bindtap="save" loading="{{busy}}" disabled="{{busy||!selectedCount}}">{{i18n.ui('保存回忆册',locale)}}</button></block>
  <block wx:else><button class="memory-back81" bindtap="list">← {{i18n.ui('回忆册',locale)}}</button><view class="title gap">{{i18n.content(album.title,locale,localeTranslations,localeOriginal)}}</view><text class="copy gap">{{i18n.content(album.message,locale,localeTranslations,localeOriginal)}}</text><view class="button-row gap"><button size="mini" bindtap="edit">{{i18n.ui('编辑',locale)}}</button><button size="mini" bindtap="askDelete">{{i18n.ui('删除回忆册',locale)}}</button></view><view class="memory-gallery81"><view class="memory-photo81" data-photo="{{item.photo}}" bindtap="photoPreview" wx:for="{{album.items}}" wx:key="mediaId"><remote-image id="memory-photo-{{index}}" wx:if="{{item.available}}" source="{{item.photo}}" mode="aspectFit"/><view wx:else class="muted">{{i18n.ui('照片已不可用',locale)}}</view><view class="point-title gap">{{i18n.content(item.place,locale,localeTranslations,localeOriginal)}}</view><text class="memory-date81">{{i18n.content(item.dateLabel,locale,localeTranslations,localeOriginal)}}</text><text class="copy">{{i18n.content(item.caption,locale,localeTranslations,localeOriginal)}}</text></view></view><view class="card gap"><view class="point-title">{{i18n.ui('留在相册，也留在手边',locale)}}</view><view class="muted gap">{{i18n.ui('导出只包含这本回忆册里主动选中的照片、地点、日期和留言。',locale)}}</view><view class="button-row gap"><button class="primary" data-format="image" bindtap="export" disabled="{{busy}}">{{i18n.ui('导出长图',locale)}}</button><button data-format="pdf" bindtap="export" disabled="{{busy}}">{{i18n.ui('导出 PDF',locale)}}</button></view><view class="muted gap" role="status">{{i18n.content(exportProgress,locale,localeTranslations,localeOriginal)}}</view></view></block>
  <state-view error="{{error}}" loading="{{loading}}" bind:retry="load"/>
  <canvas type="2d" id="memory-export-canvas" class="memory-export-canvas81"/>
</view><view wx:if="{{deleteConfirm}}" class="popover-backdrop" bindtap="closeDelete"><view class="dislike-popover" catchtap="noop"><view class="point-title">{{i18n.ui('删除这本回忆册？',locale)}}</view><view class="muted gap">{{i18n.ui('只移除回忆册的编排，原始照片与打卡记录会保留。',locale)}}</view><button class="danger gap" bindtap="deleteAlbum" loading="{{busy}}">{{i18n.ui('删除回忆册',locale)}}</button></view></view></view>

<site-overlay id="site-overlay" content="{{siteContent}}" runtime="{{runtime}}" announcement="{{announcement}}" page="memories" bind:dismiss="dismissPublicOverlay" bind:overlay="publicOverlay"/>
<experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
