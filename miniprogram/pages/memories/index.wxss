.memory-heading81 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: calc(var(--jy-rpx, 1rpx) * 20);
  margin: calc(var(--jy-rpx, 1rpx) * 10) 0 calc(var(--jy-rpx, 1rpx) * 24);
}
.memory-albums81 {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: calc(var(--jy-rpx, 1rpx) * 20);
  margin-top: calc(var(--jy-rpx, 1rpx) * 30);
}
.memory-cover81 {
  min-width: 0;
  margin: 0;
  padding: calc(var(--jy-rpx, 1rpx) * 20);
}
.memory-cover-photos81 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: calc(var(--jy-rpx, 1rpx) * 90) calc(var(--jy-rpx, 1rpx) * 90);
  gap: calc(var(--jy-rpx, 1rpx) * 6);
  overflow: hidden;
  border-radius: calc(var(--jy-rpx, 1rpx) * 18);
  background: var(--surface-soft, #edf2ef);
}
.memory-cover-photos81 remote-image {
  width: 100%;
  height: calc(var(--jy-rpx, 1rpx) * 90);
}
.memory-choices81 {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: calc(var(--jy-rpx, 1rpx) * 14);
  margin: calc(var(--jy-rpx, 1rpx) * 28) 0;
}
.memory-choice81 {
  position: relative;
  width: 100%;
  margin: 0;
  padding: calc(var(--jy-rpx, 1rpx) * 8);
  min-width: 0;
  line-height: 1.4;
  border-radius: calc(var(--jy-rpx, 1rpx) * 20);
  border: calc(var(--jy-rpx, 1rpx) * 3) solid var(--line, #d5e0db);
  background: var(--surface, #fff);
}
.memory-choice81.chosen {
  border-color: var(--primary, #34705b);
}
.memory-choice81 remote-image {
  display: block;
  height: calc(var(--jy-rpx, 1rpx) * 170);
  width: 100%;
  border-radius: calc(var(--jy-rpx, 1rpx) * 14);
  overflow: hidden;
}
.choice-mark81 {
  position: absolute;
  top: calc(var(--jy-rpx, 1rpx) * 16);
  right: calc(var(--jy-rpx, 1rpx) * 16);
  width: calc(var(--jy-rpx, 1rpx) * 35);
  height: calc(var(--jy-rpx, 1rpx) * 35);
  border-radius: 50%;
  background: var(--surface, #fff);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text, #273d35);
  font-size: calc(var(--jy-rpx, 1rpx) * 24);
}
.chosen .choice-mark81 {
  background: var(--primary, #34705b);
  color: #fff;
}
.choice-place81 {
  display: block;
  font-size: calc(var(--jy-rpx, 1rpx) * 21);
  padding: calc(var(--jy-rpx, 1rpx) * 12) calc(var(--jy-rpx, 1rpx) * 3);
  text-align: left;
}
.memory-selected-row81 {
  display: flex;
  align-items: center;
  gap: calc(var(--jy-rpx, 1rpx) * 16);
  padding: calc(var(--jy-rpx, 1rpx) * 24) 0;
  border-bottom: calc(var(--jy-rpx, 1rpx) * 1) solid var(--line, #d5e0db);
}
.memory-selected-row81 > remote-image {
  width: calc(var(--jy-rpx, 1rpx) * 86);
  height: calc(var(--jy-rpx, 1rpx) * 86);
  flex: none;
  overflow: hidden;
  border-radius: calc(var(--jy-rpx, 1rpx) * 16);
}
.memory-caption81 {
  flex: 1;
  min-width: 0;
  font-size: calc(var(--jy-rpx, 1rpx) * 23);
}
.memory-caption81 textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: calc(var(--jy-rpx, 1rpx) * 80);
  margin-top: calc(var(--jy-rpx, 1rpx) * 12);
  padding: calc(var(--jy-rpx, 1rpx) * 12);
  font-size: calc(var(--jy-rpx, 1rpx) * 23);
}
.memory-selected-row81 .tiny {
  width: calc(var(--jy-rpx, 1rpx) * 42);
  min-width: calc(var(--jy-rpx, 1rpx) * 42);
  height: calc(var(--jy-rpx, 1rpx) * 54);
  min-height: calc(var(--jy-rpx, 1rpx) * 54);
  padding: 0;
  margin: 0;
  line-height: calc(var(--jy-rpx, 1rpx) * 54);
}
.memory-gallery81 {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: calc(var(--jy-rpx, 1rpx) * 24);
  margin: calc(var(--jy-rpx, 1rpx) * 32) 0;
  align-items: start;
}
.memory-photo81 {
  min-width: 0;
}
.memory-photo81 remote-image {
  display: block;
  width: 100%;
  height: calc(var(--jy-rpx, 1rpx) * 250);
  overflow: hidden;
  border-radius: calc(var(--jy-rpx, 1rpx) * 22);
  background: var(--surface-soft, #edf2ef);
}
.memory-photo81 .point-title {
  font-size: calc(var(--jy-rpx, 1rpx) * 25);
}
.memory-date81 {
  display: block;
  overflow-wrap: anywhere;
  font-size: calc(var(--jy-rpx, 1rpx) * 18);
  color: var(--muted, #64766e);
  margin: calc(var(--jy-rpx, 1rpx) * 10) 0;
}
.memory-photo81 .copy {
  font-size: calc(var(--jy-rpx, 1rpx) * 23);
}
.memory-export-canvas81 {
  position: fixed;
  left: -10000px;
  top: 0;
  width: 640px;
  height: 1px;
  pointer-events: none;
}

.memory-back81 {
  display: inline-flex;
  align-items: center;
  justify-content: flex-start;
  width: auto;
  min-width: 0;
  min-height: calc(var(--jy-rpx, 1rpx) * 64);
  padding: calc(var(--jy-rpx, 1rpx) * 8) 0;
  margin: 0;
  font-size: calc(var(--jy-rpx, 1rpx) * 26);
  line-height: 1.4;
  white-space: nowrap;
  background: transparent;
  box-shadow: none;
  border: 0;
  color: var(--accent, #326ba6);
}
.memory-back81::after {
  border: 0;
}
.memory-heading81 .small {
  width: auto;
  margin: 0;
  flex-shrink: 0;
}
