<wxs src="/services/i18n.wxs" module="i18n"/>
<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{locale==='en-US'?'locale-en':''}} {{themeClass}}" style="{{themeStyle}}">
<view wx:if="{{localeTranslated}}" class="locale-note"><text>{{i18n.ui(localeTranslationUnavailable?'内容翻译暂时不可用，当前显示原文。':'内容由机器翻译，原文始终保留。',locale)}}</text><button bindtap="localeToggleOriginal">{{i18n.ui(localeOriginal?'显示译文':'查看原文',locale)}}</button></view>
<view class="page"><view class="eyebrow">WHAT'S NEW</view><view class="title">{{i18n.ui('更新与功能引导',locale)}}</view><button class="gap" bindtap="tour">{{i18n.ui('重新认识各项功能',locale)}}</button><view class="card" wx:for="{{items}}" wx:key="version"><view class="muted">v{{i18n.content(item.version,locale,localeTranslations,localeOriginal)}} · {{i18n.content(item.publishedAt,locale,localeTranslations,localeOriginal)}}</view><view class="point-title gap">{{i18n.content(item.title,locale,localeTranslations,localeOriginal)}}</view><text class="copy" selectable>{{i18n.content(item.body,locale,localeTranslations,localeOriginal)}}</text><button wx:for="{{item.links}}" wx:for-item="link" wx:key="href" data-path="{{link.href}}" bindtap="open">{{i18n.content(link.label,locale,localeTranslations,localeOriginal)}} ↗</button></view><view wx:if="{{!items.length&&!loading}}" class="empty">{{i18n.ui('新版本说明将在管理员检查发布后显示。',locale)}}</view><state-view error="{{error}}" loading="{{loading}}" bind:retry="load"/></view>

<experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>
