<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{themeClass}}" style="{{themeStyle}}">
<view class="page"><view class="eyebrow">WHAT'S NEW</view><view class="title">更新与功能引导</view><button class="gap" bindtap="tour">重新认识各项功能</button><view class="card" wx:for="{{items}}" wx:key="version"><view class="muted">v{{item.version}} · {{item.publishedAt}}</view><view class="point-title gap">{{item.title}}</view><text class="copy" selectable>{{item.body}}</text><button wx:for="{{item.links}}" wx:for-item="link" wx:key="href" data-path="{{link.href}}" bindtap="open">{{link.label}} ↗</button></view><view wx:if="{{!items.length&&!loading}}" class="empty">新版本说明将在管理员检查发布后显示。</view><state-view error="{{error}}" loading="{{loading}}" bind:retry="load"/></view>

<experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>
