@import '../../styles/admin-controls.wxss';
.admin-page {
  padding-bottom: calc(var(--jy-rpx, 1rpx) * 64);
}
.admin-page input {
  box-sizing: border-box;
  width: 100%;
  min-height: calc(var(--jy-rpx, 1rpx) * 88);
  padding: calc(var(--jy-rpx, 1rpx) * 20);
  background: var(--raised);
  color: var(--text);
  border-radius: calc(var(--jy-rpx, 1rpx) * 18);
  margin: calc(var(--jy-rpx, 1rpx) * 16) 0;
}
.admin-page textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: calc(var(--jy-rpx, 1rpx) * 160);
  padding: calc(var(--jy-rpx, 1rpx) * 20);
  background: var(--raised);
  color: var(--text);
  border-radius: calc(var(--jy-rpx, 1rpx) * 18);
  margin: calc(var(--jy-rpx, 1rpx) * 16) 0;
}
.admin-page label {
  display: block;
  margin-top: calc(var(--jy-rpx, 1rpx) * 20);
}
.picker {
  padding: calc(var(--jy-rpx, 1rpx) * 24);
  border-radius: calc(var(--jy-rpx, 1rpx) * 16);
  background: var(--raised);
  color: var(--text);
  overflow-wrap: anywhere;
}
.message-copy {
  white-space: pre-wrap;
  word-break: break-word;
}
.compression-canvas {
  position: fixed;
  left: -10000px;
  top: 0;
  width: 1px;
  height: 1px;
}
.badge {
  background: #dceafa;
  color: #245782;
  border-radius: calc(var(--jy-rpx, 1rpx) * 20);
  padding: calc(var(--jy-rpx, 1rpx) * 8) calc(var(--jy-rpx, 1rpx) * 16);
}
.rich-fields {
  margin: calc(var(--jy-rpx, 1rpx) * 24) 0;
}

.admin-bell {
  width: calc(var(--jy-rpx, 1rpx) * 72);
  height: calc(var(--jy-rpx, 1rpx) * 72);
  border-radius: 50%;
  background: #f9fcff;
  border: calc(var(--jy-rpx, 1rpx) * 2) solid white;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.bell-mark {
  width: calc(var(--jy-rpx, 1rpx) * 27);
  height: calc(var(--jy-rpx, 1rpx) * 32);
  border: calc(var(--jy-rpx, 1rpx) * 3) solid #385c80;
  border-radius: calc(var(--jy-rpx, 1rpx) * 20) calc(var(--jy-rpx, 1rpx) * 20)
    calc(var(--jy-rpx, 1rpx) * 6) calc(var(--jy-rpx, 1rpx) * 6);
}
.admin-bell .badge {
  position: absolute;
  right: calc(var(--jy-rpx, 1rpx) * -8);
  top: calc(var(--jy-rpx, 1rpx) * -8);
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 18) * var(--font-scale, 1));
  color: white;
  background: #e96e87;
  padding: calc(var(--jy-rpx, 1rpx) * 2) calc(var(--jy-rpx, 1rpx) * 8);
}

.admin-page .jingyu-wordmark {
  width: calc(var(--jy-rpx, 1rpx) * 190);
  height: calc(var(--jy-rpx, 1rpx) * 95);
}
