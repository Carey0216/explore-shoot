<wxs src="/services/i18n.wxs" module="i18n"/>
<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || nativeOverlayOpen ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{locale==='en-US'?'locale-en':''}} {{themeClass}} {{nativeImpact812?'native-impact812':''}}" style="{{themeStyle}}">
<view wx:if="{{localeTranslated}}" class="locale-note"><text>{{i18n.ui(localeTranslationUnavailable?'内容翻译暂时不可用，当前显示原文。':'内容由机器翻译，原文始终保留。',locale)}}</text><button bindtap="localeToggleOriginal">{{i18n.ui(localeOriginal?'显示译文':'查看原文',locale)}}</button></view><view class="locale-auth-action"><language-picker class="language-picker-host" id="language-picker" administrator="{{true}}"/></view>
<view class="page admin-page"><button size="mini" wx:if="{{account}}" class="small" bindtap="console">{{i18n.ui('完整管理工作台 ↗',locale)}}</button><view class="row between"><image class="jingyu-wordmark" src="/assets/brand/jingyu-{{themeDark ? 'dark' : 'light'}}.png" mode="aspectFit" aria-label="{{i18n.ui('景遇校园',locale)}}"/><view class="title">{{i18n.ui('管理工作台',locale)}}</view><view wx:if="{{account}}" class="admin-bell" bindtap="showInbox" aria-role="button" aria-label="{{i18n.ui('管理消息与待办',locale)}}"><view class="bell-mark"/><text wx:if="{{unread}}" class="badge">{{i18n.content(unread>99?'99+':unread,locale,localeTranslations,localeOriginal)}}</text></view></view><view wx:if="{{!account}}" class="card"><view class="point-title">{{i18n.ui('管理员登录',locale)}}</view><text class="muted">{{i18n.ui('管理会话与用户账号分别保存。',locale)}}</text><input placeholder-class="field-placeholder" placeholder="{{i18n.ui('管理员账号',locale)}}" data-key="username" bindinput="field" value="{{username}}"/><input password placeholder-class="field-placeholder" placeholder="{{i18n.ui('密码',locale)}}" data-key="password" bindinput="field" value="{{password}}"/><button class="primary" bindtap="login" loading="{{loading}}">{{i18n.ui('登录管理端',locale)}}</button></view><block wx:else><view class="row wrap gap"><button size="mini" class="small" data-tab="inbox" bindtap="tab">{{i18n.ui('消息与待办',locale)}}</button><button size="mini" wx:if="{{canMessages}}" class="small" data-tab="messages" bindtap="tab">{{i18n.ui('用户联系',locale)}}</button><button size="mini" wx:if="{{canAnnouncements}}" class="small" data-tab="announcements" bindtap="tab">{{i18n.ui('公告',locale)}}</button><button size="mini" class="small" bindtap="logout">{{i18n.ui('退出',locale)}}</button></view><block wx:if="{{tab==='inbox'}}"><view class="row wrap gap"><button size="mini" class="small" data-id="all" bindtap="inboxCategory">{{i18n.ui('全部',locale)}}</button><button size="mini" class="small" data-id="review" bindtap="inboxCategory">{{i18n.ui('审核',locale)}}</button><button size="mini" class="small" data-id="message" bindtap="inboxCategory">{{i18n.ui('用户联系',locale)}}</button><button size="mini" class="small" bindtap="batchRead">{{i18n.ui('所选已读',locale)}}</button></view><checkbox-group bindchange="inboxSelect"><view class="card" wx:for="{{items}}" wx:key="id"><label><checkbox checked="{{inboxSelection[item.id]}}" value="{{item.id}}" disabled="{{!!item.readAt}}"/>{{i18n.ui('选择消息',locale)}}</label><view class="point-title">{{i18n.content(item.title,locale,localeTranslations,localeOriginal)}}</view><view class="gap message-copy">{{i18n.content(item.message,locale,localeTranslations,localeOriginal)}}</view><view class="muted gap">{{i18n.ui(item.readAt?'已读':'未读',locale)}}</view><button size="mini" class="small gap" data-id="{{item.id}}" bindtap="notice">{{i18n.ui(item.requestId?'回应留言':'打开详情',locale)}}</button></view></checkbox-group><button wx:if="{{inboxNext}}" class="gap" bindtap="inboxMore">{{i18n.ui('加载更多',locale)}}</button><view wx:if="{{!items.length&&!loading}}" class="empty">{{i18n.ui('暂时没有待办',locale)}}</view></block><block wx:if="{{tab==='messages'}}"><block wx:if="{{!conversation&&!editing}}"><view wx:if="{{canSend&&users.length}}" class="card"><picker range="{{i18n.options(users,locale)}}" range-key="label" value="{{selectedUser}}" data-key="selectedUser" bindchange="field"><view class="picker">{{i18n.content(users[selectedUser].label,locale,localeTranslations,localeOriginal)}} ⌄</view></picker><button class="primary gap" bindtap="newThread">{{i18n.ui('联系此用户',locale)}}</button></view><view wx:for="{{threads}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="openThread"><view class="point-title">{{i18n.content(item.userName,locale,localeTranslations,localeOriginal)}}</view><text class="muted">{{i18n.ui(item.open?'对话中':'已关闭',locale)}} · {{i18n.content(item.unread,locale,localeTranslations,localeOriginal)}} {{i18n.ui('条新回复',locale)}}</text></view></block><block wx:if="{{conversation}}"><view class="card"><view class="point-title">{{i18n.content(conversation.userName,locale,localeTranslations,localeOriginal)}}</view><button size="mini" class="small" bindtap="load">{{i18n.ui('刷新消息',locale)}}</button><button size="mini" wx:if="{{canSend}}" class="small" bindtap="status">{{i18n.ui(conversation.open?'关闭对话':'重新开放',locale)}}</button></view><view class="card message-bubble" wx:for="{{messages}}" wx:key="id"><view class="muted">{{i18n.ui(item.from==='admin'?'管理员':'用户',locale)}} · {{i18n.content(item.time,locale,localeTranslations,localeOriginal)}}</view><message-body value="{{item}}" administrator/></view><button size="mini" wx:if="{{next}}" class="small" bindtap="older">{{i18n.ui('查看更早记录',locale)}}</button></block><view wx:if="{{canSend&&(editing||conversation.open)}}" class="card"><textarea auto-height value="{{body}}" data-key="body" bindinput="field" maxlength="4000" placeholder-class="field-placeholder" placeholder="{{i18n.ui('写一条消息…',locale)}}"/><view class="rich-fields"><file-composer wx:if="{{tab==='messages'}}" id="message-files" conversation-id="{{conversation.id}}" user-id="{{userId}}" administrator="{{true}}" disabled="{{loading}}"/><button size="mini" class="small" bindtap="choose" disabled="{{loading}}">{{i18n.ui('添加配图',locale)}}</button><button size="mini" class="small" wx:if="{{imageId}}" bindtap="removeImage">{{i18n.ui('移除配图',locale)}}</button><text wx:if="{{imageId}}" class="muted">{{i18n.ui('配图已准备好',locale)}}</text><input value="{{linkLabel}}" data-key="linkLabel" bindinput="field" placeholder-class="field-placeholder" placeholder="{{i18n.ui('链接名称（选填）',locale)}}"/><input value="{{linkHref}}" data-key="linkHref" bindinput="field" placeholder-class="field-placeholder" placeholder="{{i18n.ui('#publish 或 HTTPS 地址',locale)}}"/></view><button class="primary" bindtap="send" loading="{{loading}}">{{i18n.ui(conversation?'发送消息':'建立连接并发送',locale)}}</button></view></block><block wx:if="{{tab==='announcements'}}"><button wx:if="{{account.role==='owner' && !editing}}" size="mini" class="gap" bindtap="releaseLogs">{{i18n.ui('版本日志 · 发布与撤回 ↗',locale)}}</button><button wx:if="{{canPublish&&!editing}}" id="new-admin-announcement" class="primary gap" bindtap="newAnnouncement">{{i18n.ui('新建公告',locale)}}</button><block wx:if="{{!editing}}"><view class="card" wx:for="{{announcements}}" wx:key="id"><view class="point-title">{{i18n.content(item.draft.title,locale,localeTranslations,localeOriginal)}}</view><view class="muted">{{i18n.ui(item.published?'已发布':'草稿',locale)}} {{i18n.ui('· 修订',locale)}} {{i18n.content(item.revision,locale,localeTranslations,localeOriginal)}}</view><button size="mini" wx:if="{{canPublish}}" class="small" data-id="{{item.id}}" bindtap="editAnnouncement">{{i18n.ui('编辑 / 投放',locale)}}</button><button size="mini" wx:if="{{canPublish}}" class="small danger" data-id="{{item.id}}" bindtap="deleteAnnouncement">{{i18n.ui('删除公告',locale)}}</button></view></block><view wx:if="{{editing}}" class="card"><input value="{{title}}" data-key="title" bindinput="field" maxlength="80" placeholder-class="field-placeholder" placeholder="{{i18n.ui('公告标题',locale)}}"/><textarea auto-height value="{{body}}" data-key="body" bindinput="field" maxlength="6000" placeholder-class="field-placeholder" placeholder="{{i18n.ui('公告内容',locale)}}"/><button size="mini" class="small" bindtap="choose" disabled="{{loading}}">{{i18n.ui('添加 / 更换配图',locale)}}</button><button size="mini" class="small" wx:if="{{imageId}}" bindtap="removeImage">{{i18n.ui('移除配图',locale)}}</button><input value="{{linkLabel}}" data-key="linkLabel" bindinput="field" placeholder-class="field-placeholder" placeholder="{{i18n.ui('链接名称',locale)}}"/><input value="{{linkHref}}" data-key="linkHref" bindinput="field" placeholder-class="field-placeholder" placeholder="{{i18n.ui('#topics 或 HTTPS 地址',locale)}}"/><view class="row between gap"><text>{{i18n.ui('开屏弹出',locale)}}</text><switch checked="{{popup}}" data-key="popup" bindchange="toggle"/></view><view class="row between gap"><text>{{i18n.ui('送达消息中心',locale)}}</text><switch checked="{{inbox}}" data-key="inbox" bindchange="toggle"/></view><picker range="{{i18n.options(['全部用户','已登录用户','校园探索官','普通用户','访客','指定用户'],locale)}}" value="{{audience}}" data-key="audience" bindchange="field"><view class="picker">{{i18n.ui('投放对象：',locale)}}{{i18n.ui(['全部用户','已登录用户','校园探索官','普通用户','访客','指定用户'][audience],locale)}} ⌄</view></picker><textarea wx:if="{{audience==5}}" value="{{selectedIds}}" data-key="selectedIds" bindinput="field" placeholder-class="field-placeholder" placeholder="{{i18n.ui('指定用户 ID，以换行或逗号分隔',locale)}}"/><picker range="{{i18n.options(['公告','活动','更新日志','系统'],locale)}}" value="{{categoryIndex}}" data-key="categoryIndex" bindchange="field"><view class="picker">{{i18n.ui('消息标签：',locale)}}{{i18n.ui(['公告','活动','更新日志','系统'][categoryIndex],locale)}} ⌄</view></picker><text class="muted">{{i18n.ui('时间使用 ISO 格式，如 2026-10-19T08:00:00+08:00；留空不限。',locale)}}</text><input value="{{startsAt}}" data-key="startsAt" bindinput="field" placeholder-class="field-placeholder" placeholder="{{i18n.ui('开始时间',locale)}}"/><input value="{{endsAt}}" data-key="endsAt" bindinput="field" placeholder-class="field-placeholder" placeholder="{{i18n.ui('结束时间',locale)}}"/><label>{{i18n.ui('每人总次数（0不限）',locale)}}<input type="number" value="{{maxTotal}}" data-key="maxTotal" bindinput="field"/></label><label>{{i18n.ui('每日次数（0不限）',locale)}}<input type="number" value="{{maxDaily}}" data-key="maxDaily" bindinput="field"/></label><label>{{i18n.ui('间隔分钟',locale)}}<input type="number" value="{{intervalMinutes}}" data-key="intervalMinutes" bindinput="field"/></label><label>{{i18n.ui('优先级',locale)}}<input type="number" value="{{priority}}" data-key="priority" bindinput="field"/></label><view class="row wrap gap"><button size="mini" class="small" bindtap="saveAnnouncement" data-action="draft" disabled="{{loading}}">{{i18n.ui('存草稿',locale)}}</button><button size="mini" class="small primary" bindtap="saveAnnouncement" data-action="publish" disabled="{{loading}}">{{i18n.ui('保存并发布',locale)}}</button><button size="mini" wx:if="{{id}}" class="small" bindtap="saveAnnouncement" data-action="unpublish" disabled="{{loading}}">{{i18n.ui('停止投放',locale)}}</button></view></view></block></block><state-view error="{{error}}" loading="{{loading}}" bind:retry="load"/></view><canvas id="admin-photo" type="2d" class="compression-canvas"/>

<experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{true}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>

<reward-overlay id="reward-overlay812" items="{{nativeRewardItems812}}" bind:dismiss="dismissNativeRewards812" bind:impact="nativeImpact812"/>
