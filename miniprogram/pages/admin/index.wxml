<view class="page admin-page"><view class="row between"><view class="title">管理工作台</view><view wx:if="{{account}}" class="admin-bell" bindtap="showInbox" aria-role="button" aria-label="管理消息与待办"><view class="bell-mark"/><text wx:if="{{unread}}" class="badge">{{unread>99?'99+':unread}}</text></view></view><view wx:if="{{!account}}" class="card"><view class="point-title">管理员登录</view><text class="muted">管理会话与用户账号分别保存。</text><input placeholder="管理员账号" data-key="username" bindinput="field" value="{{username}}"/><input password placeholder="密码" data-key="password" bindinput="field" value="{{password}}"/><button class="primary" bindtap="login" loading="{{loading}}">登录管理端</button></view><block wx:else><view class="row wrap gap"><button class="small" data-tab="inbox" bindtap="tab">消息与待办</button><button wx:if="{{canMessages}}" class="small" data-tab="messages" bindtap="tab">用户联系</button><button wx:if="{{canAnnouncements}}" class="small" data-tab="announcements" bindtap="tab">公告</button><button class="small" bindtap="logout">退出</button></view><block wx:if="{{tab==='inbox'}}"><view class="card" wx:for="{{items}}" wx:key="id"><view class="point-title">{{item.title}}</view><view class="gap message-copy">{{item.message}}</view><view class="muted gap">{{item.readAt?'已读':'未读'}}</view><button class="small gap" data-id="{{item.id}}" bindtap="notice">{{item.requestId?'回应留言':'打开详情'}}</button></view><view wx:if="{{!items.length&&!loading}}" class="empty">暂时没有待办</view></block><block wx:if="{{tab==='messages'}}"><block wx:if="{{!conversation&&!editing}}"><view wx:if="{{canSend&&users.length}}" class="card"><picker range="{{users}}" range-key="label" value="{{selectedUser}}" data-key="selectedUser" bindchange="field"><view class="picker">{{users[selectedUser].label}} ⌄</view></picker><button class="primary gap" bindtap="newThread">联系此用户</button></view><view wx:for="{{threads}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="openThread"><view class="point-title">{{item.userName}}</view><text class="muted">{{item.open?'对话中':'已关闭'}} · {{item.unread}} 条新回复</text></view></block><block wx:if="{{conversation}}"><view class="card"><view class="point-title">{{conversation.userName}}</view><button class="small" bindtap="load">刷新消息</button><button wx:if="{{canSend}}" class="small" bindtap="status">{{conversation.open?'关闭对话':'重新开放'}}</button></view><view class="card message-bubble" wx:for="{{messages}}" wx:key="id"><view class="muted">{{item.from==='admin'?'管理员':'用户'}} · {{item.time}}</view><message-body value="{{item}}" administrator/></view><button wx:if="{{next}}" class="small" bindtap="older">查看更早记录</button></block><view wx:if="{{canSend&&(editing||conversation.open)}}" class="card"><textarea auto-height value="{{body}}" data-key="body" bindinput="field" maxlength="4000" placeholder="写一条消息…"/><view class="rich-fields"><button class="small" bindtap="choose" disabled="{{loading}}">添加配图</button><button class="small" wx:if="{{imageId}}" bindtap="removeImage">移除配图</button><text wx:if="{{imageId}}" class="muted">配图已准备好</text><input value="{{linkLabel}}" data-key="linkLabel" bindinput="field" placeholder="链接名称（选填）"/><input value="{{linkHref}}" data-key="linkHref" bindinput="field" placeholder="#publish 或 HTTPS 地址"/></view><button class="primary" bindtap="send" loading="{{loading}}">{{conversation?'发送消息':'建立连接并发送'}}</button></view></block><block wx:if="{{tab==='announcements'}}"><button wx:if="{{canPublish&&!editing}}" id="new-admin-announcement" class="primary gap" bindtap="newAnnouncement">新建公告</button><block wx:if="{{!editing}}"><view class="card" wx:for="{{announcements}}" wx:key="id"><view class="point-title">{{item.draft.title}}</view><view class="muted">{{item.published?'已发布':'草稿'}} · 修订 {{item.revision}}</view><button wx:if="{{canPublish}}" class="small" data-id="{{item.id}}" bindtap="editAnnouncement">编辑 / 投放</button><button wx:if="{{canPublish}}" class="small danger" data-id="{{item.id}}" bindtap="deleteAnnouncement">删除公告</button></view></block><view wx:if="{{editing}}" class="card"><input value="{{title}}" data-key="title" bindinput="field" maxlength="80" placeholder="公告标题"/><textarea auto-height value="{{body}}" data-key="body" bindinput="field" maxlength="6000" placeholder="公告内容"/><button class="small" bindtap="choose" disabled="{{loading}}">添加 / 更换配图</button><button class="small" wx:if="{{imageId}}" bindtap="removeImage">移除配图</button><input value="{{linkLabel}}" data-key="linkLabel" bindinput="field" placeholder="链接名称"/><input value="{{linkHref}}" data-key="linkHref" bindinput="field" placeholder="#topics 或 HTTPS 地址"/><view class="row between gap"><text>开屏弹出</text><switch checked="{{popup}}" data-key="popup" bindchange="toggle"/></view><view class="row between gap"><text>送达消息中心</text><switch checked="{{inbox}}" data-key="inbox" bindchange="toggle"/></view><picker range="{{['全部用户','已登录用户','校园探索官','普通用户','访客','指定用户']}}" value="{{audience}}" data-key="audience" bindchange="field"><view class="picker">投放对象：{{['全部用户','已登录用户','校园探索官','普通用户','访客','指定用户'][audience]}} ⌄</view></picker><textarea wx:if="{{audience==5}}" value="{{selectedIds}}" data-key="selectedIds" bindinput="field" placeholder="指定用户 ID，以换行或逗号分隔"/><text class="muted">时间使用 ISO 格式，如 2026-10-19T08:00:00+08:00；留空不限。</text><input value="{{startsAt}}" data-key="startsAt" bindinput="field" placeholder="开始时间"/><input value="{{endsAt}}" data-key="endsAt" bindinput="field" placeholder="结束时间"/><label>每人总次数（0不限）<input type="number" value="{{maxTotal}}" data-key="maxTotal" bindinput="field"/></label><label>每日次数（0不限）<input type="number" value="{{maxDaily}}" data-key="maxDaily" bindinput="field"/></label><label>间隔分钟<input type="number" value="{{intervalMinutes}}" data-key="intervalMinutes" bindinput="field"/></label><label>优先级<input type="number" value="{{priority}}" data-key="priority" bindinput="field"/></label><view class="row wrap gap"><button class="small" bindtap="saveAnnouncement" data-action="draft" disabled="{{loading}}">存草稿</button><button class="small primary" bindtap="saveAnnouncement" data-action="publish" disabled="{{loading}}">保存并发布</button><button wx:if="{{id}}" class="small" bindtap="saveAnnouncement" data-action="unpublish" disabled="{{loading}}">停止投放</button></view></view></block></block><state-view error="{{error}}" loading="{{loading}}" bind:retry="load"/></view><canvas id="admin-photo" type="2d" class="compression-canvas"/>
