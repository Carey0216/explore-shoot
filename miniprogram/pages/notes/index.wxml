<wxs src="/services/i18n.wxs" module="i18n"/>
<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{locale==='en-US'?'locale-en':''}} {{themeClass}} {{nativeImpact812?'native-impact812':''}}" style="{{themeStyle}}">
<view wx:if="{{localeTranslated}}" class="locale-note"><text>{{i18n.ui(localeTranslationUnavailable?'内容翻译暂时不可用，当前显示原文。':'内容由机器翻译，原文始终保留。',locale)}}</text><button bindtap="localeToggleOriginal">{{i18n.ui(localeOriginal?'显示译文':'查看原文',locale)}}</button></view>
<view class="page"><view class="title">{{i18n.ui(record?record.routeName:'探索手记',locale)}}</view><text class="muted gap">{{i18n.ui('仅自己可见，保留真实体验和当时的小发现。',locale)}}</text><block wx:if="{{!record}}"><view class="row gap"><input value="{{query}}" data-key="query" bindinput="field" placeholder-class="field-placeholder" placeholder="{{i18n.ui('搜索私人手记',locale)}}"/><button bindtap="load">{{i18n.ui('搜索',locale)}}</button></view><view class="card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view class="point-title">{{i18n.content(item.routeName,locale,localeTranslations,localeOriginal)}}</view><text class="muted">{{i18n.content(item.createdAt,locale,localeTranslations,localeOriginal)}} {{i18n.ui('· 完成',locale)}}{{i18n.content(item.completedTasks,locale,localeTranslations,localeOriginal)}}{{i18n.ui('项 ·',locale)}} {{i18n.content(item.photoCount,locale,localeTranslations,localeOriginal)}}{{i18n.ui('张照片',locale)}}</text><text class="link">{{i18n.ui('查看手记 ↗',locale)}}</text></view><button wx:if="{{hasMore}}" bindtap="more">{{i18n.ui('加载更多',locale)}}</button></block><block wx:else><view class="card" wx:for="{{record.tasks}}" wx:key="id"><view class="point-title">{{i18n.content(item.pointName,locale,localeTranslations,localeOriginal)}} · {{i18n.content(item.title,locale,localeTranslations,localeOriginal)}}</view><text class="muted">{{i18n.ui(item.status==='done'?'已完成':item.status==='skipped'?'已跳过':'尚未完成',locale)}}</text><text wx:for="{{item.steps}}" wx:for-item="step" wx:key="index" class="copy">{{i18n.content(step,locale,localeTranslations,localeOriginal)}}</text><view wx:if="{{item.photo}}" data-path="{{item.photo}}" bindtap="preview"><remote-image source="{{item.photo}}"/></view></view><view class="card"><view class="point-title">{{i18n.ui('留下我的感受',locale)}}</view><textarea data-key="feedback" bindinput="field" value="{{feedback}}" maxlength="4000" placeholder-class="field-placeholder" placeholder="{{i18n.ui('今天看到了什么？',locale)}}"/><picker range="{{i18n.options(['未评分','1星','2星','3星','4星','5星'],locale)}}" value="{{rating}}" data-key="rating" bindchange="field"><view class="picker">{{i18n.ui('体验评分：',locale)}}{{i18n.content(rating,locale,localeTranslations,localeOriginal)}} / 5 ⌄</view></picker><button bindtap="save" class="primary gap">{{i18n.ui('保存感受',locale)}}</button><button bindtap="exportNote" class="gap">{{i18n.ui('导出手记',locale)}}</button><button bindtap="remove" class="danger gap">{{i18n.ui('删除手记',locale)}}</button></view></block><state-view error="{{error}}" loading="{{loading}}" bind:retry="load"/></view>

<experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>

<reward-overlay id="reward-overlay812" items="{{nativeRewardItems812}}" bind:dismiss="dismissNativeRewards812" bind:impact="nativeImpact812"/>
