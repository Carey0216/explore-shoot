<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{themeClass}}" style="{{themeStyle}}">
<view class="page"><view class="title">{{record?record.routeName:'探索手记'}}</view><text class="muted gap">仅自己可见，保留真实体验和当时的小发现。</text><block wx:if="{{!record}}"><view class="row gap"><input value="{{query}}" data-key="query" bindinput="field" placeholder-class="field-placeholder" placeholder="搜索私人手记"/><button bindtap="load">搜索</button></view><view class="card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view class="point-title">{{item.routeName}}</view><text class="muted">{{item.createdAt}} · 完成{{item.completedTasks}}项 · {{item.photoCount}}张照片</text><text class="link">查看手记 ↗</text></view><button wx:if="{{hasMore}}" bindtap="more">加载更多</button></block><block wx:else><view class="card" wx:for="{{record.tasks}}" wx:key="id"><view class="point-title">{{item.pointName}} · {{item.title}}</view><text class="muted">{{item.status==='done'?'已完成':item.status==='skipped'?'已跳过':'尚未完成'}}</text><text wx:for="{{item.steps}}" wx:for-item="step" wx:key="index" class="copy">{{step}}</text><view wx:if="{{item.photo}}" data-path="{{item.photo}}" bindtap="preview"><remote-image source="{{item.photo}}"/></view></view><view class="card"><view class="point-title">留下我的感受</view><textarea data-key="feedback" bindinput="field" value="{{feedback}}" maxlength="4000" placeholder-class="field-placeholder" placeholder="今天看到了什么？"/><picker range="{{['未评分','1星','2星','3星','4星','5星']}}" value="{{rating}}" data-key="rating" bindchange="field"><view class="picker">体验评分：{{rating}} / 5 ⌄</view></picker><button bindtap="save" class="primary gap">保存感受</button><button bindtap="exportNote" class="gap">导出手记</button><button bindtap="remove" class="danger gap">删除手记</button></view></block><state-view error="{{error}}" loading="{{loading}}" bind:retry="load"/></view>

<experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>
