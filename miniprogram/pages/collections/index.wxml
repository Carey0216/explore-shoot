<wxs src="/services/i18n.wxs" module="i18n"/>
<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{locale==='en-US'?'locale-en':''}} {{themeClass}} {{nativeImpact812?'native-impact812':''}}" style="{{themeStyle}}">
<view wx:if="{{localeTranslated}}" class="locale-note"><text>{{i18n.ui(localeTranslationUnavailable?'内容翻译暂时不可用，当前显示原文。':'内容由机器翻译，原文始终保留。',locale)}}</text><button bindtap="localeToggleOriginal">{{i18n.ui(localeOriginal?'显示译文':'查看原文',locale)}}</button></view>
<view wx:if="{{featureBlocked}}" class="page"><view class="empty" role="status">{{i18n.ui('功能正在维护中，敬请期待…',locale)}}</view></view><block wx:else>
<view class="page"><view class="title">{{i18n.ui('收藏分组',locale)}}</view><view class="muted gap">{{i18n.ui('仅自己可见。进入收藏地点，选择真实机位后可加入拍摄清单。',locale)}}</view><state-view error="{{error}}" bind:retry="load"/>
<block wx:if="{{editing}}"><view class="card"><input class="input" value="{{title}}" maxlength="80" bindinput="title" placeholder-class="field-placeholder" placeholder="{{i18n.ui('分组名称',locale)}}"/><checkbox-group bindchange="select"><label wx:for="{{points}}" wx:key="id" class="row gap"><checkbox value="{{item.id}}" checked="{{item.checked}}"/>{{i18n.content(item.name,locale,localeTranslations,localeOriginal)}}</label></checkbox-group><view wx:if="{{!points.length}}" class="muted gap">{{i18n.ui('先在地点旁点爱心收藏。',locale)}}</view><view class="row wrap gap"><button class="primary" bindtap="save" disabled="{{busy}}">{{i18n.ui('保存',locale)}}</button><button bindtap="cancel">{{i18n.ui('取消',locale)}}</button><button size="mini" class="small danger" bindtap="remove">{{i18n.ui('删除分组',locale)}}</button></view></view></block>
<block wx:else><button class="primary gap" bindtap="edit">{{i18n.ui('新建分组',locale)}}</button><view wx:for="{{items}}" wx:key="id" class="card"><view class="point-title">{{i18n.content(item.title,locale,localeTranslations,localeOriginal)}}</view><view class="muted gap">{{i18n.ui(item.names || '暂无收藏地点',locale)}}</view><view class="row gap"><button size="mini" class="small" data-id="{{item.id}}" bindtap="edit">{{i18n.ui('编辑',locale)}}</button><button size="mini" wx:for="{{item.points}}" wx:for-item="point" wx:key="id" class="small" data-id="{{point.id}}" bindtap="open">{{i18n.content(point.name,locale,localeTranslations,localeOriginal)}} ↗</button></view></view></block></view>

</block>
<experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>

<reward-overlay id="reward-overlay812" items="{{nativeRewardItems812}}" bind:dismiss="dismissNativeRewards812" bind:impact="nativeImpact812"/>
