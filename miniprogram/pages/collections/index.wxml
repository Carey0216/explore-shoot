<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{themeClass}}" style="{{themeStyle}}">
<view wx:if="{{featureBlocked}}" class="page"><view class="empty" role="status">功能正在维护中，敬请期待…</view></view><block wx:else>
<view class="page"><view class="title">收藏分组</view><view class="muted gap">仅自己可见。进入收藏地点，选择真实机位后可加入拍摄清单。</view><state-view error="{{error}}" bind:retry="load"/>
<block wx:if="{{editing}}"><view class="card"><input class="input" value="{{title}}" maxlength="80" bindinput="title" placeholder-class="field-placeholder" placeholder="分组名称"/><checkbox-group bindchange="select"><label wx:for="{{points}}" wx:key="id" class="row gap"><checkbox value="{{item.id}}" checked="{{item.checked}}"/>{{item.name}}</label></checkbox-group><view wx:if="{{!points.length}}" class="muted gap">先在地点旁点爱心收藏。</view><view class="row wrap gap"><button class="primary" bindtap="save" disabled="{{busy}}">保存</button><button bindtap="cancel">取消</button><button size="mini" class="small danger" bindtap="remove">删除分组</button></view></view></block>
<block wx:else><button class="primary gap" bindtap="edit">新建分组</button><view wx:for="{{items}}" wx:key="id" class="card"><view class="point-title">{{item.title}}</view><view class="muted gap">{{item.names || '暂无收藏地点'}}</view><view class="row gap"><button size="mini" class="small" data-id="{{item.id}}" bindtap="edit">编辑</button><button size="mini" wx:for="{{item.points}}" wx:for-item="point" wx:key="id" class="small" data-id="{{point.id}}" bindtap="open">{{point.name}} ↗</button></view></view></block></view>

</block>
<experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>
