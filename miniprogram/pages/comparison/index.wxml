<wxs src="/services/i18n.wxs" module="i18n"/>
<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{locale==='en-US'?'locale-en':''}} {{themeClass}}" style="{{themeStyle}}">
<view wx:if="{{localeTranslated}}" class="locale-note"><text>{{i18n.ui(localeTranslationUnavailable?'内容翻译暂时不可用，当前显示原文。':'内容由机器翻译，原文始终保留。',locale)}}</text><button bindtap="localeToggleOriginal">{{i18n.ui(localeOriginal?'显示译文':'查看原文',locale)}}</button></view>
<view wx:if="{{featureBlocked}}" class="page"><view class="empty" role="status">{{i18n.ui('功能正在维护中，敬请期待…',locale)}}</view></view><block wx:else>
<view class="page"><view class="title">{{i18n.ui('同一机位，不同光景',locale)}}</view><text class="muted">{{i18n.ui('仅展示主动公开并审核通过的作品。时间由作者填写，未填写的单独分类。',locale)}}</text><scroll-view scroll-x class="scroll-chips"><button wx:for="{{seasons}}" wx:key="id" class="pill {{season===item.id?'active':''}}" data-kind="season" data-id="{{item.id}}" bindtap="filter">{{i18n.content(item.name,locale,localeTranslations,localeOriginal)}}</button></scroll-view><scroll-view scroll-x class="scroll-chips"><button wx:for="{{bands}}" wx:key="id" class="pill {{time===item.id?'active':''}}" data-kind="time" data-id="{{item.id}}" bindtap="filter">{{i18n.content(item.name,locale,localeTranslations,localeOriginal)}}</button></scroll-view><view class="card point-card" wx:for="{{items}}" wx:key="id"><view data-path="{{item.photo}}" bindtap="preview"><remote-image source="{{item.photo}}"/></view><view class="point-copy"><text>{{i18n.content(item.caption,locale,localeTranslations,localeOriginal)}}</text><view class="muted gap">{{item.authorName}} · {{i18n.ui(item.experience.takenAt||'时间未填写',locale)}}</view><text class="copy">{{i18n.content(item.experience.tips,locale,localeTranslations,localeOriginal)}}</text></view></view><button wx:if="{{hasMore}}" class="gap" bindtap="more">{{i18n.ui('加载更多',locale)}}</button><state-view empty="{{!items.length}}" error="{{error}}" loading="{{loading}}" bind:retry="load"/></view>

</block>
<experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>
