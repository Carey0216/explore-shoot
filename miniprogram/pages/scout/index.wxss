.quiz-progress {
  display: flex;
  justify-content: space-between;
  margin: calc(var(--jy-rpx, 1rpx) * 40) 0 calc(var(--jy-rpx, 1rpx) * 20);
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 24) * var(--font-scale, 1));
  color: var(--muted);
}
.question-card {
  padding-top: calc(var(--jy-rpx, 1rpx) * 42);
}
.question-title {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 40) * var(--font-scale, 1));
  font-weight: 700;
  line-height: 1.6;
  margin-bottom: calc(var(--jy-rpx, 1rpx) * 20);
}
.quiz-choice {
  display: flex;
  position: relative;
  align-items: center;
  gap: calc(var(--jy-rpx, 1rpx) * 24);
  min-height: calc(var(--jy-rpx, 1rpx) * 110);
  padding: calc(var(--jy-rpx, 1rpx) * 24) calc(var(--jy-rpx, 1rpx) * 28);
  margin-top: calc(var(--jy-rpx, 1rpx) * 24);
  border: calc(var(--jy-rpx, 1rpx) * 2) solid var(--line);
  border-radius: calc(var(--jy-rpx, 1rpx) * 30);
  background: var(--raised);
}
.quiz-choice.selected {
  border-color: var(--accent);
  background: var(--selected);
}
.native-radio {
  position: absolute;
  opacity: 0;
  width: 1px;
  height: 1px;
  min-height: 0;
  min-width: 0;
  padding: 0;
  margin: 0;
}
.option-letter {
  flex: 0 0 calc(var(--jy-rpx, 1rpx) * 52);
  width: calc(var(--jy-rpx, 1rpx) * 52);
  height: calc(var(--jy-rpx, 1rpx) * 52);
  line-height: calc(var(--jy-rpx, 1rpx) * 52);
  text-align: center;
  border-radius: 50%;
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 23) * var(--font-scale, 1));
  color: var(--accent);
  background: var(--surface);
}
.option-text {
  flex: 1;
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 29) * var(--font-scale, 1));
  line-height: 1.65;
}
.quiz-footer {
  display: flex;
  justify-content: space-between;
  gap: calc(var(--jy-rpx, 1rpx) * 20);
  margin-top: calc(var(--jy-rpx, 1rpx) * 48);
}
.quiz-footer button {
  min-width: calc(var(--jy-rpx, 1rpx) * 180);
}
.remaining {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 36) * var(--font-scale, 1));
  margin: calc(var(--jy-rpx, 1rpx) * 30) 0;
}
.welcome {
  text-align: center;
}
.welcome-symbol {
  display: block;
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 110) * var(--font-scale, 1));
  color: #c59643;
  margin: calc(var(--jy-rpx, 1rpx) * 30);
}
.welcome .muted {
  display: block;
  margin-top: calc(var(--jy-rpx, 1rpx) * 24);
}
