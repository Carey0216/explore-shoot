<wxs src="/services/i18n.wxs" module="i18n"/>
<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{locale==='en-US'?'locale-en':''}} {{themeClass}}" style="{{themeStyle}}">
<view wx:if="{{localeTranslated}}" class="locale-note"><text>{{i18n.ui(localeTranslationUnavailable?'内容翻译暂时不可用，当前显示原文。':'内容由机器翻译，原文始终保留。',locale)}}</text><button bindtap="localeToggleOriginal">{{i18n.ui(localeOriginal?'显示译文':'查看原文',locale)}}</button></view>
<view wx:if="{{featureBlocked}}" class="page"><view class="empty" role="status">{{i18n.ui('功能正在维护中，敬请期待…',locale)}}</view></view><block wx:else>
<view class="page scout-page"><view class="title">{{i18n.ui(passed?'欢迎成为校园探索官':'社区规范小测',locale)}}</view><view wx:if="{{passed}}" class="card welcome"><text class="welcome-symbol">✦</text><view class="point-title">{{i18n.ui('校园里的新发现，等你来分享',locale)}}</view><text class="muted">{{i18n.ui('你已通过小测。真实记录、尊重隐私，一起照顾好这片校园。',locale)}}</text><button bindtap="publish" class="primary gap">{{i18n.ui('开始我的第一次发布',locale)}}</button></view><block wx:elif="{{!paper}}"><view class="card"><view class="point-title">{{i18n.ui('一起分享校园的新发现',locale)}}</view><text class="muted">{{i18n.ui('每次5题，答对3题通过。开始即计一次机会，答卷15分钟有效。管理员实际调整身份后恢复5次机会。',locale)}}</text><view class="remaining">{{i18n.ui('剩余',locale)}} {{i18n.content(remaining,locale,localeTranslations,localeOriginal)}} {{i18n.ui('次机会',locale)}}</view><button wx:if="{{remaining}}" class="primary" bindtap="start" loading="{{loading}}">{{i18n.ui('开始答题',locale)}}</button></view><view class="card"><view class="point-title">{{i18n.ui('也可以向管理员申请',locale)}}</view><textarea value="{{reason}}" bindinput="reason" maxlength="1000" placeholder-class="field-placeholder" placeholder="{{i18n.ui('说说想贡献的校园内容（至少5字）',locale)}}"/><button bindtap="apply">{{i18n.ui('提交人工申请',locale)}}</button></view></block><block wx:else><view class="quiz-progress"><text>{{i18n.ui('第',locale)}} {{i18n.content(step+1,locale,localeTranslations,localeOriginal)}} / {{i18n.content(paper.questions.length,locale,localeTranslations,localeOriginal)}} {{i18n.ui('题',locale)}}</text><text>{{i18n.ui('已选',locale)}} {{i18n.content(answered,locale,localeTranslations,localeOriginal)}} {{i18n.ui('题',locale)}}</text></view><progress percent="{{answered/paper.questions.length*100}}" stroke-width="3" activeColor="#76a9df" backgroundColor="#a1b5c333"/><view class="question-card"><view class="question-title">{{i18n.content(current.title,locale,localeTranslations,localeOriginal)}}</view><text class="muted">{{i18n.ui('选择后自动进入下一题，提交前可返回修改。',locale)}}</text><radio-group bindchange="answer"><label wx:for="{{choices}}" wx:key="value" class="quiz-choice {{item.checked?'selected':''}}"><radio class="native-radio" value="{{item.value}}" checked="{{item.checked}}"/><text class="option-letter">{{i18n.content(item.letter,locale,localeTranslations,localeOriginal)}}</text><text class="option-text">{{i18n.content(item.text,locale,localeTranslations,localeOriginal)}}</text></label></radio-group><view class="quiz-footer"><button bindtap="previous" disabled="{{!step||loading}}">{{i18n.ui('上一题',locale)}}</button><button wx:if="{{step<paper.questions.length-1}}" bindtap="next" disabled="{{answers[current.id]===undefined||loading}}">{{i18n.ui('下一题',locale)}}</button><button wx:elif="{{complete}}" class="primary" bindtap="submit" loading="{{loading}}">{{i18n.ui('提交答卷',locale)}}</button></view></view></block><view wx:if="{{error}}" class="warning gap">{{i18n.content(error,locale,localeTranslations,localeOriginal)}}</view></view>
</block>
<experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>
