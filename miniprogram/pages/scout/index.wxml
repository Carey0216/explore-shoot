<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{themeClass}}" style="{{themeStyle}}">
<view wx:if="{{featureBlocked}}" class="page"><view class="empty" role="status">功能正在维护中，敬请期待…</view></view><block wx:else>
<view class="page scout-page"><view class="title">{{passed?'欢迎成为校园探索官':'社区规范小测'}}</view><view wx:if="{{passed}}" class="card welcome"><text class="welcome-symbol">✦</text><view class="point-title">校园里的新发现，等你来分享</view><text class="muted">你已通过小测。真实记录、尊重隐私，一起照顾好这片校园。</text><button bindtap="publish" class="primary gap">开始我的第一次发布</button></view><block wx:elif="{{!paper}}"><view class="card"><view class="point-title">一起分享校园的新发现</view><text class="muted">每次5题，答对3题通过。开始即计一次机会，答卷15分钟有效。管理员实际调整身份后恢复5次机会。</text><view class="remaining">剩余 {{remaining}} 次机会</view><button wx:if="{{remaining}}" class="primary" bindtap="start" loading="{{loading}}">开始答题</button></view><view class="card"><view class="point-title">也可以向管理员申请</view><textarea value="{{reason}}" bindinput="reason" maxlength="1000" placeholder-class="field-placeholder" placeholder="说说想贡献的校园内容（至少5字）"/><button bindtap="apply">提交人工申请</button></view></block><block wx:else><view class="quiz-progress"><text>第 {{step+1}} / {{paper.questions.length}} 题</text><text>已选 {{answered}} 题</text></view><progress percent="{{answered/paper.questions.length*100}}" stroke-width="3" activeColor="#76a9df" backgroundColor="#a1b5c333"/><view class="question-card"><view class="question-title">{{current.title}}</view><text class="muted">选择后自动进入下一题，提交前可返回修改。</text><radio-group bindchange="answer"><label wx:for="{{choices}}" wx:key="value" class="quiz-choice {{item.checked?'selected':''}}"><radio class="native-radio" value="{{item.value}}" checked="{{item.checked}}"/><text class="option-letter">{{item.letter}}</text><text class="option-text">{{item.text}}</text></label></radio-group><view class="quiz-footer"><button bindtap="previous" disabled="{{!step||loading}}">上一题</button><button wx:if="{{step<paper.questions.length-1}}" bindtap="next" disabled="{{answers[current.id]===undefined||loading}}">下一题</button><button wx:elif="{{complete}}" class="primary" bindtap="submit" loading="{{loading}}">提交答卷</button></view></view></block><view wx:if="{{error}}" class="warning gap">{{error}}</view></view>
</block>
<experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>
