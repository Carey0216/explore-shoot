<view class="page"><view wx:if="{{!paper}}" class="card"><view class="title">您目前还不是校园探索官</view><view class="muted gap">每次5题，答对3题即可解锁。共5次机会，开始即计次；退出和15分钟过期仍计次。</view><view class="gap">剩余 {{remaining}} 次机会</view><button wx:if="{{remaining>0}}" class="primary gap" bindtap="start" loading="{{loading}}">答题解锁发布</button><view class="section-title">向管理员申请</view><textarea placeholder="说明你想贡献的校园内容（至少5字）" value="{{reason}}" bindinput="reason" maxlength="1000"/><button class="gap" bindtap="apply">提交人工申请</button></view><view wx:else><view wx:for="{{paper.questions}}" wx:key="id" class="card"><view class="point-title">{{index+1}}. {{item.title}}</view><radio-group data-id="{{item.id}}" bindchange="answer"><label wx:for="{{item.options}}" wx:for-item="option" wx:for-index="answerIndex" wx:key="*this" class="quiz-option"><radio value="{{answerIndex}}"/><text>{{option}}</text></label></radio-group></view><button class="primary" bindtap="submit" loading="{{loading}}">提交答卷</button></view><view wx:if="{{error}}" class="warning gap">{{error}}</view></view>
