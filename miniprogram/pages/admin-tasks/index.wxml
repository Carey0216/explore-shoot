<wxs src="/services/i18n.wxs" module="i18n"/>
<view class="native-surface {{locale==='en-US'?'locale-en':''}} {{themeClass}}" style="{{themeStyle}}">
<view wx:if="{{localeTranslated}}" class="locale-note"><text>{{i18n.ui('内容由机器翻译，原文始终保留。',locale)}}</text><button bindtap="localeToggleOriginal">{{i18n.ui(localeOriginal?'显示译文':'查看原文',locale)}}</button></view><view class="page">
<view class="title">{{i18n.ui('这次要完成什么？',locale)}}</view><state-view loading="{{loading}}" error="{{error}}" bind:retry="load"/>
<view class="card gap" wx:for="{{tasks}}" wx:key="id"><view class="section-title">{{i18n.content(locale==='en-US'?item.titleEn:item.title,locale,localeTranslations,localeOriginal)}}</view><button wx:for="{{item.steps}}" wx:for-item="step" wx:key="route" class="gap" data-route="{{step.route}}" bindtap="open">{{i18n.content(locale==='en-US'?step.titleEn:step.title,locale,localeTranslations,localeOriginal)}} →</button></view>
<view class="section-title gap">{{i18n.ui('需要复核的内容',locale)}}</view><view class="card gap" wx:for="{{reminders}}" wx:key="id" data-route="{{item.route}}" bindtap="open"><view>{{i18n.content(item.title,locale,localeTranslations,localeOriginal)}}</view><view class="muted">{{i18n.content(locale==='en-US'?item.reasonEn:item.reason,locale,localeTranslations,localeOriginal)}} →</view></view>
<view id="topic-schedule820" class="section-title gap">{{i18n.ui('专题发布与定时安排',locale)}}</view><view class="muted">{{i18n.ui('最多选择20项，先查看修改对比，再确认保存。',locale)}}</view>
<view class="card gap" wx:for="{{topics}}" wx:key="id" data-id="{{item.id}}" bindtap="select"><view class="row"><text>{{i18n.content(selected[item.id]?'☑':'☐',locale,localeTranslations,localeOriginal)}}</text><text>{{i18n.content(item.title,locale,localeTranslations,localeOriginal)}}</text></view><view class="muted">{{i18n.content(item.status,locale,localeTranslations,localeOriginal)}} · {{i18n.content(item.updatedBy,locale,localeTranslations,localeOriginal)}} · {{i18n.content(item.updatedAt,locale,localeTranslations,localeOriginal)}}</view></view>
<view wx:if="{{canEditTopics}}" class="card gap"><picker range="{{i18n.options(actions,locale)}}" value="{{action}}" bindchange="action"><view class="field">{{i18n.ui(actions[action],locale)}} ↓</view></picker><block wx:if="{{action===2}}"><view class="muted gap">{{i18n.ui('本机时间 YYYY-MM-DD HH:mm，可留空',locale)}}</view><input class="field gap" placeholder="{{i18n.ui('上架时间 / Publish at',locale)}}" value="{{publishAt}}" data-key="publishAt" bindinput="field" maxlength="16"/><input class="field gap" placeholder="{{i18n.ui('下架时间 / Unpublish at',locale)}}" value="{{unpublishAt}}" data-key="unpublishAt" bindinput="field" maxlength="16"/></block><textarea wx:if="{{action===3}}" class="field gap" value="{{description}}" data-key="description" bindinput="field" maxlength="2000" placeholder="{{i18n.ui('介绍 / Description',locale)}}"/><button class="primary gap" bindtap="review" loading="{{busy}}">{{i18n.ui('预览修改对比',locale)}}</button></view>
<view wx:if="{{preview}}" class="task-backdrop" bindtap="close"><view class="task-sheet" catchtap="noop"><scroll-view scroll-y class="task-review"><view class="section-title">{{i18n.ui('确认这些修改',locale)}}</view><view class="muted">{{i18n.ui('保存前备份原内容；有并发修改时需重新预览。',locale)}}</view><view class="gap" wx:for="{{preview.changes}}" wx:key="id"><view>{{i18n.content(item.title,locale,localeTranslations,localeOriginal)}}</view><view class="gap" wx:for="{{item.fields}}" wx:for-item="field" wx:key="name"><view>{{i18n.ui(field.name,locale)}}</view><view class="muted before">{{i18n.content(field.before,locale,localeTranslations,localeOriginal)}}</view><view>{{i18n.content(field.after,locale,localeTranslations,localeOriginal)}}</view></view></view></scroll-view><button class="primary gap" bindtap="apply" loading="{{busy}}">{{i18n.ui('确认保存',locale)}}</button></view></view>
</view></view>
