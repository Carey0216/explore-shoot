<wxs src="/services/i18n.wxs" module="i18n"/>
<page-meta page-style="{{pageStyle}} {{nativeRewardItems812.length || publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen ? 'overflow:hidden;' : ''}}"/>
<view bindtouchstart="cancelNativeDemoHint" class="native-surface {{locale==='en-US'?'locale-en':''}} {{themeClass}} {{nativeImpact812?'native-impact812':''}}" style="{{themeStyle}}">


<view class="page">
<photo-workspace features="{{features}}" theme="{{themeClass}}" styles="{{themeStyle}}"/><community-header impact="{{nativeImpact812}}" id="community-header"/>
<view wx:if="{{localeTranslated}}" class="locale-note"><text>{{i18n.ui(localeTranslationUnavailable?'内容翻译暂时不可用，当前显示原文。':'内容由机器翻译，原文始终保留。',locale)}}</text><button bindtap="localeToggleOriginal">{{i18n.ui(localeOriginal?'显示译文':'查看原文',locale)}}</button></view>
  <view class="row map-tabs821"><view class="pill {{tab === 'map' ? 'active' : ''}}" data-id="map" bindtap="tab">{{i18n.ui('地图',locale)}}</view><view class="pill {{tab === 'navigation' ? 'active' : ''}}" id="map-nav-tab" data-id="navigation" bindtap="tab">{{i18n.ui('导航',locale)}}</view><view class="pill {{tab === 'explore' ? 'active' : ''}}" data-id="explore" bindtap="tab">{{i18n.ui('探索',locale)}}</view></view><campus-collection id="collection-entry821" impact="{{nativeImpact812}}" wx:if="{{!nativeRewardItems812.length && !nativeOverlayOpen && !publicOverlayOpen && features.passport.visible!==false}}"/>
  <view wx:if="{{tab !== 'explore'}}">
    <picker range="{{i18n.options(points,locale)}}" range-key="name" bindchange="picker"><view class="input gap map-destination830"><text>{{selected ? i18n.content(selected.name,locale,localeTranslations,localeOriginal) : i18n.ui('选择目的地',locale)}}</text><image class="map-chevron830" src="{{i18n.icon('back',themeDark)}}" mode="aspectFit"/></view></picker>
    <map id="campus-map" class="campus-map {{tilted ? 'campus-map-3d' : ''}}" latitude="{{latitude}}" longitude="{{longitude}}" markers="{{markers}}" polyline="{{polyline}}" polygons="{{buildingFaces}}" scale="{{mapScale}}" bindregionchange="regionChanged" skew="{{tilted?40:0}}" enable-3D="{{tilted}}" enable-building="{{tilted}}" show-location="{{current}}" bindmarkertap="marker" bindcallouttap="marker" enable-rotate enable-overlooking="{{features['map-3d'].enabled!==false && features['map-3d'].visible!==false}}">
      <cover-view wx:if="{{features['map-3d'].visible!==false}}" class="map-control map-mode" catchtap="toggleTilt" aria-role="button" aria-label="{{i18n.ui(tilted?'切回平面地图':'地图立体模式',locale)}}" style="background:{{themeDark?'#203542':'#fff'}};color:{{themeDark?'#daecf8':'#244257'}}">{{tilted?'2D':'3D'}}</cover-view>
      <cover-view class="map-control map-recenter" catchtap="locate" aria-role="button" aria-label="{{i18n.ui('我的位置',locale)}}" style="background:{{themeDark?'#203542':'#fff'}}">
        <cover-image class="map-recenter-icon" src="/assets/jingyu-icons/recenter{{themeDark?'-dark':''}}.png"/>
      </cover-view>
    </map>
    <view class="map-actions830 {{tab==='navigation' && route?'map-navigation-actions':''}}">
      <button wx:if="{{tab==='map'}}" class="primary map-plan-action" disabled="{{!selected}}" bindtap="planRoute"><image class="button-icon" src="{{i18n.icon('walk',themeDark,true)}}" mode="aspectFit"/><text>{{i18n.ui('规划路线',locale)}}</text></button>
      <block wx:else>
        <button class="primary map-plan-action" disabled="{{!selected || loading || routeLoading}}" loading="{{routeLoading}}" bindtap="walk"><image wx:if="{{!routeLoading}}" class="button-icon" src="{{i18n.icon('walk',themeDark,true)}}" mode="aspectFit"/><text>{{i18n.ui('规划路线',locale)}}</text></button>
        <button wx:if="{{route}}" class="map-foreground-action" disabled="{{routeLoading}}" bindtap="startNavigation"><image class="button-icon" src="{{i18n.icon('navigation',themeDark)}}" mode="aspectFit"/><text>{{i18n.ui(navigating?'停止导航定位':'前台导航',locale)}}</text></button>
        <button wx:if="{{route}}" class="map-wechat-action" disabled="{{!selected}}" bindtap="navigate"><image class="button-icon" src="{{i18n.icon('navigation',themeDark)}}" mode="aspectFit"/><text>{{i18n.ui('打开微信导航',locale)}}</text></button>
      </block>
    </view>
    <view wx:if="{{selected}}" class="card" bindtap="detail"><view class="point-title">{{i18n.content(selected.name,locale,localeTranslations,localeOriginal)}} ›</view><view class="muted gap">{{i18n.content(selected.address,locale,localeTranslations,localeOriginal)}}</view></view>
    <view wx:if="{{tab==='navigation' && selected}}" class="card map-route830">
      <view wx:if="{{routeError}}" class="error gap" role="alert">{{i18n.content(routeError,locale,localeTranslations,localeOriginal)}}</view>
      <view wx:if="{{route}}">
        <view class="point-title">{{i18n.ui('步行',locale)}} {{route.length}} {{i18n.ui('米 · 约',locale)}} {{route.duration}} {{i18n.ui('分钟',locale)}}</view>
        <view class="map-instruction830">
          <image class="button-icon" src="{{i18n.icon('navigation',themeDark)}}" mode="aspectFit"/>
          <view><text>{{i18n.content(reading,locale,localeTranslations,localeOriginal)}}</text><view wx:if="{{distanceText}}" class="muted">{{i18n.content(distanceText,locale,localeTranslations,localeOriginal)}} · {{compass}}°</view></view>
        </view>
        <view class="row between gap"><text>{{i18n.ui('语音播报',locale)}}</text><switch checked="{{voiceEnabled}}" bindchange="voice"/></view>
        <picker wx:if="{{voiceEnabled && voices.length}}" range="{{i18n.options(voices,locale)}}" range-key="name" bindchange="voicePick"><view class="picker">{{i18n.ui('导航音色：',locale)}}{{i18n.content(voiceName||preferences.voiceId,locale,localeTranslations,localeOriginal)}}</view></picker>
        <view wx:for="{{route.steps}}" wx:key="index" class="map-step830 {{stepIndex===index?'map-step-active830':'muted'}}"><text>{{index+1}}.</text><text>{{i18n.content(item.instruction,locale,localeTranslations,localeOriginal)}}</text></view>
      </view>

    </view>
    <view class="map-tools821 gap"><button size="mini" wx:if="{{features['map-3d'].visible!==false&&features['campus-3d'].visible!==false}}" bindtap="placement"><image class="button-icon" src="{{i18n.icon('building',themeDark)}}" mode="aspectFit"/><text>{{i18n.ui('地图模型与位置',locale)}}</text></button><button wx:if="{{features['campus-3d'].visible!==false}}" data-mode="photo" bindtap="scene"><image class="button-icon" src="{{i18n.icon('panorama',themeDark)}}" mode="aspectFit"/><text>{{i18n.ui('影像三维',locale)}}</text></button><button wx:if="{{features['campus-3d'].visible!==false}}" data-mode="model" bindtap="scene"><image class="button-icon" src="{{i18n.icon('panorama',themeDark)}}" mode="aspectFit"/><text>{{i18n.ui('建筑三维',locale)}}</text></button><button wx:if="{{features.panorama.visible!==false}}" data-mode="panorama" bindtap="scene"><image class="button-icon" src="{{i18n.icon('panorama',themeDark)}}" mode="aspectFit"/><text>{{i18n.ui('实景全景',locale)}}</text></button></view><view class="privacy">{{i18n.ui('路线以服务商实际道路为准，定位仅在本页面前台导航时请求，不保存导航轨迹。也可以使用微信导航。',locale)}}</view>
  </view>
  <view wx:else class="card"><button class="primary gap" wx:if="{{features['exploration'].visible!==false}}" bindtap="routes"><image class="button-icon" src="{{i18n.icon('walk',themeDark,true)}}" mode="aspectFit"/><text>{{i18n.ui('选择校园探索路线',locale)}}</text></button><button class="gap" wx:if="{{features['exploration'].visible!==false}}" bindtap="guides"><image class="button-icon" src="{{i18n.icon('photo-guide',themeDark)}}" mode="aspectFit"/><text>{{i18n.ui('从拍摄指南开始',locale)}}</text></button><view class="point-title gap">{{i18n.ui('校园打卡护照',locale)}}</view><view class="muted gap">{{i18n.ui('按主题收集地点，查看已点亮的楼宇和印章。',locale)}}</view><button class="primary gap" wx:if="{{features['passport'].visible!==false}}" bindtap="passport"><image class="button-icon" src="{{i18n.icon('passport',themeDark,true)}}" mode="aspectFit"/><text>{{i18n.ui('打开护照',locale)}}</text></button></view>
  <view wx:if="{{tab==='map'}}" class="map-photo-list"><view class="map-photo-column" wx:for="{{photoColumns}}" wx:for-item="column" wx:key="index"><view wx:for="{{column}}" wx:key="id" class="map-photo-card" data-id="{{item.id}}" bindtap="selectCard"><view class="map-card-image"><remote-image source="{{item.photo}}" mode="aspectFill"/></view><view class="map-photo-name">{{i18n.content(item.name,locale,localeTranslations,localeOriginal)}}</view><text class="muted">{{i18n.content(item.theme,locale,localeTranslations,localeOriginal)}} · {{i18n.ui(item.open ? '可前往' : '暂时关闭',locale)}}</text></view></view></view>
  <state-view loading="{{loading}}" error="{{error}}" bind:retry="load"/>
</view>

<site-overlay id="site-overlay" content="{{siteContent}}" runtime="{{runtime}}" announcement="{{announcement}}" page="map" bind:dismiss="dismissPublicOverlay" bind:overlay="publicOverlay"/>

<experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>

<reward-overlay id="reward-overlay812" items="{{nativeRewardItems812}}" bind:dismiss="dismissNativeRewards812" bind:impact="nativeImpact812"/>
