.campus-map {
  display: block;
  position: relative;
  width: 100%;
  height: 25.5vh;
  min-height: calc(var(--jy-rpx, 1rpx) * 260);
  max-height: calc(var(--jy-rpx, 1rpx) * 420);
  border-radius: calc(var(--jy-rpx, 1rpx) * 28);
  overflow: hidden;
}
.campus-map-3d {
  height: 36vh;
  max-height: calc(var(--jy-rpx, 1rpx) * 560);
}
.map-control {
  position: absolute;
  right: 12px;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  box-shadow: 0 2px 8px #152e3c38;
}
.map-mode {
  top: 12px;
  font-size: 14px;
  font-weight: 700;
  line-height: 44px;
  text-align: center;
}
.map-recenter {
  bottom: 12px;
}
.map-recenter-icon {
  width: 24px;
  height: 24px;
  margin: 10px;
}

.map-photo-list {
  display: flex;
  align-items: flex-start;
  gap: calc(var(--jy-rpx, 1rpx) * 20);
  margin: calc(var(--jy-rpx, 1rpx) * 24) 0;
}
.map-photo-column {
  flex: 1 1 0;
  min-width: 0;
}
.map-photo-card {
  width: 100%;
  box-sizing: border-box;
  padding: calc(var(--jy-rpx, 1rpx) * 18);
  margin: 0 0 calc(var(--jy-rpx, 1rpx) * 20);
  border: calc(var(--jy-rpx, 1rpx) * 1) solid var(--line);
  border-radius: calc(var(--jy-rpx, 1rpx) * 26);
  background: var(--surface);
}
.map-card-image {
  height: calc(var(--jy-rpx, 1rpx) * 180);
  border-radius: calc(var(--jy-rpx, 1rpx) * 20);
  overflow: hidden;
  margin-bottom: calc(var(--jy-rpx, 1rpx) * 14);
}
.map-photo-name {
  font-size: calc(var(--jy-rpx, 1rpx) * 25);
  font-weight: 600;
  line-height: 1.5;
  margin-bottom: calc(var(--jy-rpx, 1rpx) * 8);
}
.map-photo-card .muted {
  font-size: calc(var(--jy-rpx, 1rpx) * 22);
}

.native-surface .map-destination830 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  min-height: var(--jy-touch, 44px);
  white-space: normal;
}
.map-chevron830 {
  width: 16px;
  height: 16px;
  flex: none;
  transform: rotate(-90deg);
}
.map-actions830 {
  display: flex;
  flex-wrap: wrap;
  gap: calc(var(--jy-rpx, 1rpx) * 12);
  margin-block: calc(var(--jy-rpx, 1rpx) * 14);
}
.native-surface .map-actions830 button {
  flex: 1 1 130px;
  min-width: 0;
  margin: 0;
  min-height: var(--jy-touch, 44px);
  white-space: normal;
  line-height: 1.35;
}
.map-navigation-actions {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 6px;
}
.native-surface .map-navigation-actions button {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 4px;
  width: 100%;
  max-width: 100%;
  padding: 8px 3px;
  font-size: calc(12px * var(--font-scale, 1));
  text-align: center;
  overflow-wrap: anywhere;
}
.map-navigation-actions .button-icon {
  width: 16px;
  height: 16px;
  margin: 0;
  flex: none;
}
.map-instruction830,
.map-step830 {
  display: flex;
  align-items: flex-start;
  gap: calc(var(--jy-rpx, 1rpx) * 16);
  border-radius: calc(var(--jy-rpx, 1rpx) * 18);
  padding: calc(var(--jy-rpx, 1rpx) * 16);
}
.map-instruction830 {
  align-items: center;
  background: var(--surface-soft, var(--bg));
  margin-block: calc(var(--jy-rpx, 1rpx) * 16);
  font-weight: 600;
}
.map-instruction830 .button-icon {
  flex: none;
  margin: 0;
}
.map-step-active830 {
  background: var(--surface-soft, var(--bg));
  font-weight: 600;
}

.native-surface .map-tabs821 {
  padding: calc(var(--jy-rpx, 1rpx) * 6);
  border: calc(var(--jy-rpx, 1rpx) * 1) solid var(--line);
  border-radius: calc(var(--jy-rpx, 1rpx) * 30);
  background: var(--surface);
}
.map-tabs821 .pill {
  flex: 1;
  text-align: center;
}
.map-tools821 {
  display: flex;
  flex-wrap: wrap;
  gap: calc(var(--jy-rpx, 1rpx) * 14);
  padding: calc(var(--jy-rpx, 1rpx) * 20) 0;
}
.native-surface .map-tools821 button {
  flex: 0 0 calc((100% - calc(var(--jy-rpx, 1rpx) * 14)) / 2);
  width: calc((100% - calc(var(--jy-rpx, 1rpx) * 14)) / 2);
  min-width: 0;
  font-size: calc(var(--jy-rpx, 1rpx) * 24);
  padding: calc(var(--jy-rpx, 1rpx) * 16) calc(var(--jy-rpx, 1rpx) * 12);
  justify-content: flex-start;
}
.native-surface .map-tools821 .button-icon {
  width: calc(var(--jy-rpx, 1rpx) * 34);
  height: calc(var(--jy-rpx, 1rpx) * 34);
  margin-right: calc(var(--jy-rpx, 1rpx) * 12);
  flex: none;
}

.native-surface .map-tools821 button {
  min-height: var(--jy-touch, 44px);
  font-size: calc(var(--jy-type-small, 12px) * var(--font-scale, 1));
}
