<page-meta page-style="{{pageStyle}} {{nativeOverlayOpen?'overflow:hidden;':''}}"/><view class="native-surface {{themeClass}}" style="{{themeStyle}}"><view class="page"><view class="title">编辑头像</view><view class="muted gap">选择已有头像，或者裁剪一张自己的照片。确认保存后才上传。</view><button bindtap="choose" class="gap" disabled="{{busy}}">从相册 / 相机选择</button><view class="avatar-stage"><canvas id="avatar-canvas" type="2d" bindtouchstart="start" catchtouchmove="move"/><view wx:if="{{!image}}" class="avatar-empty">选择照片后，可拖动调整头像位置</view><view class="crop-outline"/></view><block wx:if="{{image}}"><view class="row between"><text>缩放</text><slider min="100" max="300" value="{{zoom}}" bindchanging="zoom" bindchange="zoom"/></view><button class="primary" bindtap="save" disabled="{{busy}}" loading="{{busy}}">确认保存裁剪头像</button></block><view class="section-title">选择预设头像</view><view class="avatar-grid"><button wx:for="{{presets}}" wx:key="*this" data-id="{{item}}" bindtap="preset" disabled="{{busy}}" aria-label="选择{{item}}头像"><image src="/assets/avatars/{{item}}.png"/></button></view><view wx:if="{{error}}" class="warning">{{error}}</view></view><experience-layer id="experience" page="settings" account="{{nativeAccount}}" administrator="{{administrator}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/></view>