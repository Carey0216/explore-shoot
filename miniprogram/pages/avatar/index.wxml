<wxs src="/services/i18n.wxs" module="i18n"/>
<page-meta page-style="{{pageStyle}} {{nativeOverlayOpen?'overflow:hidden;':''}}"/><view class="native-surface {{locale==='en-US'?'locale-en':''}} {{themeClass}} {{nativeImpact812?'native-impact812':''}}" style="{{themeStyle}}">
<view wx:if="{{localeTranslated}}" class="locale-note"><text>{{i18n.ui(localeTranslationUnavailable?'内容翻译暂时不可用，当前显示原文。':'内容由机器翻译，原文始终保留。',locale)}}</text><button bindtap="localeToggleOriginal">{{i18n.ui(localeOriginal?'显示译文':'查看原文',locale)}}</button></view><view class="page"><view class="title">{{i18n.ui('编辑头像',locale)}}</view><view class="muted gap">{{i18n.ui('选择已有头像，或者裁剪一张自己的照片。确认保存后才上传。',locale)}}</view><button bindtap="choose" class="gap" disabled="{{busy}}">{{i18n.ui('从相册 / 相机选择',locale)}}</button><view class="avatar-stage"><canvas id="avatar-canvas" type="2d" bindtouchstart="start" catchtouchmove="move"/><view wx:if="{{!image}}" class="avatar-empty">{{i18n.ui('选择照片后，可拖动调整头像位置',locale)}}</view><view class="crop-outline"/></view><block wx:if="{{image}}"><view class="row between"><text>{{i18n.ui('缩放',locale)}}</text><slider min="100" max="300" value="{{zoom}}" bindchanging="zoom" bindchange="zoom"/></view><button class="primary" bindtap="save" disabled="{{busy}}" loading="{{busy}}">{{i18n.ui('确认保存裁剪头像',locale)}}</button></block><view class="section-title">{{i18n.ui('选择预设头像',locale)}}</view><view class="avatar-grid"><button wx:for="{{presets}}" wx:key="*this" data-id="{{item}}" bindtap="preset" disabled="{{busy}}" aria-label="{{i18n.ui('选择',locale)}}{{i18n.content(item,locale,localeTranslations,localeOriginal)}}{{i18n.ui('头像',locale)}}"><image src="/assets/avatars/{{item}}.png"/></button></view><view wx:if="{{error}}" class="warning">{{i18n.content(error,locale,localeTranslations,localeOriginal)}}</view></view><experience-layer id="experience" page="settings" account="{{nativeAccount}}" administrator="{{administrator}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/></view>
<reward-overlay id="reward-overlay812" items="{{nativeRewardItems812}}" bind:dismiss="dismissNativeRewards812" bind:impact="nativeImpact812"/>
