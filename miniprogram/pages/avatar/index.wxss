.avatar-stage {
  position: relative;
  width: calc(var(--jy-rpx, 1rpx) * 600);
  height: calc(var(--jy-rpx, 1rpx) * 600);
  max-width: 100%;
  margin: calc(var(--jy-rpx, 1rpx) * 30) auto;
  overflow: hidden;
  background: var(--raised);
  border-radius: calc(var(--jy-rpx, 1rpx) * 30);
}
.avatar-stage canvas {
  width: 100%;
  height: 100%;
}
.avatar-empty {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--muted);
  font-size: calc(var(--jy-rpx, 1rpx) * 26);
  pointer-events: none;
}
.crop-outline {
  position: absolute;
  inset: 0;
  border: calc(var(--jy-rpx, 1rpx) * 2) solid var(--line);
  border-radius: 50%;
  pointer-events: none;
}
.avatar-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: calc(var(--jy-rpx, 1rpx) * 16);
}
.avatar-grid button {
  padding: calc(var(--jy-rpx, 1rpx) * 12);
  border-radius: 50%;
  background: none;
}
.avatar-grid image {
  width: calc(var(--jy-rpx, 1rpx) * 110);
  height: calc(var(--jy-rpx, 1rpx) * 110);
  border-radius: 50%;
}
.row slider {
  flex: 1;
  min-width: 0;
}
