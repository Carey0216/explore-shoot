<wxs src="/services/i18n.wxs" module="i18n"/>
<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{locale==='en-US'?'locale-en':''}} {{themeClass}} {{nativeImpact812?'native-impact812':''}}" style="{{themeStyle}}">
<view wx:if="{{localeTranslated}}" class="locale-note"><text>{{i18n.ui(localeTranslationUnavailable?'内容翻译暂时不可用，当前显示原文。':'内容由机器翻译，原文始终保留。',locale)}}</text><button bindtap="localeToggleOriginal">{{i18n.ui(localeOriginal?'显示译文':'查看原文',locale)}}</button></view>

<view class="page"><view class="title">{{i18n.ui('账户设置',locale)}}</view><view class="card"><view class="point-title">{{i18n.ui('显示与动效',locale)}}</view><picker range="{{i18n.options(['跟随设备语言','简体中文','English'],locale)}}" value="{{preferences.language==='en-US'?2:preferences.language==='zh-CN'?1:0}}" data-key="language" bindchange="preference"><view class="input">{{i18n.ui('语言 / Language：',locale)}}{{i18n.ui(preferences.language==='system'?'跟随设备语言':preferences.language==='en-US'?'English':'简体中文',locale)}} ⌄</view></picker><view class="muted">{{i18n.ui('语言偏好会随账号保存，链接语言只临时覆盖。',locale)}}</view><picker range="{{i18n.options(['跟随系统','浅色','深色'],locale)}}" data-key="appearance" bindchange="preference"><view class="input">{{i18n.ui('外观：',locale)}}{{i18n.ui(preferences.appearance==='system'?'跟随系统':preferences.appearance==='dark'?'深色':'浅色',locale)}} ⌄</view></picker><picker range="{{i18n.options(['标准字号','大字号'],locale)}}" data-key="textSize" bindchange="preference"><view class="input">{{i18n.ui('文字：',locale)}}{{i18n.ui(preferences.textSize==='large'?'大字号':'标准',locale)}} ⌄</view></picker><view wx:if="{{features['campus-time'].visible!==false && features['campus-time'].enabled===false}}" class="input" data-feature="campus-time" bindtap="featureTap">{{i18n.ui('校园时段 ⌄',locale)}}</view><picker wx:if="{{features['campus-time'].visible!==false && features['campus-time'].enabled!==false}}" range="{{i18n.options(['跟随设备时间','白天','傍晚'],locale)}}" value="{{preferences.campusTime==='evening'?2:preferences.campusTime==='day'?1:0}}" data-key="campusTime" bindtap="campusTimeGate" bindchange="preference"><view class="input">{{i18n.ui('校园时段：',locale)}}{{i18n.ui(preferences.campusTime==='auto'?'跟随设备时间':preferences.campusTime==='evening'?'傍晚':'白天',locale)}} ⌄</view></picker><view wx:if="{{features['campus-time'].visible!==false}}" class="muted">{{i18n.ui('全景与三维共用 · 18:00—次日07:00为傍晚',locale)}}</view></view><block wx:if="{{account}}">
  <view class="card"><view class="row wrap"><image wx:for="{{['panda','cat','dog','fox','sprout','cloud','astronaut','anime-blue']}}" wx:key="*this" src="/assets/avatars/{{item}}.png" style="width:80rpx;height:80rpx;border-radius:50%" data-id="{{item}}" bindtap="avatar"/></view><button class="gap" bindtap="editAvatar">{{i18n.ui('完整头像库 / 上传与裁剪',locale)}}</button><label class="label">{{i18n.ui('昵称',locale)}}</label><input class="input" value="{{nickname}}" data-field="nickname" bindinput="input" maxlength="24"/><button class="primary" bindtap="profile" disabled="{{busy}}">{{i18n.ui('保存昵称',locale)}}</button></view>
  <view wx:if="{{account.wechatTestAccount}}" class="warning">{{i18n.ui('当前为独立微信测试账号。可体验私密打卡和护照，正式上线前会清除账号与关联记录；不提交公开作品或探索官申请。',locale)}}</view>
  <view wx:if="{{!account.wechatTestAccount}}" class="card"><view class="point-title">{{i18n.ui('修改密码',locale)}}</view><input class="input gap" password value="{{currentPassword}}" placeholder-class="field-placeholder" placeholder="{{i18n.ui('当前密码',locale)}}" data-field="currentPassword" bindinput="input"/><input class="input" password value="{{newPassword}}" placeholder-class="field-placeholder" placeholder="{{i18n.ui('新密码',locale)}}" data-field="newPassword" bindinput="input"/><button bindtap="password" disabled="{{busy}}">{{i18n.ui('更新密码',locale)}}</button></view>
  <view wx:if="{{wechat && !account.wechatTestAccount}}" class="card"><view class="point-title">{{i18n.ui('微信账号',locale)}}</view><view class="privacy">{{i18n.ui('绑定现有账号后，微信登录可继续使用原有打卡与护照记录。',locale)}}</view><button wx:if="{{!bound}}" bindtap="bind" disabled="{{busy}}">{{i18n.ui('绑定此微信',locale)}}</button><button wx:else class="danger" bindtap="unbind">{{i18n.ui('解除微信绑定',locale)}}</button></view>
  <view wx:if="{{!account.wechatTestAccount && account.scoutStatus !== 'approved'}}" class="card"><view class="point-title">{{i18n.ui('申请校园探索官',locale)}}</view><input class="input gap" placeholder-class="field-placeholder" placeholder="{{i18n.ui('简单介绍你的拍摄与探索想法',locale)}}" value="{{reason}}" data-field="reason" bindinput="input" maxlength="1000"/><button bindtap="apply" disabled="{{busy}}">{{i18n.ui('提交申请',locale)}}</button></view>
  <button class="danger gap" bindtap="logout">{{i18n.ui('退出登录',locale)}}</button>
  </block>
<view wx:if="{{features.weather.visible!==false}}" class="card"><button class="text-button" bindtap="weatherCredits">{{i18n.ui('天气数据说明',locale)}} ⌄</button><view wx:if="{{weatherCreditsOpen}}" class="muted">{{i18n.ui('天气由 Open-Meteo 提供，依据 CC BY 4.0 使用。预报仅供拍摄安排参考。',locale)}}<view>open-meteo.com · creativecommons.org/licenses/by/4.0/</view></view></view>
</view>

<site-overlay id="site-overlay" content="{{siteContent}}" runtime="{{runtime}}" announcement="{{announcement}}" page="settings" bind:dismiss="dismissPublicOverlay" bind:overlay="publicOverlay"/>

<experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>

<reward-overlay id="reward-overlay812" items="{{nativeRewardItems812}}" bind:dismiss="dismissNativeRewards812" bind:impact="nativeImpact812"/>
