<wxs src="/services/i18n.wxs" module="i18n"/>
<view class="native-surface {{locale==='en-US'?'locale-en':''}} {{themeClass}}" style="{{themeStyle}}">
<view wx:if="{{localeTranslated}}" class="locale-note"><text>{{i18n.ui('内容由机器翻译，原文始终保留。',locale)}}</text><button bindtap="localeToggleOriginal">{{i18n.ui(localeOriginal?'显示译文':'查看原文',locale)}}</button></view><view class="page"><view class="title">{{i18n.ui('同一个地方，不同的时间',locale)}}</view><view class="muted gap">{{i18n.ui('只使用你自己的打卡照片。日期为打卡时间；不会自动公开。',locale)}}</view><state-view loading="{{loading}}" error="{{error}}" bind:retry="retryLoad"/>
<picker wx:if="{{places.length}}" range="{{i18n.options(places,locale)}}" range-key="name" value="{{placeIndex}}" bindchange="place"><view class="card gap">{{i18n.content(places[placeIndex].name,locale,localeTranslations,localeOriginal)}} ↓</view></picker>
<block wx:if="{{first}}"><view class="pair gap"><picker range="{{i18n.options(items,locale)}}" range-key="label" value="{{left}}" data-side="left" bindchange="pick"><view class="card">{{i18n.ui('之前',locale)}} · {{first.label}} ↓</view></picker><picker range="{{i18n.options(items,locale)}}" range-key="label" value="{{right}}" data-side="right" bindchange="pick"><view class="card">{{i18n.ui('后来',locale)}} · {{second.label}} ↓</view></picker></view><view class="compare gap"><image src="{{secondPhoto}}" mode="aspectFit"/><view class="before" style="width:{{split}}%"><image src="{{firstPhoto}}" mode="aspectFit" style="width:{{compareWidth}}px"/></view><view class="divider" style="left:{{split}}%"/></view><view class="muted">{{i18n.ui('左右滑动，比较变化',locale)}}</view><slider value="{{split}}" min="0" max="100" bindchanging="split" bindchange="split" activeColor="#366c96"/><view wx:if="{{photoError}}" class="warning">{{i18n.content(photoError,locale,localeTranslations,localeOriginal)}}<button bindtap="pair">{{i18n.ui('重试照片',locale)}}</button></view><button class="primary gap" bindtap="retake" disabled="{{!first.canRetake}}">{{i18n.ui('按之前这张照片再拍一次',locale)}} ↗</button><view class="muted gap" wx:if="{{items.length<2}}">{{i18n.ui('这里还只有一张照片。再拍一次，就能比较变化。',locale)}}</view><view class="card gap" wx:for="{{items}}" wx:key="id"><view>{{item.label}} · {{i18n.ui(item.seasonLabel,locale)}} · {{i18n.ui(item.timeLabel,locale)}}</view><view class="muted">{{i18n.content(item.note,locale,localeTranslations,localeOriginal)}}</view></view><button wx:if="{{hasMore}}" class="gap" bindtap="more">{{i18n.ui('查看更早的照片',locale)}}</button></block><view wx:elif="{{!loading && !error}}" class="empty">{{i18n.ui('在地点完成一次带照片的打卡，就能开始你的时间线。',locale)}}</view>
</view></view>
