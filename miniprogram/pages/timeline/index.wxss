.pair {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  min-width: 0;
}
.pair picker {
  min-width: 0;
}
.pair .card {
  font-size: 12px;
  overflow-wrap: anywhere;
}
.compare {
  height: 300px;
  max-height: 44vh;
  position: relative;
  overflow: hidden;
  border-radius: 24px;
  background: var(--jy-color-surface);
}
.compare > image {
  width: 100%;
  height: 100%;
  position: absolute;
  inset: 0;
}
.before {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
}
.before image {
  height: 100%;
  max-width: none;
  background: var(--jy-color-surface);
}
.divider {
  position: absolute;
  top: 0;
  bottom: 0;
  border-left: 2px solid white;
  pointer-events: none;
}
