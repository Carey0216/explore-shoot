.login-page {
  min-height: 88vh;
  display: flex;
  align-items: center;
  background: linear-gradient(155deg, #f6f7f4, #eaf0e9 60%, #f5eadb);
}
.login-card {
  width: 100%;
  background: rgba(255, 255, 255, 0.93);
  padding: calc(var(--jy-rpx, 1rpx) * 48) calc(var(--jy-rpx, 1rpx) * 36);
  border-radius: calc(var(--jy-rpx, 1rpx) * 36);
  border: calc(var(--jy-rpx, 1rpx) * 2) solid #fff;
  box-shadow: 0 calc(var(--jy-rpx, 1rpx) * 20) calc(var(--jy-rpx, 1rpx) * 80) rgba(37, 60, 45, 0.07);
}

.account-choices {
  display: flex;
  gap: calc(var(--jy-rpx, 1rpx) * 12);
  margin: calc(var(--jy-rpx, 1rpx) * 32) 0 calc(var(--jy-rpx, 1rpx) * 20);
}
.account-choices button {
  flex: 1;
  min-width: 0;
  font-size: calc(var(--jy-rpx, 1rpx) * 28);
  padding: calc(var(--jy-rpx, 1rpx) * 20) calc(var(--jy-rpx, 1rpx) * 8);
  line-height: 1.4;
}
.account-choices .selected {
  background: var(--selected);
  color: var(--accent);
  border-color: var(--accent);
}

.login-page {
  background: var(--bg);
  min-height: calc(100vh - calc(var(--jy-rpx, 1rpx) * 100));
}
.login-card {
  background: var(--surface);
  border-color: var(--line);
  color: var(--text);
  box-shadow: none;
  box-sizing: border-box;
}
.login-card .title {
  font-size: calc(var(--jy-rpx, 1rpx) * 42);
  line-height: 1.3;
}
.login-card .input {
  box-sizing: border-box;
}
.login-card .label {
  margin: calc(var(--jy-rpx, 1rpx) * 26) 0 calc(var(--jy-rpx, 1rpx) * 12);
}

.login-card .jingyu-wordmark {
  width: calc(var(--jy-rpx, 1rpx) * 190);
  height: calc(var(--jy-rpx, 1rpx) * 95);
}
