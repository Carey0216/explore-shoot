<wxs src="/services/i18n.wxs" module="i18n"/>
<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{locale==='en-US'?'locale-en':''}} {{themeClass}} {{nativeImpact812?'native-impact812':''}}" style="{{themeStyle}}">
<view wx:if="{{localeTranslated}}" class="locale-note"><text>{{i18n.ui(localeTranslationUnavailable?'内容翻译暂时不可用，当前显示原文。':'内容由机器翻译，原文始终保留。',locale)}}</text><button bindtap="localeToggleOriginal">{{i18n.ui(localeOriginal?'显示译文':'查看原文',locale)}}</button></view><view class="locale-auth-action"><language-picker class="language-picker-host" id="language-picker" administrator="{{false}}"/></view>

<view class="page login-page"><view class="login-card"><image class="jingyu-wordmark" src="/assets/brand/jingyu-{{themeDark ? 'dark' : 'light'}}.png" mode="aspectFit" aria-label="{{i18n.ui('景遇校园',locale)}}"/><view class="title">{{i18n.ui(onboarding ? '连接你的校园账号' : register ? '创建账号' : '欢迎回来',locale)}}</view><view class="muted gap">{{i18n.ui('与网页端共用账号和打卡记录',locale)}}</view>
  <view wx:if="{{onboarding}}" class="account-choices"><button class="{{binding ? 'selected' : ''}}" data-action="bind" bindtap="chooseAccount" disabled="{{loading}}">{{i18n.ui('绑定已有账号',locale)}}</button><button class="{{!binding ? 'selected' : ''}}" data-action="create" bindtap="chooseAccount" disabled="{{loading}}">{{i18n.ui('创建新账号',locale)}}</button></view>
  <view wx:if="{{onboarding}}" class="privacy">{{i18n.ui(binding ? '输入原网页账号和密码，保留收藏、打卡与探索官身份。' : '设置账号和密码，之后也能在网页端登录同一账号。',locale)}}</view>
  <label class="label">{{i18n.ui('账号',locale)}}</label><input class="input" value="{{username}}" data-field="username" bindinput="input" maxlength="32" placeholder-class="field-placeholder" placeholder="{{i18n.ui('输入账号',locale)}}" disabled="{{loading}}"/>
  <label class="label">{{i18n.ui('密码',locale)}}</label><input class="input" password value="{{password}}" data-field="password" bindinput="input" maxlength="128" placeholder-class="field-placeholder" placeholder="{{i18n.ui('输入密码',locale)}}" disabled="{{loading}}"/>
  <block wx:if="{{register || (onboarding && !binding)}}"><label class="label">{{i18n.ui('昵称',locale)}}</label><input class="input" value="{{nickname}}" data-field="nickname" bindinput="input" maxlength="24" disabled="{{loading}}"/><view class="privacy">{{i18n.ui('注册为普通用户，完成社区规范小测后可成为校园探索官。',locale)}}</view></block>
  <block wx:if="{{onboarding && !binding}}"><label class="label">{{i18n.ui('确认密码',locale)}}</label><input class="input" password value="{{confirm}}" data-field="confirm" bindinput="input" maxlength="128" placeholder-class="field-placeholder" placeholder="{{i18n.ui('再次输入密码',locale)}}" disabled="{{loading}}"/></block>
  <view wx:if="{{error}}" class="warning">{{i18n.content(error,locale,localeTranslations,localeOriginal)}}</view><button class="primary" loading="{{loading}}" disabled="{{loading}}" bindtap="submit">{{i18n.ui(onboarding ? (binding ? '绑定并进入校园' : '创建并进入校园') : register ? '注册并登录' : '登录',locale)}}</button>
  <button wx:if="{{(wechat || testWechat) && !register && !onboarding}}" class="gap" bindtap="wechat" disabled="{{loading || !wechat}}">{{i18n.ui(testWechat ? '微信一键登录（测试）' : '微信一键登录',locale)}}</button><view wx:if="{{!onboarding}}" class="link" bindtap="toggle">{{i18n.ui(register ? '已有账号，去登录' : '没有账号？注册',locale)}}</view>
  <view wx:if="{{onboarding}}" class="link" bindtap="cancelWechat">{{i18n.ui('返回其他登录方式',locale)}}</view><view wx:if="{{testWechat}}" class="privacy">{{i18n.ui('微信一键登录会创建独立测试账号，正式上线前将清除其账号、打卡与照片；不会合并或替换已有账号。',locale)}}{{i18n.ui(wechat ? '' : '服务器尚未配置微信密钥。',locale)}}</view>
  <view wx:else class="privacy">{{i18n.ui('微信首次登录可选择绑定已有账号，或创建新账号。',locale)}}</view>
</view></view>

<site-overlay id="site-overlay" content="{{siteContent}}" runtime="{{runtime}}" announcement="{{announcement}}" page="login" bind:dismiss="dismissPublicOverlay" bind:overlay="publicOverlay"/>

<experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>

<reward-overlay id="reward-overlay812" items="{{nativeRewardItems812}}" bind:dismiss="dismissNativeRewards812" bind:impact="nativeImpact812"/>
