<wxs src="/services/i18n.wxs" module="i18n"/>
<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{locale==='en-US'?'locale-en':''}} {{themeClass}}" style="{{themeStyle}}">
<view wx:if="{{localeTranslated}}" class="locale-note"><text>{{i18n.ui(localeTranslationUnavailable?'内容翻译暂时不可用，当前显示原文。':'内容由机器翻译，原文始终保留。',locale)}}</text><button bindtap="localeToggleOriginal">{{i18n.ui(localeOriginal?'显示译文':'查看原文',locale)}}</button></view>
<view wx:if="{{featureBlocked}}" class="page"><view class="empty" role="status">{{i18n.ui('功能正在维护中，敬请期待…',locale)}}</view></view><block wx:else>
<view class="page"><view wx:if="{{!conversation}}"><view class="title">{{i18n.ui('联系管理员',locale)}}</view><view class="muted gap">{{i18n.ui('先留言，管理员处理后可为你建立专属对话。',locale)}}</view><view wx:for="{{threads}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open">{{i18n.content(item.adminName,locale,localeTranslations,localeOriginal)}} · {{i18n.ui(item.unread ? item.unread+'条新回复' : '查看对话',locale)}} ↗</view><view wx:for="{{requests}}" wx:key="id" class="card"><view class="muted">{{i18n.ui(item.status==='pending'?'等待处理':'已建立连接',locale)}}</view><view class="gap">{{i18n.content(item.body,locale,localeTranslations,localeOriginal)}}</view></view></view><view wx:else><view class="title">{{i18n.content(conversation.adminName,locale,localeTranslations,localeOriginal)}}</view><button size="mini" class="small gap" bindtap="load">{{i18n.ui('刷新消息',locale)}}</button><button size="mini" wx:if="{{next}}" class="small gap" bindtap="older">{{i18n.ui('查看更早消息',locale)}}</button><view wx:for="{{items}}" wx:key="id" class="card bubble {{item.from}}"><view class="muted">{{i18n.ui(item.from==='admin'?'管理员':'我',locale)}} · {{i18n.content(item.time,locale,localeTranslations,localeOriginal)}}</view><message-body value="{{item}}"/></view></view><view wx:if="{{!conversation || conversation.open}}" class="card"><textarea class="input text" maxlength="{{conversation ? 4000 : 2000}}" value="{{body}}" data-key="body" bindinput="field" placeholder-class="field-placeholder" placeholder="{{i18n.ui(conversation ? '写下回复…' : '告诉管理员你遇到的问题或建议…',locale)}}"/><block wx:if="{{conversation}}"><button size="mini" class="small gap" bindtap="choose" disabled="{{loading}}">{{i18n.ui('添加图片',locale)}}</button><image wx:if="{{image}}" src="{{image}}" mode="widthFix" class="attachment"/><button size="mini" wx:if="{{imageId}}" class="small" bindtap="removeImage">{{i18n.ui('移除图片',locale)}}</button><input class="input gap" data-key="linkLabel" bindinput="field" value="{{linkLabel}}" placeholder-class="field-placeholder" placeholder="{{i18n.ui('链接名称（选填）',locale)}}"/><input class="input gap" data-key="linkHref" bindinput="field" value="{{linkHref}}" placeholder-class="field-placeholder" placeholder="{{i18n.ui('站内窗口或HTTPS链接',locale)}}"/></block><button class="primary gap" loading="{{loading}}" disabled="{{loading}}" bindtap="send">{{i18n.ui(conversation?'发送回复':'提交联系请求',locale)}}</button></view><view wx:else class="muted gap">{{i18n.ui('此对话已关闭。返回联系页可以重新留言。',locale)}}</view><state-view error="{{error}}"/><canvas id="message-photo" type="2d" class="offscreen"/></view>
</block>
<experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>
