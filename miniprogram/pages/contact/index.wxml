<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{themeClass}}" style="{{themeStyle}}">
<view wx:if="{{featureBlocked}}" class="page"><view class="empty" role="status">功能正在维护中，敬请期待…</view></view><block wx:else>
<view class="page"><view wx:if="{{!conversation}}"><view class="title">联系管理员</view><view class="muted gap">先留言，管理员处理后可为你建立专属对话。</view><view wx:for="{{threads}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open">{{item.adminName}} · {{item.unread ? item.unread+'条新回复' : '查看对话'}} ↗</view><view wx:for="{{requests}}" wx:key="id" class="card"><view class="muted">{{item.status==='pending'?'等待处理':'已建立连接'}}</view><view class="gap">{{item.body}}</view></view></view><view wx:else><view class="title">{{conversation.adminName}}</view><button size="mini" class="small gap" bindtap="load">刷新消息</button><button size="mini" wx:if="{{next}}" class="small gap" bindtap="older">查看更早消息</button><view wx:for="{{items}}" wx:key="id" class="card bubble {{item.from}}"><view class="muted">{{item.from==='admin'?'管理员':'我'}} · {{item.time}}</view><message-body value="{{item}}"/></view></view><view wx:if="{{!conversation || conversation.open}}" class="card"><textarea class="input text" maxlength="{{conversation ? 4000 : 2000}}" value="{{body}}" data-key="body" bindinput="field" placeholder-class="field-placeholder" placeholder="{{conversation ? '写下回复…' : '告诉管理员你遇到的问题或建议…'}}"/><block wx:if="{{conversation}}"><button size="mini" class="small gap" bindtap="choose" disabled="{{loading}}">添加图片</button><image wx:if="{{image}}" src="{{image}}" mode="widthFix" class="attachment"/><button size="mini" wx:if="{{imageId}}" class="small" bindtap="removeImage">移除图片</button><input class="input gap" data-key="linkLabel" bindinput="field" value="{{linkLabel}}" placeholder-class="field-placeholder" placeholder="链接名称（选填）"/><input class="input gap" data-key="linkHref" bindinput="field" value="{{linkHref}}" placeholder-class="field-placeholder" placeholder="站内窗口或HTTPS链接"/></block><button class="primary gap" loading="{{loading}}" disabled="{{loading}}" bindtap="send">{{conversation?'发送回复':'提交联系请求'}}</button></view><view wx:else class="muted gap">此对话已关闭。返回联系页可以重新留言。</view><state-view error="{{error}}"/><canvas id="message-photo" type="2d" class="offscreen"/></view>
</block>
<experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>
