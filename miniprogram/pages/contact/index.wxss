.text {
  width: 100%;
  height: calc(var(--jy-rpx, 1rpx) * 210);
  box-sizing: border-box;
}
.bubble.admin {
  background: #e7f1fa;
}
.attachment {
  width: 100%;
  height: auto;
  border-radius: calc(var(--jy-rpx, 1rpx) * 28);
  margin: calc(var(--jy-rpx, 1rpx) * 20) 0;
}
.offscreen {
  position: fixed;
  left: -3000px;
  top: 0;
  width: 1600px;
  height: 1600px;
}
