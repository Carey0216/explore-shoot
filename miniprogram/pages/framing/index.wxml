<wxs src="/services/i18n.wxs" module="i18n"/>
<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{locale==='en-US'?'locale-en':''}} {{themeClass}} {{nativeImpact812?'native-impact812':''}}" style="{{themeStyle}}">
<view wx:if="{{localeTranslated}}" class="locale-note"><text>{{i18n.ui(localeTranslationUnavailable?'内容翻译暂时不可用，当前显示原文。':'内容由机器翻译，原文始终保留。',locale)}}</text><button bindtap="localeToggleOriginal">{{i18n.ui(localeOriginal?'显示译文':'查看原文',locale)}}</button></view>
<view wx:if="{{featureBlocked}}" class="page"><view class="empty" role="status">{{i18n.ui('功能正在维护中，敬请期待…',locale)}}</view></view><block wx:else>
<view class="page"><view class="title">{{i18n.ui('站位取景辅助',locale)}}</view><view wx:if="{{error}}" class="warning">{{i18n.content(error,locale,localeTranslations,localeOriginal)}}</view><block wx:if="{{spot}}"><view class="gap">{{i18n.content(spot.title,locale,localeTranslations,localeOriginal)}} <text wx:if="{{!spot.referenceOnly}}">{{i18n.ui('· 朝向',locale)}} {{i18n.content(spot.bearing,locale,localeTranslations,localeOriginal)}}°</text></view><view class="muted gap">{{i18n.content(spot.standDescription,locale,localeTranslations,localeOriginal)}}</view><view class="gap">{{i18n.ui(spot.heightMeters?'建议镜头距地 '+spot.heightMeters+' 米':'建议高度待维护',locale)}} {{i18n.content(spot.heightAdvice,locale,localeTranslations,localeOriginal)}}</view><view class="framing-stage"><camera wx:if="{{camera}}" device-position="back" flash="off" binderror="error"><cover-image wx:if="{{example}}" src="{{example}}" style="position:absolute;width:100%;height:100%;opacity:{{opacity}}"/></camera><image wx:else src="{{example}}" mode="aspectFit"/><view wx:if="{{!example}}" class="muted">{{i18n.ui('暂无可用示例照片',locale)}}</view></view><view class="muted gap">{{i18n.ui('参考图透明度',locale)}}</view><slider min="0" max="100" value="40" bindchanging="opacity" bindchange="opacity"/><view class="row gap"><button class="primary grow" bindtap="start">{{i18n.ui('开启相机',locale)}}</button><button class="grow" bindtap="compass">{{i18n.ui('朝向参考',locale)}}</button></view><button wx:if="{{camera&&features.publishing.visible!==false}}" class="primary gap" bindtap="capture" disabled="{{capturing}}">{{i18n.ui(capturing?'正在保存照片…':'拍摄并接续记录',locale)}}</button><view class="muted gap">{{i18n.content(heading,locale,localeTranslations,localeOriginal)}}</view><view class="muted gap">{{i18n.ui('正北为0°。仅辅助构图，不自动拍摄上传，不用于精密导航。离开页面即停止相机。',locale)}}</view></block></view>

</block>
<experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>

<reward-overlay id="reward-overlay812" items="{{nativeRewardItems812}}" bind:dismiss="dismissNativeRewards812" bind:impact="nativeImpact812"/>
