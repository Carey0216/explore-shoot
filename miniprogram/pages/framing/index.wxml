<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{themeClass}}" style="{{themeStyle}}">
<view wx:if="{{featureBlocked}}" class="page"><view class="empty" role="status">功能正在维护中，敬请期待…</view></view><block wx:else>
<view class="page"><view class="title">站位取景辅助</view><view wx:if="{{error}}" class="warning">{{error}}</view><block wx:if="{{spot}}"><view class="gap">{{spot.title}} · 朝向 {{spot.bearing}}°</view><view class="muted gap">{{spot.standDescription}}</view><view class="gap">{{spot.heightMeters?'建议镜头距地 '+spot.heightMeters+' 米':'建议高度待维护'}} {{spot.heightAdvice}}</view><view class="framing-stage"><camera wx:if="{{camera}}" device-position="back" flash="off" binderror="error"><cover-image wx:if="{{example}}" src="{{example}}" style="position:absolute;width:100%;height:100%;opacity:{{opacity}}"/></camera><image wx:else src="{{example}}" mode="aspectFit"/><view wx:if="{{!example}}" class="muted">暂无可用示例照片</view></view><slider min="0" max="100" value="40" bindchanging="opacity" bindchange="opacity"/><view class="row gap"><button class="primary grow" bindtap="start">开启相机</button><button class="grow" bindtap="compass">朝向参考</button></view><view class="muted gap">{{heading}}</view><view class="muted gap">正北为0°。仅辅助构图，不自动拍摄上传，不用于精密导航。离开页面即停止相机。</view></block></view>

</block>
<experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>
