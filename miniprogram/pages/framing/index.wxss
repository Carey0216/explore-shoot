.plan-row {
  padding: calc(var(--jy-rpx, 1rpx) * 28) 0;
  border-bottom: calc(var(--jy-rpx, 1rpx) * 1) solid #d9e5df;
}
.wrap {
  flex-wrap: wrap;
}
.framing-stage {
  position: relative;
  width: 100%;
  height: calc(var(--jy-rpx, 1rpx) * 900);
  background: #182b27;
  border-radius: calc(var(--jy-rpx, 1rpx) * 28);
  overflow: hidden;
}
.framing-stage camera,
.framing-stage image {
  width: 100%;
  height: 100%;
}
