<wxs src="/services/i18n.wxs" module="i18n"/>
<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{locale==='en-US'?'locale-en':''}} {{themeClass}} {{nativeImpact812?'native-impact812':''}}" style="{{themeStyle}}">
<view wx:if="{{localeTranslated}}" class="locale-note"><text>{{i18n.ui(localeTranslationUnavailable?'内容翻译暂时不可用，当前显示原文。':'内容由机器翻译，原文始终保留。',locale)}}</text><button bindtap="localeToggleOriginal">{{i18n.ui(localeOriginal?'显示译文':'查看原文',locale)}}</button></view>
<view wx:if="{{featureBlocked}}" class="page"><view class="empty" role="status">{{i18n.ui('功能正在维护中，敬请期待…',locale)}}</view></view><block wx:else>
<view class="page"><view class="title">{{i18n.ui(session?session.routeName:'校园探索路线',locale)}}</view><view class="muted gap">{{i18n.ui('路线时间包含余量。开放与通行以现场为准，不将完成任务视为真实打卡。',locale)}}</view><block wx:if="{{!session}}"><view class="card"><view class="row between"><text>{{i18n.ui('时间预算',locale)}}</text><picker range="{{i18n.options([15,20,30],locale)}}" data-key="budget" bindchange="pick"><view class="picker">{{i18n.content(budget,locale,localeTranslations,localeOriginal)}} {{i18n.ui('分钟 ⌄',locale)}}</view></picker></view><picker range="{{i18n.options(['轻松','适中'],locale)}}" data-key="intensity" bindchange="intensityPick"><view class="picker">{{i18n.ui('步行强度：',locale)}}{{i18n.content(intensity,locale,localeTranslations,localeOriginal)}}</view></picker><picker range="{{i18n.options([1,2],locale)}}" data-key="people" bindchange="pick"><view class="picker">{{i18n.content(people,locale,localeTranslations,localeOriginal)}} {{i18n.ui('人 ⌄',locale)}}</view></picker><picker range="{{i18n.options(['全部','建筑','自然','人文','运动'],locale)}}" data-key="theme" bindchange="pick"><view class="picker">{{i18n.content(theme,locale,localeTranslations,localeOriginal)}} ⌄</view></picker><picker range="{{i18n.options(['引导探索','固定路线','自由拍摄'],locale)}}" data-key="mode" bindchange="pick"><view class="picker">{{i18n.ui(mode==='guide'?'引导探索':mode==='personal'?'自由拍摄':'固定路线',locale)}} ⌄</view></picker><input value="{{query}}" data-key="query" bindinput="field" placeholder-class="field-placeholder" placeholder="{{i18n.ui('搜索路线或途经地点',locale)}}"/><button class="primary" bindtap="load">{{i18n.ui('查看可用路线',locale)}}</button></view><view wx:for="{{items}}" wx:key="id" class="card"><view class="point-title">{{i18n.content(item.name,locale,localeTranslations,localeOriginal)}}</view><view class="muted gap">{{i18n.content(item.total,locale,localeTranslations,localeOriginal)}} {{i18n.ui('分钟 ·',locale)}} {{i18n.ui(item.measured?'实走校准':'估算时间',locale)}}</view><button size="mini" wx:for="{{item.stops}}" wx:key="id" wx:for-item="stop" class="small gap" data-id="{{stop.id}}" bindtap="place">{{i18n.content(stop.name,locale,localeTranslations,localeOriginal)}} ↗</button><view class="warning" wx:if="{{!item.available}}">{{i18n.content(item.reason,locale,localeTranslations,localeOriginal)}}</view><button class="primary gap" data-id="{{item.id}}" bindtap="start" disabled="{{!item.available||busy}}">{{i18n.ui('开始这段探索',locale)}}</button></view></block><block wx:else><view class="card"><view class="row between"><text>{{i18n.ui('状态：',locale)}}{{i18n.content(session.status,locale,localeTranslations,localeOriginal)}}</text><text>{{i18n.content(elapsedText,locale,localeTranslations,localeOriginal)}}</text></view><view class="row wrap gap"><button data-action="pause" bindtap="action" wx:if="{{session.status==='active'}}">{{i18n.ui('暂停',locale)}}</button><button data-action="resume" bindtap="action" wx:if="{{session.status==='paused'}}">{{i18n.ui('继续',locale)}}</button><button data-action="finish" bindtap="action" disabled="{{!canFinish||busy}}">{{i18n.ui('完成探索',locale)}}</button><button data-action="exit" bindtap="action">{{i18n.ui('结束并保存手记',locale)}}</button></view><view class="row between gap"><text>{{i18n.ui('记录本次私人轨迹',locale)}}</text><switch checked="{{recording}}" bindchange="recording" disabled="{{session.status!=='active'}}"/></view><view class="muted">{{i18n.ui('仅本页前台、活动探索期间记录，切换页面自动停止，可随手记一并删除。',locale)}}</view><view wx:if="{{trackError}}" class="warning">{{i18n.content(trackError,locale,localeTranslations,localeOriginal)}}</view><view wx:if="{{session.blocked.length}}" class="warning">{{i18n.ui('部分地点已下线，请按提示结束或重新选择。',locale)}}</view></view><view wx:for="{{session.tasks}}" wx:key="id" class="card"><view class="pill">{{i18n.ui(item.status==='done'?'已完成':item.status==='skipped'?'已跳过':'待完成',locale)}}</view><view class="point-title gap">{{i18n.content(item.pointName,locale,localeTranslations,localeOriginal)}} · {{i18n.content(item.title,locale,localeTranslations,localeOriginal)}}</view><remote-image wx:if="{{item.photo}}" source="{{item.photo}}"/><button size="mini" wx:if="{{item.photo}}" class="small danger" data-id="{{item.id}}" bindtap="clearPhoto">{{i18n.ui('移除任务照片',locale)}}</button><text wx:for="{{item.steps}}" wx:for-item="step" wx:key="index" class="copy">{{i18n.content(step,locale,localeTranslations,localeOriginal)}}</text><view class="row wrap gap"><button size="mini" class="small" data-id="{{item.pointId}}" bindtap="place">{{i18n.ui('地点详情',locale)}}</button><button size="mini" class="small" data-id="{{item.pointId}}" bindtap="navigate">{{i18n.ui('导航',locale)}}</button><button size="mini" class="small" data-id="{{item.pointId}}" wx:if="{{features['publishing'].visible!==false}}" bindtap="checkin">{{i18n.ui('真实打卡',locale)}}</button></view><view class="row wrap gap"><button size="mini" class="small primary" data-action="task" data-id="{{item.id}}" data-status="done" bindtap="action" disabled="{{busy||session.status!=='active'}}">{{i18n.ui('完成任务',locale)}}</button><button size="mini" class="small" data-action="task" data-id="{{item.id}}" data-status="skipped" bindtap="action">{{i18n.ui('跳过',locale)}}</button><button size="mini" class="small" data-id="{{item.id}}" bindtap="photo">{{i18n.ui('任务照片',locale)}}</button></view></view><textarea value="{{reason}}" data-key="reason" bindinput="field" placeholder-class="field-placeholder" placeholder="{{i18n.ui('如需跳过，请说明原因',locale)}}"/><textarea value="{{feedback}}" data-key="feedback" bindinput="field" placeholder-class="field-placeholder" placeholder="{{i18n.ui('私人体验感受',locale)}}"/><button class="gap" data-action="feedback" bindtap="action">{{i18n.ui('保存感受',locale)}}</button></block><state-view error="{{error}}" loading="{{loading}}" bind:retry="load"/></view><canvas type="2d" id="journey-photo" class="compression-canvas"/>

</block>
<experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>

<reward-overlay id="reward-overlay812" items="{{nativeRewardItems812}}" bind:dismiss="dismissNativeRewards812" bind:impact="nativeImpact812"/>
