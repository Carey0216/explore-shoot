<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{themeClass}}" style="{{themeStyle}}">
<view wx:if="{{featureBlocked}}" class="page"><view class="empty" role="status">功能正在维护中，敬请期待…</view></view><block wx:else>
<view class="page"><view class="title">{{session?session.routeName:'校园探索路线'}}</view><view class="muted gap">路线时间包含余量。开放与通行以现场为准，不将完成任务视为真实打卡。</view><block wx:if="{{!session}}"><view class="card"><view class="row between"><text>时间预算</text><picker range="{{[15,20,30]}}" data-key="budget" bindchange="pick"><view class="picker">{{budget}} 分钟 ⌄</view></picker></view><picker range="{{['轻松','适中']}}" data-key="intensity" bindchange="intensityPick"><view class="picker">步行强度：{{intensity}}</view></picker><picker range="{{[1,2]}}" data-key="people" bindchange="pick"><view class="picker">{{people}} 人 ⌄</view></picker><picker range="{{['全部','建筑','自然','人文','运动']}}" data-key="theme" bindchange="pick"><view class="picker">{{theme}} ⌄</view></picker><picker range="{{['引导探索','固定路线','自由拍摄']}}" data-key="mode" bindchange="pick"><view class="picker">{{mode==='guide'?'引导探索':mode==='personal'?'自由拍摄':'固定路线'}} ⌄</view></picker><input value="{{query}}" data-key="query" bindinput="field" placeholder-class="field-placeholder" placeholder="搜索路线或途经地点"/><button class="primary" bindtap="load">查看可用路线</button></view><view wx:for="{{items}}" wx:key="id" class="card"><view class="point-title">{{item.name}}</view><view class="muted gap">{{item.total}} 分钟 · {{item.measured?'实走校准':'估算时间'}}</view><button size="mini" wx:for="{{item.stops}}" wx:key="id" wx:for-item="stop" class="small gap" data-id="{{stop.id}}" bindtap="place">{{stop.name}} ↗</button><view class="warning" wx:if="{{!item.available}}">{{item.reason}}</view><button class="primary gap" data-id="{{item.id}}" bindtap="start" disabled="{{!item.available||busy}}">开始这段探索</button></view></block><block wx:else><view class="card"><view class="row between"><text>状态：{{session.status}}</text><text>{{elapsedText}}</text></view><view class="row wrap gap"><button data-action="pause" bindtap="action" wx:if="{{session.status==='active'}}">暂停</button><button data-action="resume" bindtap="action" wx:if="{{session.status==='paused'}}">继续</button><button data-action="finish" bindtap="action" disabled="{{!canFinish||busy}}">完成探索</button><button data-action="exit" bindtap="action">结束并保存手记</button></view><view class="row between gap"><text>记录本次私人轨迹</text><switch checked="{{recording}}" bindchange="recording" disabled="{{session.status!=='active'}}"/></view><view class="muted">仅本页前台、活动探索期间记录，切换页面自动停止，可随手记一并删除。</view><view wx:if="{{trackError}}" class="warning">{{trackError}}</view><view wx:if="{{session.blocked.length}}" class="warning">部分地点已下线，请按提示结束或重新选择。</view></view><view wx:for="{{session.tasks}}" wx:key="id" class="card"><view class="pill">{{item.status==='done'?'已完成':item.status==='skipped'?'已跳过':'待完成'}}</view><view class="point-title gap">{{item.pointName}} · {{item.title}}</view><remote-image wx:if="{{item.photo}}" source="{{item.photo}}"/><button size="mini" wx:if="{{item.photo}}" class="small danger" data-id="{{item.id}}" bindtap="clearPhoto">移除任务照片</button><text wx:for="{{item.steps}}" wx:for-item="step" wx:key="index" class="copy">{{step}}</text><view class="row wrap gap"><button size="mini" class="small" data-id="{{item.pointId}}" bindtap="place">地点详情</button><button size="mini" class="small" data-id="{{item.pointId}}" bindtap="navigate">导航</button><button size="mini" class="small" data-id="{{item.pointId}}" wx:if="{{features['publishing'].visible!==false}}" bindtap="checkin">真实打卡</button></view><view class="row wrap gap"><button size="mini" class="small primary" data-action="task" data-id="{{item.id}}" data-status="done" bindtap="action" disabled="{{busy||session.status!=='active'}}">完成任务</button><button size="mini" class="small" data-action="task" data-id="{{item.id}}" data-status="skipped" bindtap="action">跳过</button><button size="mini" class="small" data-id="{{item.id}}" bindtap="photo">任务照片</button></view></view><textarea value="{{reason}}" data-key="reason" bindinput="field" placeholder-class="field-placeholder" placeholder="如需跳过，请说明原因"/><textarea value="{{feedback}}" data-key="feedback" bindinput="field" placeholder-class="field-placeholder" placeholder="私人体验感受"/><button class="gap" data-action="feedback" bindtap="action">保存感受</button></block><state-view error="{{error}}" loading="{{loading}}" bind:retry="load"/></view><canvas type="2d" id="journey-photo" class="compression-canvas"/>

</block>
<experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>
