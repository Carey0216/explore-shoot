<wxs src="/services/i18n.wxs" module="i18n"/>
<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || nativeOverlayOpen || editor || viewer || finderOpen ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{locale==='en-US'?'locale-en':''}} {{themeClass}} {{nativeImpact812?'native-impact812':''}}" style="{{themeStyle}}">
<view wx:if="{{localeTranslated}}" class="locale-note"><text>{{i18n.ui(localeTranslationUnavailable?'内容翻译暂时不可用，当前显示原文。':'内容由机器翻译，原文始终保留。',locale)}}</text><button bindtap="localeToggleOriginal">{{i18n.ui(localeOriginal?'显示译文':'查看原文',locale)}}</button></view><view class="locale-auth-action"><language-picker class="language-picker-host" id="language-picker" administrator="{{true}}"/></view>

<view class="page console-page console-{{activeGroup}}"><view class="console-head"><view><image class="jingyu-wordmark console-wordmark" src="/assets/brand/jingyu-{{themeDark ? 'dark' : 'light'}}.png" mode="aspectFit" aria-label="{{i18n.ui('景遇校园',locale)}}"/><text class="eyebrow">{{i18n.ui(account.role==='owner'?'顶级管理员':'管理工作台',locale)}}</text><view class="title">{{i18n.content(title,locale,localeTranslations,localeOriginal)}}</view></view><view class="console-head-actions"><button class="admin-avatar81" bindtap="toggleAccount" aria-label="{{i18n.ui('我的账号',locale)}}"><image wx:if="{{accountAvatar}}" src="{{accountAvatar}}" mode="aspectFill"/><text wx:else>{{i18n.content(accountInitial,locale,localeTranslations,localeOriginal)}}</text></button><button size="mini" class="small" bindtap="findFunctions">{{i18n.ui('找功能',locale)}}</button><button size="mini" class="small" bindtap="replay">{{i18n.ui('引导',locale)}}</button></view></view><button class="module-switch812" bindtap="toggleModuleMenu812">{{i18n.ui('切换栏目',locale)}} · {{i18n.content(title,locale,localeTranslations,localeOriginal)}} ⌄</button><view wx:if="{{moduleMenuOpen812}}" class="console-subnav"><button wx:for="{{entries}}" wx:key="id" class="{{module===item.id?'active':''}}" data-id="{{item.id}}" bindtap="openModule"><image class="module-icon812" src="{{i18n.icon(item.icon,themeDark)}}" mode="aspectFit"/>{{i18n.content(item.title,locale,localeTranslations,localeOriginal)}}</button></view><state-view loading="{{loading}}" error="{{error}}" bind:retry="load"/>
<block wx:if="{{module==='overview'}}"><view class="summary-grid"><view wx:for="{{summary}}" wx:key="title" class="card"><text class="summary-value">{{i18n.content(item.value,locale,localeTranslations,localeOriginal)}}</text><text class="muted">{{i18n.content(item.title,locale,localeTranslations,localeOriginal)}}</text></view></view><view wx:for="{{groups}}" wx:key="id" class="card function-section group-{{item.id}}"><view class="point-title">{{i18n.content(item.title,locale,localeTranslations,localeOriginal)}}</view><view class="entry-grid"><button wx:for="{{item.entries}}" wx:for-item="entry" wx:key="id" data-id="{{entry.id}}" bindtap="openModule"><image class="module-icon812" src="{{i18n.icon(entry.icon,themeDark)}}" mode="aspectFit"/>{{i18n.content(entry.title,locale,localeTranslations,localeOriginal)}} ↗</button></view></view></block>
<view wx:if="{{module==='updates'}}" class="card"><view class="point-title">{{i18n.ui('管理端更新说明',locale)}}</view><text class="copy">{{i18n.content(readBody,locale,localeTranslations,localeOriginal)}}</text><text class="muted">{{i18n.ui('新版本日志自动生成草稿；只有顶管检查并发布后才投递用户和管理端。',locale)}}</text></view>
<block wx:if="{{module!=='overview'}}"><view class="console-toolbar"><input wx:if="{{!isConfig}}" value="{{query}}" data-key="query" bindinput="field" placeholder-class="field-placeholder" placeholder="{{i18n.ui('搜索当前栏目',locale)}}" bindconfirm="load"/><button size="mini" wx:if="{{!isConfig}}" class="small" bindtap="load">{{i18n.ui('搜索',locale)}}</button><button wx:if="{{canCreate}}" class="primary" bindtap="create">{{i18n.ui('＋ 新建',locale)}}</button><button wx:if="{{module==='map-config'}}" bindtap="create">{{i18n.ui('验证并查看配置',locale)}}</button></view><picker wx:if="{{module==='review-queue'}}" range="{{i18n.options(reviewKinds,locale)}}" range-key="title" bindchange="reviewKind"><view class="picker">{{i18n.ui('审核类型：',locale)}}{{i18n.content(reviewKindLabel,locale,localeTranslations,localeOriginal)}} ⌄</view></picker><picker wx:if="{{module==='review-queue'}}" range="{{i18n.options(reviewStates,locale)}}" range-key="title" bindchange="reviewState"><view class="picker gap">{{i18n.ui('状态：',locale)}}{{i18n.content(reviewStatusLabel,locale,localeTranslations,localeOriginal)}} ⌄</view></picker><view wx:if="{{module==='audit'}}" class="card"><picker range="{{i18n.options(recordKinds,locale)}}" range-key="title" data-key="recordKind" bindchange="recordFilter"><view class="picker">{{i18n.ui(recordKind==='audit'?'操作记录':'路线校验',locale)}} ⌄</view></picker><picker range="{{i18n.options(recordCategories,locale)}}" range-key="title" data-key="recordCategory" bindchange="recordFilter"><view class="picker gap">{{i18n.content(recordCategoryLabel,locale,localeTranslations,localeOriginal)}} ⌄</view></picker><picker range="{{i18n.options(recordRoles,locale)}}" range-key="title" data-key="recordRole" bindchange="recordFilter"><view class="picker gap">{{i18n.content(recordRoleLabel,locale,localeTranslations,localeOriginal)}} ⌄</view></picker><picker mode="date" value="{{recordFrom}}" data-key="recordFrom" bindchange="recordFilter"><view class="picker gap">{{i18n.ui('从：',locale)}}{{i18n.ui(recordFrom||'不限日期',locale)}}</view></picker><picker mode="date" value="{{recordTo}}" data-key="recordTo" bindchange="recordFilter"><view class="picker gap">{{i18n.ui('至：',locale)}}{{i18n.ui(recordTo||'不限日期',locale)}}</view></picker><button size="mini" class="small gap" bindtap="resetRecords">{{i18n.ui('清空筛选',locale)}}</button><button class="gap" wx:if="{{account.role==='owner'}}" bindtap="deleteRecords">{{i18n.ui('移出所选记录',locale)}}</button></view><view wx:if="{{module==='review-queue'&&canWrite}}" class="row gap"><button class="primary" data-action="approve" bindtap="batch">{{i18n.ui('通过所选',locale)}}</button><button data-action="reject" bindtap="batch">{{i18n.ui('不通过所选',locale)}}</button></view><checkbox-group bindchange="selection"><view wx:for="{{visibleRows}}" wx:key="id" class="card console-row"><label wx:if="{{module==='review-queue'||(module==='audit'&&account.role==='owner')}}" class="check-row"><checkbox disabled="{{module==='review-queue'&&!item.pending}}" value="{{item.id}}" checked="{{selectedMap[item.id]}}"/><text>{{i18n.ui('选择',locale)}}</text></label><image wx:if="{{item.badge}}" class="badge-preview" src="{{item.badge}}"/><remote-image wx:if="{{item.photo}}" source="{{item.photo}}" administrator/><button wx:if="{{module==='buildings' && account.role==='owner'}}" class="small" size="mini" data-id="{{item.id}}" bindtap="redrawBuilding">{{i18n.ui('重画轮廓',locale)}}</button><view class="row between"><view class="point-title">{{i18n.content(item.title,locale,localeTranslations,localeOriginal)}}</view><text class="pill">{{i18n.content(item.status,locale,localeTranslations,localeOriginal)}}</text></view><text wx:if="{{item.username}}" class="muted">@{{item.username}}</text><text wx:if="{{item.time}}" class="muted">{{i18n.ui(module==='users'?'加入时间：':'',locale)}}{{i18n.content(item.time,locale,localeTranslations,localeOriginal)}}</text><text wx:if="{{item.identity}}" class="identity">{{i18n.ui('探索官身份：',locale)}}{{i18n.content(item.identity,locale,localeTranslations,localeOriginal)}}</text><text class="copy">{{i18n.content(item.description,locale,localeTranslations,localeOriginal)}}</text><view class="row wrap gap"><button size="mini" class="small" data-id="{{item.id}}" bindtap="viewRecord">{{i18n.ui('查看详情',locale)}}</button><button size="mini" wx:if="{{canWrite&&module!=='audit'&&module!=='review-queue'}}" class="small" data-id="{{item.id}}" bindtap="edit">{{i18n.ui(module==='updates'?'检查 / 修改 / 发布':'管理',locale)}}</button><button size="mini" wx:if="{{module==='admins'&&account.role==='owner'}}" class="small" data-id="{{item.id}}" bindtap="permissions">{{i18n.ui('单账号功能授权',locale)}}</button><button size="mini" wx:if="{{module==='points'&&canStatistics}}" class="small" data-id="{{item.id}}" bindtap="popularity">{{i18n.ui('展示热度',locale)}}</button><button size="mini" wx:if="{{module==='users'}}" class="small" data-id="{{item.id}}" bindtap="contact">{{i18n.ui('建立联系',locale)}}</button></view></view></checkbox-group><button wx:if="{{next||hasMore}}" class="gap" bindtap="more">{{i18n.ui('加载更多',locale)}}</button><view wx:if="{{!rows.length&&!loading&&!isConfig}}" class="empty">{{i18n.ui('暂时没有记录',locale)}}</view><view wx:if="{{module==='settings'}}" class="card"><view class="row between"><text>{{i18n.ui('语言 / Language',locale)}}</text><language-picker class="language-picker-host" id="language-picker" administrator="{{true}}"/></view><button bindtap="editAvatar">{{i18n.ui('编辑我的头像',locale)}}</button><button class="gap" bindtap="create">{{i18n.ui('编辑我的账号资料',locale)}}</button><button wx:if="{{account.role==='owner'}}" class="gap" bindtap="ownerAccount">{{i18n.ui('顶管登录账号与密码',locale)}}</button><view class="point-title gap">{{i18n.ui('外观',locale)}}</view><picker range="{{i18n.options(['跟随系统','浅色','深色'],locale)}}" value="{{appearanceIndex}}" bindchange="appearance"><view class="picker">{{i18n.ui(['跟随系统','浅色','深色'][appearanceIndex],locale)}} ⌄</view></picker><button wx:if="{{account.role==='owner'}}" class="gap" bindtap="runtime">{{i18n.ui('查看运行指标',locale)}}</button><view wx:if="{{runtimeSummary}}" class="card"><view class="point-title">{{i18n.ui('运行与恢复',locale)}}</view><view class="gap">{{i18n.ui('接口请求 / 异常',locale)}}：{{runtimeSummary.requests}} / {{runtimeSummary.errors}}</view><view class="gap">{{i18n.ui('图片加载失败（网页 / 小程序）',locale)}}：{{runtimeSummary.operations.clientFailures['web:image-failed']||0}} / {{runtimeSummary.operations.clientFailures['mini:image-failed']||0}}</view><view class="gap">{{i18n.ui('天气接口',locale)}}：{{i18n.ui(runtimeSummary.operations.weather.status==='ok'?'正常':runtimeSummary.operations.weather.status==='unavailable'?'暂不可用':'本次尚未请求',locale)}}</view><view class="gap">{{i18n.ui('最近备份',locale)}}：{{runtimeSummary.operations.backup.createdAt||i18n.ui('暂无回执',locale)}}</view><view class="gap">{{i18n.ui('恢复演练',locale)}}：{{runtimeSummary.operations.backup.restoreVerifiedAt||i18n.ui('尚未演练',locale)}}</view><view class="muted gap">{{i18n.content(runtimeSummary.operations.notice,locale,localeTranslations,localeOriginal)}}</view></view><text wx:if="{{readBody}}" class="copy">{{i18n.content(readBody,locale,localeTranslations,localeOriginal)}}</text><button class="gap danger" bindtap="logout">{{i18n.ui('退出管理账号',locale)}}</button></view></block></view>
<view wx:if="{{finderOpen}}" class="editor-mask"><view class="editor-dialog"><view class="editor-head"><text>{{i18n.ui('想管理什么？',locale)}}</text><button size="mini" bindtap="closeFunctions" aria-label="{{i18n.ui('关闭功能搜索',locale)}}">×</button></view><input class="function-search" placeholder="{{i18n.ui('搜索活动、用户、通知、地图…',locale)}}" value="{{functionQuery}}" bindinput="searchFunctions"/><scroll-view scroll-y enhanced class="editor-scroll"><view wx:for="{{functionGroups}}" wx:key="id" class="function-section group-{{item.id}}"><view class="point-title">{{i18n.content(item.title,locale,localeTranslations,localeOriginal)}}</view><view class="entry-grid"><button wx:for="{{item.entries}}" wx:for-item="entry" wx:key="id" data-id="{{entry.id}}" bindtap="openModule"><image class="module-icon812" src="{{i18n.icon(entry.icon,themeDark)}}" mode="aspectFit"/>{{i18n.content(entry.title,locale,localeTranslations,localeOriginal)}} ↗</button></view></view><view wx:if="{{!functionGroups.length}}" class="empty">{{i18n.ui('没有匹配的功能',locale)}}</view></scroll-view></view></view>
<view class="admin-dock"><button wx:for="{{groups}}" wx:key="id" class="{{activeGroup===item.id?'active':''}}" data-id="{{item.id}}" bindtap="group"><image src="{{i18n.icon(item.icon,themeDark || theme==='theme-dark')}}"/><text>{{i18n.content(item.title,locale,localeTranslations,localeOriginal)}}</text></button></view>
<view wx:if="{{editor}}" class="editor-mask"><view class="editor-dialog"><view class="editor-head"><text>{{i18n.content(editor.title,locale,localeTranslations,localeOriginal)}}</text><button size="mini" aria-label="{{i18n.ui('关闭编辑窗口',locale)}}" bindtap="closeEditor" disabled="{{busy}}">×</button></view><scroll-view scroll-y enhanced class="editor-scroll"><text class="muted editor-hint">{{i18n.content(editor.hint,locale,localeTranslations,localeOriginal)}}</text><form-editor id="editor-fields" fields="{{formFields}}" administrator busy="{{busy||editor.readonly}}"/><text wx:if="{{formError}}" class="warning">{{i18n.content(formError,locale,localeTranslations,localeOriginal)}}</text><text wx:if="{{previewText}}" class="preview-copy">{{i18n.content(previewText,locale,localeTranslations,localeOriginal)}}</text><view class="editor-buttons"><block wx:if="{{editor.kind==='sdk'||editor.kind==='mini-sdk'}}"><button data-mode="web" bindtap="mapConfiguration">{{i18n.ui('网页地图 SDK',locale)}}</button><button data-mode="mini" bindtap="mapConfiguration">{{i18n.ui('小程序地图服务',locale)}}</button></block><button wx:if="{{editor.kind==='map-model'}}" bindtap="previewModel">{{i18n.ui('查看模型与位置预览',locale)}}</button><button wx:for="{{editor.actions}}" wx:key="*this" data-action="{{item}}" bindtap="save" disabled="{{busy}}" class="{{item==='publish'||item==='save'?'primary':''}}">{{i18n.ui(item==='save'?'确认保存':item==='draft'?'存草稿':item==='preview'?'预览':item==='publish'?'检查并发布':'停止投放',locale)}}</button><button wx:if="{{module==='celebrations'}}" bindtap="previewEffect">{{i18n.ui('预览彩纸',locale)}}</button><button wx:if="{{canDelete&&editor.kind!=='delete-prepare'&&editor.kind!=='delete-commit'}}" class="danger" bindtap="remove" disabled="{{busy}}">{{i18n.ui('删除',locale)}}</button></view></scroll-view></view></view>

<view wx:if="{{viewer}}" class="editor-mask"><view class="editor-dialog"><view class="editor-head"><text>{{i18n.content(viewer.title,locale,localeTranslations,localeOriginal)}}</text><button size="mini" bindtap="closeViewer" aria-label="{{i18n.ui('关闭详情',locale)}}">×</button></view><scroll-view scroll-y class="editor-scroll"><view wx:for="{{viewer.fields}}" wx:key="label" class="read-field"><text class="muted">{{i18n.content(item.label,locale,localeTranslations,localeOriginal)}}</text><text selectable class="copy">{{i18n.content(item.value,locale,localeTranslations,localeOriginal)}}</text></view></scroll-view></view></view><experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{true}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>

<account-menu theme="{{themeClass}}" styles="{{themeStyle}}" open="{{accountMenuOpen}}" account="{{account}}" avatar="{{accountAvatar}}" administrator bind:close="closeAccount" bind:home="accountHome" bind:profile="accountProfile" bind:avatar="editAvatar" bind:settings="accountSettings" bind:logout="logout"/>

<reward-overlay id="reward-overlay812" items="{{nativeRewardItems812}}" bind:dismiss="dismissNativeRewards812" bind:impact="nativeImpact812"/>
