<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || nativeOverlayOpen || editor || viewer ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{themeClass}}" style="{{themeStyle}}">

<view class="page console-page"><view class="console-head"><view><text class="eyebrow">ADMIN / {{account.role==='owner'?'顶级管理员':'管理工作台'}}</text><view class="title">{{title}}</view></view><button size="mini" class="small" bindtap="replay">引导</button></view><view class="console-subnav"><button wx:for="{{entries}}" wx:key="id" class="{{module===item.id?'active':''}}" data-id="{{item.id}}" bindtap="openModule">{{item.title}}</button></view><state-view loading="{{loading}}" error="{{error}}" bind:retry="load"/>
<block wx:if="{{module==='overview'}}"><view class="summary-grid"><view wx:for="{{summary}}" wx:key="title" class="card"><text class="summary-value">{{item.value}}</text><text class="muted">{{item.title}}</text></view></view><view wx:for="{{groups}}" wx:key="id" class="card"><view class="point-title">{{item.title}}</view><view class="entry-grid"><button wx:for="{{item.entries}}" wx:for-item="entry" wx:key="id" data-id="{{entry.id}}" bindtap="openModule">{{entry.title}} ↗</button></view></view></block>
<view wx:if="{{module==='updates'}}" class="card"><view class="point-title">管理端更新说明</view><text class="copy">{{readBody}}</text><text class="muted">新版本日志自动生成草稿；只有顶管检查并发布后才投递用户和管理端。</text></view>
<block wx:if="{{module!=='overview'}}"><view class="console-toolbar"><input wx:if="{{!isConfig}}" value="{{query}}" data-key="query" bindinput="field" placeholder-class="field-placeholder" placeholder="搜索当前栏目" bindconfirm="load"/><button size="mini" wx:if="{{!isConfig}}" class="small" bindtap="load">搜索</button><button wx:if="{{canCreate}}" class="primary" bindtap="create">＋ 新建</button><button wx:if="{{module==='map-config'}}" bindtap="create">验证并查看配置</button></view><picker wx:if="{{module==='review-queue'}}" range="{{reviewKinds}}" range-key="title" bindchange="reviewKind"><view class="picker">审核类型：{{reviewKindLabel}} ⌄</view></picker><picker wx:if="{{module==='review-queue'}}" range="{{reviewStates}}" range-key="title" bindchange="reviewState"><view class="picker gap">状态：{{reviewStatusLabel}} ⌄</view></picker><view wx:if="{{module==='audit'}}" class="card"><picker range="{{recordKinds}}" range-key="title" data-key="recordKind" bindchange="recordFilter"><view class="picker">{{recordKind==='audit'?'操作记录':'路线校验'}} ⌄</view></picker><picker range="{{recordCategories}}" range-key="title" data-key="recordCategory" bindchange="recordFilter"><view class="picker gap">{{recordCategoryLabel}} ⌄</view></picker><picker range="{{recordRoles}}" range-key="title" data-key="recordRole" bindchange="recordFilter"><view class="picker gap">{{recordRoleLabel}} ⌄</view></picker><picker mode="date" value="{{recordFrom}}" data-key="recordFrom" bindchange="recordFilter"><view class="picker gap">从：{{recordFrom||'不限日期'}}</view></picker><picker mode="date" value="{{recordTo}}" data-key="recordTo" bindchange="recordFilter"><view class="picker gap">至：{{recordTo||'不限日期'}}</view></picker><button size="mini" class="small gap" bindtap="resetRecords">清空筛选</button><button class="gap" wx:if="{{account.role==='owner'}}" bindtap="deleteRecords">移出所选记录</button></view><view wx:if="{{module==='review-queue'&&canWrite}}" class="row gap"><button class="primary" data-action="approve" bindtap="batch">通过所选</button><button data-action="reject" bindtap="batch">不通过所选</button></view><checkbox-group bindchange="selection"><view wx:for="{{visibleRows}}" wx:key="id" class="card console-row"><label wx:if="{{module==='review-queue'||(module==='audit'&&account.role==='owner')}}" class="check-row"><checkbox disabled="{{module==='review-queue'&&!item.pending}}" value="{{item.id}}" checked="{{selectedMap[item.id]}}"/><text>选择</text></label><image wx:if="{{item.badge}}" class="badge-preview" src="{{item.badge}}"/><remote-image wx:if="{{item.photo}}" source="{{item.photo}}" administrator/><button wx:if="{{module==='buildings' && account.role==='owner'}}" class="small" size="mini" data-id="{{item.id}}" bindtap="redrawBuilding">重画轮廓</button><view class="row between"><view class="point-title">{{item.title}}</view><text class="pill">{{item.status}}</text></view><text wx:if="{{item.username}}" class="muted">@{{item.username}}</text><text wx:if="{{item.time}}" class="muted">{{module==='users'?'加入时间：':''}}{{item.time}}</text><text wx:if="{{item.identity}}" class="identity">探索官身份：{{item.identity}}</text><text class="copy">{{item.description}}</text><view class="row wrap gap"><button size="mini" class="small" data-id="{{item.id}}" bindtap="viewRecord">查看详情</button><button size="mini" wx:if="{{canWrite&&module!=='audit'&&module!=='review-queue'}}" class="small" data-id="{{item.id}}" bindtap="edit">{{module==='updates'?'检查 / 修改 / 发布':'管理'}}</button><button size="mini" wx:if="{{module==='admins'&&account.role==='owner'}}" class="small" data-id="{{item.id}}" bindtap="permissions">单账号功能授权</button><button size="mini" wx:if="{{module==='points'&&canStatistics}}" class="small" data-id="{{item.id}}" bindtap="popularity">展示热度</button><button size="mini" wx:if="{{module==='users'}}" class="small" data-id="{{item.id}}" bindtap="contact">建立联系</button></view></view></checkbox-group><button wx:if="{{next||hasMore}}" class="gap" bindtap="more">加载更多</button><view wx:if="{{!rows.length&&!loading&&!isConfig}}" class="empty">暂时没有记录</view><view wx:if="{{module==='settings'}}" class="card"><button bindtap="editAvatar">编辑我的头像</button><button class="gap" bindtap="create">编辑我的账号资料</button><button wx:if="{{account.role==='owner'}}" class="gap" bindtap="ownerAccount">顶管登录账号与密码</button><view class="point-title gap">外观</view><picker range="{{['跟随系统','浅色','深色']}}" value="{{appearanceIndex}}" bindchange="appearance"><view class="picker">{{['跟随系统','浅色','深色'][appearanceIndex]}} ⌄</view></picker><button class="gap" bindtap="runtime">查看运行指标</button><text wx:if="{{readBody}}" class="copy">{{readBody}}</text><button class="gap danger" bindtap="logout">退出管理账号</button></view></block></view>
<view class="admin-dock"><button wx:for="{{groups}}" wx:key="id" class="{{activeGroup===item.id?'active':''}}" data-id="{{item.id}}" bindtap="group"><image src="/assets/tools/{{item.icon}}.png"/><text>{{item.title}}</text></button></view>
<view wx:if="{{editor}}" class="editor-mask"><view class="editor-dialog"><view class="editor-head"><text>{{editor.title}}</text><button size="mini" aria-label="关闭编辑窗口" bindtap="closeEditor" disabled="{{busy}}">×</button></view><scroll-view scroll-y enhanced class="editor-scroll"><text class="muted editor-hint">{{editor.hint}}</text><form-editor id="editor-fields" fields="{{formFields}}" administrator busy="{{busy||editor.readonly}}"/><text wx:if="{{formError}}" class="warning">{{formError}}</text><text wx:if="{{previewText}}" class="preview-copy">{{previewText}}</text><view class="editor-buttons"><block wx:if="{{editor.kind==='sdk'||editor.kind==='mini-sdk'}}"><button data-mode="web" bindtap="mapConfiguration">网页地图 SDK</button><button data-mode="mini" bindtap="mapConfiguration">小程序地图服务</button></block><button wx:if="{{editor.kind==='map-model'}}" bindtap="previewModel">查看模型与位置预览</button><button wx:for="{{editor.actions}}" wx:key="*this" data-action="{{item}}" bindtap="save" disabled="{{busy}}" class="{{item==='publish'||item==='save'?'primary':''}}">{{item==='save'?'确认保存':item==='draft'?'存草稿':item==='preview'?'预览':item==='publish'?'检查并发布':'停止投放'}}</button><button wx:if="{{module==='celebrations'}}" bindtap="previewEffect">预览彩纸</button><button wx:if="{{canDelete&&editor.kind!=='delete-prepare'&&editor.kind!=='delete-commit'}}" class="danger" bindtap="remove" disabled="{{busy}}">删除</button></view></scroll-view></view></view>

<view wx:if="{{viewer}}" class="editor-mask"><view class="editor-dialog"><view class="editor-head"><text>{{viewer.title}}</text><button size="mini" bindtap="closeViewer" aria-label="关闭详情">×</button></view><scroll-view scroll-y class="editor-scroll"><view wx:for="{{viewer.fields}}" wx:key="label" class="read-field"><text class="muted">{{item.label}}</text><text selectable class="copy">{{item.value}}</text></view></scroll-view></view></view><experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{true}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>
