<wxs src="/services/i18n.wxs" module="i18n"/>
<page-meta page-style="{{pageStyle}} {{preview||editor?'overflow:hidden;':''}}"/>
<view class="native-surface {{locale==='en-US'?'locale-en':''}} {{themeClass}}" style="{{themeStyle}}">
<view wx:if="{{localeTranslated}}" class="locale-note"><text>{{i18n.ui('内容由机器翻译，原文始终保留。',locale)}}</text><button bindtap="localeToggleOriginal">{{i18n.ui(localeOriginal?'显示译文':'查看原文',locale)}}</button></view><view class="page"><button class="quiet-button73" bindtap="back">← {{i18n.ui('管理工作台',locale)}}</button>
<block wx:if="{{mode==='preflight'}}"><view class="title gap">{{i18n.ui('先检查，再发布',locale)}}</view><view class="muted gap">{{i18n.ui('集中核对图片、开放时间、英文校订与链接。只展示当前账号有权维护的内容。',locale)}}</view><view class="preflight-summary81 gap" wx:if="{{summary}}">{{summary.resources}} {{i18n.ui('项内容',locale)}} · {{summary.errors}} {{i18n.ui('个明确问题',locale)}} · {{summary.warnings}} {{i18n.ui('项待补充',locale)}}</view><button class="primary gap" bindtap="run" disabled="{{loading}}">{{i18n.ui('运行完整预检',locale)}}</button><picker range="{{i18n.options(filters,locale)}}" value="{{filter}}" bindchange="filter"><view class="picker gap">{{i18n.ui(filters[filter],locale)}} ⌄</view></picker><view class="card gap" wx:for="{{checks}}" wx:key="url"><view>{{i18n.content(item.message,locale,localeTranslations,localeOriginal)}}</view><text class="muted">{{i18n.content(item.url,locale,localeTranslations,localeOriginal)}}</text></view><view class="card preflight-row81 gap" wx:for="{{rows}}" wx:key="key"><text class="muted">{{i18n.ui(item.typeLabel,locale)}} · {{i18n.ui(item.published?'已发布':'草稿 / 未发布',locale)}}</text><view class="point-title gap">{{i18n.content(item.title||'未填写标题',locale,localeTranslations,localeOriginal)}}</view><view class="preflight-issue81" wx:for="{{item.issues}}" wx:for-item="issue" wx:key="code">{{i18n.content(issue.message,locale,localeTranslations,localeOriginal)}}</view><view class="button-row gap"><button data-key="{{item.key}}" bindtap="preview">{{i18n.ui('手机 / 桌面预览',locale)}}</button><button wx:if="{{item.editable}}" data-key="{{item.key}}" bindtap="edit">{{i18n.ui('编辑英文内容',locale)}}</button></view></view></block>
<block wx:else><view class="title gap">{{i18n.ui('校园天气与拍摄预报',locale)}}</view><view class="muted gap">{{i18n.ui('统一查询校园公共位置，不上传用户定位。',locale)}} Open-Meteo</view><view class="card gap" wx:if="{{config}}"><view class="field"><text>{{i18n.ui('显示位置名称',locale)}}</text><input data-key="label" value="{{config.label}}" bindinput="field" maxlength="30"/></view><view class="field"><text>{{i18n.ui('纬度',locale)}}</text><input data-key="latitude" type="digit" value="{{config.latitude}}" bindinput="field"/></view><view class="field"><text>{{i18n.ui('经度',locale)}}</text><input data-key="longitude" type="digit" value="{{config.longitude}}" bindinput="field"/></view><view class="field"><text>{{i18n.ui('缓存分钟',locale)}}</text><input data-key="refreshMinutes" type="number" value="{{config.refreshMinutes}}" bindinput="field"/></view><button class="primary gap" bindtap="save" loading="{{busy}}">{{i18n.ui('保存天气配置',locale)}}</button><button class="gap" bindtap="test">{{i18n.ui('检查天气接口',locale)}}</button><view class="muted gap">{{i18n.content(testResult,locale,localeTranslations,localeOriginal)}}</view></view></block><state-view error="{{error}}" loading="{{loading}}" bind:retry="load"/></view>
<view wx:if="{{preview||editor}}" class="popover-backdrop" bindtap="close"><view class="preflight-modal81 {{desktop?'desktop':''}}" catchtap="noop"><view class="row between"><view class="point-title">{{i18n.ui(editor?'校订英文内容':'发布前内容预览',locale)}}</view><button class="tiny" bindtap="close">×</button></view><scroll-view scroll-y class="preflight-scroll81"><block wx:if="{{preview}}"><view class="button-row gap"><button bindtap="size">{{i18n.ui(desktop?'切换手机':'切换桌面',locale)}}</button><button bindtap="language">{{i18n.ui(english?'简体中文':'English',locale)}}</button></view><view class="muted gap">{{i18n.ui('这是内容排版预览，不会发布草稿或增加浏览统计。',locale)}}</view><view class="preflight-frame81 {{desktop?'desktop-frame':''}}"><remote-image wx:if="{{preview.photo}}" source="{{preview.photo}}" administrator mode="aspectFit"/><view class="title gap">{{i18n.content(english?(preview.english.title||preview.title):preview.title,locale,localeTranslations,localeOriginal)}}</view><view class="muted gap">{{i18n.content(preview.subtitle,locale,localeTranslations,localeOriginal)}}</view><text class="copy gap">{{i18n.content(english?(preview.english.body||preview.body):preview.body,locale,localeTranslations,localeOriginal)}}</text></view></block><block wx:else><view class="field"><text>English title</text><input data-key="title" value="{{editor.english.title}}" bindinput="field" maxlength="160"/></view><view class="field"><text>English copy</text><textarea data-key="body" value="{{editor.english.body}}" bindinput="field" maxlength="4000" auto-height/></view><button class="primary gap" bindtap="save" loading="{{busy}}">{{i18n.ui('保存英文校订',locale)}}</button></block></scroll-view></view></view></view>
