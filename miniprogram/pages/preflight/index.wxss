@import '../../app.wxss';
.preflight-summary81 {
  padding: calc(var(--jy-rpx, 1rpx) * 24);
  border-radius: calc(var(--jy-rpx, 1rpx) * 24);
  background: var(--raised, #eaf1f6);
  font-size: calc(var(--jy-rpx, 1rpx) * 24);
}
.preflight-row81 {
  padding: calc(var(--jy-rpx, 1rpx) * 30);
}
.preflight-issue81 {
  font-size: calc(var(--jy-rpx, 1rpx) * 25);
  line-height: 1.8;
  margin-top: calc(var(--jy-rpx, 1rpx) * 16);
  color: var(--muted, #70818f);
}
.preflight-modal81 {
  width: calc(100vw - calc(var(--jy-rpx, 1rpx) * 48));
  max-height: 85vh;
  border-radius: calc(var(--jy-rpx, 1rpx) * 36);
  padding: calc(var(--jy-rpx, 1rpx) * 28);
  box-sizing: border-box;
  background: var(--surface, #fff);
  display: flex;
  flex-direction: column;
}
.preflight-scroll81 {
  height: 60vh;
}
.preflight-frame81 {
  padding: calc(var(--jy-rpx, 1rpx) * 24);
  max-width: 390px;
  margin: calc(var(--jy-rpx, 1rpx) * 20) auto;
  border: calc(var(--jy-rpx, 1rpx) * 1) solid var(--line, #d8e4ed);
  border-radius: calc(var(--jy-rpx, 1rpx) * 28);
}
.preflight-frame81 remote-image {
  display: block;
  width: 100%;
  height: calc(var(--jy-rpx, 1rpx) * 360);
}
.desktop-frame {
  width: 900px;
  max-width: none;
  transform: scale(0.33);
  transform-origin: left top;
  margin-bottom: -300px;
}
.preflight-modal81 .copy {
  display: block;
  white-space: pre-wrap;
  line-height: 1.85;
}
