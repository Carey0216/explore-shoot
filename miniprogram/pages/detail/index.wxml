<view class="page">
  <state-view loading="{{loading}}" error="{{error}}" bind:retry="load"/>
  <block wx:if="{{point}}">
    <view class="photo hero" data-photo="{{point.cover}}" bindtap="preview"><remote-image source="{{point.cover}}" full/></view>
    <view class="row between gap"><view class="title grow">{{point.name}}</view><button class="small" bindtap="bookmark">{{saved ? '已收藏' : '收藏'}}</button></view>
    <view class="muted gap">{{point.description}}</view>
    <view wx:if="{{!point.open}}" class="warning">此地点暂未开放打卡</view>
    <view class="row gap"><button class="small {{point.myReaction === 'like' ? 'primary' : ''}}" bindtap="like" disabled="{{reactionBusy}}">👍 喜欢 {{point.likeCount || 0}}</button><button class="small {{point.myReaction === 'dislike' ? 'danger' : ''}}" bindtap="dislike" disabled="{{reactionBusy}}">👎 {{point.myReaction === 'dislike' ? '已标记不喜欢' : '不喜欢'}}</button><button class="small" open-type="share">分享</button></view>
    <view class="section-title">拍摄站位</view>
    <scroll-view scroll-x class="scroll-chips"><view wx:for="{{spots}}" wx:key="id" class="pill {{spot.id === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectSpot">{{item.title}}</view></scroll-view>
    <view wx:if="{{spot}}" class="card">
      <view wx:if="{{spot.photo}}" class="photo" data-photo="{{spot.photo}}" bindtap="preview"><remote-image source="{{spot.photo}}" full/></view>
      <view class="point-title gap">{{spot.title}}</view><view class="gap">{{spot.standDescription}}</view>
      <view class="muted gap">拍摄朝向：{{spot.bearing}}°（正北为 0°）</view><view class="muted">适合时间：{{spot.bestTime}}</view>
      <view class="warning">{{spot.availabilityText}}<view>{{spot.openingHours || '开放时间待补充'}}</view><view wx:if="{{spot.accessNotice}}">{{spot.accessNotice}}</view></view>
    </view>
    <view wx:else class="muted">尚未发布独立机位；地点坐标只能帮助找到附近位置。</view>
    <view class="row gap"><button class="grow" bindtap="navigate">去这里</button><button class="grow primary" bindtap="checkin" disabled="{{!point.open || spot.availability === 'closed'}}">拍照打卡</button></view>
    <view class="section-title">机位作品墙</view><view class="muted">仅展示作者主动公开并经审核的照片</view>
    <view wx:for="{{works}}" wx:key="id" class="card point-card"><view class="photo" data-photo="{{item.photo}}" bindtap="preview"><remote-image source="{{item.photo}}"/></view><view class="point-copy"><view>{{item.caption}}</view><view class="row between gap"><text class="muted">{{item.authorName}}</text><button class="small" data-id="{{item.id}}" bindtap="report">举报</button></view></view></view>
    <view wx:if="{{!works.length && !wallBusy}}" class="empty">还没有公开作品</view><button wx:if="{{next}}" bindtap="moreWorks" loading="{{wallBusy}}">查看更多</button>
  </block>
  <view wx:if="{{dislikeOpen}}" class="popover-backdrop" bindtap="closeDislike"><view class="dislike-popover" catchtap="noop"><view class="point-title">确认不喜欢该作品？</view><view class="muted gap">标选为“不喜欢”的作品将会被移至最底部噢</view><button class="danger gap" bindtap="confirmDislike">确认不喜欢</button></view></view>
</view>
