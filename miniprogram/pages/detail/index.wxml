<wxs src="/services/i18n.wxs" module="i18n"/>
<page-meta page-style="{{pageStyle}} {{publicOverlayOpen || dockOverlayOpen || nativeOverlayOpen || dislikeOpen ? 'overflow:hidden;' : ''}}"/>
<view class="native-surface {{locale==='en-US'?'locale-en':''}} {{themeClass}}" style="{{themeStyle}}">
<view wx:if="{{localeTranslated}}" class="locale-note"><text>{{i18n.ui(localeTranslationUnavailable?'内容翻译暂时不可用，当前显示原文。':'内容由机器翻译，原文始终保留。',locale)}}</text><button bindtap="localeToggleOriginal">{{i18n.ui(localeOriginal?'显示译文':'查看原文',locale)}}</button></view>

<view class="page detail-page">
  <state-view loading="{{loading}}" error="{{error}}" bind:retry="load"/>
  <view wx:if="{{offline}}" class="warning">{{i18n.ui('当前为离线公开资料，通行信息可能已变化；联网后刷新核实。',locale)}}</view>
  <block wx:if="{{point}}">
    <button size="mini" class="hero-back" bindtap="back" aria-label="{{i18n.ui('返回',locale)}}">‹</button><button size="mini" class="hero-share" bindtap="share" aria-label="{{i18n.ui('分享地点',locale)}}"><image src="/assets/tools/share{{themeDark ? '-dark' : ''}}.png"/></button><view class="photo hero" data-photo="{{point.photo}}" bindtap="preview"><remote-image id="detail-photo" source="{{point.photo}}" full mode="aspectFill" eager/></view>
    <view wx:if="{{point.photoIsReference}}" class="muted">{{i18n.ui('校园参考配图 · 非该机位实拍',locale)}}</view>
    <view class="detail-content"><view class="row between gap"><view class="title grow">{{i18n.content(point.name,locale,localeTranslations,localeOriginal)}}</view><button size="mini" class="small" wx:if="{{features['bookmarks'].visible!==false}}" bindtap="bookmark">{{i18n.ui(saved ? '已收藏' : '收藏',locale)}}</button></view>
    <view class="muted gap">{{i18n.content(point.description,locale,localeTranslations,localeOriginal)}}</view>
    <view wx:if="{{!point.open}}" class="warning">{{i18n.ui('此地点暂未开放打卡',locale)}}</view>
    <view class="row gap"><button size="mini" class="small {{point.myReaction === 'like' ? 'primary' : ''}}" wx:if="{{features['reactions'].visible!==false}}" bindtap="like" disabled="{{reactionBusy}}">👍 {{i18n.content(point.likeCount || 0,locale,localeTranslations,localeOriginal)}}</button><button size="mini" class="small {{point.myReaction === 'dislike' ? 'danger' : ''}}" wx:if="{{features['reactions'].visible!==false}}" bindtap="dislike" disabled="{{reactionBusy}}">👎</button><button size="mini" class="small" bindtap="share">{{i18n.ui('分享',locale)}}</button></view>
    <view class="address-card"><view><view>{{i18n.ui(point.address||'北方民族大学校园内',locale)}}</view><text class="muted">{{i18n.ui('通行与开放以现场为准',locale)}}</text></view><button size="mini" class="small" bindtap="navigate">{{i18n.ui('导航 ↗',locale)}}</button></view><view class="section-title">{{i18n.ui('拍摄站位',locale)}}</view>
    <scroll-view scroll-x class="scroll-chips"><view wx:for="{{spots}}" wx:key="id" class="pill {{spot.id === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectSpot">{{i18n.content(item.title,locale,localeTranslations,localeOriginal)}}</view></scroll-view>
    <view wx:if="{{spot}}" class="card">
      <view wx:if="{{spot.photo}}" class="photo" data-photo="{{spot.photo}}" bindtap="preview"><remote-image source="{{spot.photo}}" full/></view>
      <view class="point-title gap">{{i18n.content(spot.title,locale,localeTranslations,localeOriginal)}}</view><view class="gap">{{i18n.content(spot.standDescription,locale,localeTranslations,localeOriginal)}}</view>
      <view wx:if="{{spot.compositionTip}}" class="gap">{{i18n.ui('构图建议：',locale)}}{{i18n.content(spot.compositionTip,locale,localeTranslations,localeOriginal)}}</view><view wx:if="{{spot.verifiedAt}}" class="muted gap">{{i18n.ui('资料核验：',locale)}}{{i18n.content(spot.verifiedAt,locale,localeTranslations,localeOriginal)}} {{i18n.ui('· 以现场情况为准',locale)}}</view><view class="muted gap">{{i18n.ui('拍摄朝向：',locale)}}{{i18n.content(spot.bearing,locale,localeTranslations,localeOriginal)}}{{i18n.ui('°（正北为 0°）',locale)}}</view><view class="muted">{{i18n.ui('适合时间：',locale)}}{{i18n.content(spot.bestTime,locale,localeTranslations,localeOriginal)}}</view><view class="muted gap">{{i18n.ui(spot.heightMeters?'建议镜头距地 '+spot.heightMeters+' 米':'建议高度待维护',locale)}} {{i18n.content(spot.heightAdvice,locale,localeTranslations,localeOriginal)}}</view><view class="row gap"><button size="mini" wx:if="{{features.framing.visible!==false}}" class="small" bindtap="framing">{{i18n.ui('取景辅助',locale)}}</button><button size="mini" wx:if="{{features.plans.visible!==false}}" class="small" bindtap="plan" disabled="{{offline}}">{{i18n.ui('加入拍摄清单',locale)}}</button></view>
      <view class="warning">{{i18n.content(spot.availabilityText,locale,localeTranslations,localeOriginal)}}<view>{{i18n.ui(spot.openingHours || '开放时间待补充',locale)}}</view><view wx:if="{{spot.accessNotice}}">{{i18n.content(spot.accessNotice,locale,localeTranslations,localeOriginal)}}</view></view>
    </view>
    <view wx:else class="muted">{{i18n.ui('尚未发布独立机位；地点坐标只能帮助找到附近位置。',locale)}}</view>
    <photo-workspace spot="{{spot}}" features="{{features}}" theme="{{themeClass}}" styles="{{themeStyle}}"/><view wx:if="{{!spot}}" class="row gap detail-actions"><button class="grow" bindtap="navigate">{{i18n.ui('去这里',locale)}}</button><button class="grow primary activity-checkin" wx:if="{{features['publishing'].visible!==false}}" bindtap="checkin" disabled="{{!point.open || spot.availability === 'closed'}}">{{i18n.ui('拍照打卡',locale)}}</button></view>
<block wx:if="{{features['work-wall'].visible!==false}}">    <button wx:if="{{spot}}" class="gap" bindtap="compare">{{i18n.ui('同一机位 · 季节 / 时段对比 ↗',locale)}}</button><view class="section-title">{{i18n.ui('机位作品墙',locale)}}</view><view class="muted">{{i18n.ui('仅展示作者主动公开并经审核的照片',locale)}}</view>
    <view wx:for="{{works}}" wx:key="id" class="card point-card"><view class="photo" data-photo="{{item.photo}}" bindtap="preview"><remote-image source="{{item.photo}}"/></view><view class="point-copy"><view>{{i18n.content(item.caption,locale,localeTranslations,localeOriginal)}}</view><view wx:if="{{item.experience.takenAt || item.experience.device || item.experience.focalLength || item.experience.tips}}" class="experience-card gap"><view>{{i18n.ui('拍摄经验 · 作者自填',locale)}}</view><view class="muted">{{i18n.content(item.experienceTime,locale,localeTranslations,localeOriginal)}} {{i18n.content(item.experience.device,locale,localeTranslations,localeOriginal)}} {{i18n.content(item.experience.focalLength,locale,localeTranslations,localeOriginal)}}</view><view>{{i18n.content(item.experience.tips,locale,localeTranslations,localeOriginal)}}</view></view><view class="row between gap"><text class="muted">{{item.authorName}}</text><button size="mini" class="small" data-id="{{item.id}}" wx:if="{{features['feedback'].visible!==false}}" bindtap="report">{{i18n.ui('举报',locale)}}</button></view></view></view>
    <view wx:if="{{!works.length && !wallBusy}}" class="empty">{{i18n.ui('还没有公开作品',locale)}}</view><button wx:if="{{next}}" bindtap="moreWorks" loading="{{wallBusy}}">{{i18n.ui('查看更多',locale)}}</button>
</block>  </view></block>
  <view wx:if="{{dislikeOpen}}" class="popover-backdrop" bindtap="closeDislike"><view class="dislike-popover" catchtap="noop"><view class="point-title">{{i18n.ui('确认不喜欢该作品？',locale)}}</view><view class="muted gap">{{i18n.ui('标选为“不喜欢”的作品将会被移至最底部噢',locale)}}</view><button class="danger gap" bindtap="confirmDislike">{{i18n.ui('确认不喜欢',locale)}}</button></view></view>
</view>

<site-overlay id="site-overlay" content="{{siteContent}}" runtime="{{runtime}}" announcement="{{announcement}}" page="detail" bind:dismiss="dismissPublicOverlay" bind:overlay="publicOverlay"/>

<experience-layer features="{{features}}" id="experience" page="{{nativePage}}" account="{{nativeAccount}}" administrator="{{false}}" theme="{{themeClass}}" styles="{{themeStyle}}" avatar="{{preferences.assistantAvatar}}" bind:overlay="nativeOverlay"/>
</view>
