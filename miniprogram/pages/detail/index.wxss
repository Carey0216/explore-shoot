.popover-backdrop {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(22, 38, 30, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: calc(var(--jy-rpx, 1rpx) * 50);
}
.dislike-popover {
  width: 100%;
  max-width: calc(var(--jy-rpx, 1rpx) * 600);
  padding: calc(var(--jy-rpx, 1rpx) * 38);
  background: var(--surface, #fff);
  color: var(--text, #25374a);
  border: calc(var(--jy-rpx, 1rpx) * 2) solid var(--line, #d8e4ed);
  border-radius: calc(var(--jy-rpx, 1rpx) * 48);
  box-shadow: 0 calc(var(--jy-rpx, 1rpx) * 28) calc(var(--jy-rpx, 1rpx) * 100)
    rgba(30, 50, 40, 0.18);
  animation: expand 0.18s ease-out;
}
@keyframes expand {
  from {
    opacity: 0;
    transform: scale(0.92);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.detail-page {
  padding: 0 0 calc(calc(var(--jy-rpx, 1rpx) * 160) + env(safe-area-inset-bottom));
}
.detail-content {
  position: relative;
  margin-top: calc(var(--jy-rpx, 1rpx) * -36);
  border-radius: calc(var(--jy-rpx, 1rpx) * 40) calc(var(--jy-rpx, 1rpx) * 40) 0 0;
  background: var(--surface);
  padding: calc(var(--jy-rpx, 1rpx) * 36) calc(var(--jy-rpx, 1rpx) * 30)
    calc(var(--jy-rpx, 1rpx) * 80);
}
.detail-content > .title {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 44) * var(--font-scale, 1));
}
.detail-page .hero-back,
.detail-page .hero-share {
  position: absolute;
  top: calc(var(--jy-rpx, 1rpx) * 24);
  z-index: 10;
  width: calc(var(--jy-rpx, 1rpx) * 80);
  height: calc(var(--jy-rpx, 1rpx) * 80);
  border-radius: 50%;
  padding: calc(var(--jy-rpx, 1rpx) * 18);
  background: #20283099;
  color: #fff;
  border-color: #ffffff44;
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 50) * var(--font-scale, 1));
  line-height: 1;
}
.hero-back {
  left: calc(var(--jy-rpx, 1rpx) * 25);
}
.hero-share {
  right: calc(var(--jy-rpx, 1rpx) * 25);
}
.hero-share image {
  width: calc(var(--jy-rpx, 1rpx) * 40);
  height: calc(var(--jy-rpx, 1rpx) * 40);
}
.address-card {
  display: flex;
  gap: calc(var(--jy-rpx, 1rpx) * 20);
  justify-content: space-between;
  align-items: center;
  border-radius: calc(var(--jy-rpx, 1rpx) * 28);
  background: var(--raised);
  padding: calc(var(--jy-rpx, 1rpx) * 25);
  margin: calc(var(--jy-rpx, 1rpx) * 26) 0;
  line-height: 1.7;
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 26) * var(--font-scale, 1));
}
.address-card > view {
  flex: 1;
  min-width: 0;
}
.detail-actions {
  position: fixed;
  left: 0;
  right: 0;
  width: calc(100% - 24px);
  max-width: var(--jy-dock-max, 456px);
  box-sizing: border-box;
  margin: 0 auto;
  bottom: calc(calc(var(--jy-rpx, 1rpx) * 20) + env(safe-area-inset-bottom));
  z-index: 80;
  gap: calc(var(--jy-rpx, 1rpx) * 20);
  padding: calc(var(--jy-rpx, 1rpx) * 14);
  background: var(--dock);
  border: calc(var(--jy-rpx, 1rpx) * 1) solid var(--line);
  border-radius: calc(var(--jy-rpx, 1rpx) * 50);
}
.detail-actions button {
  border-radius: calc(var(--jy-rpx, 1rpx) * 40);
  flex: 1;
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 28) * var(--font-scale, 1));
}
.detail-page .photo.hero remote-image {
  height: 100%;
}

.detail-page .hero {
  margin: calc(var(--jy-rpx, 1rpx) * 24) calc(var(--jy-rpx, 1rpx) * 28) 0;
  border-radius: calc(var(--jy-rpx, 1rpx) * 36);
}
.detail-page .detail-content {
  margin-top: 0;
  border-radius: 0;
  padding-top: calc(var(--jy-rpx, 1rpx) * 36);
}
.detail-page .detail-content .title {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 46) * var(--font-scale, 1));
  line-height: 1.35;
}

.detail-page {
  position: relative;
}
.detail-page .hero-back,
.detail-page .hero-share {
  top: calc(var(--jy-rpx, 1rpx) * 44);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  min-height: calc(var(--jy-rpx, 1rpx) * 80);
  line-height: 1;
}
.detail-page .hero-back {
  left: calc(var(--jy-rpx, 1rpx) * 48);
}
.detail-page .hero-share {
  right: calc(var(--jy-rpx, 1rpx) * 48);
}

/* Override the legacy global auto-height rule only for the bounded detail hero. */
.detail-page .photo.hero {
  height: 32vh !important;
  min-height: 0 !important;
  max-height: 320px;
  overflow: hidden !important;
  width: auto;
}

.native-surface .detail-title821 {
  align-items: flex-start;
  gap: calc(var(--jy-rpx, 1rpx) * 20);
}
.native-surface .detail-title821 .title {
  font-size: calc(var(--jy-rpx, 1rpx) * 40);
  line-height: 1.4;
  min-width: 0;
}
.native-surface .button-icon {
  width: calc(var(--jy-rpx, 1rpx) * 36);
  height: calc(var(--jy-rpx, 1rpx) * 36);
  flex: none;
  margin-right: calc(var(--jy-rpx, 1rpx) * 12);
}
.native-surface .detail-actions button {
  flex: 1;
  width: 0;
  padding: calc(var(--jy-rpx, 1rpx) * 16) calc(var(--jy-rpx, 1rpx) * 12);
  gap: calc(var(--jy-rpx, 1rpx) * 8);
}
.native-surface .detail-actions .button-icon {
  margin-right: 0;
}
.theme-light .detail-actions .primary .button-icon {
  filter: brightness(0) invert(1);
}
.theme-dark .detail-actions .primary .button-icon {
  filter: brightness(0.55);
}
