.compose-page {
  padding: 24rpx 36rpx 60rpx;
}
.compose-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 12rpx 0 30rpx;
  font-size: calc(31rpx * var(--font-scale, 1));
}
.preview-action {
  font-size: calc(27rpx * var(--font-scale, 1));
  color: #44715d;
}
.compose-photo {
  min-height: 380rpx;
  border: 2rpx solid white;
  border-radius: 48rpx;
  background:
    radial-gradient(circle at 15% 15%, #f4ead8, transparent 55%),
    linear-gradient(130deg, #dfede3, #e8e4f3);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  overflow: hidden;
  color: #567964;
}
.compose-photo image {
  width: 100%;
  height: auto;
}
.camera-glyph {
  position: relative;
  width: 64rpx;
  height: 46rpx;
  border: 4rpx solid #769b83;
  border-radius: 9rpx;
  margin: 16rpx 0 10rpx;
}
.camera-glyph::before {
  content: '';
  position: absolute;
  width: 26rpx;
  height: 8rpx;
  border: 4rpx solid #769b83;
  border-bottom: none;
  border-radius: 6rpx 6rpx 0 0;
  top: -12rpx;
  left: 14rpx;
}
.camera-lens {
  width: 21rpx;
  height: 21rpx;
  border: 4rpx solid #769b83;
  border-radius: 50%;
  margin: 8rpx auto;
}
.photo-title {
  font-size: calc(36rpx * var(--font-scale, 1));
  margin: 20rpx 0;
}
.photo-hint {
  font-size: calc(23rpx * var(--font-scale, 1));
  color: #81937f;
  padding: 18rpx;
}
.compose-caption {
  font-size: calc(21rpx * var(--font-scale, 1));
  color: #99a698;
  text-align: center;
  margin: 25rpx 0 38rpx;
}
.compose-title {
  font-size: calc(42rpx * var(--font-scale, 1));
  font-weight: 600;
  border-bottom: 1rpx solid #dce5dc;
  padding: 22rpx 0;
  height: 66rpx;
}
.compose-description {
  width: 100%;
  min-height: 230rpx;
  height: 250rpx;
  font-size: calc(29rpx * var(--font-scale, 1));
  line-height: 1.9;
  padding: 28rpx 0;
}
.compose-tags {
  display: flex;
  gap: 15rpx;
  flex-wrap: wrap;
  margin: 15rpx 0 30rpx;
}
.compose-tag {
  font-size: calc(24rpx * var(--font-scale, 1));
  padding: 16rpx 25rpx;
  background: #e7eee9aa;
  border-radius: 22rpx;
  color: #7d927f;
}
.compose-tag.active {
  background: #d2e9da;
  color: #326a51;
}
.compose-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  border-top: 1rpx solid #e0e8dd;
  padding: 33rpx 0;
  color: #56715c;
  font-size: calc(27rpx * var(--font-scale, 1));
}
.row-symbol {
  font-size: calc(40rpx * var(--font-scale, 1));
}
.row-copy {
  flex: 1;
  min-width: 0;
}
.row-hint {
  font-size: calc(22rpx * var(--font-scale, 1));
  color: #93a08e;
  line-height: 1.7;
  margin-top: 9rpx;
  word-break: break-all;
}
.picker-map {
  width: 100%;
  height: 480rpx;
  border-radius: 30rpx;
}
.compose-condition {
  width: 100%;
  font-size: calc(27rpx * var(--font-scale, 1));
  line-height: 1.8;
  background: #fff9;
  border-radius: 25rpx;
  box-sizing: border-box;
  padding: 20rpx;
}
.compose-actions {
  position: sticky;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 15rpx;
  background: #f8fbf2eb;
  backdrop-filter: blur(18px);
  border-radius: 36rpx;
  border: 2rpx solid white;
  margin-top: 35rpx;
}
.save-draft {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx;
  font-size: calc(38rpx * var(--font-scale, 1));
  color: #6b816c;
}
.save-draft text {
  font-size: calc(20rpx * var(--font-scale, 1));
  margin-top: 5rpx;
}
.compose-submit {
  flex: 1;
  border-radius: 35rpx;
  background: linear-gradient(130deg, #e88083, #d65a88);
  color: white;
  font-size: calc(29rpx * var(--font-scale, 1));
}
.draft-note {
  font-size: calc(22rpx * var(--font-scale, 1));
  color: #829783;
  margin-top: 15rpx;
}
.offscreen {
  position: fixed;
  left: -3000px;
  top: -3000px;
  width: 320px;
  height: 320px;
}
.preview-backdrop {
  position: fixed;
  inset: 0;
  z-index: 9000;
  background: #284d3b69;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx;
  backdrop-filter: blur(12px);
}
.preview-panel {
  max-height: 84vh;
  width: 100%;
  border-radius: 42rpx;
  background: #f9fcf5;
  padding: 30rpx;
  box-sizing: border-box;
}
.preview-heading {
  font-size: calc(28rpx * var(--font-scale, 1));
  margin-bottom: 22rpx;
  color: #7d907a;
}
.preview-image {
  width: 100%;
  border-radius: 28rpx;
}
.preview-title {
  font-size: calc(38rpx * var(--font-scale, 1));
  font-weight: 600;
  margin: 25rpx 0;
}
.preview-description {
  font-size: calc(29rpx * var(--font-scale, 1));
  line-height: 1.8;
  white-space: pre-wrap;
}
.preview-panel button {
  margin-top: 30rpx;
  color: #285f47;
  border-radius: 28rpx;
}

.preview-panel {
  height: 80vh;
  background: var(--surface);
  color: var(--text);
}
.preview-backdrop {
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}
.preview-heading,
.row-hint {
  color: var(--muted);
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18rpx;
  margin: 24rpx 0;
}
.photo-cell {
  position: relative;
  min-width: 0;
}
.photo-cell image {
  width: 100%;
  height: 190rpx;
  border-radius: 24rpx;
  display: block;
}
.photo-label {
  display: block;
  text-align: center;
  padding: 10rpx 0;
  color: var(--muted);
  font-size: 22rpx;
}
.photo-remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  padding: 0;
  margin: 0;
  width: 60rpx;
  min-width: 60rpx;
  height: 60rpx;
  min-height: 60rpx;
  line-height: 60rpx;
  color: #fff;
  background: #707784ce;
  border-radius: 50%;
  font-size: 32rpx;
}
.photo-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  width: 100%;
  height: 190rpx;
  margin: 0;
  padding: 12rpx;
  border: 1rpx dashed var(--line);
  background: var(--raised);
  border-radius: 24rpx;
  color: var(--muted);
}
.photo-add text:first-child {
  font-size: 56rpx;
}
.photo-add text:last-child {
  font-size: 23rpx;
}
.photo-confirm {
  position: absolute;
  z-index: 10;
  top: 45rpx;
  right: -2rpx;
  width: 260rpx;
  padding: 20rpx;
  background: var(--surface);
  color: var(--text);
  border: 1rpx solid var(--line);
  border-radius: 22rpx;
  box-shadow: 0 12rpx 35rpx #0002;
  font-size: 23rpx;
}
.photo-confirm view {
  display: flex;
  gap: 8rpx;
  margin-top: 14rpx;
}
.photo-confirm button {
  width: auto;
  flex: 1;
  padding: 10rpx;
  min-height: 60rpx;
  font-size: 23rpx;
  margin: 0;
}
.photo-confirm button:last-child {
  color: var(--danger, #b33f57);
}
.photo-viewer {
  width: 100%;
  max-height: 90vh;
  padding: 24rpx;
  box-sizing: border-box;
  border-radius: 32rpx;
  background: var(--surface);
}
.photo-viewer image {
  width: 100%;
  height: 55vh;
}
.photo-viewer-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.photo-viewer-head button {
  width: 80rpx;
  min-width: 80rpx;
  margin: 0;
  padding: 0;
}

.photo-confirm-mask {
  position: fixed;
  inset: 0;
  z-index: 9900;
  background: transparent;
}
.native-surface .photo-confirm {
  position: absolute;
  right: auto;
  max-width: calc(100vw - 24px);
  padding: 36rpx 32rpx 28rpx;
  border: 1rpx solid var(--line);
  border-radius: 46rpx;
  background: var(--surface);
  box-shadow: 0 22rpx 80rpx #0003;
  box-sizing: border-box;
}
.photo-confirm-title {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
}
.photo-confirm-copy {
  display: block;
  color: var(--muted);
  font-size: 23rpx;
  line-height: 1.6;
  margin: 14rpx 0 26rpx;
}
.native-surface .photo-confirm button {
  width: 100%;
  min-height: 76rpx;
  margin: 0;
  border: 0;
  border-radius: 38rpx;
  background: var(--raised);
  color: var(--danger);
  font-size: 28rpx;
}

.photo-confirm .photo-confirm-title {
  display: block;
  margin: 0;
}
