.compose-page {
  padding: calc(var(--jy-rpx, 1rpx) * 24) calc(var(--jy-rpx, 1rpx) * 36)
    calc(var(--jy-rpx, 1rpx) * 60);
}
.compose-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: calc(var(--jy-rpx, 1rpx) * 12) 0 calc(var(--jy-rpx, 1rpx) * 30);
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 31) * var(--font-scale, 1));
}
.preview-action {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 27) * var(--font-scale, 1));
  color: #44715d;
}
.compose-photo {
  min-height: calc(var(--jy-rpx, 1rpx) * 380);
  border: calc(var(--jy-rpx, 1rpx) * 2) solid white;
  border-radius: calc(var(--jy-rpx, 1rpx) * 48);
  background:
    radial-gradient(circle at 15% 15%, #f4ead8, transparent 55%),
    linear-gradient(130deg, #dfede3, #e8e4f3);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  overflow: hidden;
  color: #567964;
}
.compose-photo image {
  width: 100%;
  height: auto;
}
.camera-glyph {
  position: relative;
  width: calc(var(--jy-rpx, 1rpx) * 64);
  height: calc(var(--jy-rpx, 1rpx) * 46);
  border: calc(var(--jy-rpx, 1rpx) * 4) solid #769b83;
  border-radius: calc(var(--jy-rpx, 1rpx) * 9);
  margin: calc(var(--jy-rpx, 1rpx) * 16) 0 calc(var(--jy-rpx, 1rpx) * 10);
}
.camera-glyph::before {
  content: '';
  position: absolute;
  width: calc(var(--jy-rpx, 1rpx) * 26);
  height: calc(var(--jy-rpx, 1rpx) * 8);
  border: calc(var(--jy-rpx, 1rpx) * 4) solid #769b83;
  border-bottom: none;
  border-radius: calc(var(--jy-rpx, 1rpx) * 6) calc(var(--jy-rpx, 1rpx) * 6) 0 0;
  top: calc(var(--jy-rpx, 1rpx) * -12);
  left: calc(var(--jy-rpx, 1rpx) * 14);
}
.camera-lens {
  width: calc(var(--jy-rpx, 1rpx) * 21);
  height: calc(var(--jy-rpx, 1rpx) * 21);
  border: calc(var(--jy-rpx, 1rpx) * 4) solid #769b83;
  border-radius: 50%;
  margin: calc(var(--jy-rpx, 1rpx) * 8) auto;
}
.photo-title {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 36) * var(--font-scale, 1));
  margin: calc(var(--jy-rpx, 1rpx) * 20) 0;
}
.photo-hint {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 23) * var(--font-scale, 1));
  color: #81937f;
  padding: calc(var(--jy-rpx, 1rpx) * 18);
}
.compose-caption {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 21) * var(--font-scale, 1));
  color: #99a698;
  text-align: center;
  margin: calc(var(--jy-rpx, 1rpx) * 25) 0 calc(var(--jy-rpx, 1rpx) * 38);
}
.compose-title {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 42) * var(--font-scale, 1));
  font-weight: 600;
  border-bottom: calc(var(--jy-rpx, 1rpx) * 1) solid #dce5dc;
  padding: calc(var(--jy-rpx, 1rpx) * 22) 0;
  height: calc(var(--jy-rpx, 1rpx) * 66);
}
.compose-description {
  width: 100%;
  min-height: calc(var(--jy-rpx, 1rpx) * 230);
  height: calc(var(--jy-rpx, 1rpx) * 250);
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 29) * var(--font-scale, 1));
  line-height: 1.9;
  padding: calc(var(--jy-rpx, 1rpx) * 28) 0;
}
.compose-tags {
  display: flex;
  gap: calc(var(--jy-rpx, 1rpx) * 15);
  flex-wrap: wrap;
  margin: calc(var(--jy-rpx, 1rpx) * 15) 0 calc(var(--jy-rpx, 1rpx) * 30);
}
.compose-tag {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 24) * var(--font-scale, 1));
  padding: calc(var(--jy-rpx, 1rpx) * 16) calc(var(--jy-rpx, 1rpx) * 25);
  background: #e7eee9aa;
  border-radius: calc(var(--jy-rpx, 1rpx) * 22);
  color: #7d927f;
}
.compose-tag.active {
  background: #d2e9da;
  color: #326a51;
}
.compose-row {
  display: flex;
  align-items: center;
  gap: calc(var(--jy-rpx, 1rpx) * 24);
  border-top: calc(var(--jy-rpx, 1rpx) * 1) solid #e0e8dd;
  padding: calc(var(--jy-rpx, 1rpx) * 33) 0;
  color: #56715c;
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 27) * var(--font-scale, 1));
}
.row-symbol {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 40) * var(--font-scale, 1));
}
.row-copy {
  flex: 1;
  min-width: 0;
}
.row-hint {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 22) * var(--font-scale, 1));
  color: #93a08e;
  line-height: 1.7;
  margin-top: calc(var(--jy-rpx, 1rpx) * 9);
  word-break: break-all;
}
.picker-map {
  width: 100%;
  height: calc(var(--jy-rpx, 1rpx) * 480);
  border-radius: calc(var(--jy-rpx, 1rpx) * 30);
}
.compose-condition {
  width: 100%;
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 27) * var(--font-scale, 1));
  line-height: 1.8;
  background: #fff9;
  border-radius: calc(var(--jy-rpx, 1rpx) * 25);
  box-sizing: border-box;
  padding: calc(var(--jy-rpx, 1rpx) * 20);
}
.compose-actions {
  position: sticky;
  bottom: calc(calc(var(--jy-rpx, 1rpx) * 20) + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: calc(var(--jy-rpx, 1rpx) * 24);
  padding: calc(var(--jy-rpx, 1rpx) * 15);
  background: #f8fbf2eb;
  backdrop-filter: blur(18px);
  border-radius: calc(var(--jy-rpx, 1rpx) * 36);
  border: calc(var(--jy-rpx, 1rpx) * 2) solid white;
  margin-top: calc(var(--jy-rpx, 1rpx) * 35);
}
.save-draft {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: calc(var(--jy-rpx, 1rpx) * 10);
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 38) * var(--font-scale, 1));
  color: #6b816c;
}
.save-draft text {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 20) * var(--font-scale, 1));
  margin-top: calc(var(--jy-rpx, 1rpx) * 5);
}
.compose-submit {
  flex: 1;
  border-radius: calc(var(--jy-rpx, 1rpx) * 35);
  background: linear-gradient(130deg, #e88083, #d65a88);
  color: white;
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 29) * var(--font-scale, 1));
}
.draft-note {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 22) * var(--font-scale, 1));
  color: #829783;
  margin-top: calc(var(--jy-rpx, 1rpx) * 15);
}
.offscreen {
  position: fixed;
  left: -3000px;
  top: -3000px;
  width: 320px;
  height: 320px;
}
.preview-backdrop {
  position: fixed;
  inset: 0;
  z-index: 9000;
  background: #284d3b69;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: calc(var(--jy-rpx, 1rpx) * 28);
  backdrop-filter: blur(12px);
}
.preview-panel {
  max-height: 84vh;
  width: 100%;
  border-radius: calc(var(--jy-rpx, 1rpx) * 42);
  background: #f9fcf5;
  padding: calc(var(--jy-rpx, 1rpx) * 30);
  box-sizing: border-box;
}
.preview-heading {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 28) * var(--font-scale, 1));
  margin-bottom: calc(var(--jy-rpx, 1rpx) * 22);
  color: #7d907a;
}
.preview-image {
  width: 100%;
  border-radius: calc(var(--jy-rpx, 1rpx) * 28);
}
.preview-title {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 38) * var(--font-scale, 1));
  font-weight: 600;
  margin: calc(var(--jy-rpx, 1rpx) * 25) 0;
}
.preview-description {
  font-size: calc(calc(var(--jy-rpx, 1rpx) * 29) * var(--font-scale, 1));
  line-height: 1.8;
  white-space: pre-wrap;
}
.preview-panel button {
  margin-top: calc(var(--jy-rpx, 1rpx) * 30);
  color: #285f47;
  border-radius: calc(var(--jy-rpx, 1rpx) * 28);
}

.preview-panel {
  height: 80vh;
  background: var(--surface);
  color: var(--text);
}
.preview-backdrop {
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}
.preview-heading,
.row-hint {
  color: var(--muted);
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: calc(var(--jy-rpx, 1rpx) * 18);
  margin: calc(var(--jy-rpx, 1rpx) * 24) 0;
}
.photo-cell {
  position: relative;
  min-width: 0;
}
.photo-cell image {
  width: 100%;
  height: calc(var(--jy-rpx, 1rpx) * 190);
  border-radius: calc(var(--jy-rpx, 1rpx) * 24);
  display: block;
}
.photo-label {
  display: block;
  text-align: center;
  padding: calc(var(--jy-rpx, 1rpx) * 10) 0;
  color: var(--muted);
  font-size: calc(var(--jy-rpx, 1rpx) * 22);
}
.photo-remove {
  position: absolute;
  top: calc(var(--jy-rpx, 1rpx) * -10);
  right: calc(var(--jy-rpx, 1rpx) * -10);
  padding: 0;
  margin: 0;
  width: calc(var(--jy-rpx, 1rpx) * 60);
  min-width: calc(var(--jy-rpx, 1rpx) * 60);
  height: calc(var(--jy-rpx, 1rpx) * 60);
  min-height: calc(var(--jy-rpx, 1rpx) * 60);
  line-height: calc(var(--jy-rpx, 1rpx) * 60);
  color: #fff;
  background: #707784ce;
  border-radius: 50%;
  font-size: calc(var(--jy-rpx, 1rpx) * 32);
}
.photo-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: calc(var(--jy-rpx, 1rpx) * 8);
  width: 100%;
  height: calc(var(--jy-rpx, 1rpx) * 190);
  margin: 0;
  padding: calc(var(--jy-rpx, 1rpx) * 12);
  border: calc(var(--jy-rpx, 1rpx) * 1) dashed var(--line);
  background: var(--raised);
  border-radius: calc(var(--jy-rpx, 1rpx) * 24);
  color: var(--muted);
}
.photo-add text:first-child {
  font-size: calc(var(--jy-rpx, 1rpx) * 56);
}
.photo-add text:last-child {
  font-size: calc(var(--jy-rpx, 1rpx) * 23);
}
.photo-confirm {
  position: absolute;
  z-index: 10;
  top: calc(var(--jy-rpx, 1rpx) * 45);
  right: calc(var(--jy-rpx, 1rpx) * -2);
  width: calc(var(--jy-rpx, 1rpx) * 260);
  padding: calc(var(--jy-rpx, 1rpx) * 20);
  background: var(--surface);
  color: var(--text);
  border: calc(var(--jy-rpx, 1rpx) * 1) solid var(--line);
  border-radius: calc(var(--jy-rpx, 1rpx) * 22);
  box-shadow: 0 calc(var(--jy-rpx, 1rpx) * 12) calc(var(--jy-rpx, 1rpx) * 35) #0002;
  font-size: calc(var(--jy-rpx, 1rpx) * 23);
}
.photo-confirm view {
  display: flex;
  gap: calc(var(--jy-rpx, 1rpx) * 8);
  margin-top: calc(var(--jy-rpx, 1rpx) * 14);
}
.photo-confirm button {
  width: auto;
  flex: 1;
  padding: calc(var(--jy-rpx, 1rpx) * 10);
  min-height: calc(var(--jy-rpx, 1rpx) * 60);
  font-size: calc(var(--jy-rpx, 1rpx) * 23);
  margin: 0;
}
.photo-confirm button:last-child {
  color: var(--danger, #b33f57);
}
.photo-viewer {
  width: 100%;
  max-height: 90vh;
  padding: calc(var(--jy-rpx, 1rpx) * 24);
  box-sizing: border-box;
  border-radius: calc(var(--jy-rpx, 1rpx) * 32);
  background: var(--surface);
}
.photo-viewer image {
  width: 100%;
  height: 55vh;
}
.photo-viewer-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.photo-viewer-head button {
  width: calc(var(--jy-rpx, 1rpx) * 80);
  min-width: calc(var(--jy-rpx, 1rpx) * 80);
  margin: 0;
  padding: 0;
}

.photo-confirm-mask {
  position: fixed;
  inset: 0;
  z-index: 9900;
  background: transparent;
}
.native-surface .photo-confirm {
  position: absolute;
  right: auto;
  max-width: calc(100vw - 24px);
  padding: calc(var(--jy-rpx, 1rpx) * 36) calc(var(--jy-rpx, 1rpx) * 32)
    calc(var(--jy-rpx, 1rpx) * 28);
  border: calc(var(--jy-rpx, 1rpx) * 1) solid var(--line);
  border-radius: calc(var(--jy-rpx, 1rpx) * 46);
  background: var(--surface);
  box-shadow: 0 calc(var(--jy-rpx, 1rpx) * 22) calc(var(--jy-rpx, 1rpx) * 80) #0003;
  box-sizing: border-box;
}
.photo-confirm-title {
  font-size: calc(var(--jy-rpx, 1rpx) * 30);
  font-weight: 600;
  line-height: 1.5;
}
.photo-confirm-copy {
  display: block;
  color: var(--muted);
  font-size: calc(var(--jy-rpx, 1rpx) * 23);
  line-height: 1.6;
  margin: calc(var(--jy-rpx, 1rpx) * 14) 0 calc(var(--jy-rpx, 1rpx) * 26);
}
.native-surface .photo-confirm button {
  width: 100%;
  min-height: calc(var(--jy-rpx, 1rpx) * 76);
  margin: 0;
  border: 0;
  border-radius: calc(var(--jy-rpx, 1rpx) * 38);
  background: var(--raised);
  color: var(--danger);
  font-size: calc(var(--jy-rpx, 1rpx) * 28);
}

.photo-confirm .photo-confirm-title {
  display: block;
  margin: 0;
}

.compose-actions .compose-submit {
  background: linear-gradient(120deg, #ed8ea0, #cf6194);
  color: #fff;
  border: calc(var(--jy-rpx, 1rpx) * 2) solid #ffffff70;
  box-shadow: inset 0 0 0 calc(var(--jy-rpx, 1rpx) * 2) #ffffff40;
}
.compose-actions .save-draft {
  padding: calc(var(--jy-rpx, 1rpx) * 8);
  min-width: calc(var(--jy-rpx, 1rpx) * 88);
  min-height: calc(var(--jy-rpx, 1rpx) * 88);
  background: transparent;
  border: 0;
  line-height: 1.35;
}
.save-draft image {
  width: calc(var(--jy-rpx, 1rpx) * 34);
  height: calc(var(--jy-rpx, 1rpx) * 34);
}
/* Native button defaults otherwise let the draft action consume the whole flex row. */
.native-surface .compose-actions {
  flex-wrap: nowrap;
  gap: var(--jy-space-2);
  padding: 8px;
}
.native-surface .compose-actions .save-draft {
  width: var(--jy-touch);
  min-width: var(--jy-touch);
  min-height: var(--jy-touch);
  flex: 0 0 var(--jy-touch);
  padding: 4px;
}
.native-surface .compose-actions .compose-submit {
  width: 0;
  min-width: 0;
  flex: 1 1 0;
  min-height: var(--jy-touch);
  padding: 8px 12px;
  line-height: 1.35;
}

.validation-mask821 {
  position: fixed;
  inset: 0;
  z-index: 10002;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: calc(var(--jy-rpx, 1rpx) * 44);
  background: #142b3c33;
}
.validation-card821 {
  width: 100%;
  max-width: calc(var(--jy-rpx, 1rpx) * 620);
  padding: calc(var(--jy-rpx, 1rpx) * 36);
  border-radius: calc(var(--jy-rpx, 1rpx) * 32);
  background: var(--surface);
  color: var(--text);
  box-shadow: 0 calc(var(--jy-rpx, 1rpx) * 12) calc(var(--jy-rpx, 1rpx) * 50) #142b3c26;
  line-height: 1.7;
  animation: validation-in821 250ms ease-out;
}
.validation-card821 .button-icon {
  width: calc(var(--jy-rpx, 1rpx) * 44);
  height: calc(var(--jy-rpx, 1rpx) * 44);
  margin-bottom: calc(var(--jy-rpx, 1rpx) * 18);
}
.validation-card821 view {
  font-weight: 600;
  font-size: calc(var(--jy-rpx, 1rpx) * 32);
}
.validation-card821 text {
  display: block;
  margin-top: calc(var(--jy-rpx, 1rpx) * 14);
  font-size: calc(var(--jy-rpx, 1rpx) * 27);
}
.validation-card821 .validation-dismiss821 {
  color: var(--muted);
  font-size: calc(var(--jy-rpx, 1rpx) * 23);
  margin-top: calc(var(--jy-rpx, 1rpx) * 24);
}
@keyframes validation-in821 {
  from {
    opacity: 0;
    transform: scale(0.96);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
