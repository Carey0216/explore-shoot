.dock-space {
  position: fixed;
  z-index: 80;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(14rpx + env(safe-area-inset-bottom));
  pointer-events: none;
}
.dock {
  display: flex;
  padding: 10rpx;
  border-radius: 46rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.95);
  background: rgba(246, 252, 250, 0.91);
  background-image: linear-gradient(125deg, rgba(255, 255, 255, 0.64), rgba(216, 236, 231, 0.34));
  box-shadow:
    0 12rpx 44rpx rgba(45, 77, 70, 0.12),
    inset 0 2rpx 2rpx rgba(255, 255, 255, 0.95);
  -webkit-backdrop-filter: blur(18px);
  backdrop-filter: blur(18px);
  pointer-events: auto;
}
.tab {
  position: relative;
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 98rpx;
  margin: 0;
  padding: 10rpx 0;
  border-radius: 34rpx;
  color: #6d8580;
  font-size: calc(22rpx * var(--font-scale, 1));
  line-height: 1;
  background: transparent;
  border: 1rpx solid transparent;
}
.tab-pressed {
  opacity: 0.8;
  transform: scale(0.97);
}
.badge {
  position: absolute;
  top: 5rpx;
  right: 22rpx;
  min-width: 28rpx;
  padding: 4rpx 7rpx;
  border: 2rpx solid white;
  border-radius: 30rpx;
  background: #bd5b59;
  color: white;
  font-size: calc(18rpx * var(--font-scale, 1));
}
.tab::after {
  border: 0;
}
.active {
  color: #245b4c;
  background: linear-gradient(150deg, rgba(255, 255, 255, 0.98), rgba(185, 220, 211, 0.75));
  border-color: rgba(255, 255, 255, 0.95);
  box-shadow:
    0 4rpx 14rpx rgba(52, 91, 80, 0.1),
    inset 0 2rpx 3rpx white;
}
.icon {
  position: relative;
  width: 36rpx;
  height: 32rpx;
}
.camera {
  height: 27rpx;
  border: 3rpx solid currentColor;
  border-radius: 7rpx;
  margin-top: 5rpx;
}
.camera::before {
  content: '';
  position: absolute;
  top: -8rpx;
  left: 8rpx;
  width: 14rpx;
  height: 7rpx;
  border: 3rpx solid currentColor;
  border-bottom: 0;
  border-radius: 4rpx 4rpx 0 0;
}
.camera .icon-detail {
  width: 12rpx;
  height: 12rpx;
  margin: 4rpx auto;
  border: 3rpx solid currentColor;
  border-radius: 50%;
}
.compass {
  width: 32rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
}
.compass .icon-detail {
  width: 9rpx;
  height: 17rpx;
  margin: 4rpx auto;
  border: 2rpx solid currentColor;
  transform: rotate(36deg);
  border-radius: 2rpx;
}
.route {
  width: 26rpx;
  height: 28rpx;
  border: 3rpx solid currentColor;
  border-top: 0;
  border-bottom: 0;
  transform: skewY(-12deg);
}
.route::before,
.route::after {
  content: '';
  position: absolute;
  width: 7rpx;
  height: 7rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  background: #eef8f3;
}
.route::before {
  left: -7rpx;
  top: -4rpx;
}
.route::after {
  right: -7rpx;
  bottom: -4rpx;
}
.person::before {
  content: '';
  position: absolute;
  width: 13rpx;
  height: 13rpx;
  top: -1rpx;
  left: 10rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
}
.person::after {
  content: '';
  position: absolute;
  left: 3rpx;
  bottom: -1rpx;
  width: 28rpx;
  height: 15rpx;
  border: 3rpx solid currentColor;
  border-bottom: 0;
  border-radius: 20rpx 20rpx 0 0;
}

.dock-create {
  flex: 0 0 100rpx;
  width: 100rpx;
  height: 100rpx;
  line-height: 86rpx;
  font-size: calc(74rpx * var(--font-scale, 1));
  margin: -22rpx 8rpx 0;
  padding: 0;
  color: #fff;
  border-radius: 33rpx;
  background: linear-gradient(145deg, #ff9779, #e75e80 70%, #c45ea5);
  border: 3rpx solid #fff9;
  box-shadow: 0 9rpx 25rpx #af36633b;
}
.dock-create:after {
  border: 0;
}

.publish-gate-mask {
  position: fixed;
  inset: 0;
  z-index: 9000;
  pointer-events: auto;
}
.publish-gate {
  position: absolute;
  bottom: 170rpx;
  left: 28rpx;
  right: 28rpx;
  padding: 34rpx;
  border-radius: 42rpx;
  background: #f9fcf4ed;
  border: 2rpx solid white;
  box-shadow: 0 25rpx 80rpx #23473c40;
  backdrop-filter: blur(20px);
}
.gate-title {
  font-size: calc(33rpx * var(--font-scale, 1));
  font-weight: 600;
  color: #365849;
}
.gate-hint {
  font-size: calc(25rpx * var(--font-scale, 1));
  line-height: 1.6;
  color: #849087;
  margin: 20rpx 0;
}
.publish-gate .u-button {
  background: #2c6553;
  color: #fff;
  border-radius: 25rpx;
  font-size: calc(25rpx * var(--font-scale, 1));
}

.calendar {
  border: 3rpx solid currentColor;
  border-radius: 7rpx;
  width: 31rpx;
  height: 28rpx;
}
.calendar:before {
  content: '';
  position: absolute;
  top: 7rpx;
  left: 0;
  right: 0;
  border-top: 3rpx solid currentColor;
}
.calendar:after {
  content: '';
  position: absolute;
  left: 7rpx;
  top: -8rpx;
  width: 13rpx;
  height: 8rpx;
  border-left: 3rpx solid currentColor;
  border-right: 3rpx solid currentColor;
}

.dock {
  position: relative;
  background: transparent;
  border: 0;
  box-shadow: none;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
  isolation: isolate;
  gap: 8rpx;
}
.dock::before,
.dock::after {
  content: '';
  position: absolute;
  top: 6rpx;
  bottom: 6rpx;
  width: calc(50% - 69rpx);
  z-index: -1;
  border: 2rpx solid white;
  border-radius: 50rpx 38rpx 62rpx 50rpx;
  background: linear-gradient(135deg, #f8fcfff0, #e2edf9d0);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  box-shadow: 0 9rpx 30rpx #23446522;
}
.dock::before {
  left: 0;
}
.dock::after {
  right: 0;
  transform: scaleX(-1);
}
.dock-create {
  flex: 0 0 100rpx;
  width: 100rpx;
  height: 104rpx;
  margin: 0 12rpx;
  transform: translateY(-15rpx) rotate(-5deg);
  border-radius: 40rpx 31rpx 47rpx 28rpx;
  background: linear-gradient(135deg, #fb929a, #e36d9f);
  font-size: calc(57rpx * var(--font-scale, 1));
  line-height: 95rpx;
  box-shadow:
    inset 0 2rpx 4rpx #fff9,
    0 8rpx 24rpx #c5558250;
  border: 2rpx solid #fffc;
}
.tab {
  background: transparent;
  border: 0;
  box-shadow: none;
}
.tab.active {
  background: #d7e8f9aa;
  color: #35688e;
  border: 0;
  box-shadow: none;
}

/* Dock selection is immediate; keep the glass silhouette without costly live blur. */
.dock::before,
.dock::after {
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
  background: var(--dock, #edf5fcf5);
  border-color: var(--line, #d8e4ed);
  box-shadow: 0 6rpx 20rpx #162c431a;
}
.tab {
  color: var(--muted, #6e808b);
  transition: none;
  animation: none;
}
.tab.active {
  background: var(--selected, #dcecff);
  color: var(--accent, #326ba6);
}
.tab-pressed {
  transform: none;
  opacity: 0.85;
}
.publish-gate {
  background: var(--surface, #fff);
  color: var(--text, #25374a);
  backdrop-filter: none;
}
.gate-title {
  color: var(--text, #25374a);
}
.gate-hint {
  color: var(--muted, #6e808b);
}

.dock.compact:before,
.dock.compact:after {
  display: none;
}
.dock.compact {
  background: var(--dock);
  border: 1rpx solid var(--line);
  border-radius: 45rpx;
}
.dock.compact .tab {
  flex: 1;
}

.dock-icon {
  display: block;
  width: 40rpx;
  height: 40rpx;
  flex: 0 0 40rpx;
}
.dock-create {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  line-height: 1;
  color: #fff;
  box-sizing: border-box;
}
.tab {
  box-sizing: border-box;
  height: 108rpx;
  gap: 8rpx;
  padding: 12rpx 0;
}
.tab .dock-label {
  display: block;
  line-height: 1.25;
  white-space: nowrap;
}

/* The web dock's two glass groups, without a moving blur layer on tab changes. */
.theme-light .dock:before,
.theme-light .dock:after {
  background: linear-gradient(125deg, #ffffffeb, #e6f1fce6);
  border-color: #ffffff;
  box-shadow:
    0 8rpx 24rpx #162c4314,
    inset 0 2rpx 3rpx #fff;
}
.theme-light .tab.active {
  background: linear-gradient(145deg, #e0efff, #cde5fd);
  border-color: #ffffffd9;
  box-shadow: inset 0 2rpx 2rpx #fff;
}
.theme-dark .dock:before,
.theme-dark .dock:after {
  background: #222225eb;
  border-color: #4a4a4f;
  box-shadow: inset 0 1rpx #ffffff14;
}
.theme-dark .tab.active {
  background: #3b4149;
  color: #c6e1ff;
  border-color: #4a4a4f;
  box-shadow: none;
}
.theme-dark .dock-create {
  background: linear-gradient(145deg, #c66a8d, #a7466e);
  border-color: #e3a9c299;
  box-shadow: 0 8rpx 20rpx #0004;
}

/* Real group surfaces avoid Android/WebView pseudo-element stacking differences. */
.dock-regular814 {
  padding: 0;
  gap: 0;
}
.dock-regular814:before,
.dock-regular814:after {
  display: none;
}
.dock-group {
  display: flex;
  flex: 1;
  min-width: 0;
  padding: 8rpx;
  border: 2rpx solid var(--line);
  background: var(--dock);
  box-shadow: 0 8rpx 24rpx #162c4314;
  border-radius: 52rpx 40rpx 64rpx 52rpx;
}
.dock-group-right {
  border-radius: 40rpx 52rpx 52rpx 64rpx;
}
.theme-light .dock-group {
  background: linear-gradient(125deg, #ffffffeb, #e6f1fce6);
  border-color: #fff;
  box-shadow:
    0 8rpx 24rpx #162c4314,
    inset 0 2rpx 3rpx #fff;
}
.theme-dark .dock-group {
  background: #222225eb;
  border-color: #4a4a4f;
  box-shadow: inset 0 1rpx #ffffff14;
}
.dock-regular814 .dock-create {
  align-self: center;
  margin: 0 18rpx;
  flex-basis: 92rpx;
  width: 92rpx;
  height: 98rpx;
}

/* Optical size of the shared 48px artwork matches the web Dock. */
.dock-icon {
  width: 48rpx;
  height: 48rpx;
  flex-basis: 48rpx;
}
/* Match the web Dock's optical icon/label ratio, without changing its split silhouette. */
.tab .dock-label {
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.25;
  letter-spacing: 0.02em;
}
.tab {
  gap: 8rpx;
}
/* One outer wing per side. Quiet tabs, one selected pill, and optical small-size glyphs. */
.dock-group {
  box-sizing: border-box;
  height: 128rpx;
  padding: 6rpx;
  border-radius: 56rpx 46rpx 64rpx 56rpx;
}
.dock-group-right {
  border-radius: 46rpx 56rpx 56rpx 64rpx;
}
.tab {
  box-sizing: border-box;
  min-height: 112rpx;
  height: 112rpx;
  padding: 14rpx 0;
  gap: 6rpx;
  border-radius: 48rpx;
  border: 0;
  background: transparent;
  box-shadow: none;
}
.tab .dock-label {
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1.25;
  letter-spacing: 0.02em;
}
.dock-icon {
  width: 44rpx;
  height: 44rpx;
  flex-basis: 44rpx;
}
.theme-light .tab.active {
  background: #dfeaf4;
  border: 0;
  box-shadow: none;
  color: #365f7e;
}
.theme-dark .tab.active {
  background: #2a4051;
  border: 0;
  box-shadow: none;
  color: #c3d8e4;
}
.dock-regular814 .dock-create {
  width: 96rpx;
  height: 100rpx;
  flex-basis: 96rpx;
  margin: 0 16rpx;
}

.impact813 .dock-group {
  animation: dock-impact813 420ms ease-out both;
}
.impact813 .tab,
.impact813 .dock-create {
  animation: tab-impact813 600ms ease-out both;
}
.impact813 .tab:nth-child(2n) {
  animation-delay: 35ms;
}
@keyframes dock-impact813 {
  0%,
  100% {
    transform: none;
  }
  18% {
    transform: translate(6rpx, 8rpx);
  }
  38% {
    transform: translate(-8rpx, -4rpx);
  }
  62% {
    transform: translate(4rpx, 2rpx);
  }
}
@keyframes tab-impact813 {
  0%,
  100% {
    transform: none;
  }
  24% {
    transform: translateY(-10rpx) rotate(2deg);
  }
  48% {
    transform: translateY(4rpx) rotate(-1deg);
  }
  76% {
    transform: translateY(-2rpx);
  }
}

/* The landing strikes the real Dock, with separate wing and control recoil. */
.impact813 .dock-group {
  animation: dock-impact814 1000ms both;
}
.impact813 .tab,
.impact813 .dock-create {
  animation: tab-impact814 1100ms both;
}
.impact813 .tab:nth-child(2n) {
  animation-delay: 30ms;
}
@keyframes dock-impact814 {
  0%,
  100% {
    transform: none;
  }
  14% {
    transform: translate(40rpx, 64rpx) rotate(1.5deg);
  }
  32% {
    transform: translate(-48rpx, -32rpx) rotate(-1.2deg);
  }
  48% {
    transform: translate(36rpx, 28rpx) rotate(0.8deg);
  }
  64% {
    transform: translate(-28rpx, -20rpx) rotate(-0.5deg);
  }
  78% {
    transform: translate(16rpx, 12rpx);
  }
  90% {
    transform: translate(-8rpx, -4rpx);
  }
}
@keyframes tab-impact814 {
  0%,
  100% {
    transform: none;
  }
  12% {
    transform: translateY(-56rpx) rotate(10deg);
  }
  29% {
    transform: translateY(28rpx) rotate(-7deg);
  }
  46% {
    transform: translateY(-16rpx) rotate(4deg);
  }
  67% {
    transform: translateY(8rpx) rotate(-2deg);
  }
  85% {
    transform: translateY(-3rpx);
  }
}

/* Ordinary map content cannot cover the navigation surface. Blocking rewards stay above it. */
.dock-space {
  z-index: 8000;
}
.dock-group {
  height: var(--jy-dock-height);
  padding: 3px;
}
.tab {
  height: var(--jy-dock-item);
  min-height: var(--jy-dock-item);
  gap: 3px;
  padding: 7px 0;
}
.tab .dock-label {
  font-size: var(--jy-dock-label);
  line-height: 1.25;
}
.dock-icon {
  width: var(--jy-dock-icon);
  height: var(--jy-dock-icon);
  flex-basis: var(--jy-dock-icon);
}
.dock-regular814 .dock-create {
  width: var(--jy-dock-create-width);
  height: var(--jy-dock-create-height);
  flex-basis: var(--jy-dock-create-width);
}
