@import '../components/base.wxss';
.dock-space {
  position: fixed;
  z-index: 8000;
  left: 12px;
  right: 12px;
  bottom: calc(8px + env(safe-area-inset-bottom));
  max-width: var(--jy-dock-max);
  margin: 0 auto;
  pointer-events: none;
}
.dock-space::before {
  content: '';
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(var(--jy-dock-height) + env(safe-area-inset-bottom) + 20px);
  background: linear-gradient(180deg, transparent, var(--bg, #f5f8fa) 14px);
  z-index: -1;
  pointer-events: auto;
}
.atlas-active821::before {
  display: none;
}
.has-gate821 {
  z-index: 10002;
}
.dock {
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: var(--jy-dock-height);
}
.dock-group {
  display: flex;
  flex: 1;
  min-width: 0;
  height: var(--jy-dock-height);
  padding: 3px;
  border: 1px solid var(--line);
  background: var(--dock);
  border-radius: 30px 26px 34px 30px;
  box-shadow: 0 4px 12px #162c4314;
  pointer-events: auto;
  box-sizing: border-box;
}
.dock-group-right {
  border-radius: 26px 30px 30px 34px;
}
.theme-light .dock-group {
  background: linear-gradient(125deg, #ffffffeb, #e6f1fce6);
  border-color: #fff;
}
.theme-dark .dock-group {
  background: #222a33ed;
  border-color: #405260;
}
.tab {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  flex: 1;
  min-width: 0;
  height: var(--jy-dock-item);
  min-height: var(--jy-dock-item);
  gap: 3px;
  margin: 0;
  padding: 7px 0;
  border: 0;
  border-radius: 26px;
  box-shadow: none;
  background: transparent;
  color: var(--muted);
  line-height: 1.25;
  box-sizing: border-box;
  pointer-events: auto;
}
.tab::after,
.dock-create::after {
  border: 0;
}
.tab.active {
  background: var(--selected);
  color: var(--accent);
}
.tab-pressed {
  opacity: 0.8;
}
.dock-icon {
  display: block;
  width: var(--jy-dock-icon);
  height: var(--jy-dock-icon);
  flex: 0 0 var(--jy-dock-icon);
}
.dock-label {
  display: block;
  font-size: var(--jy-dock-label);
  font-weight: 400;
  line-height: 1.25;
  white-space: nowrap;
}
.dock-create {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 var(--jy-dock-create-width);
  width: var(--jy-dock-create-width);
  height: var(--jy-dock-create-height);
  min-height: 0;
  margin: 0;
  padding: 0;
  border: 1px solid #fffc;
  border-radius: 20px 15px 24px 14px;
  background: linear-gradient(135deg, #fb929a, #e36d9f);
  box-shadow:
    inset 0 1px 2px #fff9,
    0 4px 12px #c5558230;
  color: #fff;
  transform: translateY(-7px) rotate(-5deg);
  pointer-events: auto;
  box-sizing: border-box;
}
.theme-dark .dock-create {
  background: linear-gradient(145deg, #c66a8d, #a7466e);
  border-color: #e3a9c299;
  box-shadow: 0 4px 12px #0004;
}
.dock-plus821 {
  display: block;
  color: #fff;
  font:
    500 var(--jy-dock-plus-font)/1 Arial,
    sans-serif;
  transform: rotate(5deg);
}
.compact {
  gap: 4px;
  padding: 3px;
  border: 1px solid var(--line);
  border-radius: 30px;
  background: var(--dock);
  pointer-events: auto;
}
.compact .dock-create {
  margin: 0 4px;
}
.publish-gate-mask {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: #142b3c55;
  pointer-events: auto;
}
.publish-gate {
  width: 100%;
  max-width: 400px;
  padding: 24px;
  border-radius: 24px;
  background: var(--surface);
  color: var(--text);
  box-sizing: border-box;
}
.gate-title {
  font-size: 18px;
  font-weight: 600;
  line-height: 1.5;
}
.gate-hint {
  margin: 12px 0 20px;
  color: var(--muted);
  font-size: 14px;
  line-height: 1.6;
}
.publish-gate .u-button {
  width: 100%;
  padding: 12px;
  white-space: normal;
}
.publish-gate .gate-primary821 {
  background: var(--accent);
  color: var(--onAccent, #fff);
}
.publish-gate .gate-secondary821 {
  margin-top: 8px;
  background: transparent;
  color: var(--muted);
}
.impact813 .dock-group {
  animation: dock-impact814 1000ms both;
}
.impact813 .tab {
  animation: tab-impact814 1100ms both;
}
.impact813 .dock-create {
  animation: create-impact814 1100ms both;
}
.impact813 .tab:nth-child(2n) {
  animation-delay: 30ms;
}
@keyframes dock-impact814 {
  0%,
  100% {
    transform: none;
  }
  14% {
    transform: translate(24px, 36px) rotate(1.5deg);
  }
  32% {
    transform: translate(-28px, -18px) rotate(-1.2deg);
  }
  48% {
    transform: translate(20px, 16px) rotate(0.8deg);
  }
  64% {
    transform: translate(-16px, -12px) rotate(-0.5deg);
  }
  78% {
    transform: translate(9px, 7px);
  }
  90% {
    transform: translate(-5px, -2px);
  }
}
@keyframes tab-impact814 {
  0%,
  100% {
    transform: none;
  }
  12% {
    transform: translateY(-32px) rotate(10deg);
  }
  29% {
    transform: translateY(16px) rotate(-7deg);
  }
  46% {
    transform: translateY(-9px) rotate(4deg);
  }
  67% {
    transform: translateY(5px) rotate(-2deg);
  }
  85% {
    transform: translateY(-2px);
  }
}
@keyframes create-impact814 {
  0%,
  100% {
    transform: translateY(-7px) rotate(-5deg);
  }
  12% {
    transform: translateY(-35px) rotate(5deg);
  }
  29% {
    transform: translateY(13px) rotate(-12deg);
  }
  46% {
    transform: translateY(-12px) rotate(-1deg);
  }
  67% {
    transform: translateY(2px) rotate(-7deg);
  }
  85% {
    transform: translateY(-5px) rotate(-5deg);
  }
}
